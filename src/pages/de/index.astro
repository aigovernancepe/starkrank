---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/ui/HeroSection.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import PillarCard from '../../components/ui/PillarCard.astro';
import Button from '../../components/ui/Button.astro';
import CTABanner from '../../components/ui/CTABanner.astro';
import { getLocalizedPillars } from '../../data/pillars';
import { getSpokePath } from '../../data/service-slugs';

const pillars = getLocalizedPillars('de');

const pillarCityLinks: Record<string, string> = {
  'search-ai-intelligence': `/de/${getSpokePath('ai-search-optimization', 'hannover', 'de')}/`,
  'performance-media': `/de/${getSpokePath('google-ads-management', 'hannover', 'de')}/`,
  'authority-pr': `/de/${getSpokePath('reactive-pr', 'hannover', 'de')}/`,
  'content-copywriting': `/de/${getSpokePath('seo-copywriting', 'hannover', 'de')}/`,
  'data-web': `/de/${getSpokePath('google-analytics-consultancy', 'hannover', 'de')}/`,
};

const allSpokes = await getCollection('spokes', (s) => s.data.locale === 'de');
const spokesByPillar = pillars.map((pillar) => ({
  pillar,
  spokes: pillar.services
    .flatMap((serviceSlug) => allSpokes.filter((s) => s.data.serviceSlug === serviceSlug))
    .map((s) => ({
      title: s.data.title,
      description: s.data.description,
      href: `/de/${getSpokePath(s.data.serviceSlug, s.data.citySlug, 'de')}/`,
    })),
}));
---

<BaseLayout
  title="StarkRank Deutschland — Datengetriebenes Digitales Marketing"
  description="StarkRank unterstützt deutsche Unternehmen und den Mittelstand mit KI-Suchoptimierung, technischem SEO, Performance-Marketing und datengetriebenen Wachstumsstrategien — von Hannover aus für den gesamten deutschen Markt."
  locale="de"
>
  <HeroSection
    headline="Datenbasiertes Wachstum für das **KI-Zeitalter**"
    subheadline="StarkRank positioniert B2B-Unternehmen, Mittelstand und IT-Dienstleister für Sichtbarkeit in Suchmaschinen und KI-Plattformen — mit Sitz in Hannover, aktiv in ganz Deutschland."
  >
    <Button href="/de/aiso-check/" variant="primary" size="lg">Kostenloser AISO-Check &rarr;</Button>
  </HeroSection>

  <Section bg="cream">
    <SectionHeader label="Unsere Dienstleistungen" title="Fünf Säulen des digitalen Wachstums" align="center" />
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {pillars.map((pillar) => <PillarCard pillar={pillar} locale="de" href={pillarCityLinks[pillar.id]} />)}
    </div>
  </Section>

  <Section bg="white">
    <SectionHeader
      label="Leistungen in Deutschland"
      title="Alle Dienstleistungen im Überblick"
      subtitle="Vollständige Palette an digitalen Marketingleistungen — lokal verankert in Hannover, für Unternehmen in ganz Deutschland."
      align="center"
    />
    <div class="space-y-12">
      {spokesByPillar.map(({ pillar, spokes }) => spokes.length > 0 && (
        <div>
          <h3 class="text-sm font-label font-bold uppercase tracking-[0.2em] text-blue mb-4">{pillar.name}</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {spokes.map((spoke) => (
              <a
                href={spoke.href}
                class="group block bg-cream/40 border border-gray-light/40 rounded-lg p-5 transition-all hover:shadow-md hover:border-blue/30"
              >
                <h4 class="text-base font-headline font-black text-navy group-hover:text-blue transition-colors leading-snug">
                  {spoke.title}
                </h4>
                <p class="mt-2 text-sm font-body text-gray leading-relaxed line-clamp-2">
                  {spoke.description}
                </p>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </Section>

  <CTABanner bg="navy" title="Bereit zu wachsen?" subtitle="Buchen Sie eine kostenlose Erstberatung.">
    <Button href="/de/kontakt/" variant="primary" size="lg">Kontaktieren Sie uns</Button>
  </CTABanner>
</BaseLayout>
