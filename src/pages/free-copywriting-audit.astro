---
import LandingLayout from '../layouts/LandingLayout.astro';
import Section from '../components/ui/Section.astro';

const title = 'Free Copywriting Audit — Is Your Website Converting? | StarkRank';
const description = "Your website gets traffic but not leads? Our free 6-dimension copywriting audit shows exactly where your copy loses visitors. No commitment. Results in 48h.";

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Free Copywriting & UX Audit — 6-Dimension Diagnostic',
  description: 'Free 6-dimension copywriting audit evaluating search alignment, AI citability, conversion effectiveness, and brand consistency. 3 key pages reviewed with actionable recommendations.',
  url: 'https://starkrank.com/free-copywriting-audit/',
  inLanguage: 'en-US',
  isPartOf: {
    '@type': 'WebSite',
    name: 'StarkRank',
    url: 'https://starkrank.com',
  },
  mainEntity: {
    '@type': 'Service',
    name: 'Free Copywriting & UX Audit',
    description: '6-dimension copywriting diagnostic covering search alignment, entity coverage, AI citability, E-E-A-T signals, conversion effectiveness, and brand consistency.',
    provider: {
      '@type': 'Organization',
      name: 'StarkRank',
      url: 'https://starkrank.com',
    },
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
      description: 'Free copywriting audit — 3 key pages, 6 dimensions scored',
    },
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://starkrank.com/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Free Copywriting Audit',
      item: 'https://starkrank.com/free-copywriting-audit/',
    },
  ],
};

const schemas = [webPageSchema, breadcrumbSchema];

const auditDimensions = [
  { num: 1, dimension: 'Search Alignment', weight: '20%', check: 'Are your headlines, meta descriptions, and page structure optimized for the keywords your audience actually uses?' },
  { num: 2, dimension: 'Entity Coverage', weight: '15%', check: 'Does your content cover the topics, services, and concepts that establish your expertise? Are there gaps vs competitors?' },
  { num: 3, dimension: 'AI Citability', weight: '25%', check: 'Is your content structured so AI platforms (ChatGPT, Google AI) can extract and quote it? Answer-first format, FAQ sections, original data.' },
  { num: 4, dimension: 'E-E-A-T Signals', weight: '15%', check: 'Does your site demonstrate Experience, Expertise, Authoritativeness, and Trust? Author bios, credentials, source citations, contact methods.' },
  { num: 5, dimension: 'Conversion Effectiveness', weight: '15%', check: 'Are your CTAs visible, your value proposition clear, and your trust signals (reviews, testimonials, certifications) working for you?' },
  { num: 6, dimension: 'Brand Consistency', weight: '10%', check: 'Does your tone, terminology, and messaging stay consistent across pages? Does your copy sound like YOU or like a template?' },
];
---

<LandingLayout
  title={title}
  description={description}
  ogImage="/images/copywriting-audit-preview.png"
  schema={schemas}
  backLink={{ label: 'Back to Services', href: '/services/seo-copywriting/' }}
>
  <Fragment slot="head">
    <link rel="alternate" hreflang="en" href="https://starkrank.com/free-copywriting-audit/" />
    <link rel="alternate" hreflang="x-default" href="https://starkrank.com/free-copywriting-audit/" />
  </Fragment>

  <!-- Hero + Form -->
  <Section bg="cream">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
      <!-- Hero text -->
      <div>
        <h1 class="text-4xl md:text-5xl font-headline font-black tracking-tight text-navy leading-tight">
          Is Your Website Selling — or Just Existing?
        </h1>
        <p class="mt-6 text-lg font-body text-gray leading-relaxed">
          Most websites look fine but don't convert. The copy reads like a brochure, the CTAs are buried, and visitors leave without taking action. Our free 6-dimension copywriting audit shows you exactly where your pages lose leads — and what to fix first.
        </p>

        <!-- Value bullets -->
        <div class="mt-8">
          <p class="text-xs font-label font-bold uppercase tracking-widest text-blue mb-4">What you'll learn</p>
          <div class="space-y-4">
            <div class="flex items-start gap-3">
              <span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span>
              <p class="text-base font-body text-gray"><strong class="text-dark">Is your copy aligned with what people actually search for?</strong> — We check whether your headlines, page structure, and messaging match the keywords your audience uses</p>
            </div>
            <div class="flex items-start gap-3">
              <span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span>
              <p class="text-base font-body text-gray"><strong class="text-dark">Can AI platforms quote your content?</strong> — We evaluate whether your content is structured for AI citation (capsule answers, FAQ sections, original data)</p>
            </div>
            <div class="flex items-start gap-3">
              <span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span>
              <p class="text-base font-body text-gray"><strong class="text-dark">Are visitors converting or bouncing?</strong> — We audit your CTAs, value propositions, trust signals, and conversion paths page by page</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Form -->
      <div id="get-your-free-copywriting-audit" class="bg-white border border-gray-light/40 rounded-lg p-8 shadow-lg">
        <h2 class="text-2xl font-headline font-black text-navy mb-6">Get Your Free Copywriting Audit</h2>
        <form class="contact-form space-y-4" data-success="Thank you! We're reviewing your site now. You'll receive your 6-dimension copywriting diagnostic within 48 hours." data-error="Something went wrong. Please try again or email us at contact@starkrank.com.">
          <input type="hidden" name="access_key" value="c6c510f0-14d6-42e3-b16b-c4db8ac4e71b" />
          <input type="hidden" name="subject" value="Free Copywriting Audit Request" />
          <input type="hidden" name="from_name" value="StarkRank — Copywriting Audit" />
          <input type="checkbox" name="botcheck" class="hidden" style="display:none" />
          <div>
            <label for="website" class="block text-sm font-label font-semibold text-dark mb-1">Website URL <span class="text-blue">*</span></label>
            <input
              type="url"
              id="website"
              name="website"
              required
              placeholder="https://yoursite.com"
              class="w-full px-4 py-3 border border-gray-light/60 rounded-md text-sm font-body text-dark placeholder-gray focus:outline-none focus:ring-2 focus:ring-blue/40 focus:border-blue transition-colors"
            />
          </div>
          <div>
            <label for="pages" class="block text-sm font-label font-semibold text-dark mb-1">Which pages matter most? <span class="text-gray text-xs font-normal">(optional)</span></label>
            <select
              id="pages"
              name="pages"
              class="w-full px-4 py-3 border border-gray-light/60 rounded-md text-sm font-body text-dark focus:outline-none focus:ring-2 focus:ring-blue/40 focus:border-blue transition-colors"
            >
              <option value="">Select...</option>
              <option value="Homepage">Homepage</option>
              <option value="Service pages">Service pages</option>
              <option value="Landing pages">Landing pages</option>
              <option value="Blog">Blog</option>
              <option value="All of the above">All of the above</option>
            </select>
          </div>
          <div>
            <label for="industry" class="block text-sm font-label font-semibold text-dark mb-1">Industry <span class="text-gray text-xs font-normal">(optional)</span></label>
            <select
              id="industry"
              name="industry"
              class="w-full px-4 py-3 border border-gray-light/60 rounded-md text-sm font-body text-dark focus:outline-none focus:ring-2 focus:ring-blue/40 focus:border-blue transition-colors"
            >
              <option value="">Select...</option>
              <option value="Dental">Dental</option>
              <option value="Legal">Legal</option>
              <option value="Auto Services">Auto Services</option>
              <option value="Med Spa">Med Spa</option>
              <option value="Home Services">Home Services</option>
              <option value="Financial">Financial</option>
              <option value="E-Commerce">E-Commerce</option>
              <option value="SaaS">SaaS</option>
              <option value="Other">Other</option>
            </select>
          </div>
          <div>
            <label for="email" class="block text-sm font-label font-semibold text-dark mb-1">Work Email <span class="text-blue">*</span></label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="you@company.com"
              class="w-full px-4 py-3 border border-gray-light/60 rounded-md text-sm font-body text-dark placeholder-gray focus:outline-none focus:ring-2 focus:ring-blue/40 focus:border-blue transition-colors"
            />
          </div>
          <div>
            <label for="name" class="block text-sm font-label font-semibold text-dark mb-1">Full Name <span class="text-blue">*</span></label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="Jane Smith"
              class="w-full px-4 py-3 border border-gray-light/60 rounded-md text-sm font-body text-dark placeholder-gray focus:outline-none focus:ring-2 focus:ring-blue/40 focus:border-blue transition-colors"
            />
          </div>
          <div>
            <button
              type="submit"
              class="w-full inline-flex items-center justify-center font-label font-semibold uppercase tracking-wide transition-all rounded-md bg-blue text-white hover:bg-blue-light px-8 py-4 text-sm mt-2"
            >
              <span class="submit-text">Get My Free Copywriting Audit &rarr;</span>
              <svg class="submit-spinner hidden w-5 h-5 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            </button>
          </div>
          <p class="text-xs font-body text-gray text-center mt-2">
            Takes 2 minutes to request. We review your 3 most important pages. Results in 48 hours.
          </p>
          <div class="form-status hidden rounded-lg p-4 text-sm font-body"></div>
        </form>
      </div>
    </div>
  </Section>

  <!-- The 6 Dimensions -->
  <Section bg="white">
    <div class="max-w-4xl">
      <p class="text-xs font-label font-semibold uppercase tracking-[0.2em] text-blue mb-3">What We Audit</p>
      <h2 class="text-2xl md:text-3xl font-headline font-black text-navy tracking-tight mb-4">
        6 Dimensions of Copywriting Performance
      </h2>
      <p class="text-base font-body text-gray leading-relaxed mb-8">
        We evaluate your website copy across 6 dimensions — each scored 1-10 with specific, actionable recommendations. Your composite score is a weighted average benchmarked against competitors in your vertical.
      </p>

      <div class="overflow-x-auto">
        <table class="w-full text-sm font-body border-collapse">
          <thead>
            <tr class="border-b-2 border-navy/20">
              <th class="text-left py-3 pr-4 font-headline font-bold text-navy w-8">#</th>
              <th class="text-left py-3 pr-4 font-headline font-bold text-navy">Dimension</th>
              <th class="text-left py-3 pr-4 font-headline font-bold text-navy w-16">Weight</th>
              <th class="text-left py-3 font-headline font-bold text-navy">What We Check</th>
            </tr>
          </thead>
          <tbody>
            {auditDimensions.map((d) => (
              <tr class="border-b border-gray-light/40">
                <td class="py-3 pr-4 text-blue font-headline font-bold">{d.num}</td>
                <td class="py-3 pr-4 whitespace-nowrap font-semibold text-dark">{d.dimension}</td>
                <td class="py-3 pr-4 text-gray">{d.weight}</td>
                <td class="py-3 text-gray leading-relaxed">{d.check}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </Section>

  <!-- Why Copy Quality Matters -->
  <Section bg="cream">
    <div class="max-w-3xl">
      <h2 class="text-2xl md:text-3xl font-headline font-black text-navy tracking-tight mb-4">
        Why Copy Quality Matters More Than Ever
      </h2>
      <p class="text-base font-body text-gray leading-relaxed mb-6">
        Search engines and AI platforms evaluate content quality differently than humans do. A page can look professional to a visitor but score poorly for:
      </p>
      <div class="space-y-4">
        <div class="flex items-start gap-3">
          <span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span>
          <p class="text-base font-body text-gray"><strong class="text-dark">AI extraction</strong> — if your answers are buried in paragraphs instead of structured as direct responses, AI platforms skip you</p>
        </div>
        <div class="flex items-start gap-3">
          <span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span>
          <p class="text-base font-body text-gray"><strong class="text-dark">Search relevance</strong> — if your headlines don't match real search queries, you rank for nothing</p>
        </div>
        <div class="flex items-start gap-3">
          <span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span>
          <p class="text-base font-body text-gray"><strong class="text-dark">Trust</strong> — if there's no author, no credentials, no sources cited, both Google and AI models downgrade your authority</p>
        </div>
      </div>
      <p class="mt-6 text-base font-body text-dark font-semibold">
        The gap between "looks fine" and "actually converts" is measurable. That's what the copywriting audit reveals.
      </p>
    </div>
  </Section>

  <!-- Upsell -->
  <Section bg="white">
    <div class="max-w-4xl">
      <h2 class="text-2xl md:text-3xl font-headline font-black text-navy tracking-tight mb-4">
        Want a Full Page-by-Page Rewrite?
      </h2>
      <p class="text-base font-body text-gray leading-relaxed mb-8">
        The free audit covers your 3 most important pages. For businesses ready for a comprehensive overhaul:
      </p>

      <div class="overflow-x-auto">
        <table class="w-full text-sm font-body border-collapse">
          <thead>
            <tr class="border-b-2 border-navy/20">
              <th class="text-left py-3 pr-4 font-headline font-bold text-navy"></th>
              <th class="text-center py-3 px-4 font-headline font-bold text-navy">Free Audit</th>
              <th class="text-center py-3 px-4 font-headline font-bold text-navy">Full Copywriting Audit</th>
              <th class="text-center py-3 px-4 font-headline font-bold text-navy">Content Retainer</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-light/40">
              <td class="py-3 pr-4 text-dark font-semibold">Pages reviewed</td>
              <td class="py-3 px-4 text-center text-gray">3 key pages</td>
              <td class="py-3 px-4 text-center text-gray">All service/landing pages</td>
              <td class="py-3 px-4 text-center text-gray">Ongoing</td>
            </tr>
            <tr class="border-b border-gray-light/40">
              <td class="py-3 pr-4 text-dark font-semibold">6-dimension scoring</td>
              <td class="py-3 px-4 text-center text-blue">Yes</td>
              <td class="py-3 px-4 text-center text-blue">Yes</td>
              <td class="py-3 px-4 text-center text-blue">Yes</td>
            </tr>
            <tr class="border-b border-gray-light/40">
              <td class="py-3 pr-4 text-dark font-semibold">Competitor comparison</td>
              <td class="py-3 px-4 text-center text-gray">Top 3</td>
              <td class="py-3 px-4 text-center text-gray">Top 5 + AI citation check</td>
              <td class="py-3 px-4 text-center text-gray">Monthly</td>
            </tr>
            <tr class="border-b border-gray-light/40">
              <td class="py-3 pr-4 text-dark font-semibold">Rewrite recommendations</td>
              <td class="py-3 px-4 text-center text-gray">Summary</td>
              <td class="py-3 px-4 text-center text-gray">Page-by-page action plan</td>
              <td class="py-3 px-4 text-center text-gray">Done for you</td>
            </tr>
            <tr class="border-b border-gray-light/40">
              <td class="py-3 pr-4 text-dark font-semibold">AI citability optimization</td>
              <td class="py-3 px-4 text-center text-gray">Flagged</td>
              <td class="py-3 px-4 text-center text-gray">Detailed restructuring plan</td>
              <td class="py-3 px-4 text-center text-gray">Capsule rewrites</td>
            </tr>
            <tr class="border-b border-gray-light/40">
              <td class="py-3 pr-4 text-dark font-semibold">Semantic content scoring</td>
              <td class="py-3 px-4 text-center text-gray">No</td>
              <td class="py-3 px-4 text-center text-blue">Yes</td>
              <td class="py-3 px-4 text-center text-blue">Yes</td>
            </tr>
            <tr>
              <td class="py-3 pr-4 font-headline font-bold text-navy">Price</td>
              <td class="py-3 px-4 text-center font-headline font-bold text-navy">Free</td>
              <td class="py-3 px-4 text-center font-headline font-bold text-navy">From $2,000</td>
              <td class="py-3 px-4 text-center font-headline font-bold text-navy">From $3,000/mo</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="mt-6 space-y-2">
        <p class="text-base font-body text-gray">
          <a href="/services/content-marketing/" class="text-blue font-semibold hover:text-blue-light">Learn about our Content Marketing services &rarr;</a>
        </p>
        <p class="text-base font-body text-gray">
          <a href="/services/seo-copywriting/" class="text-blue font-semibold hover:text-blue-light">Learn about our SEO Copywriting services &rarr;</a>
        </p>
      </div>
    </div>
  </Section>

  <!-- Who This Is For -->
  <Section bg="cream">
    <div class="max-w-3xl">
      <p class="text-xs font-label font-bold uppercase tracking-widest text-blue mb-6">Who This Is For</p>
      <div class="space-y-4">
        <div class="flex items-start gap-3">
          <span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span>
          <p class="text-base font-body text-gray"><strong class="text-dark">Your website gets traffic but not enough leads</strong> — visitors browse but don't call, fill out forms, or buy</p>
        </div>
        <div class="flex items-start gap-3">
          <span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span>
          <p class="text-base font-body text-gray"><strong class="text-dark">You've been told "the website looks great" but results disagree</strong> — design isn't the problem, copy is</p>
        </div>
        <div class="flex items-start gap-3">
          <span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span>
          <p class="text-base font-body text-gray"><strong class="text-dark">Your previous agency wrote content that reads like AI slop</strong> — generic, no personality, no conversion intent</p>
        </div>
        <div class="flex items-start gap-3">
          <span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span>
          <p class="text-base font-body text-gray"><strong class="text-dark">You're investing in SEO but pages aren't ranking</strong> — the issue might be content quality, not technical SEO</p>
        </div>
      </div>
    </div>
  </Section>

  <!-- Closing CTA -->
  <section class="bg-navy text-cream py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-headline font-black tracking-tight text-cream">
        Your Copy Is Either Converting or Costing You
      </h2>
      <p class="mt-4 text-lg font-body text-gray-light">
        Every page on your site is either moving visitors toward action or pushing them to a competitor. The free audit takes 2 minutes to request and shows you exactly which pages need work — and why.
      </p>
      <div class="mt-8">
        <a
          href="#get-your-free-copywriting-audit"
          class="inline-flex items-center justify-center font-label font-semibold uppercase tracking-wide transition-all rounded-md bg-blue text-white hover:bg-blue-light px-8 py-4 text-sm"
        >
          Get Your Free Copywriting Audit Now &uarr;
        </a>
      </div>
    </div>
  </section>
</LandingLayout>

<script>
  function initForms() {
    document.querySelectorAll('.contact-form').forEach((form) => {
      if ((form as HTMLFormElement).dataset.initialized) return;
      (form as HTMLFormElement).dataset.initialized = 'true';

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const f = e.target as HTMLFormElement;
        const submitText = f.querySelector('.submit-text') as HTMLElement;
        const spinner = f.querySelector('.submit-spinner') as HTMLElement;
        const status = f.querySelector('.form-status') as HTMLElement;
        const button = f.querySelector('button[type="submit"]') as HTMLButtonElement;

        submitText.classList.add('hidden');
        spinner.classList.remove('hidden');
        button.disabled = true;
        status.classList.add('hidden');

        try {
          const res = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(Object.fromEntries(new FormData(f))),
          });
          const data = await res.json();

          if (data.success) {
            status.textContent = f.dataset.success || 'Message sent!';
            status.className = 'form-status rounded-lg p-4 text-sm font-body bg-blue/10 text-blue border border-blue/20';
            f.reset();
          } else {
            status.textContent = f.dataset.error || 'Something went wrong.';
            status.className = 'form-status rounded-lg p-4 text-sm font-body bg-red-50 text-red-700 border border-red-200';
          }
        } catch {
          status.textContent = f.dataset.error || 'Something went wrong.';
          status.className = 'form-status rounded-lg p-4 text-sm font-body bg-red-50 text-red-700 border border-red-200';
        }

        submitText.classList.remove('hidden');
        spinner.classList.add('hidden');
        button.disabled = false;
      });
    });
  }

  initForms();
  document.addEventListener('astro:after-swap', initForms);
</script>
