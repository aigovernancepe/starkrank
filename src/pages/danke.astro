---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/ui/HeroSection.astro';
import Button from '../components/ui/Button.astro';
import { t } from '../utils/i18n';
---

<BaseLayout
  title={`${t('thanks.title', 'de')} — StarkRank`}
  description={t('thanks.body', 'de')}
  locale="de"
  noViewTransitions
>
  <meta slot="head" name="robots" content="noindex" />
  <HeroSection
    headline={t('thanks.title', 'de')}
    subheadline={t('thanks.body', 'de')}
  >
    <Button href="/" variant="primary" size="lg">{t('thanks.cta', 'de')}</Button>
  </HeroSection>

  {/* Google-Ads-Conversion: feuert NUR bei echtem Lead (kein ?error). Client-seitiges
      Gating, da diese Seite statisch pre-rendered ist (Frontmatter läuft zur Build-Zeit).
      TODO: send_to-Platzhalter nach Anlegen der Conversion-Action im Ads-Konto ersetzen. */}
  <script is:inline>
    (function () {
      var params = new URLSearchParams(window.location.search);
      if (params.has('error')) return;
      if (params.get('lead') === 'hp') return;
      var formType = params.get('lead') || undefined;
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'conversion', { send_to: 'AW-XXXXXXXXXX/XXXXXXXXXXXXXXX' });
      }
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: 'generate_lead', form_type: formType });
    })();
  </script>
</BaseLayout>
