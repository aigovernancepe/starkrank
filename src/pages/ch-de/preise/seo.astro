---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HeroSection from '../../../components/ui/HeroSection.astro';
import Section from '../../../components/ui/Section.astro';
import SectionHeader from '../../../components/ui/SectionHeader.astro';
import Card from '../../../components/ui/Card.astro';
import CTASplit from '../../../components/ui/CTASplit.astro';
import Button from '../../../components/ui/Button.astro';

const title = 'SEO Kosten Schweiz — Transparente Retainer | StarkRank';
const description = 'Was kostet eine SEO-Agentur in der Schweiz? Transparente Retainer ab 1\'190 CHF/Monat und Audit-Preise ab 1\'800 CHF — fair kalkuliert für KMU.';

// Pricing commitment marker. Update manually when published bands actually change.
// Distinct from the freshness/last-edit date (that tracks any file edit via git).
const priceValidFrom = new Date('2026-04-29');
const priceValidFromIso = priceValidFrom.toISOString().split('T')[0];
const priceValidFromLabel = priceValidFrom.toLocaleDateString('de-CH', { year: 'numeric', month: 'long' });

const retainerBands = [
  {
    label: 'Solo & Kleinunternehmen',
    price: 'ab 1\'190 CHF/Monat',
    description:
      'Technisches SEO-Monitoring, quartalsweise Reviews und laufende On-Page-Optimierung für Unternehmen mit einem Standort und kleinem Content-Team.',
  },
  {
    label: 'Mittelstand',
    price: 'ab 3\'000 CHF/Monat',
    description:
      'Vollumfänglicher Retainer mit technischer Optimierung, Content-Kollaboration und monatlichem Reporting. Für Unternehmen, die SEO als echten Wachstumskanal betreiben.',
  },
  {
    label: 'Enterprise / Multi-Standort',
    price: 'ab 6\'000 CHF/Monat',
    description:
      'Individueller Scope — Multi-Location SEO, mehrsprachige Sites, E-Commerce mit 10\'000+ SKUs. Preise nach Umfang auf Anfrage.',
  },
];

const siteBuildTiers = [
  {
    label: 'Small Hub',
    price: 'ab 3\'900 CHF',
    description: '5–7 Seiten: Hub, Team, Anlagephilosophie / Service, eine Service-Seite, FinSv-Compliance-Block, Kontakt. Nur Deutsch. FinancialService- und Person-Schema (1 GF). revDSG-Block. Profil: Solo-Vermögensverwalter / Einzel-Partner-Boutique.',
  },
  {
    label: 'Medium Hub',
    price: 'ab 6\'900 CHF',
    description: '8–12 Seiten: + 1–2 Spezialisierungs-Nischen als eigene Service-Seiten, 2–3 Person-Schemata, Risikohinweise nach FINMA-RS 2025/2, auf Wunsch Blog-Aufbau. Profil: Boutique mittlerer Grösse mit Nischen-Funnel.',
  },
  {
    label: 'Large Hub',
    price: 'ab 8\'900 CHF',
    description: '15+ Seiten: + Multi-Partner mit 5+ Person-Schemata, Multi-Standort- oder Gruppen-Aufbau, auf Wunsch Portfolio- und Produkte-Verzeichnisse, zweisprachig Deutsch und Englisch, Multi-Schema-Aufbau. Profil: Multi-Partner / Multi-Standort.',
  },
];

const projectPrices = [
  {
    service: 'SEO Audit',
    price: '1\'800 CHF / 3\'000 CHF / ab 5\'000 CHF',
    scope: 'Gestaffelt nach Site-Grösse: Standard bis 1\'000 URLs / Mittelstand 1\'000–5\'000 URLs (multi-CMS) / Enterprise 5\'000+ URLs (individueller Scope). Inklusive Crawl, manueller Expertenprüfung, AI Search Optimization Score-Bewertung über sechs Dimensionen, priorisierter Roadmap und 60-minütigem Walkthrough.',
  },
  {
    service: 'E-commerce SEO Audit',
    price: '2\'500 CHF / 3\'600 CHF / 4\'000 CHF',
    scope: 'Gestaffelt nach Katalog­grösse: bis 1\'000 SKUs / 1\'000–10\'000 SKUs / über 10\'000 SKUs.',
  },
  {
    service: 'Pre-Deploy SEO Check',
    price: 'ab 500 CHF',
    scope: 'Bis zu 30 URLs vor dem Launch einer neuen Site oder Migration, 10 CHF pro zusätzliche URL.',
  },
  {
    service: 'E-E-A-T Audit',
    price: 'ab 1\'500 CHF',
    scope: 'Experience-Expertise-Authoritativeness-Trustworthiness-Scoring nach 4×10-Rubrik, 10 Seiten; zusätzliche Seiten 140 CHF.',
  },
];

const priceFactors = [
  'Grösse und Komplexität der Website — Anzahl der URLs, Domain-Alter und vorhandene technische Altlasten.',
  'Sprach- und Standort-Setup — Single-Market, DACH-weit oder international mit mehrsprachiger Auslieferung.',
  'Wettbewerbsintensität in Ihrer Branche — SaaS-SEO und lokale Dienstleister unterscheiden sich deutlich im Aufwand.',
  'Umfang der Content-Kollaboration — reiner Technik-Retainer oder inklusive Content-Pipeline.',
];

const faqs = [
  {
    q: 'Wie lange läuft ein typischer SEO-Retainer?',
    a: 'Wir empfehlen mindestens sechs Monate. SEO-Effekte — insbesondere aus technischen Änderungen und neuem Content — brauchen Zeit, bis Google sie bewertet und in Rankings übersetzt. Monatsverträge sind möglich, aber ehrlich gesagt nicht sinnvoll.',
  },
  {
    q: 'Gibt es Rabatte?',
    a: 'Bei Jahresverträgen prüfen wir im Einzelfall. Bei Audit-Bundles (etwa drei Sites gleichzeitig für E-E-A-T) gewähren wir einen prozentualen Nachlass — der genaue Satz hängt vom Gesamtumfang ab.',
  },
  {
    q: 'Was ist in einem «ab»-Preis nicht enthalten?',
    a: 'Werbebudget für Google Ads, Content-Produktion ab einem bestimmten Volumen (etwa mehr als vier Longform-Artikel pro Monat), Übersetzungen in weitere Sprachen und Lizenzgebühren für Drittanbieter-Tools werden getrennt ausgewiesen.',
  },
  {
    q: 'Kann ich mit einem Audit starten und später auf Retainer umsteigen?',
    a: 'Nicht nur können Sie — Sie sollten. Ein Audit ist für uns die Baseline jedes Retainers: Ohne belastbare Ausgangsanalyse arbeiten wir nicht. Der Audit-Preis wird dabei nicht auf den Retainer angerechnet, weil der Retainer bereits wettbewerbsfähig kalkuliert ist.',
  },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'SEO-Dienstleistungen Schweiz',
  description:
    'SEO-Retainer, Festpreis-Webauftritte für Vermögensverwalter-Boutiquen und Einmal-Audits für Schweizer Unternehmen — technisches SEO, KI-Suchoptimierung, E-Commerce-SEO und E-E-A-T-Analysen, mit Datenverarbeitung in der Schweiz.',
  provider: {
    '@type': 'Organization',
    name: 'StarkRank',
    url: 'https://starkrank.com',
  },
  areaServed: [
    { '@type': 'Country', name: 'Switzerland' },
    { '@type': 'Country', name: 'Germany' },
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'SEO-Retainer, VV-Webauftritt-Festpreise und Audit-Preise (Schweiz)',
    itemListElement: [
      {
        '@type': 'Offer',
        name: 'SEO-Retainer — Solo & Kleinunternehmen',
        priceCurrency: 'CHF',
        priceSpecification: {
          '@type': 'UnitPriceSpecification',
          minPrice: '1190',
          priceCurrency: 'CHF',
          validFrom: priceValidFromIso,
          referenceQuantity: { '@type': 'QuantitativeValue', value: '1', unitText: 'MONTH' },
        },
      },
      {
        '@type': 'Offer',
        name: 'SEO-Retainer — Mittelstand',
        priceCurrency: 'CHF',
        priceSpecification: {
          '@type': 'PriceSpecification',
          minPrice: '3000',
          maxPrice: '5000',
          priceCurrency: 'CHF',
          validFrom: priceValidFromIso,
        },
      },
      {
        '@type': 'Offer',
        name: 'SEO-Retainer — Enterprise / Multi-Standort',
        priceCurrency: 'CHF',
        priceSpecification: {
          '@type': 'UnitPriceSpecification',
          minPrice: '6000',
          priceCurrency: 'CHF',
          validFrom: priceValidFromIso,
          referenceQuantity: { '@type': 'QuantitativeValue', value: '1', unitText: 'MONTH' },
        },
      },
      {
        '@type': 'Offer',
        name: 'VV-Webauftritt — Small',
        price: '3900',
        priceCurrency: 'CHF',
        priceSpecification: {
          '@type': 'PriceSpecification',
          minPrice: '3900',
          priceCurrency: 'CHF',
          validFrom: priceValidFromIso,
        },
      },
      {
        '@type': 'Offer',
        name: 'VV-Webauftritt — Medium',
        price: '6900',
        priceCurrency: 'CHF',
        priceSpecification: {
          '@type': 'PriceSpecification',
          minPrice: '6900',
          priceCurrency: 'CHF',
          validFrom: priceValidFromIso,
        },
      },
      {
        '@type': 'Offer',
        name: 'VV-Webauftritt — Large',
        price: '8900',
        priceCurrency: 'CHF',
        priceSpecification: {
          '@type': 'PriceSpecification',
          minPrice: '8900',
          priceCurrency: 'CHF',
          validFrom: priceValidFromIso,
        },
      },
      {
        '@type': 'Offer',
        name: 'SEO Audit',
        priceCurrency: 'CHF',
        priceSpecification: {
          '@type': 'PriceSpecification',
          minPrice: '1800',
          maxPrice: '5000',
          priceCurrency: 'CHF',
          validFrom: priceValidFromIso,
        },
      },
      {
        '@type': 'Offer',
        name: 'E-commerce SEO Audit',
        priceCurrency: 'CHF',
        priceSpecification: {
          '@type': 'PriceSpecification',
          minPrice: '2500',
          maxPrice: '4000',
          priceCurrency: 'CHF',
          validFrom: priceValidFromIso,
        },
      },
      {
        '@type': 'Offer',
        name: 'Pre-Deploy SEO Check',
        price: '500',
        priceCurrency: 'CHF',
      },
      {
        '@type': 'Offer',
        name: 'E-E-A-T Audit',
        price: '1500',
        priceCurrency: 'CHF',
      },
    ],
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Start', item: 'https://starkrank.com/ch-de/' },
    { '@type': 'ListItem', position: 2, name: 'Preise', item: 'https://starkrank.com/ch-de/preise/' },
    { '@type': 'ListItem', position: 3, name: 'SEO', item: 'https://starkrank.com/ch-de/preise/seo/' },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const schemas = [serviceSchema, breadcrumbSchema, faqSchema];
---

<BaseLayout title={title} description={description} locale="ch-de" schema={schemas}>
  <Fragment slot="head">
    <link rel="alternate" hreflang="de-DE" href="https://starkrank.com/preise/seo/" />
    <link rel="alternate" hreflang="de-CH" href="https://starkrank.com/ch-de/preise/seo/" />
    <link rel="alternate" hreflang="x-default" href="https://starkrank.com/preise/seo/" />
  </Fragment>

  <HeroSection
    eyebrow="Transparent · Fair · Nachvollziehbar"
    headline="SEO-Preise Schweiz"
    subheadline="Was kostet eine SEO-Agentur in der Schweiz? Bei StarkRank zahlen Sie das, was Ihr Unternehmensmassstab braucht — keine aufgeblähten Agenturstrukturen, keine undurchsichtigen Pauschalverträge."
  >
    <Button href="/ch-de/kontakt/" variant="primary">Kostenlose Erstberatung</Button>
    <Button href="#retainer-baender" variant="secondary">SEO-Retainer ansehen</Button>
  </HeroSection>

  <Section bg="cream">
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-gray-light/60 bg-white text-xs font-label text-gray mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-blue" aria-hidden="true"></span>
        Preise gültig ab <time datetime={priceValidFromIso}>{priceValidFromLabel}</time> · Änderungen vorbehalten
      </div>
      <h2 class="text-2xl md:text-3xl font-headline font-bold text-navy">Warum unsere Preise fair sind</h2>
      <p class="mt-4 text-base font-body text-gray leading-relaxed">
        Wir sind eine kleine Agentur mit niedrigem Overhead. Das heisst: Sie zahlen für Arbeit an Ihrem Account, nicht für repräsentative Bahnhofstrasse-Büros in Zürich oder Adressen am Genfer Paradeplatz. Gleiche Qualität, andere Kostenstruktur.
      </p>
      <p class="mt-4 text-base font-body text-gray leading-relaxed">
        Wir veröffentlichen SEO-Retainer und Audit-Preise, weil Preistransparenz selbst in der Schweizer Agenturlandschaft selten ist. Unser Ziel: Sie erkennen vor dem ersten Gespräch, ob ein Projekt mit uns finanziell realistisch ist.
      </p>
    </div>
  </Section>

  <Section bg="white" id="retainer-baender" class="scroll-mt-20">
    <SectionHeader
      label="Monatliche Betreuung"
      title="SEO-Retainer (Kontinuierliche Optimierung)"
      subtitle="Drei Grössen, keine aufgedrückten Zusatzpakete. Alle Preise exklusive Mehrwertsteuer."
    />
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {retainerBands.map((band) => (
        <Card>
          <span class="text-xs font-label font-bold uppercase tracking-[0.2em] text-blue">{band.label}</span>
          <div class="mt-3 text-2xl font-headline font-black text-navy">{band.price}</div>
          <p class="mt-4 text-sm font-body text-gray leading-relaxed">{band.description}</p>
        </Card>
      ))}
    </div>
  </Section>

  <Section bg="cream" id="site-builds" class="scroll-mt-20">
    <SectionHeader
      label="Festpreis-Webauftritt"
      title="VV-Webauftritt (Vermögensverwalter-Boutique)"
      subtitle="Drei Preis-Anker für Boutiquen ohne aktive Web-Identität — analog zum Onlineshop-Modell, kalibriert an der Seitenstruktur der 14 inhaltsstärksten Vermögensverwalter-Webauftritte mit FinancialService-Schema. Webauftritt und Retainer separat buchbar, kein Paket-Zwang. Alle Preise exklusive Mehrwertsteuer."
    />
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {siteBuildTiers.map((tier) => (
        <Card>
          <span class="text-xs font-label font-bold uppercase tracking-[0.2em] text-blue">{tier.label}</span>
          <div class="mt-3 text-2xl font-headline font-black text-navy">{tier.price}</div>
          <p class="mt-4 text-sm font-body text-gray leading-relaxed">{tier.description}</p>
        </Card>
      ))}
    </div>
    <div class="mt-8 max-w-3xl">
      <p class="text-base font-body text-gray leading-relaxed">
        Der Webauftritt ist auf FINMA-bewilligte Vermögensverwalter zugeschnitten — FIDLEG- und FINMA-RS-2025/2-konformer Compliance-Block, FinancialService- und Person-Schema mit Verweis auf die FINMA-Bewilligungsliste, revDSG-konformer Datenschutz, Schweizer Hosting auf Cloudflare. Welcher Tier zur Boutique passt, ergibt die <a href="/ch-de/erstberatung/" class="text-blue hover:underline">Erstberatung</a> anhand Service-Funnels, Partner-Struktur und Mehrsprachen-Bedarf. Hintergrund zur Kalibrierung im <a href="/ch-de/seo-fuer-vermoegensverwalter/#sie-haben-heute-keine-eigene-web-identitaet" class="text-blue hover:underline">SEO für Vermögensverwalter-Hub</a>.
      </p>
    </div>
  </Section>

  <Section bg="white" id="projekte">
    <SectionHeader
      label="Einmal-Projekte"
      title="Projekte & Audits"
      subtitle="Für Unternehmen, die mit einer belastbaren Analyse starten wollen — oder einen spezifischen Prüfpunkt brauchen, bevor ein laufender Retainer Sinn macht."
    />
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {projectPrices.map((item) => (
        <Card>
          <h3 class="text-lg font-headline font-bold text-navy">{item.service}</h3>
          <div class="mt-2 text-xl font-headline font-black text-blue">{item.price}</div>
          <p class="mt-3 text-sm font-body text-gray leading-relaxed">{item.scope}</p>
        </Card>
      ))}
    </div>
  </Section>

  <Section bg="white">
    <div class="max-w-3xl">
      <SectionHeader
        label="Transparenz"
        title="Was den Preis beeinflusst"
        subtitle="Innerhalb jedes Bands liegen die tatsächlichen Preise unterschiedlich. Diese vier Faktoren bestimmen, wo im Band Sie landen."
      />
      <ul class="mt-6 space-y-4">
        {priceFactors.map((factor) => (
          <li class="flex gap-3 text-base font-body text-gray leading-relaxed">
            <span class="mt-2 block h-1.5 w-1.5 flex-shrink-0 rounded-full bg-blue" aria-hidden="true"></span>
            <span>{factor}</span>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <Section bg="cream">
    <div class="max-w-3xl">
      <SectionHeader label="Fragen & Antworten" title="Häufig gestellte Fragen" />
      <dl class="mt-8 space-y-8">
        {faqs.map((f) => (
          <div>
            <dt class="text-lg font-headline font-bold text-navy">{f.q}</dt>
            <dd class="mt-2 text-base font-body text-gray leading-relaxed">{f.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </Section>

  <CTASplit
    eyebrow="Erstberatung"
    title="Welches Paket passt zu Ihrem Unternehmen?"
    subtitle="15-minütige Erstberatung, unverbindlich. Wir sagen Ihnen direkt, ob ein Retainer oder ein Audit der bessere Einstieg ist — und welcher Umfang realistisch zu Ihrem aktuellen Stand passt."
    image="/images/pricing-cta.webp"
    imageAlt="StarkRank-Team in Erstgespräch — drei Berater am Tisch mit Laptop und Notizen, Basler Münster im Hintergrund."
    imagePosition="center top"
  >
    <Button href="/ch-de/kontakt/" variant="primary">Kostenlose Erstberatung</Button>
    <Button href="/ch-de/kostenloser-google-ads-check/" variant="secondary">Kostenlose Audits ansehen</Button>
  </CTASplit>
</BaseLayout>
