---
import CitySpokePage from '../../components/pages/CitySpokePage.astro';
import { getCollection } from 'astro:content';
import { getSpokePath } from '../../data/service-slugs';

export async function getStaticPaths() {
  const cities = await getCollection('cities');
  const services = await getCollection('services');
  const spokeEntries = await getCollection('spokes');
  const chCities = cities.filter((c) => c.data.locale === 'ch-de');

  const paths: Array<{ params: { citySlug: string }; props: Record<string, unknown> }> = [];

  for (const city of chCities) {
    for (const serviceSlug of city.data.services) {
      const service = services.find((s) => s.data.slug === serviceSlug);
      if (!service) continue;

      const spokeSlug = getSpokePath(serviceSlug, city.data.citySlug, 'ch-de');
      const spoke = spokeEntries.find(
        (s) => s.data.serviceSlug === serviceSlug && s.data.citySlug === city.data.citySlug && s.data.locale === 'ch-de'
      ) ?? null;

      paths.push({
        params: { citySlug: spokeSlug },
        props: { city: city.data, service, spokeSlug, spoke },
      });
    }
  }

  return paths;
}

const { city, service, spokeSlug, spoke } = Astro.props;
---

<CitySpokePage city={city} service={service} locale="ch-de" spokeSlug={spokeSlug} spoke={spoke} />
