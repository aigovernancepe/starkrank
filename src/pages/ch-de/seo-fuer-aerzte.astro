        referenceQuantity: { '@type': 'QuantitativeValue', value: 1, unitCode: 'MON' },
      },
      url: 'https://starkrank.com/ch-de/preise/seo/',
    },
    {
      '@type': 'Offer',
      name: 'Mittelstand / Mehr-Standort Retainer',
      priceCurrency: 'CHF',
      priceSpecification: {
        '@type': 'PriceSpecification',
        priceCurrency: 'CHF',
        minPrice: '3000',
        maxPrice: '5000',
      },
