  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': 'https://starkrank.com/ch-de/seo-fuer-aerzte/#service',
  name: 'SEO für Ärzte',
  serviceType: 'Search Engine Optimization',
  datePublished,
  dateModified,
  description:
