import Button from '../../components/ui/Button.astro';
import LastUpdated from '../../components/seo/LastUpdated.astro';

const title = 'SEO für Ärzte in der Schweiz — revDSG-konform | StarkRank';
const description = 'SEO für Schweizer Facharzt-Praxen: revDSG-konform, FMH-Werberecht-bewusst, AI-Search-messbar. Lebende Fallstudie Handzentrum Ost. Erstberatung gratis.';

const datePublished = '2026-04-29';
const dateModified = '2026-05-12';

const pricingTiers = [
  { tier: 'Einzelpraxis / KMU', price: '1\'190 CHF', profile: 'Einzelner Standort, klares Spezialgebiet' },
  { tier: 'Mittelstand / Mehr-Standort', price: '3\'000–5\'000 CHF', profile: '2–4 Standorte · Festpreis nach Diagnose-Phase' },
  { tier: 'Klinik / Multi-Standort', price: 'ab 6\'000 CHF', profile: 'Individueller Scope · Festpreis nach Diagnose-Phase' },
];

const comparison = [
  {
    axis: 'Hauptträger',
    praxismarketing: 'Print, Logo, Praxisräume, Patienten-Newsletter',
    seoForDoctors: 'Indexierbarkeit, Schema-Markup, AI-Citability, Local Pack',
