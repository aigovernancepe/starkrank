    seoForDoctors: 'quartalsweises Re-Scoring, kontinuierliche Inhaltspflege',
  },
];

const measurementMetrics = [
  {
    name: 'Patientenzulauf nach Quelle',
    body: 'Welche Erstpatienten kamen über organische Suche, Google-Unternehmensprofil, KI-Antwortmaschinen oder Zuweisung. Quelle-Attribution direkt in der Patientenaufnahme — eine Frage am Empfang, sauber dokumentiert. Alle technischen Metriken weiter unten dienen dieser Outcome-Achse.',
  },
  {
    name: 'AI Search Optimization Score',
