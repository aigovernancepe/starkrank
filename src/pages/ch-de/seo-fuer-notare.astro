  },
];

const measurementMetrics = [
  {
    name: 'Mandantenzulauf nach Quelle',
    body: 'Welche Erstmandate kamen über organische Suche, Google Unternehmensprofil, KI-Antwortmaschinen, Berufsregister-Listing oder Empfehlung. Die Quellen-Zuordnung passiert direkt in der Mandatsaufnahme — eine Frage im Erstgespräch, sauber dokumentiert. Das Beurkundungs-Volumen pro Thema (Erbvertrag, Hauskauf, Gesellschaftsgründung) wird als Sub-Achse mitgeführt, weil Notariats-Themen unterschiedliche Akquise-Pfade haben. Mandatsanfragen ohne Quellen-Zuordnung erschweren jede Erfolgs-Bewertung; neue Mandanten gewinnen wir nur dann strukturiert dazu, wenn die Akquise-Schicht messbar ist.',
  },
  {
    name: 'AISO Score',
    body: 'StarkRank-eigene 6-Dimensions-Diagnostik 0–100 für AI-Search-Readiness (Crawlability, Structure, Authority, Citability, Freshness, Measurability). Quartalsweises Re-Scoring.',
  },
  {
    name: 'Indexierungs-Quote in der Google Search Console',
    body: 'Wie viele Notariats-Seiten Google überhaupt kennt. Eine gepflegte Online-Präsenz nützt wenig, wenn die Hälfte der Service-Unterseiten aus dem Google-Index gesperrt ist — potenzielle Mandanten suchen ein Beurkundungs-Thema, finden das Notariat aber nicht. Bei Erst-Audits Schweizer Notariate liegt die Quote regelmässig unter 60 Prozent, oft weil ältere Eigenbauten, JavaScript-lastige Templates oder veraltete Content-Management-Systeme im Einsatz sind.',
  },
  {
    name: 'Position × Klickrate auf Beurkundungs-Suchanfragen',
    body: 'Viele Notariate ranken bereits für Beurkundungs-Themen — Erbvertrag-Beratung, Hauskauf-Notar, Gesellschaftsgründung-Beurkundung — und sind in den Suchergebnissen gut platziert, ohne dass Klicks konvertieren. Die anklick-Anreize im Suchergebnis fehlen: der Titel trifft die Suchanfrage nicht, die Meta-Description ist leer, Sub-Listen fehlen. Hier zu optimieren bedeutet nicht, weiter zu ranken — Rankings konvertieren erst, wenn das Snippet die Suchanfrage einlöst.',
  },
  {
    name: 'Zitations-Quote in KI-Antwortmaschinen',
    body: 'Wie oft zitieren ChatGPT, Perplexity, Google AI Overviews und Microsoft Copilot das Notariat im Spezialisierungs-Gebiet. Quartalsweise Stichproben gegen die wichtigsten Beurkundungs-Suchanfragen.',
  },
  {
    name: 'Lokale SEO im Local Pack auf Google Maps',
    body: 'Sichtbarkeit im lokalen Suchergebnis via Google Unternehmensprofil — Google My Business, Google Unternehmensprofil und Google Business Profil bezeichnen denselben Eintrag. Für ein Notariat oft der relevanteste Hebel überhaupt, weil Mandanten lokal wählen, bevor sie das Beurkundungs-Thema bewusst wählen.',
  },
  {
    name: 'Mobile Ladezeit und Stabilität auf dem Smartphone',
    body: 'Ladezeit, Layout-Stabilität und Reaktionszeit der Notariats-Website auf dem Smartphone. Schlechte Ladezeiten sind ein direkter Konversions-Killer für Mandanten-Anfragen über mobile Endgeräte; eine Ladezeit unter zwei Sekunden korreliert empirisch mit höherer Mandats-Konversion. Tools wie Google PageSpeed Insights geben eine erste Diagnose; die vollständige technische Optimierung folgt im Audit.',
  },
  {
    name: 'Kosten pro Anfrage aus organischer Suche',
    body: 'Gemessen über Anruf-Tracking oder die Formular-Auswertung der Website. Kein Ranking-Report-Ersatz für Diagnose; isoliert die organische Akquise von Empfehlungs-Effekten und misst, wie viele Mandatsanfragen tatsächlich aus der Online-Sichtbarkeit konvertieren.',
  },
];

const regulatoryAnchors = [
  {
    title: 'revDSG + Art. 321 StGB Berufsgeheimnis',
    body: 'Datenschutzerklärung mit expliziter Schweizer Datenresidenz-Aussage, Cookie-Einwilligung standardmässig deaktiviert, Auftragsdaten-Verarbeitungsverträge mit allen Drittanbietern (Tracking, Hosting, Formular-Tools, KI-Assistenten). Die notarielle Verschwiegenheit unter Art. 321 StGB ist strikter als das Anwaltsgeheimnis — ein Datenleck mit Mandanten-Daten aus einem Erbvertrag oder einer Beurkundung kann strafrechtlich relevant werden. Ein Audit ohne Schweizer Rechts-Bezug lässt diese Spezifika regelmässig stehen.',
  },
  {
    title: 'Kantonales Notariatsgesetz + SBN-Standesordnung (Werberecht)',
    body: 'Sachlich-berufsbezogene Information statt anpreisender Werbung. Die kantonalen Werbebeschränkungen für Notare variieren — BS und BL kennen das Werbeverbot über kantonale Notariatsverordnungen plus die Standesordnung des Schweizerischen Notarenverbands (SBN). Keine vergleichende Werbung, keine Erfolgsgarantien, keine Tarif-Vergleichswerbung — Notariats-Tarife sind kantonal geregelt. Spezialisierungs-Bezeichnungen wie „Spezialist für Erbrecht" nur mit verifizierbarer fachlicher Kompetenz.',
  },
  {
    title: 'UWG Art. 3 Abs. 1 lit. s — Impressum-Pflicht',
    body: 'Vollständige Anbieter-Angabe inklusive Handelsregister- und kantonalem Notariatsregister-Eintrag, schnelle elektronische Kontaktaufnahme, eindeutige Identifikation der Urkundsperson. Bei Notaren strikter als bei Anwälten, weil der Notar als öffentliche Urkundsperson eine zusätzliche Identifikations-Pflicht trägt. Eine UWG-Lücke auf der eigenen Notariats-Website ist berufsrechtliches Risiko, nicht nur Marketing-Detail.',
  },
];

const localSeoItems = [
  {
    title: 'Google Unternehmensprofil vollständig + verifiziert',
    body: 'Google My Business, Google Unternehmensprofil und Google Business Profil sind drei Begriffe für denselben Eintrag. Ohne verifiziertes Profil ist das Notariat im Local Pack auf Google Maps strukturell unsichtbar. Kategorien: Notar als primary, Rechtsanwalt als secondary bei Advokatur-Notariat-Kombination. Öffnungszeit, Kontaktinformationen, URL, Foto.',
  },
  {
    title: 'Strukturierte Daten (LegalService + LocalBusiness)',
    body: 'Die Website wird mit LegalService- und LocalBusiness-Markierung versehen. Notariats-Name, Adresse und Telefon müssen identisch zu Berufsregister, Google Unternehmensprofil und Impressum sein — Abweichungen verwirren KI-Antwortmaschinen, die Quellen abgleichen, und kosten Sichtbarkeit.',
  },
  {
    title: 'Kantonales Notariatsregister-Listing aktiv prüfen',
    body: 'Die kantonalen Notariatsregister (notariat-baselland.ch, notariatskammerbasel.ch, weitere kantonale Notarverzeichnisse) und local.ch sind die primäre Quelle für ChatGPT, Perplexity und Google AI Overviews bei lokalen Notar-Queries. Eintrag muss vollständig sein: Spezialisierungen, Sprachen, Öffnungszeit, Kontakt. Eine Lücke im Register ist eine Lücke in der AI-Antwort.',
  },
  {
    title: 'Bewertungen aktiv einladen und beantworten',
    body: 'Positive Bewertungen auf Google Unternehmensprofil und local.ch sind ein direkter Ranking-Faktor im Local Pack und ein Trust-Anker für AI-Antwortmaschinen. Mandanten nach Mandats-Abschluss systematisch einladen, professionell auf jede Bewertung antworten — auch auf neutrale. Bewertungs-Velocity (neue Bewertungen pro Monat) ist relevanter als Bewertungs-Volumen.',
  },
  {
    title: 'Beurkundungs-Themen als eigene Unterseite mit Capsule-Format',
    body: 'Eine Service-Unterseite pro Beurkundungs-Thema — Erbvertrag, Ehevertrag, Hauskauf-Beurkundung, Gesellschaftsgründung, Vorsorgeauftrag, Testamentserstellung, Beglaubigungen — statt einer pauschalen Leistungs-Seite. Jede Unterseite beantwortet die typischen Suchanfragen rund um das Thema im Capsule-Format: H2 als Frage, Antwort 40–60 Wörter, weitere Details darunter. Menschen suchen Beurkundungs-Themen mit lokalen Keywords, nicht abstrakte Notariats-Begriffe.',
  },
  {
    title: 'Multi-Standort-Schema bei Praxis-Kombinationen',
    body: 'Advokatur-Notariat-Kombinationen mit Filialen in mehreren Gemeinden brauchen separate LocalBusiness-Knoten pro Standort mit eigenständigen Öffnungszeiten und Kontaktinformationen. Ein Multi-Standort-Notariat als ein einziger Knoten verliert lokale Sichtbarkeit in jeder Gemeinde, die nicht der Haupt-Sitz ist.',
  },
];

