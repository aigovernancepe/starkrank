---

<BaseLayout title={title} description={description} locale="ch-de" schema={schemas} preloadImage="/images/notare-hero.webp">
  <HeroSection
    headline="SEO für Notare"
    subheadline="Ein Schweizer Notariat kann im Register korrekt eingetragen sein und trotzdem keine Mandate gewinnen — weil Google und ChatGPT die Beurkundungs-Spezialisierungen gar nicht sehen. SEO für Notare beginnt deshalb nicht beim Content, sondern bei der Listing-Differenzierungs- und Inventar-Frage: was sieht Google überhaupt, und ist es UWG-konform?"
    backgroundImage="/images/notare-hero.webp"
    backgroundImageAlt="Notarin am Laptop in einem hellen Schweizer Notariats-Backoffice — Bildschirm zeigt abstraktes Diagnose-Dashboard mit aufsteigender Sichtbarkeitskurve"
  >
    <Button href="/ch-de/kontakt/" variant="primary">Erstberatung anfragen</Button>
    <Button href="#beispiel-diagnose" variant="secondary">Beispiel-Diagnose</Button>
  </HeroSection>

  <LastUpdated date={dateModified} />

  <Section bg="cream">
