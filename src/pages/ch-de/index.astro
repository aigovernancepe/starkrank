---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/ui/HeroSection.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import PillarCard from '../../components/ui/PillarCard.astro';
import BuildingGraphicStatic from '../../components/ui/BuildingGraphicStatic.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import CTASplit from '../../components/ui/CTASplit.astro';
import { getLocalizedPillars } from '../../data/pillars';

const pillars = getLocalizedPillars('ch-de');

const pillarAnchorLinks: Record<string, string> = {
  'search-ai-intelligence': '/ch-de/services/#search-ai-intelligence',
  'performance-media': '/ch-de/services/#performance-media',
  'authority-pr': '/ch-de/services/#authority-pr',
  'content-copywriting': '/ch-de/services/#content-copywriting',
  'data-web': '/ch-de/services/#data-web',
};

// Info-box content for the mobile building graphic (tap a block → expand a panel).
const buildingPanels = pillars.map((p) => ({
  id: p.id,
  name: p.name,
  tagline: p.tagline,
  description: p.description,
  href: pillarAnchorLinks[p.id],
}));

const verticals = [
  {
    label: 'SEO für Ärzte',
    href: '/ch-de/seo-fuer-aerzte/',
    description:
      'Spezialkliniken und Facharzt-Praxen mit Selbstzahler- oder Zuweiser-Funnel — revDSG-konform, FMH-Werberecht-bewusst, mit lebender Fallstudie Handzentrum Ost.',
  },
  {
    label: 'SEO für Zahnärzte',
    href: '/ch-de/seo-fuer-zahnaerzte/',
    description:
      'Aesthetic- und Implantat-Zahnarztpraxen mit Selbstzahler-Anteil — revDSG-konform, SSO-Standesordnung-bewusst, mit anonymisierter Phase-0-Beispiel-Diagnose statt Mandats-Versprechen.',
  },
  {
    label: 'SEO für Anwälte',
    href: '/ch-de/seo-fuer-anwaelte/',
    description:
      'Schweizer Anwaltskanzleien mit Spezialisierungs-Funnel (Wirtschaft, Familienrecht, Mediation, Erbrecht) — revDSG-konform, BGFA-Standesregeln-bewusst, mit LegalService-Schema-Strukturierung.',
  },
  {
    label: 'SEO für Notare',
    href: '/ch-de/seo-fuer-notare/',
    description:
      'Schweizer Notariate im Freien Notariat (BS, BL, GE, JU u.a.) mit Spezialisierungs-Funnel (Erbverträge, Immobilien, Gesellschaftsgründungen) — revDSG-konform, kantonal NotG- und SBN-bewusst, mit Local-Pack- und LegalService-Schema-Strukturierung.',
  },
  {
    label: 'SEO für Vermögensverwalter',
    href: '/ch-de/seo-fuer-vermoegensverwalter/',
    description:
      'FINMA-bewilligte unabhängige Vermögensverwalter mit Spezialisierungs-Funnel (Vorsorge 50+, Unternehmerverkauf, Expat-RSU, Generationswechsel) — FINIG-/FIDLEG-konform, VSV-Standesregeln-respektierend, FinancialService-Schema-strukturiert.',
  },
];

const processSteps = [
  {
    num: '01',
    title: 'Analyse',
    body: 'AI Search Optimization Check, Keyword-Mapping und Wettbewerbsvergleich. Wo steht Ihre Marke heute in klassischer Suche und in KI-Antworten — und was genau bremst sie?',
  },
  {
    num: '02',
    title: 'Strategie',
    body: 'Priorisierte Roadmap mit messbaren Zielen, Budget- und Zeitrahmen. Welche Hebel bewegen in den nächsten 90 Tagen den grössten Teil des Umsatzes?',
  },
  {
    num: '03',
    title: 'Umsetzung',
    body: 'SEO, Google Ads, Content, Digital PR, Analytics — laufend im Retainer oder projektbasiert. Keine Blackbox: jede Massnahme mit nachvollziehbarem Warum.',
  },
  {
    num: '04',
    title: 'Messung & Anpassung',
    body: 'Monatliche Daten, Quartals-Review, Pivot wo nötig. Was nicht wirkt, fliegt. Was wirkt, skaliert. Zurück zu Schritt 01 mit neuer Datenlage.',
  },
];

const faqs = [
  {
    q: 'Was bedeutet KI-Suchoptimierung für mein Unternehmen?',
    a: 'Heute beginnt die Recherche oft nicht mehr bei Google, sondern direkt in Tools wie ChatGPT, Perplexity oder Copilot. KI-Suchoptimierung sorgt dafür, dass diese Systeme Ihre Inhalte korrekt erfassen und in ihren Antworten nennen — nicht nur, dass Sie in der klassischen Trefferliste auftauchen. Den Fortschritt halten wir in unserem proprietären AI Search Optimization Score fest.',
  },
  {
    q: 'Mit welchen Kosten muss ich rechnen?',
    a: 'Unsere Preise sind offen einsehbar, bevor Sie ein Gespräch buchen. Der Einstiegs-Retainer liegt bei 1\'190 CHF pro Monat, für wachstumsorientierte Firmen ab 3\'000 CHF pro Monat. Wer lieber einmalig startet, wählt ein Audit ab 1\'800 CHF — gestaffelt nach Umfang der Website. Keine Pauschalstunden, keine Überraschungen auf der Rechnung.',
  },
  {
    q: 'Wie sieht die Zusammenarbeit konkret aus?',
    a: 'In wiederkehrenden Runden statt als Einmalprojekt. Auf eine Bestandsaufnahme folgt eine priorisierte Roadmap, dann die laufende Umsetzung über SEO, Content und Performance Media. Monatlich schauen wir auf echte Zahlen, behalten was funktioniert und verwerfen was nicht trägt. So wird jede Runde präziser als die vorige — kein Report, der in der Schublade landet.',
  },
  {
    q: 'Was bringt mir der kostenlose AI-Search-Check?',
    a: 'Er gibt Ihnen kostenlos und unverbindlich einen ersten Eindruck, wo Ihre Marke in Google und in KI-Antworten steht und welcher Schritt am meisten bewegt. Das ist bewusst noch kein tiefes SEO-Audit — diese ausführliche Analyse über sechs Dimensionen ist kostenpflichtig — sondern eine Entscheidungshilfe, ob sich der nächste Schritt mit uns lohnt.',
  },
  {
    q: 'Passt StarkRank zu meinem Unternehmen?',
    a: 'Wenn Sie ein Schweizer KMU, ein Dienstleister oder ein gründergeführter Fachbetrieb sind und Suche als Umsatztreiber sehen — ja. Wir betreuen von Basel aus die ganze Deutschschweiz, inklusive regulierter Berufe mit strengen Werberegeln. Wer nur einen monatlichen Ranking-Report ohne Wirkung sucht, ist bei uns hingegen falsch.',
  },
  {
    q: 'Binde ich mich langfristig?',
    a: 'Sie wählen zwischen laufendem Retainer und einem fest umrissenen Projekt. Für Retainer raten wir zu mindestens sechs Monaten, da Suchmaschinen Änderungen erst mit Verzögerung in Rankings umsetzen. Ein häufiger Einstieg ist ein einmaliges Audit als Ausgangsbasis, aus dem später ein Retainer wird — der Audit-Preis wird dabei nicht verrechnet.',
  },
];

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://starkrank.com/#organization',
  name: 'StarkRank',
  url: 'https://starkrank.com',
  logo: 'https://starkrank.com/SR-Logo-standard_high-res.png',
  description: 'Digital-Marketing-Agentur aus der Deutschschweiz mit Fokus auf KI-Suchoptimierung, technisches SEO und datengetriebene Wachstumsstrategien — aktiv in Basel, Zürich, Bern und der übrigen Deutschschweiz.',
  sameAs: [
    'https://www.linkedin.com/company/starkrank',
    'https://www.wikidata.org/wiki/Q138764144',
    'https://www.crunchbase.com/organization/starkrank',
    'https://www.local.ch/de/d/oberwil-bl/4104/marketing/starkrank-feye-KN9ZenQHAYQeeoIE6nM2SQ',
    'https://www.search.ch/tel/oberwil/langegasse-117/starkrank-feye',
  ],
  contactPoint: [
    {
      '@type': 'ContactPoint',
      email: 'info@starkrank.com',
      contactType: 'sales',
      areaServed: 'CH',
      availableLanguage: ['German', 'English'],
    },
    {
      '@type': 'ContactPoint',
      email: 'kontakt@starkrank.com',
      contactType: 'sales',
      areaServed: 'DE',
      availableLanguage: ['German', 'English'],
    },
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://starkrank.com/#website',
  name: 'StarkRank',
  url: 'https://starkrank.com',
  publisher: { '@id': 'https://starkrank.com/#organization' },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// HowTo-Prozess-Schema aus den sichtbaren processSteps (Single Source of Truth).
// Google hat HowTo-Rich-Results 2023 abgeschaltet — dieser Knoten dient als
// maschinenlesbares Prozess-/Entity-Signal für KI-Antwortmaschinen, analog zur
// FAQPage-Beibehaltung.
const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  '@id': 'https://starkrank.com/ch-de/#prozess',
  name: 'StarkRank Arbeitsweise — der iterative Marketing-Prozess',
  step: processSteps.map((s) => ({
    '@type': 'HowToStep',
    position: Number(s.num),
    name: s.title,
    text: s.body,
  })),
};
---

<BaseLayout
  title="StarkRank Schweiz — SEO & KI-Suchoptimierung für KMU"
  description="StarkRank ist eine Schweizer Digital-Marketing-Agentur mit Fokus auf KI-Suchoptimierung, technisches SEO und datengetriebene Wachstumsstrategien für Unternehmen in der Schweiz."
  locale="ch-de"
  schema={[orgSchema, websiteSchema, faqSchema, howToSchema]}
>
  <HeroSection
    eyebrow="Stark in Search. Stark in Data. Stark in Growth."
    headline="Datenbasiertes Wachstum für das **KI-Zeitalter**"
    subheadline="StarkRank unterstützt Schweizer Unternehmen bei der Sichtbarkeit in Suchmaschinen, KI-Plattformen und bei den Menschen dahinter — von unserem Standort in Basel aus, mit Fokus auf die deutschsprachige Schweiz."
  >
    <Button href="/ch-de/aiso-check/" variant="primary" size="lg">Kostenloser AI-Search-Check &rarr;</Button>
  </HeroSection>

  {/* Building-graphic: decorative on desktop, tap-to-expand accordion on mobile. */}
  <Section bg="cream">
    <SectionHeader
      label="Unsere Dienstleistungen"
      title="Fünf Bausteine des digitalen Wachstums"
      subtitle="Vier Disziplinen tragen das Wachstum Ihres Unternehmens — auf einem Fundament aus Daten und Web-Architektur."
      align="center"
    />
    {/* Desktop SVG decorative; mobile SVG clickable with per-pillar info boxes. */}
    <BuildingGraphicStatic locale="ch-de" panels={buildingPanels} />

    {/* Detailed pillar cards — desktop only; on mobile the graphic's info boxes
        carry the descriptions. 2-col grid on md+, foundation spans full width. */}
    <div class="hidden md:grid mt-8 md:mt-16 md:grid-cols-2 gap-6">
      {pillars.filter((p) => p.id !== 'data-web').map((pillar) => (
        <div id={`card-${pillar.id}`} data-pillar-id={pillar.id} class="pillar-card-wrapper">
          <PillarCard pillar={pillar} locale="ch-de" href={pillarAnchorLinks[pillar.id]} />
        </div>
      ))}
      {pillars.filter((p) => p.id === 'data-web').map((pillar) => (
        <div id={`card-${pillar.id}`} data-pillar-id={pillar.id} class="pillar-card-wrapper md:col-span-2">
          <PillarCard pillar={pillar} locale="ch-de" href={pillarAnchorLinks[pillar.id]} variant="foundation" />
        </div>
      ))}
    </div>
  </Section>

  {/* Specialised verticals — discovery surface for medical-vertical sub-spokes */}
  <Section bg="white">
    <SectionHeader
      label="Branchen-Lösungen"
      title="Für Schweizer Berufe mit strengen Werbevorschriften"
      subtitle="Manche Branchen brauchen mehr als Standard-SEO — wir kennen die Standesregeln, die andere Agenturen übersehen."
      align="center"
    />
    {/* Desktop: card grid */}
    <div class="hidden md:grid mt-10 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
      {verticals.map((v) => (
        <Card href={v.href}>
          <h3 class="text-lg font-headline font-bold text-navy">{v.label}</h3>
          <p class="mt-3 text-sm font-body text-gray leading-relaxed">{v.description}</p>
        </Card>
      ))}
    </div>
    {/* Mobile: collapsible list — only the heading shows until tapped, scales as verticals grow */}
    <div class="md:hidden mt-8 space-y-3 max-w-3xl mx-auto">
      {verticals.map((v) => (
        <details class="group bg-white border border-gray-light/40 rounded-lg">
          <summary class="flex items-center justify-between gap-4 cursor-pointer p-5 font-headline font-bold text-navy text-base select-none list-none [&::-webkit-details-marker]:hidden">
            {v.label}
            <svg class="w-5 h-5 shrink-0 text-blue transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
          </summary>
          <div class="px-5 pb-5">
            <p class="text-sm font-body text-gray leading-relaxed">{v.description}</p>
            <a href={v.href} class="mt-3 inline-flex items-center text-sm font-label font-semibold uppercase tracking-wide text-blue">
              Mehr erfahren
              <svg class="ml-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </details>
      ))}
    </div>
  </Section>

  {/* Specialised E-Commerce service pages — discovery surface for Build + Audit */}
  <Section bg="cream">
    <SectionHeader
      label="E-Commerce in der Schweiz"
      title="Onlineshop bauen oder vorhandenen Shop optimieren?"
      subtitle="Zwei Festpreis-Service-Pages für Schweizer Onlinehändler — neuer Shopify-Build mit SEO-Fundament, oder spezialisiertes Audit für laufende Kataloge."
      align="center"
    />
    <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto">
      <Card href="/ch-de/onlineshop-erstellen-lassen/">
        <h3 class="text-lg font-headline font-bold text-navy">Onlineshop erstellen lassen</h3>
        <p class="mt-3 text-sm font-body text-gray leading-relaxed">
          Shopify-Build mit SEO-Fundament für den Schweizer Markt. Vier Festpreis-Stufen ab 3'900 CHF (Lean-Launch) bis 39'000 CHF (Signature). Inklusive TWINT, revDSG-Cookie-Logik, Schema-Markup, Loom-Hand-off — Liefertermin 3 bis 14 Wochen je nach Paket.
        </p>
      </Card>
      <Card href="/ch-de/ecommerce-seo-audit/">
        <h3 class="text-lg font-headline font-bold text-navy">E-Commerce-SEO-Audit</h3>
        <p class="mt-3 text-sm font-body text-gray leading-relaxed">
          Spezialisiertes Audit für laufende Produktkataloge: 8 Schwachstellen-Bereiche (Produktschema, Faceted Nav, Varianten, OOS, Crawl-Budget, PLP-/PDP-SEO, AggregateRating, Bilder). Festpreise 2'500–4'000 CHF, Lieferung in 7 Werktagen.
        </p>
      </Card>
    </div>
  </Section>

  {/* Iterative process section */}
  <Section bg="cream">
    <SectionHeader
      label="Wie wir arbeiten"
      title="Ein Zyklus, kein Projekt"
      subtitle="Digitales Marketing ist kein einmaliger Relaunch. Es ist ein iterativer Prozess aus Analyse, Strategie, Umsetzung und Messung — mit Anpassungen auf Basis echter Daten."
      align="center"
    />
    {/* Desktop: 4-up grid with arrow connectors */}
    <div class="hidden md:grid mt-10 md:grid-cols-2 lg:grid-cols-4 gap-6 relative">
      {processSteps.map((step, idx) => (
        <div class="bg-white border border-gray-light/40 rounded-lg p-6 relative">
          <span class="text-xs font-label font-semibold uppercase tracking-[0.2em] text-blue">Schritt {step.num}</span>
          <h3 class="mt-2 text-lg font-headline font-bold text-navy">{step.title}</h3>
          <p class="mt-3 text-sm font-body text-gray leading-relaxed">{step.body}</p>
          {idx < processSteps.length - 1 && (
            <svg class="hidden lg:block absolute -right-4 top-1/2 -translate-y-1/2 w-6 h-6 text-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          )}
        </div>
      ))}
    </div>
    {/* Mobile: vertical timeline — numbered nodes on a connecting spine, tap a step to expand */}
    <div class="md:hidden mt-8 space-y-3 max-w-md mx-auto">
      {processSteps.map((step, idx) => (
        <details class="group relative">
          {idx < processSteps.length - 1 && (
            <span class="absolute left-5 top-10 -bottom-3 w-px -translate-x-1/2 bg-gray-light/60" aria-hidden="true"></span>
          )}
          <summary class="flex items-center gap-4 cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden">
            <span class="relative z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-blue/30 bg-white text-xs font-label font-bold text-blue transition-colors group-open:border-blue group-open:bg-blue group-open:text-white">{step.num}</span>
            <span class="flex-1 text-base font-headline font-bold text-navy">{step.title}</span>
            <svg class="mr-1 w-5 h-5 shrink-0 text-blue transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
          </summary>
          <p class="ml-14 mt-2 pb-1 text-sm font-body text-gray leading-relaxed">{step.body}</p>
        </details>
      ))}
    </div>
    <div class="mt-8 flex items-center justify-center gap-3 text-sm font-label font-semibold uppercase tracking-wide text-blue">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v6h6M20 20v-6h-6M4 10a8 8 0 0114-4M20 14a8 8 0 01-14 4" />
      </svg>
      <span>Daten aus Schritt 04 fliessen zurück in Schritt 01 — jeder Zyklus wird schärfer.</span>
    </div>
  </Section>

  {/* Pricing-transparency callout */}
  <Section bg="white">
    <div class="max-w-3xl mx-auto text-center">
      <span class="text-xs font-label font-semibold uppercase tracking-[0.2em] text-blue">Transparente Preise</span>
      <h2 class="mt-3 text-2xl md:text-3xl font-headline font-black text-navy">Wissen, was es kostet — bevor wir reden</h2>
      <p class="mt-4 text-base font-body text-gray leading-relaxed">Klare Retainer-Bänder ohne versteckte Stunden. Schauen Sie sich die Preisstruktur an, bevor Sie ein Erstgespräch buchen.</p>
      <div class="mt-8 flex flex-wrap gap-4 justify-center">
        <Button href="/ch-de/preise/seo/" variant="primary" size="lg">SEO-Preise ansehen &rarr;</Button>
        <Button href="/ch-de/services/" variant="outline" size="lg">Alle Services ansehen</Button>
      </div>
    </div>
  </Section>

  {/* FAQ / Capsule — top-of-funnel objection handling, feeds FAQPage schema */}
  <Section bg="cream">
    <SectionHeader
      label="Fragen & Antworten"
      title="Häufig gestellte Fragen"
      align="center"
    />
    <div class="mt-8 space-y-4 max-w-3xl mx-auto">
      {faqs.map((f) => (
        <details class="group bg-white border border-gray-light/40 rounded-lg">
          <summary class="flex items-center justify-between gap-4 cursor-pointer p-6 font-headline font-bold text-navy text-base md:text-lg select-none list-none [&::-webkit-details-marker]:hidden">
            {f.q}
            <svg class="w-5 h-5 shrink-0 text-blue transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
          </summary>
          <div class="px-6 pb-6 text-base font-body text-gray leading-relaxed">
            {f.a}
          </div>
        </details>
      ))}
    </div>
  </Section>

  <CTASplit
    eyebrow="Erstgespräch"
    title="Bereit zu wachsen?"
    subtitle="Buchen Sie eine kostenlose Erstberatung — unverbindlich, ohne Verkaufsdruck. Wir hören erst zu, bevor wir etwas vorschlagen."
    image="/images/home-cta.webp"
    imageAlt="StarkRank-Team im Erstgespräch — drei Berater im offenen Austausch mit Kaffee, Basler Münster durchs Fenster sichtbar."
    imagePosition="center top"
  >
    <Button href="/ch-de/kontakt/" variant="primary" size="lg">Kontaktieren Sie uns</Button>
  </CTASplit>
</BaseLayout>
