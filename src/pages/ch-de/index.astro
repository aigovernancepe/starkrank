---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/ui/HeroSection.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import PillarCard from '../../components/ui/PillarCard.astro';
import BuildingGraphic from '../../components/ui/BuildingGraphic.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import CTABanner from '../../components/ui/CTABanner.astro';
import { getLocalizedPillars } from '../../data/pillars';

const pillars = getLocalizedPillars('ch-de');

const pillarAnchorLinks: Record<string, string> = {
  'search-ai-intelligence': '/ch-de/services/#search-ai-intelligence',
  'performance-media': '/ch-de/services/#performance-media',
  'authority-pr': '/ch-de/services/#authority-pr',
  'content-copywriting': '/ch-de/services/#content-copywriting',
  'data-web': '/ch-de/services/#data-web',
};

const verticals = [
  {
    label: 'SEO für Ärzte',
    href: '/ch-de/seo-fuer-aerzte/',
    description:
      'Spezialkliniken und Facharzt-Praxen mit Selbstzahler- oder Zuweiser-Funnel — revDSG-konform, FMH-Werberecht-bewusst, mit lebender Fallstudie Handzentrum Ost.',
  },
  {
    label: 'SEO für Zahnärzte',
    href: '/ch-de/seo-fuer-zahnaerzte/',
    description:
      'Aesthetic- und Implantat-Zahnarztpraxen mit Selbstzahler-Anteil — revDSG-konform, SSO-Standesordnung-bewusst, mit anonymisierter Phase-0-Beispiel-Diagnose statt Mandats-Versprechen.',
  },
  {
    label: 'SEO für Anwälte',
    href: '/ch-de/seo-fuer-anwaelte/',
    description:
      'Schweizer Anwaltskanzleien mit Spezialisierungs-Funnel (Wirtschaft, Familienrecht, Mediation, Erbrecht) — revDSG-konform, BGFA-Standesregeln-bewusst, mit LegalService-Schema-Strukturierung.',
  },
];

const processSteps = [
  {
    num: '01',
    title: 'Analyse',
    body: 'AISO-Check, Keyword-Mapping und Wettbewerbsvergleich. Wo steht Ihre Marke heute in klassischer Suche und in KI-Antworten — und was genau bremst sie?',
  },
  {
    num: '02',
    title: 'Strategie',
    body: 'Priorisierte Roadmap mit messbaren Zielen, Budget- und Zeitrahmen. Welche Hebel bewegen in den nächsten 90 Tagen den grössten Teil des Umsatzes?',
  },
  {
    num: '03',
    title: 'Umsetzung',
    body: 'SEO, Google Ads, Content, Digital PR, Analytics — laufend im Retainer oder projektbasiert. Keine Blackbox: jede Massnahme mit nachvollziehbarem Warum.',
  },
  {
    num: '04',
    title: 'Messung & Anpassung',
    body: 'Monatliche Daten, Quartals-Review, Pivot wo nötig. Was nicht wirkt, fliegt. Was wirkt, skaliert. Zurück zu Schritt 01 mit neuer Datenlage.',
  },
];
---

<BaseLayout
  title="StarkRank Schweiz — SEO & KI-Suchoptimierung für KMU"
  description="StarkRank ist eine Schweizer Digital-Marketing-Agentur mit Fokus auf KI-Suchoptimierung, technisches SEO und datengetriebene Wachstumsstrategien für Unternehmen in der Schweiz."
  locale="ch-de"
>
  <HeroSection
    eyebrow="Stark in Search. Stark in Data. Stark in Growth."
    headline="Datenbasiertes Wachstum für das **KI-Zeitalter**"
    subheadline="StarkRank unterstützt Schweizer Unternehmen bei der Sichtbarkeit in Suchmaschinen, KI-Plattformen und bei den Menschen dahinter — von unserem Standort in Basel aus, mit Fokus auf die deutschsprachige Schweiz."
  >
    <Button href="/ch-de/aiso-check/" variant="primary" size="lg">Kostenloser AISO-Check &rarr;</Button>
  </HeroSection>

  {/* Building-graphic: interactive on desktop, hidden on mobile */}
  <Section bg="cream">
    <SectionHeader
      label="Unsere Dienstleistungen"
      title="Fünf Bausteine des digitalen Wachstums"
      subtitle="Vier Disziplinen tragen das Wachstum Ihres Unternehmens — auf einem Fundament aus Daten und Web-Architektur."
      align="center"
    />
    <div class="hidden md:block">
      <BuildingGraphic locale="ch-de" />
    </div>

    {/* Detailed pillar cards — on mobile these carry the whole metaphor (no SVG).
        Pillars in 2-col grid on md+, foundation (Daten & Web) spans full width. */}
    <div class="mt-8 md:mt-16 grid grid-cols-1 md:grid-cols-2 gap-6">
      {pillars.filter((p) => p.id !== 'data-web').map((pillar) => (
        <div id={`card-${pillar.id}`} data-pillar-id={pillar.id} class="pillar-card-wrapper">
          <PillarCard pillar={pillar} locale="ch-de" href={pillarAnchorLinks[pillar.id]} />
        </div>
      ))}
      {pillars.filter((p) => p.id === 'data-web').map((pillar) => (
        <div id={`card-${pillar.id}`} data-pillar-id={pillar.id} class="pillar-card-wrapper md:col-span-2">
          <PillarCard pillar={pillar} locale="ch-de" href={pillarAnchorLinks[pillar.id]} variant="foundation" />
        </div>
      ))}
    </div>
  </Section>

  {/* Specialised verticals — discovery surface for medical-vertical sub-spokes */}
  <Section bg="white">
    <SectionHeader
      label="Branchen-Lösungen"
      title="Für Schweizer Berufe mit strengen Werbevorschriften"
      subtitle="Manche Branchen brauchen mehr als Standard-SEO — wir kennen die Standesregeln, die andere Agenturen übersehen."
      align="center"
    />
    <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
      {verticals.map((v) => (
        <Card href={v.href}>
          <h3 class="text-lg font-headline font-bold text-navy">{v.label}</h3>
          <p class="mt-3 text-sm font-body text-gray leading-relaxed">{v.description}</p>
        </Card>
      ))}
    </div>
  </Section>

  {/* Iterative process section */}
  <Section bg="cream">
    <SectionHeader
      label="Wie wir arbeiten"
      title="Ein Zyklus, kein Projekt"
      subtitle="Digitales Marketing ist kein einmaliger Relaunch. Es ist ein iterativer Prozess aus Analyse, Strategie, Umsetzung und Messung — mit Anpassungen auf Basis echter Daten."
      align="center"
    />
    <div class="mt-10 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 relative">
      {processSteps.map((step, idx) => (
        <div class="bg-white border border-gray-light/40 rounded-lg p-6 relative">
          <span class="text-xs font-label font-semibold uppercase tracking-[0.2em] text-blue">Schritt {step.num}</span>
          <h3 class="mt-2 text-lg font-headline font-bold text-navy">{step.title}</h3>
          <p class="mt-3 text-sm font-body text-gray leading-relaxed">{step.body}</p>
          {idx < processSteps.length - 1 && (
            <svg class="hidden lg:block absolute -right-4 top-1/2 -translate-y-1/2 w-6 h-6 text-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          )}
        </div>
      ))}
    </div>
    <div class="mt-8 flex items-center justify-center gap-3 text-sm font-label font-semibold uppercase tracking-wide text-blue">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v6h6M20 20v-6h-6M4 10a8 8 0 0114-4M20 14a8 8 0 01-14 4" />
      </svg>
      <span>Daten aus Schritt 04 fliessen zurück in Schritt 01 — jeder Zyklus wird schärfer.</span>
    </div>
  </Section>

  {/* Pricing-transparency callout */}
  <Section bg="white">
    <div class="max-w-3xl mx-auto text-center">
      <span class="text-xs font-label font-semibold uppercase tracking-[0.2em] text-blue">Transparente Preise</span>
      <h2 class="mt-3 text-2xl md:text-3xl font-headline font-black text-navy">Wissen, was es kostet — bevor wir reden</h2>
      <p class="mt-4 text-base font-body text-gray leading-relaxed">Klare Retainer-Bänder ohne versteckte Stunden. Schauen Sie sich die Preisstruktur an, bevor Sie ein Erstgespräch buchen.</p>
      <div class="mt-8 flex flex-wrap gap-4 justify-center">
        <Button href="/ch-de/preise/seo/" variant="primary" size="lg">SEO-Preise ansehen &rarr;</Button>
        <Button href="/ch-de/services/" variant="outline" size="lg">Alle Services ansehen</Button>
      </div>
    </div>
  </Section>

  <CTABanner
    bg="navy"
    title="Bereit zu wachsen?"
    subtitle="Buchen Sie eine kostenlose Erstberatung."
    backgroundImage="/images/home-cta.webp"
    backgroundImageAlt="StarkRank-Team im Erstgespräch — drei Berater im offenen Austausch mit Kaffee, Basler Münster durchs Fenster sichtbar."
    imagePosition="center top"
  >
    <Button href="/ch-de/kontakt/" variant="primary" size="lg">Kontaktieren Sie uns</Button>
  </CTABanner>
</BaseLayout>
