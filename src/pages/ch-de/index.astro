---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/ui/HeroSection.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import PillarCard from '../../components/ui/PillarCard.astro';
import Button from '../../components/ui/Button.astro';
import CTABanner from '../../components/ui/CTABanner.astro';
import { getLocalizedPillars } from '../../data/pillars';

const pillars = getLocalizedPillars('ch-de');

const pillarAnchorLinks: Record<string, string> = {
  'search-ai-intelligence': '/ch-de/services/#search-ai-intelligence',
  'performance-media': '/ch-de/services/#performance-media',
  'authority-pr': '/ch-de/services/#authority-pr',
  'content-copywriting': '/ch-de/services/#content-copywriting',
  'data-web': '/ch-de/services/#data-web',
};

const processSteps = [
  {
    num: '01',
    title: 'Analyse',
    body: 'AISO-Check, Keyword-Mapping und Wettbewerbsvergleich. Wo steht Ihre Marke heute in klassischer Suche und in KI-Antworten — und was genau bremst sie?',
  },
  {
    num: '02',
    title: 'Strategie',
    body: 'Priorisierte Roadmap mit messbaren Zielen, Budget- und Zeitrahmen. Welche Hebel bewegen in den nächsten 90 Tagen den grössten Teil des Umsatzes?',
  },
  {
    num: '03',
    title: 'Umsetzung',
    body: 'SEO, Google Ads, Content, Authority-Linkaufbau, Analytics — laufend im Retainer oder projektbasiert. Keine Blackbox: jede Massnahme mit nachvollziehbarem Warum.',
  },
  {
    num: '04',
    title: 'Messung & Anpassung',
    body: 'Monatliche Daten, Quartals-Review, Pivot wo nötig. Was nicht wirkt, fliegt. Was wirkt, skaliert. Zurück zu Schritt 01 mit neuer Datenlage.',
  },
];
---

<BaseLayout
  title="StarkRank Schweiz — Datengetriebenes Digitales Marketing"
  description="StarkRank ist eine Schweizer Digital-Marketing-Agentur mit Fokus auf KI-Suchoptimierung, technisches SEO und datengetriebene Wachstumsstrategien für Unternehmen in der Schweiz."
  locale="ch-de"
>
  <HeroSection
    headline="Datenbasiertes Wachstum für das **KI-Zeitalter**"
    subheadline="StarkRank unterstützt Schweizer Unternehmen bei der Sichtbarkeit in Suchmaschinen, KI-Plattformen und bei den Menschen dahinter — von unserem Standort in Basel aus, für den gesamten Schweizer Markt."
  >
    <Button href="/ch-de/aiso-check/" variant="primary" size="lg">Kostenloser AISO-Check &rarr;</Button>
  </HeroSection>

  {/* Building-graphic: the five-pillar metaphor */}
  <Section bg="cream">
    <SectionHeader
      label="Unsere Dienstleistungen"
      title="Fünf Säulen des digitalen Wachstums"
      subtitle="Vier Disziplinen tragen das Wachstum Ihres Unternehmens — auf einem Fundament aus Daten und Web-Architektur."
      align="center"
    />
    <svg viewBox="0 0 800 440" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="building-title building-desc" class="w-full h-auto max-w-3xl mx-auto mt-8">
      <title id="building-title">Das Gebäude des digitalen Wachstums</title>
      <desc id="building-desc">Vier Säulen des digitalen Marketings — Suche und KI-Intelligenz, Performance Media, Autorität und Content und Texterstellung — getragen vom Fundament Daten und Web. Zusammen bauen sie das Wachstum eines Unternehmens.</desc>

      <text x="400" y="28" text-anchor="middle" fill="#0E1A2D" font-size="14" font-weight="700" letter-spacing="6">WACHSTUM</text>
      <path d="M 400 36 L 390 50 L 410 50 Z" fill="#0E1A2D" />

      <rect x="40" y="58" width="720" height="14" fill="#0E1A2D" />
      <rect x="60" y="72" width="680" height="4" fill="#3B7DD8" />

      <a href="/ch-de/services/#search-ai-intelligence" aria-label="Suche und KI-Intelligenz">
        <rect x="90" y="86" width="130" height="248" fill="#ffffff" stroke="#3B7DD8" stroke-width="2" />
        <rect x="90" y="86" width="130" height="8" fill="#3B7DD8" />
        <rect x="90" y="326" width="130" height="8" fill="#3B7DD8" />
        <text x="155" y="202" text-anchor="middle" fill="#0E1A2D" font-size="14" font-weight="700">Suche</text>
        <text x="155" y="222" text-anchor="middle" fill="#0E1A2D" font-size="14" font-weight="700">&amp; KI</text>
      </a>
      <a href="/ch-de/services/#performance-media" aria-label="Performance Media">
        <rect x="250" y="86" width="130" height="248" fill="#ffffff" stroke="#3B7DD8" stroke-width="2" />
        <rect x="250" y="86" width="130" height="8" fill="#3B7DD8" />
        <rect x="250" y="326" width="130" height="8" fill="#3B7DD8" />
        <text x="315" y="202" text-anchor="middle" fill="#0E1A2D" font-size="13" font-weight="700">Performance</text>
        <text x="315" y="222" text-anchor="middle" fill="#0E1A2D" font-size="13" font-weight="700">Media</text>
      </a>
      <a href="/ch-de/services/#authority-pr" aria-label="Autorität">
        <rect x="410" y="86" width="130" height="248" fill="#ffffff" stroke="#3B7DD8" stroke-width="2" />
        <rect x="410" y="86" width="130" height="8" fill="#3B7DD8" />
        <rect x="410" y="326" width="130" height="8" fill="#3B7DD8" />
        <text x="475" y="212" text-anchor="middle" fill="#0E1A2D" font-size="14" font-weight="700">Autorität</text>
      </a>
      <a href="/ch-de/services/#content-copywriting" aria-label="Content und Texterstellung">
        <rect x="570" y="86" width="130" height="248" fill="#ffffff" stroke="#3B7DD8" stroke-width="2" />
        <rect x="570" y="86" width="130" height="8" fill="#3B7DD8" />
        <rect x="570" y="326" width="130" height="8" fill="#3B7DD8" />
        <text x="635" y="212" text-anchor="middle" fill="#0E1A2D" font-size="14" font-weight="700">Content</text>
      </a>

      <a href="/ch-de/services/#data-web" aria-label="Daten und Web">
        <rect x="40" y="348" width="720" height="26" fill="#3B7DD8" />
        <rect x="20" y="374" width="760" height="14" fill="#0E1A2D" />
        <text x="400" y="366" text-anchor="middle" fill="#ffffff" font-size="15" font-weight="700" letter-spacing="4">DATEN &amp; WEB</text>
      </a>

      <text x="400" y="414" text-anchor="middle" fill="#888888" font-size="11" font-style="italic">Fundament jeder strategischen Entscheidung</text>
    </svg>
  </Section>

  {/* Detailed pillar cards */}
  <Section bg="white">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {pillars.map((pillar) => <PillarCard pillar={pillar} locale="ch-de" href={pillarAnchorLinks[pillar.id]} />)}
    </div>
  </Section>

  {/* Iterative process section */}
  <Section bg="cream">
    <SectionHeader
      label="Wie wir arbeiten"
      title="Ein Zyklus, kein Projekt"
      subtitle="Digitales Marketing ist kein einmaliger Relaunch. Es ist ein iterativer Prozess aus Analyse, Strategie, Umsetzung und Messung — mit Anpassungen auf Basis echter Daten."
      align="center"
    />
    <div class="mt-10 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 relative">
      {processSteps.map((step, idx) => (
        <div class="bg-white border border-gray-light/40 rounded-lg p-6 relative">
          <span class="text-xs font-label font-semibold uppercase tracking-[0.2em] text-blue">Schritt {step.num}</span>
          <h3 class="mt-2 text-lg font-headline font-bold text-navy">{step.title}</h3>
          <p class="mt-3 text-sm font-body text-gray leading-relaxed">{step.body}</p>
          {idx < processSteps.length - 1 && (
            <svg class="hidden lg:block absolute -right-4 top-1/2 -translate-y-1/2 w-6 h-6 text-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          )}
        </div>
      ))}
    </div>
    <div class="mt-8 flex items-center justify-center gap-3 text-sm font-label font-semibold uppercase tracking-wide text-blue">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v6h6M20 20v-6h-6M4 10a8 8 0 0114-4M20 14a8 8 0 01-14 4" />
      </svg>
      <span>Daten aus Schritt 04 fliessen zurück in Schritt 01 — jeder Zyklus wird schärfer.</span>
    </div>
  </Section>

  {/* Schnellcheck callout */}
  <Section bg="white">
    <div class="max-w-3xl mx-auto text-center">
      <span class="text-xs font-label font-semibold uppercase tracking-[0.2em] text-blue">Nicht sicher, wo Sie starten sollen?</span>
      <h2 class="mt-3 text-2xl md:text-3xl font-headline font-black text-navy">60 Sekunden zu Ihrem nächsten Hebel</h2>
      <p class="mt-4 text-base font-body text-gray leading-relaxed">Unser Schnellcheck matcht Ihre Situation mit den Services, die in den nächsten 90 Tagen den grössten Impact haben — ohne Termin, ohne E-Mail-Angabe.</p>
      <div class="mt-8 flex flex-wrap gap-4 justify-center">
        <Button href="/ch-de/schnellcheck/" variant="primary" size="lg">Zum Schnellcheck &rarr;</Button>
        <Button href="/ch-de/services/" variant="secondary" size="lg">Alle Services ansehen</Button>
      </div>
    </div>
  </Section>

  <CTABanner bg="navy" title="Bereit zu wachsen?" subtitle="Buchen Sie eine kostenlose Erstberatung.">
    <Button href="/ch-de/kontakt/" variant="primary" size="lg">Kontaktieren Sie uns</Button>
  </CTABanner>
</BaseLayout>
