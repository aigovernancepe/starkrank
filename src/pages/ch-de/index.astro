---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/ui/HeroSection.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import PillarCard from '../../components/ui/PillarCard.astro';
import Button from '../../components/ui/Button.astro';
import CTABanner from '../../components/ui/CTABanner.astro';
import { getLocalizedPillars } from '../../data/pillars';
import { getSpokePath } from '../../data/service-slugs';

const pillars = getLocalizedPillars('ch-de');

const pillarCityLinks: Record<string, string> = {
  'search-ai-intelligence': `/ch-de/${getSpokePath('ai-search-optimisation', 'basel', 'ch-de')}/`,
  'performance-media': `/ch-de/${getSpokePath('google-ads-management', 'basel', 'ch-de')}/`,
  'authority-pr': `/ch-de/${getSpokePath('reactive-pr', 'basel', 'ch-de')}/`,
  'content-copywriting': `/ch-de/${getSpokePath('seo-copywriting', 'basel', 'ch-de')}/`,
  'data-web': `/ch-de/${getSpokePath('google-analytics-consultancy', 'basel', 'ch-de')}/`,
};
---

<BaseLayout
  title="StarkRank Schweiz — Datengetriebenes Digitales Marketing"
  description="StarkRank ist eine Schweizer Digital-Marketing-Agentur mit Fokus auf KI-Suchoptimierung, technisches SEO und datengetriebene Wachstumsstrategien."
  locale="ch-de"
>
  <HeroSection
    headline="Datengetriebenes Wachstum für das **KI-Zeitalter**"
    subheadline="Wir optimieren Ihre Marke für Suchmaschinen, KI-Plattformen und die Menschen dahinter."
  >
    <Button href="/ch-de/kontakt/" variant="primary" size="lg">Kontakt</Button>
  </HeroSection>

  <Section bg="cream">
    <SectionHeader label="Unsere Dienstleistungen" title="Fünf Säulen des digitalen Wachstums" align="center" />
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {pillars.map((pillar) => <PillarCard pillar={pillar} locale="ch-de" href={pillarCityLinks[pillar.id]} />)}
    </div>
  </Section>

  <CTABanner bg="navy" title="Bereit zu wachsen?" subtitle="Buchen Sie eine kostenlose Beratung.">
    <Button href="/ch-de/kontakt/" variant="primary" size="lg">Kontaktieren Sie uns</Button>
  </CTABanner>
</BaseLayout>
