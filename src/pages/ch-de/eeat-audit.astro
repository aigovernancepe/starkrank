---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import CTABanner from '../../components/ui/CTABanner.astro';

const title = 'E-E-A-T-Audit — 4×10-Rubrik für echte Autorität | StarkRank';
const description = 'Echtes E-E-A-T wird gezeigt, nicht behauptet. Wir bewerten Ihre Seite nach einer 40-Punkte-Rubrik mit signal-basierter Remediation. 1\'500 CHF pauschal.';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'E-E-A-T-Audit',
  description: 'Evidenzbasierte Bewertung von gezeigter Experience, Expertise, Authoritativeness und Trustworthiness anhand einer 4-Dimensions-40-Punkte-Rubrik. Inklusive Signal-Remediation, YMYL-Compliance-Abgleich und 90-Tage-Re-Audit.',
  url: 'https://starkrank.com/ch-de/eeat-audit/',
  provider: { '@type': 'Organization', name: 'StarkRank', url: 'https://starkrank.com' },
  areaServed: [
    { '@type': 'Country', name: 'Germany' },
    { '@type': 'Country', name: 'Austria' },
    { '@type': 'Country', name: 'Switzerland' },
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'E-E-A-T-Audit Pakete',
    itemListElement: [
      { '@type': 'Offer', name: 'E-E-A-T-Audit — Standalone', description: 'Einzel-Site-Audit mit Stichprobe bis zu 10 Seiten. Composite-Score, Signal-Evidenz, priorisierte Remediation, 90-Tage-Re-Audit.', price: '1400', priceCurrency: 'CHF' },
      { '@type': 'Offer', name: 'E-E-A-T-Audit — AISO-Bundle', description: 'E-E-A-T-Audit ohne Aufpreis enthalten beim Bündeln mit dem AISO Score Bundle.', price: '3600', priceCurrency: 'CHF' },
    ],
  },
};

const faqItems = [
  { question: 'Wie unterscheidet sich das vom Authority-Dimension im AISO Score?', answer: 'Die AISO-Authority-Dimension (15% Gewicht, Teil unseres 6-Dimensions-KI-Suche-Readiness-Audits) deckt Knowledge-Graph-Präsenz, sameAs-Abdeckung und LLM-Trainingsdaten-Sichtbarkeit ab. Das E-E-A-T-Audit ist der evidenzbasierte Deep-Dive darunter — 40 Punkte, Signal für Signal, fokussiert auf das, was Content zeigt, statt auf Entitäts-Ebene-Signale. Sie ergänzen sich.' },
  { question: 'Warum ist Experience die am meisten unterschätzte Dimension?', answer: 'Experience-Content kann nicht von KI erzeugt werden — er muss von jemandem kommen, der es tatsächlich getan hat. Fehlschlag-Stories, Workflow-Details, Fallanekdoten mit konkreten Zahlen und eigene Fotografien sind für Wettbewerber ausserordentlich schwer zu kopieren und für Googles Rater wie LLM-Zitations-Systeme ausserordentlich stark.' },
  { question: 'Was, wenn Experience als Abwesend bewertet wird?', answer: 'Experience-Content wird extrahiert, nicht geschrieben. Wird Experience als Abwesend oder Schwach bewertet, ist die wirksamste Remediation ein Experteninterview oder eine Expertenbibliothek mit Ihrem Fachexperten. Die Audit-Empfehlung nennt, welche Themen und Dimensionen das Interview abdecken soll.' },
  { question: 'Wie bewertet das Audit YMYL-Compliance?', answer: 'Für Zahnmedizin, Recht, Medizin, Finanzberatung, Handwerk und Kfz prüfen wir Trustworthiness-Signale gegen anwendbare Regularien (nDSG, HMG, UWG, FINMA-Regulierung, FMH-Vorgaben, DSGVO bei grenzüberschreitendem Geschäft). Compliance-Lücken erscheinen als Trustworthiness-Evidenz und drücken den Trust-Score. Sie erscheinen im Remediation-Plan als priorisierte Fixes. Die Prüfung ist indikativ und ersetzt keine juristische Stellungnahme; eine abschliessende rechtliche Bewertung ist separat zu beauftragen.' },
  { question: 'Brauche ich für jede Branche ein eigenes Audit?', answer: 'Für Agenturen oder Marken mit mehreren Branchen-Websites: ja, jede Seite wird separat bewertet, weil die relevanten Signale variieren. Wir bieten ein 3-Standort-Bundle mit prozentualem Nachlass, wenn die Audits parallel laufen.' },
  { question: 'Was beinhaltet das 90-Tage-Re-Audit?', answer: 'Dieselbe Rubrik, dieselbe Methodik, frische Datenerhebung. Wir bewerten die 4 Dimensionen erneut, identifizieren welche Signale von Abwesend zu Schwach zu Stark gewandert sind, halten das Composite-Score-Delta fest und markieren Dimensionen, die nicht vorangekommen sind.' },
  { question: 'Können Sie eine Website auditieren, die noch nicht live ist?', answer: 'Ja, aber mit Einschränkungen. Authoritativeness-Signale (Backlinks, KI-Zitationen, Wikidata-Präsenz) existieren noch nicht, sodass diese Dimension niedrig bewertet wird und der Remediation-Plan die Launch-Strategie abdeckt. Experience, Expertise und Trustworthiness können aus Entwurfscontent bewertet werden.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

const schemas = [serviceSchema, faqSchema];

const breadcrumbs = [
  { label: 'Start', href: '/' },
  { label: 'E-E-A-T-Audit', href: '/eeat-audit/' },
];

const dimensions = [
  { name: 'Experience', weight: '25%', measures: 'Hat der Autor / die Organisation tatsächlich getan, nicht nur darüber geschrieben?', signals: 'Beobachtungen in der Ich-Perspektive, eigene Fotografien, Fehlschlag-Stories, Workflow-Details, Fallanekdoten mit konkreten Zahlen' },
  { name: 'Expertise', weight: '25%', measures: 'Zeigt der Content technische Tiefe jenseits der Verbraucher-Oberfläche?', signals: 'Primärquellen-Zitate, korrekte Fachterminologie, Bereitschaft gängige Ratschläge zu widerlegen, Information Gain ≥ 2' },
  { name: 'Authoritativeness', weight: '25%', measures: 'Anerkennt das breitere Web diese Entität als primäre Quelle?', signals: 'Wikidata-/Wikipedia-Präsenz, verifizierbare externe Identität des Autors, KI-Zitationen, Topical-Cluster-Tiefe' },
  { name: 'Trustworthiness', weight: '25%', measures: 'Gibt die Seite legitime Gründe zum Vertrauen jenseits der Behauptungen?', signals: 'Offengelegte Methodik, erklärte Grenzen, Empfehlung von Wettbewerbern, aktuelle Datumsstempel, YMYL-Konformität' },
];

const processSteps = [
  { num: 1, title: 'Scope-Call (Tag 1)', body: 'Audit-Scope bestätigen (einzelne Seite / Seiten-Set / Site-Stichprobe), Branche, YMYL-Compliance-Anforderungen und etwaige Experten-Interview- oder vorherige Audit-Dateien klären.' },
  { num: 2, title: 'Signale erfassen (Tag 2-4)', body: 'Firecrawl-Scraping der Zielseiten und 3-5 Wettbewerberseiten mit gleicher Suchintention. Domain-Level-Daten via DataForSEO. Knowledge-Graph-Prüfungen via Wikidata.' },
  { num: 3, title: 'Dimensionen bewerten (Tag 5)', body: 'Die 1-10-Band-Rubrik pro Dimension anwenden, nachdem mindestens 3 Signale protokolliert sind. Experience erfordert typischerweise die tiefste Lektüre.' },
  { num: 4, title: 'Bericht + Remediation (Tag 6)', body: 'Composite-Scoreboard, Evidenz pro Dimension, priorisierte Fixes. Die schwächste Einzeldimension treibt die Top-Remediation-Punkte.' },
  { num: 5, title: 'Lieferung + Walkthrough (Tag 7)', body: '45-minütige Besprechung zu Scores, Evidenz, Fixes und 90-Tage-Re-Audit-Plan. Für YMYL-Branchen markieren wir Compliance-Lücken explizit.' },
  { num: 6, title: '90-Tage-Re-Audit', body: 'Re-Scoring nach derselben Rubrik nach +90 Tagen. Verfolgung von Dimensions-Deltas, Signale, die von Abwesend → Schwach → Stark gewandert sind.' },
];

const relatedLinks = [
  { title: 'KI-Suchoptimierung', href: '/ki-suchoptimierung-basel/' },
  { title: 'Experteninterview', href: '/ch-de/experteninterview/' },
  { title: 'Expertenbibliothek', href: '/ch-de/expertenbibliothek/' },
  { title: 'Content-Marketing', href: '/content-marketing-basel/' },
  { title: 'Kostenloser AISO-Check', href: '/aiso-check/' },
];
---

<BaseLayout title={title} description={description} locale="de" schema={schemas}>
  <Fragment slot="head">
    <link rel="alternate" hreflang="en" href="https://starkrank.com/services/eeat-audit/" />
    <link rel="alternate" hreflang="de" href="https://starkrank.com/eeat-audit/" />
    <link rel="alternate" hreflang="de-CH" href="https://starkrank.com/ch-de/eeat-audit/" />
    <link rel="alternate" hreflang="x-default" href="https://starkrank.com/services/eeat-audit/" />
  </Fragment>

  <!-- Hero -->
  <Section bg="cream">
    <Breadcrumbs items={breadcrumbs} />

    <span class="text-xs font-label font-semibold uppercase tracking-[0.2em] text-blue mb-3 block">
      Authority &amp; PR
    </span>
    <h1 class="text-4xl md:text-5xl font-headline font-black tracking-tight text-navy">
      E-E-A-T-Audit — Bewerten, was Google und KI tatsächlich belohnen
    </h1>
    <p class="mt-4 text-lg text-gray font-body leading-relaxed max-w-3xl">
      Die Search Quality Rater Guidelines von Google benennen Experience, Expertise, Authoritativeness und Trustworthiness als die vier Dimensionen, die zitierwürdige Websites von solchen trennen, die übersprungen werden. Die meisten Agenturen behandeln E-E-A-T als Gefühlssache. Wir bewerten es anhand einer 40-Punkte-Evidenz-Rubrik und nennen Ihnen genau, welche Signale fehlen, welche behauptet aber nicht gezeigt werden und welche 3 Fixes den grössten Hebel haben.
    </p>

    <div class="mt-8 flex flex-wrap gap-4">
      <Button href="/ch-de/kontakt/" variant="primary" size="lg">E-E-A-T-Audit buchen</Button>
      <Button href="#dimensions" variant="ghost" size="lg">Die 4 Dimensionen</Button>
    </div>

    <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs font-body text-gray">
      <span>Zuletzt aktualisiert: <time datetime="2026-04-19">April 2026</time></span>
      <span>Von <a href="/about/" class="text-blue hover:text-blue-light font-semibold">Wilko Feye</a>, StarkRank</span>
    </div>
  </Section>

  <!-- Main + sidebar -->
  <section class="bg-white">
    <div class="max-w-7xl mx-auto px-6 py-16 md:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <div class="lg:col-span-2 space-y-0">

          <div class="pb-14">
            <h2 class="text-2xl md:text-3xl font-headline font-black text-navy tracking-tight mb-6">
              Warum schlägt gezeigtes E-E-A-T behauptetes E-E-A-T?
            </h2>
            <div class="space-y-4 text-base font-body text-gray leading-relaxed">
              <p>Echtes E-E-A-T ist Substanz, keine Biografie. Eine Seite, die mit "20 Jahre Erfahrung" wirbt, schneidet schwach ab, wenn der Fliesstext nach KI-zusammengefasstem Allgemeinwissen klingt. Eine Seite, auf der ein junger Autor einen konkreten Fall mit Zahlen und gezogener Lehre durchgeht, schneidet stark ab, weil Googles Rater und LLM-Zitations-Systeme belohnen, was Content zeigt — nicht, was er behauptet.</p>
            </div>
          </div>

          <div id="dimensions" class="pt-14 pb-14 border-t border-gray-light/30">
            <h2 class="text-2xl md:text-3xl font-headline font-black text-navy tracking-tight mb-4">
              Was messen die 4 E-E-A-T-Dimensionen?
            </h2>
            <p class="text-base font-body text-gray leading-relaxed mb-8">
              Jede Dimension trägt 25% des Composite-Gewichts (10 Punkte von 40). Die Bewertung ist evidenzbasiert: kein Score wird vergeben, bevor mindestens 3 Signale pro Dimension als vorhanden oder abwesend protokolliert sind. Biografische Marker ("20 Jahre Erfahrung") sind notwendig, aber niemals hinreichend.
            </p>
            <div class="overflow-x-auto">
              <table class="w-full text-sm font-body border-collapse">
                <thead>
                  <tr class="border-b-2 border-navy/20">
                    <th class="text-left py-3 pr-4 font-headline font-bold text-navy">Dimension</th>
                    <th class="text-left py-3 pr-4 font-headline font-bold text-navy">Gewicht</th>
                    <th class="text-left py-3 pr-4 font-headline font-bold text-navy">Was sie misst</th>
                    <th class="text-left py-3 font-headline font-bold text-navy">Stärkste Signale</th>
                  </tr>
                </thead>
                <tbody>
                  {dimensions.map((d) => (
                    <tr class="border-b border-gray-light/40">
                      <td class="py-3 pr-4 font-semibold text-dark align-top whitespace-nowrap">{d.name}</td>
                      <td class="py-3 pr-4 text-gray align-top">{d.weight}</td>
                      <td class="py-3 pr-4 text-gray leading-relaxed align-top">{d.measures}</td>
                      <td class="py-3 text-gray leading-relaxed align-top">{d.signals}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <div class="pt-14 pb-14 border-t border-gray-light/30">
            <h2 class="text-2xl md:text-3xl font-headline font-black text-navy tracking-tight mb-6">
              Was unterscheidet einen starken von einem schwachen Score?
            </h2>
            <div class="space-y-4 text-base font-body text-gray leading-relaxed">
              <p>Jede Dimension wird auf einer 3-Band-Leiter von 1-10 bewertet.</p>
              <ul class="space-y-3 list-none pl-0">
                <li class="flex items-start gap-3"><span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span><span><strong class="text-dark">Stark (8-10):</strong> mehrere spezifische Signale vorhanden, gezeigt statt behauptet, besser als Wettbewerber bei derselben Anfrage.</span></li>
                <li class="flex items-start gap-3"><span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span><span><strong class="text-dark">Schwach (4-6):</strong> Signale teilweise vorhanden, meist behauptet statt gezeigt, oder gleichwertig zu dem, was Wettbewerber bereits tun.</span></li>
                <li class="flex items-start gap-3"><span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span><span><strong class="text-dark">Abwesend (1-3):</strong> nur biografische Marker — der Content hätte von jedem Generalisten mit Trainingsdaten-Zusammenfassung stammen können.</span></li>
              </ul>
            </div>
          </div>

          <div class="pt-14 pb-14 border-t border-gray-light/30">
            <h2 class="text-2xl md:text-3xl font-headline font-black text-navy tracking-tight mb-6">
              Warum bekommen YMYL-Branchen besondere Trustworthiness-Prüfung?
            </h2>
            <div class="space-y-4 text-base font-body text-gray leading-relaxed">
              <p>YMYL-Branchen (Your Money or Your Life) wie Zahnmedizin, Recht, Medizin, Finanzberatung, Handwerk und Kfz erhalten zusätzliche Prüfung auf Trustworthiness. Wir prüfen offengelegte Lizenzen, Disclaimer zu Ergebnis-Aussagen, jurisdiktionsspezifische Regularien<sup>*</sup> (nDSG, HMG, UWG, FINMA-Vorgaben, DSGVO für grenzüberschreitende Fälle) und branchenspezifische Compliance-Lücken. Compliance-Lücken erscheinen als Trustworthiness-Abwesend-Evidenz, nicht als separate Befunde.</p>
              <p class="text-sm text-gray/70"><sup>*</sup> Unsere Prüfung ist indikativ und ersetzt keine juristische Stellungnahme; eine abschliessende rechtliche Bewertung ist separat zu beauftragen.</p>
            </div>
          </div>

          <div id="deliverables" class="pt-14 pb-14 border-t border-gray-light/30">
            <h2 class="text-2xl md:text-3xl font-headline font-black text-navy tracking-tight mb-6">
              Was erhalten Sie beim E-E-A-T-Audit?
            </h2>
            <p class="text-base font-body text-gray leading-relaxed mb-6">
              Einen vollständigen Audit-Bericht innerhalb von 7 Werktagen, strukturiert um den 40-Punkte-Composite-Score. Der Auftrag enthält ein 90-Tage-Re-Audit ohne Aufpreis, um die Score-Progression zu verfolgen.
            </p>
            <ul class="space-y-3 list-none pl-0 text-base font-body text-gray leading-relaxed">
              <li class="flex items-start gap-3"><span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span><span><strong class="text-dark">Composite-Scoreboard</strong> — Experience, Expertise, Authoritativeness, Trustworthiness jeweils 1-10 bewertet mit Band (Stark/Schwach/Abwesend)</span></li>
              <li class="flex items-start gap-3"><span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span><span><strong class="text-dark">Signal-Evidenz pro Dimension</strong> — konkrete Beobachtungen mit URLs und Zeilen-Referenzen für Vorhandenes und Abwesendes</span></li>
              <li class="flex items-start gap-3"><span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span><span><strong class="text-dark">Priorisierter Remediation-Plan</strong> — Top-3-Fixes pro Dimension, geordnet nach Wirkung gewichtet mit Machbarkeit</span></li>
              <li class="flex items-start gap-3"><span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span><span><strong class="text-dark">YMYL-Compliance-Abgleich</strong><sup>*</sup> — anwendbare Regularien markiert und Trustworthiness-Signalen zugeordnet</span></li>
              <li class="flex items-start gap-3"><span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span><span><strong class="text-dark">Querverweise</strong> — Abgleich mit AISO-Authority-Dimension, Copywriting-Audit-E-E-A-T-Subscore und Experteninterview-Dateien</span></li>
              <li class="flex items-start gap-3"><span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span><span><strong class="text-dark">90-Tage-Re-Audit</strong> — Folge-Bewertung zur Verfolgung von Dimensions-Deltas und Signal-Progression</span></li>
            </ul>
            <p class="text-sm text-gray/70 mt-4"><sup>*</sup> Der Compliance-Abgleich ist indikativ und ersetzt keine juristische Stellungnahme; eine abschliessende rechtliche Bewertung ist separat zu beauftragen.</p>
          </div>

        </div>

        <!-- Sidebar -->
        <aside class="lg:col-span-1">
          <div class="lg:sticky lg:top-8 space-y-6">
            <div class="bg-cream border border-gray-light/40 rounded-lg p-6">
              <p class="text-xs font-label font-bold uppercase tracking-widest text-blue mb-4">Methodik</p>
              <div class="space-y-2 text-sm font-body text-gray">
                <div class="flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-blue shrink-0"></span><span>40-Punkte-Composite</span></div>
                <div class="flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-blue shrink-0"></span><span>4 Dimensionen × 10 Punkte</span></div>
                <div class="flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-blue shrink-0"></span><span>90-Tage-Re-Audit inklusive</span></div>
                <div class="flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-blue shrink-0"></span><span>Speist AISO-Authority-Dimension</span></div>
              </div>
            </div>

            <div class="bg-cream border border-gray-light/40 rounded-lg p-6">
              <p class="text-xs font-label font-bold uppercase tracking-widest text-blue mb-2">Typische Branchen</p>
              <p class="text-sm font-body text-gray">Zahnmedizin · Recht · Medizin · Finanzberatung · Handwerk · Kfz · Experten-geführte B2B</p>
            </div>

            <div>
              <h3 class="text-xs font-label font-bold uppercase tracking-widest text-blue mb-4">Verwandte Services</h3>
              <div class="space-y-3">
                {relatedLinks.map((r) => (
                  <Card href={r.href}>
                    <h4 class="text-sm font-headline font-bold text-navy">{r.title}</h4>
                  </Card>
                ))}
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <Section bg="cream">
    <SectionHeader label="Preise" title="Wie viel kostet das E-E-A-T-Audit?" />
    <p class="text-base font-body text-gray leading-relaxed max-w-3xl mb-10">
      1'400 CHF pauschal für ein Einzel-Site-Audit mit Stichprobe bis zu 10 repräsentativen Seiten. Grössere Stichproben über 10 Seiten kosten 140 CHF pro Seite. Beim Bündeln mit dem AISO Score Bundle (3'600 CHF) ist das E-E-A-T-Audit ohne Aufpreis enthalten und wird zur Evidenz-Ebene unter der AISO-Authority-Dimension.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl">
      <div class="bg-white border border-gray-light/40 rounded-lg p-6 flex flex-col">
        <h3 class="text-lg font-headline font-black text-navy mb-2">Standalone</h3>
        <p class="text-xs font-label font-semibold uppercase tracking-widest text-blue mb-4">E-E-A-T als primäres Deliverable</p>
        <ul class="space-y-2 text-sm font-body text-gray mb-6 flex-1">
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">·</span> Composite-Score (0-40)</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">·</span> 4-Dimensions-Rubrik</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">·</span> Signal-Evidenz</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">·</span> Priorisierte Remediation</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">·</span> YMYL-Compliance-Abgleich</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">·</span> 90-Tage-Re-Audit</li>
        </ul>
        <p class="text-2xl font-headline font-black text-navy mb-4">1'400 CHF</p>
        <Button href="/ch-de/kontakt/" variant="primary" size="md">E-E-A-T-Audit buchen</Button>
      </div>

      <div class="bg-white border-2 border-blue rounded-lg p-6 flex flex-col">
        <h3 class="text-lg font-headline font-black text-navy mb-2">AISO-Bundle</h3>
        <p class="text-xs font-label font-semibold uppercase tracking-widest text-blue mb-4">KI-Suche-Readiness + E-E-A-T-Deep-Dive</p>
        <ul class="space-y-2 text-sm font-body text-gray mb-6 flex-1">
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">·</span> Alle Features des Standalone-Audits</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">·</span> AISO Score 6-Dimensions-Audit</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">·</span> Wettbewerbs-Benchmarking</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">·</span> E-E-A-T als Evidenz-Ebene unter Authority</li>
        </ul>
        <p class="text-2xl font-headline font-black text-navy mb-4">3'600 CHF <span class="text-sm font-body font-normal text-gray">(E-E-A-T enthalten)</span></p>
        <Button href="/ch-de/kontakt/" variant="primary" size="md">AISO-Bundle buchen</Button>
      </div>
    </div>

    <div class="mt-8 bg-white border border-gray-light/40 rounded-lg p-6 max-w-4xl">
      <p class="text-xs font-label font-bold uppercase tracking-widest text-blue mb-2">3-Standort-Bundle</p>
      <p class="text-sm font-body text-gray">Prozentualer Nachlass bei drei gleichzeitig laufenden Audits. Retainer-Kunden erhalten das jährliche E-E-A-T-Audit ohne Aufpreis; quartalsweise Dimensions-Spot-Checks optional.</p>
    </div>
  </Section>

  <!-- Process -->
  <Section bg="white">
    <SectionHeader label="Ablauf" title="Wie läuft der Audit-Prozess ab?" />
    <p class="text-base font-body text-gray leading-relaxed max-w-3xl mb-10">
      Der Prozess gliedert sich über 7 Werktage in sechs Phasen, gefolgt vom 90-Tage-Re-Audit. Die schwächste Dimension treibt die Reihenfolge der Top-Remediation-Punkte.
    </p>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {processSteps.map((step) => (
        <div class="bg-cream border border-gray-light/40 rounded-lg p-6">
          <div class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-blue text-white font-headline font-bold mb-4">{step.num}</div>
          <h3 class="text-base font-headline font-bold text-navy mb-2">{step.title}</h3>
          <p class="text-sm font-body text-gray leading-relaxed">{step.body}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- FAQ -->
  <Section bg="cream">
    <SectionHeader label="FAQ" title="Welche Fragen stellen Käufer am häufigsten?" />
    <div class="max-w-3xl space-y-6">
      {faqItems.map((item) => (
        <details class="group bg-white border border-gray-light/40 rounded-lg">
          <summary class="flex items-center justify-between gap-4 cursor-pointer p-6 font-headline font-bold text-navy text-base md:text-lg select-none">
            {item.question}
            <svg class="w-5 h-5 shrink-0 text-blue transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
          </summary>
          <div class="px-6 pb-6 text-sm font-body text-gray leading-relaxed">
            {item.answer}
          </div>
        </details>
      ))}
    </div>
  </Section>

  <!-- CTA -->
  <CTABanner bg="navy" title="Bereit, zu bewerten, was Google und KI tatsächlich belohnen?" subtitle="Unsere 40-Punkte-Rubrik, evidenzbasierte Signalanalyse und das 90-Tage-Re-Audit liefern Ihnen einen Score, den Sie verteidigen können, einen Remediation-Plan, den Sie umsetzen können, und ein Re-Scoring, das Fortschritt belegt. 1'400 CHF pauschal, geliefert in 7 Tagen.">
    <Button href="/ch-de/kontakt/" variant="primary" size="lg">E-E-A-T-Audit buchen</Button>
    <Button href="/ch-de/ki-suchoptimierung-basel/" variant="secondary" size="lg">AISO-Bundle anfragen</Button>
  </CTABanner>
</BaseLayout>
