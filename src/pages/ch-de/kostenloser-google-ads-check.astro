---
import LandingLayout from '../../layouts/LandingLayout.astro';
import Section from '../../components/ui/Section.astro';
import LeadForm from '../../components/ui/LeadForm.astro';

const title = 'Kostenloser Google-Ads-Audit | StarkRank Schweiz';
const description = 'Verbrennt Ihr Google-Ads-Budget? Unsere kostenlose 9-Bereiche-Diagnose zeigt ungenutzte Chancen und schnelle Verbesserungen. Kein Kontozugriff nötig.';

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Kostenloser Google Ads Check — 9-Bereiche-Diagnose',
  description: 'Kostenlose 9-Bereiche-Google-Ads-Diagnose für Schweizer Unternehmen. Deckt ungenutztes Keyword-Potenzial, CPC-Effizienz, Landingpage-Performance und Organic/Paid-Überschneidungen auf.',
  url: 'https://starkrank.com/ch-de/kostenloser-google-ads-check/',
  inLanguage: 'de-CH',
  isPartOf: {
    '@type': 'WebSite',
    name: 'StarkRank',
    url: 'https://starkrank.com',
  },
  mainEntity: {
    '@type': 'Service',
    name: 'Kostenloser Google Ads Check',
    description: '9-Bereiche-Google-Ads-Diagnose mit Wettbewerbsanalyse. Umfasst Keyword-Chancen, CPC-Effizienz, Landingpage-Performance und Organic/Paid-Überschneidungen.',
    provider: {
      '@type': 'Organization',
      name: 'Datanalytico Feye',
      url: 'https://starkrank.com',
    },
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'CHF',
      description: 'Kostenlose 9-Bereiche-Google-Ads-Diagnose',
    },
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Start', item: 'https://starkrank.com/ch-de/' },
    { '@type': 'ListItem', position: 2, name: 'Kostenloser Google Ads Check', item: 'https://starkrank.com/ch-de/kostenloser-google-ads-check/' },
  ],
};

const schemas = [webPageSchema, breadcrumbSchema];

const auditAreas = [
  { num: 1, area: 'Wettbewerbslandschaft', check: 'Wer bietet auf Ihre Keywords? Wie hoch ist das geschätzte Budget? Wo erscheinen Wettbewerber, Sie aber nicht?' },
  { num: 2, area: 'Keyword-Chancen', check: 'High-Intent-Keywords in Ihrem Markt mit hohem Suchvolumen und realistischen CPCs' },
  { num: 3, area: 'Keyword-Lücken', check: 'Begriffe, auf die Wettbewerber bieten und die Sie übersehen — und Begriffe, die Sie bieten, die es aber nicht wert sind' },
  { num: 4, area: 'CPC- und Budget-Effizienz', check: 'Zahlen Sie mehr als nötig? Wie vergleichen sich Ihre CPCs mit Marktdurchschnitten?' },
  { num: 5, area: 'Anzeigenposition und Impression Share', check: 'Wo erscheinen Ihre Anzeigen im Vergleich zu Wettbewerbern? Wie viel Marktanteil sichern Sie?' },
  { num: 6, area: 'Landingpage-Performance', check: 'Core Web Vitals, Mobile Experience und Conversion-Signale auf Ihren wichtigsten Landingpages' },
  { num: 7, area: 'Lokal vs. national', check: 'Ist Ihr Geo-Targeting richtig eingestellt? Versickert Budget in irrelevanten Regionen?' },
  { num: 8, area: 'Organic + Paid Überschneidung', check: 'Zahlen Sie für Klicks, die Sie organisch bekommen könnten? Wo sollten Sie Budget in SEO verlagern?' },
  { num: 9, area: 'Quick Wins', check: '3 bis 5 sofort umsetzbare Änderungen, die innerhalb von 30 Tagen die Rendite verbessern können' },
];
---

<LandingLayout
  title={title}
  description={description}
  ogImage="/images/ads-audit-preview.png"
  schema={schemas}
  locale="ch-de"
  backLink={{ label: 'Zurück zu den Dienstleistungen', href: '/ch-de/services/#performance-media' }}
>
  <Fragment slot="head">
    <link rel="alternate" hreflang="de-CH" href="https://starkrank.com/ch-de/kostenloser-google-ads-check/" />
    <link rel="alternate" hreflang="de-DE" href="https://starkrank.com/kostenloser-google-ads-check/" />
    <link rel="alternate" hreflang="en" href="https://starkrank.com/free-google-ads-audit/" />
    <link rel="alternate" hreflang="x-default" href="https://starkrank.com/kostenloser-google-ads-check/" />
  </Fragment>

  <!-- Hero + Form -->
  <Section bg="cream">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
      <!-- Hero text -->
      <div>
        <h1 class="text-4xl md:text-5xl font-headline font-black tracking-tight text-navy leading-tight">
          Arbeitet Ihr Google-Ads-Budget hart genug?
        </h1>
        <p class="mt-6 text-lg font-body text-gray leading-relaxed">
          Die meisten Unternehmen verschwenden 20 bis 40 Prozent ihres Google-Ads-Budgets durch irrelevante Klicks, schwaches Keyword-Targeting und Landingpages, die nicht konvertieren. Unsere kostenlose 9-Bereiche-Diagnose zeigt Ihnen genau, wohin das Geld fliesst — und wohin es fliessen sollte.
        </p>
        <p class="mt-4 text-base font-body text-dark font-semibold">
          Funktioniert mit oder ohne aktives Google-Ads-Konto. Datenverarbeitung in der Schweiz.
        </p>

        <!-- Value bullets -->
        <div class="mt-8">
          <p class="text-xs font-label font-bold uppercase tracking-widest text-blue mb-4">Was Sie erfahren</p>
          <div class="space-y-4">
            <div class="flex items-start gap-3">
              <span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span>
              <p class="text-base font-body text-gray"><strong class="text-dark">Wo Ihre Wettbewerber investieren</strong> — Wir kartieren die Paid-Search-Landschaft für Ihre Keywords und zeigen, wer bietet, was gezahlt wird und wo die Lücken sind</p>
            </div>
            <div class="flex items-start gap-3">
              <span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span>
              <p class="text-base font-body text-gray"><strong class="text-dark">Welche Keywords die Investition wert sind</strong> — Wir identifizieren High-Intent-Keywords mit starker kommerzieller Relevanz und vertretbaren CPCs im Schweizer Markt</p>
            </div>
            <div class="flex items-start gap-3">
              <span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span>
              <p class="text-base font-body text-gray"><strong class="text-dark">Ob Ihre Landingpages konvertieren</strong> — Wir prüfen Ihre wichtigsten Landingpages auf Core Web Vitals, Mobile Experience und Conversion-Signale</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Form -->
      <div id="kostenloser-google-ads-check-formular" class="bg-white border border-gray-light/40 rounded-lg p-8 shadow-lg">
        <h2 class="text-2xl font-headline font-black text-navy mb-6">Kostenlosen Google Ads Check anfordern</h2>
        <LeadForm formType="google-ads" locale="ch-de" />
      </div>
    </div>
  </Section>

  <!-- The 9 Areas -->
  <Section bg="white">
    <div class="max-w-3xl">
      <p class="text-xs font-label font-semibold uppercase tracking-[0.2em] text-blue mb-3">Was wir prüfen</p>
      <h2 class="text-2xl md:text-3xl font-headline font-black text-navy tracking-tight mb-4">
        9 Bereiche der Paid-Search-Performance
      </h2>
      <p class="text-base font-body text-gray leading-relaxed mb-8">
        Unsere Diagnose deckt 9 Bereiche der Paid-Search-Performance ab — mit Wettbewerbsanalyse-Daten, nicht mit Ihrem Ads-Konto. Das heisst: Wir können Ihren Markt auditieren, auch wenn Sie noch keine Ads schalten.
      </p>

      <div class="overflow-x-auto">
        <table class="w-full text-sm font-body border-collapse">
          <thead>
            <tr class="border-b-2 border-navy/20">
              <th class="text-left py-3 pr-4 font-headline font-bold text-navy w-8">#</th>
              <th class="text-left py-3 pr-4 font-headline font-bold text-navy">Bereich</th>
              <th class="text-left py-3 font-headline font-bold text-navy">Was wir prüfen</th>
            </tr>
          </thead>
          <tbody>
            {auditAreas.map((a) => (
              <tr class="border-b border-gray-light/40">
                <td class="py-3 pr-4 text-blue font-headline font-bold">{a.num}</td>
                <td class="py-3 pr-4 whitespace-nowrap font-semibold text-dark">{a.area}</td>
                <td class="py-3 text-gray leading-relaxed">{a.check}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </Section>

  <!-- Why No Account Access -->
  <Section bg="cream">
    <div class="max-w-3xl">
      <h2 class="text-2xl md:text-3xl font-headline font-black text-navy tracking-tight mb-4">
        Warum wir keinen Kontozugriff brauchen
      </h2>
      <p class="text-base font-body text-gray leading-relaxed mb-6">
        Klassische Google-Ads-Audits verlangen Login-Zugriff auf Ihr Konto. Unser Check nicht. Wir nutzen Wettbewerbsanalyse-Tools (DataForSEO SERP-Analyse, Keyword-Daten und Traffic-Schätzung), um Ihren Markt von aussen zu analysieren. Das bedeutet:
      </p>
      <div class="space-y-4">
        <div class="flex items-start gap-3">
          <span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span>
          <p class="text-base font-body text-gray"><strong class="text-dark">Kein Risiko</strong> — wir fassen Ihre Kampagnen nicht an</p>
        </div>
        <div class="flex items-start gap-3">
          <span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span>
          <p class="text-base font-body text-gray"><strong class="text-dark">Auch für Nicht-Werbetreibende</strong> — Sie erwägen Google Ads? Wir zeigen Ihnen, ob sich der Einsatz lohnt, bevor Sie einen Franken ausgeben</p>
        </div>
        <div class="flex items-start gap-3">
          <span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span>
          <p class="text-base font-body text-gray"><strong class="text-dark">Unvoreingenommen</strong> — wir sehen, was Ihre Kund:innen sehen, nicht nur, was Ihr Dashboard zeigt</p>
        </div>
      </div>
      <p class="mt-6 text-sm font-body text-gray">
        Wenn Sie später Kontozugriff gewähren, können wir eine tiefere Diagnose auf Kampagnenebene durchführen.
      </p>
    </div>
  </Section>

  <!-- Upsell -->
  <Section bg="white">
    <div class="max-w-4xl">
      <h2 class="text-2xl md:text-3xl font-headline font-black text-navy tracking-tight mb-4">
        Bereit für laufende Ads-Betreuung?
      </h2>
      <p class="text-base font-body text-gray leading-relaxed mb-8">
        Der kostenlose Check ist eine einmalige Diagnose. Für Unternehmen, die kontinuierlich optimieren wollen:
      </p>

      <div class="overflow-x-auto">
        <table class="w-full text-sm font-body border-collapse">
          <thead>
            <tr class="border-b-2 border-navy/20">
              <th class="text-left py-3 pr-4 font-headline font-bold text-navy"></th>
              <th class="text-center py-3 px-4 font-headline font-bold text-navy">Kostenloser Check</th>
              <th class="text-center py-3 px-4 font-headline font-bold text-navy">Paid-Strategie</th>
              <th class="text-center py-3 px-4 font-headline font-bold text-navy">Laufende Betreuung</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-light/40">
              <td class="py-3 pr-4 text-dark font-semibold">9-Bereiche-Diagnose</td>
              <td class="py-3 px-4 text-center text-blue">Ja</td>
              <td class="py-3 px-4 text-center text-blue">Ja</td>
              <td class="py-3 px-4 text-center text-blue">Ja</td>
            </tr>
            <tr class="border-b border-gray-light/40">
              <td class="py-3 pr-4 text-dark font-semibold">Wettbewerbs-Monitoring</td>
              <td class="py-3 px-4 text-center text-gray">Einmalig</td>
              <td class="py-3 px-4 text-center text-gray">Monatlich</td>
              <td class="py-3 px-4 text-center text-gray">Monatlich</td>
            </tr>
            <tr class="border-b border-gray-light/40">
              <td class="py-3 pr-4 text-dark font-semibold">Kampagnen-Empfehlungen</td>
              <td class="py-3 px-4 text-center text-gray">Nur Report</td>
              <td class="py-3 px-4 text-center text-gray">Umsetzungs-Roadmap</td>
              <td class="py-3 px-4 text-center text-gray">Für Sie umgesetzt</td>
            </tr>
            <tr class="border-b border-gray-light/40">
              <td class="py-3 pr-4 text-dark font-semibold">Budget-Neuverteilung</td>
              <td class="py-3 px-4 text-center text-gray">Vorschlag</td>
              <td class="py-3 px-4 text-center text-gray">Detaillierter Plan</td>
              <td class="py-3 px-4 text-center text-gray">Laufend gesteuert</td>
            </tr>
            <tr class="border-b border-gray-light/40">
              <td class="py-3 pr-4 text-dark font-semibold">Reporting</td>
              <td class="py-3 px-4 text-center text-gray">Einmaliger Report</td>
              <td class="py-3 px-4 text-center text-gray">Monatlich</td>
              <td class="py-3 px-4 text-center text-gray">Wöchentlich</td>
            </tr>
            <tr>
              <td class="py-3 pr-4 font-headline font-bold text-navy">Preis</td>
              <td class="py-3 px-4 text-center font-headline font-bold text-navy">Kostenlos</td>
              <td class="py-3 px-4 text-center font-headline font-bold text-navy">ab 1'000 CHF</td>
              <td class="py-3 px-4 text-center font-headline font-bold text-navy">ab 2'000 CHF/Monat</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="mt-6 text-base font-body text-gray">
        <a href="/ch-de/services/google-ads-schweiz/" class="text-blue font-semibold hover:text-blue-light">Mehr zu unserer Google-Ads-Betreuung &rarr;</a>
      </p>
    </div>
  </Section>

  <!-- Who This Is For -->
  <Section bg="cream">
    <div class="max-w-3xl">
      <p class="text-xs font-label font-bold uppercase tracking-widest text-blue mb-6">Für wen ist das?</p>
      <div class="space-y-4">
        <div class="flex items-start gap-3">
          <span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span>
          <p class="text-base font-body text-gray"><strong class="text-dark">Sie schalten Google Ads und sind unsicher, ob es funktioniert</strong> — Holen Sie sich eine objektive Zweitmeinung</p>
        </div>
        <div class="flex items-start gap-3">
          <span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span>
          <p class="text-base font-body text-gray"><strong class="text-dark">Erfahrungen mit einer Vor-Agentur enttäuscht</strong> — Sehen Sie genau, was die Agentur hätte machen sollen</p>
        </div>
        <div class="flex items-start gap-3">
          <span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span>
          <p class="text-base font-body text-gray"><strong class="text-dark">Sie erwägen Google Ads zum ersten Mal</strong> — Verstehen Sie die Landschaft, bevor Sie investieren</p>
        </div>
        <div class="flex items-start gap-3">
          <span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span>
          <p class="text-base font-body text-gray"><strong class="text-dark">Sie investieren in Ads und SEO gleichzeitig</strong> — Finden Sie heraus, ob Sie für Klicks zahlen, die Sie organisch bekommen könnten</p>
        </div>
      </div>
    </div>
  </Section>

  <!-- Closing CTA -->
  <section class="bg-navy text-cream py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-headline font-black tracking-tight text-cream">
        Schluss mit dem Rätselraten.
      </h2>
      <p class="mt-4 text-lg font-body text-gray-light">
        Jeder Tag verschwendetes Ad-Budget ist Geld, das in konvertierende Keywords hätte fliessen können. Der Check ist in 2 Minuten angefordert und liefert verwertbare Erkenntnisse innerhalb von 48 Stunden.
      </p>
      <div class="mt-8">
        <a
          href="#kostenloser-google-ads-check-formular"
          class="inline-flex items-center justify-center font-label font-semibold uppercase tracking-wide transition-all rounded-md bg-blue text-white hover:bg-blue-light px-8 py-4 text-sm"
        >
          Kostenlosen Google Ads Check anfordern &uarr;
        </a>
      </div>
    </div>
  </section>
</LandingLayout>
