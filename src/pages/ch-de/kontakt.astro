---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SplitHero from '../../components/ui/SplitHero.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import LeadForm from '../../components/ui/LeadForm.astro';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Start', item: 'https://starkrank.com/ch-de/' },
    { '@type': 'ListItem', position: 2, name: 'Kontakt', item: 'https://starkrank.com/ch-de/kontakt/' },
  ],
};
---

<BaseLayout
  schema={[breadcrumbSchema]}
  title="Kontakt — StarkRank Schweiz"
  description="Kostenlose 15–20-minütige Erstberatung zu KI-Suchoptimierung, SEO, PPC und digitalen Marketingdienstleistungen — wir klären Scope und Budget vor dem Auftrag."
  locale="ch-de"
  noViewTransitions
>
  <SplitHero
    headline="Kontakt"
    subheadline="So läuft ein Erstgespräch ab — 15–20 Minuten am Telefon oder per Video, kostenlos und unverbindlich. Wir klären Scope und Budget — und empfehlen den Einstieg, der realistisch zu Ihrem aktuellen Stand passt."
    image="/images/kontakt-hero.webp"
    imageAlt="StarkRank-Beraterin mit Headset im Erstgespräch, Kollege macht handschriftliche Notizen, Tageslicht und Basler Stadtblick durchs Fenster."
    imagePosition="center top"
  />

  <Section bg="cream">
    <div class="max-w-2xl">
      <SectionHeader label="Nachricht senden" title="Welche Ziele wollen Sie erreichen?" />
      <LeadForm formType="kontakt" locale="ch-de" />
      <p class="mt-6 text-sm font-body text-gray">
        Oder direkt per E-Mail: <a href="mailto:info@starkrank.com" class="text-blue hover:text-blue-light">info@starkrank.com</a>
      </p>
      <p class="mt-3 text-sm font-body text-gray">
        <a
          href="https://www.google.com/maps?cid=5783059190730403381"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-blue hover:text-blue-light"
          aria-label="StarkRank auf Google Maps ansehen"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
          </svg>
          Auf Google Maps ansehen
        </a>
      </p>
    </div>
  </Section>
</BaseLayout>
