---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/ui/HeroSection.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Button from '../../components/ui/Button.astro';
---

<BaseLayout
  title="Kontakt — StarkRank Schweiz"
  description="Bereit zu wachsen? Kontaktieren Sie uns für eine kostenlose Beratung zu KI-Suchoptimierung, SEO, PPC und digitalen Marketingdienstleistungen."
  locale="ch-de"
>
  <HeroSection
    headline="Kontakt"
    subheadline="Bereit zu wachsen? Lassen Sie uns über Ihre digitale Strategie sprechen."
  />

  <Section bg="cream">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
      <div>
        <SectionHeader label="Nachricht Senden" title="Erzählen Sie uns von Ihren Zielen" />
        <form class="space-y-6" method="POST" action="/ch-de/kontakt/">
          <div>
            <label for="name" class="block text-sm font-label font-semibold uppercase tracking-wide text-dark mb-2">Name</label>
            <input type="text" id="name" name="name" required class="w-full px-4 py-3 border border-gray-light rounded-md font-body text-dark bg-white focus:border-blue focus:outline-none" />
          </div>
          <div>
            <label for="email" class="block text-sm font-label font-semibold uppercase tracking-wide text-dark mb-2">E-Mail</label>
            <input type="email" id="email" name="email" required class="w-full px-4 py-3 border border-gray-light rounded-md font-body text-dark bg-white focus:border-blue focus:outline-none" />
          </div>
          <div>
            <label for="message" class="block text-sm font-label font-semibold uppercase tracking-wide text-dark mb-2">Nachricht</label>
            <textarea id="message" name="message" rows="5" required class="w-full px-4 py-3 border border-gray-light rounded-md font-body text-dark bg-white focus:border-blue focus:outline-none resize-y"></textarea>
          </div>
          <Button variant="primary" size="lg">Nachricht Senden</Button>
        </form>
      </div>

      <div>
        <SectionHeader label="Unser Büro" title="Finden Sie uns" />
        <div class="space-y-8">
          <div class="border-b border-gray-light/40 pb-6">
            <h3 class="text-lg font-headline font-black text-navy">Schweiz</h3>
            <p class="mt-1 text-sm font-body text-gray">Basel-Landschaft</p>
            <a href="mailto:ch@starkrank.com" class="mt-1 text-sm font-body text-blue hover:text-blue-light">
              ch@starkrank.com
            </a>
          </div>
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>
