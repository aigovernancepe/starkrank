---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/ui/HeroSection.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import LeadForm from '../../components/ui/LeadForm.astro';
---

<BaseLayout
  title="Kontakt — StarkRank Schweiz"
  description="Kostenlose 15–20-minütige Erstberatung zu KI-Suchoptimierung, SEO, PPC und digitalen Marketingdienstleistungen — wir klären Scope und Budget vor dem Auftrag."
  locale="ch-de"
  noViewTransitions
>
  <HeroSection
    headline="Kontakt"
    subheadline="So läuft ein Erstgespräch ab — 15–20 Minuten am Telefon oder per Video, kostenlos und unverbindlich. Wir klären Scope und Budget, oder sagen direkt, wenn ein Auftrag bei uns gerade nicht passt."
  />

  <Section bg="cream">
    <div class="max-w-2xl">
      <SectionHeader label="Nachricht senden" title="Welche Ziele wollen Sie erreichen?" />
      <LeadForm formType="kontakt" locale="ch-de" />
      <p class="mt-6 text-sm font-body text-gray">
        Oder direkt per E-Mail: <a href="mailto:info@starkrank.com" class="text-blue hover:text-blue-light">info@starkrank.com</a>
      </p>
    </div>
  </Section>
</BaseLayout>
