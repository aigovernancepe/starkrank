---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/ui/HeroSection.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Button from '../../components/ui/Button.astro';
import ContactForm from '../../components/ui/ContactForm.astro';
---

<BaseLayout
  title="Kontakt — StarkRank Schweiz"
  description="Bereit zu wachsen? Kontaktieren Sie uns für eine kostenlose Beratung zu KI-Suchoptimierung, SEO, PPC und digitalen Marketingdienstleistungen."
  locale="ch-de"
>
  <HeroSection
    headline="Kontakt"
    subheadline="Bereit zu wachsen? Lassen Sie uns über Ihre digitale Strategie sprechen."
  />

  <Section bg="cream">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
      <div>
        <SectionHeader label="Nachricht Senden" title="Erzählen Sie uns von Ihren Zielen" />
        <ContactForm locale="ch-de" />
      </div>

      <div>
        <SectionHeader label="Unser Büro" title="Finden Sie uns" />
        <div class="space-y-8">
          <div class="border-b border-gray-light/40 pb-6">
            <h3 class="text-lg font-headline font-black text-navy">Schweiz</h3>
            <p class="mt-1 text-sm font-body text-gray">Basel-Landschaft</p>
            <a href="mailto:info@starkrank.com" class="mt-1 text-sm font-body text-blue hover:text-blue-light">
              info@starkrank.com
            </a>
          </div>
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>
