---
import BlogPost from '../../../components/pages/BlogPost.astro';
import { getCollection, render } from 'astro:content';
import { getEffectiveUpdatedDate } from '../../../utils/getLastModified';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((post) => post.data.locale === 'ch-de')
    .map((post) => ({
      params: { slug: post.id },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const allPosts = await getCollection('blog');
const relatedPosts = allPosts
  .filter((p) => p.data.locale === 'ch-de' && p.id !== post.id)
  .filter((p) => p.data.tags?.some((t) => post.data.tags?.includes(t)))
  .slice(0, 3);

const effectiveUpdatedDate = getEffectiveUpdatedDate(post.filePath, post.data.updatedDate);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  inLanguage: 'de-CH',
  datePublished: post.data.pubDate.toISOString(),
  dateModified: effectiveUpdatedDate.toISOString(),
  author: { '@type': 'Person', name: post.data.author, url: 'https://starkrank.com/about/' },
  publisher: { '@id': 'https://starkrank.com/#organization' },
  url: `https://starkrank.com/ch-de/blog/${post.id}/`,
};

const schemas: Record<string, unknown>[] = [articleSchema];

if (post.data.faq?.length) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: post.data.faq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  });
}

const breadcrumbs = [
  { label: 'Startseite', href: '/ch-de/' },
  { label: 'Blog', href: '/ch-de/blog/' },
  { label: post.data.title, href: `/ch-de/blog/${post.id}/` },
];

const blogHreflangPairs: Record<string, Record<string, string>> = {
  'seo-kosten-schweiz': { 'en': '/blog/seo-pricing-guide/', 'de': '/blog/seo-kosten/' },
  'seo-vs-google-ads-ch': { 'en': '/blog/seo-vs-google-ads/', 'de': '/blog/seo-vs-google-ads-de/' },
  'seo-agentur-auswaehlen-ch': { 'en': '/blog/how-to-choose-seo-agency/', 'de': '/blog/seo-agentur-auswaehlen/' },
};
const pairs = blogHreflangPairs[post.id] ?? {};
const hreflangAlternates = Object.entries(pairs).map(([hreflang, href]) => ({ hreflang, href }));
---

<BlogPost
  post={post}
  Content={Content}
  headings={headings}
  relatedPosts={relatedPosts}
  schemas={schemas}
  breadcrumbs={breadcrumbs}
  hreflangAlternates={hreflangAlternates}
  effectiveUpdatedDate={effectiveUpdatedDate}
  locale="ch-de"
  blogBasePath="/ch-de/blog"
  primaryCTA={{ label: 'Kostenloser AISO-Check', href: '/ch-de/aiso-check/' }}
  secondaryCTA={{ label: 'Kontakt', href: '/ch-de/kontakt/' }}
/>
