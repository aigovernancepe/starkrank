---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceFinderApp from '../../components/ServiceFinder/ServiceFinderApp';
import { chDe } from '../../data/service-finder/locales/ch-de';

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Service Schnellcheck',
  alternateName: ['Find Your Service'],
  description: 'Finden Sie in 60 Sekunden heraus, welche digitalen Marketing-Services Ihr Unternehmen braucht.',
  url: 'https://starkrank.com/ch-de/schnellcheck/',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'CHF' },
  provider: { '@type': 'Organization', name: 'Datanalytico Feye', url: 'https://starkrank.com' },
  inLanguage: ['de', 'en'],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: chDe.faq.map(f => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

const hreflangAlternates = [
  { hreflang: 'en', href: 'https://starkrank.com/find-your-service/' },
  { hreflang: 'es-PE', href: 'https://starkrank.com/pe/diagnostico-rapido/' },
  { hreflang: 'de-DE', href: 'https://starkrank.com/schnellcheck/' },
  { hreflang: 'de-CH', href: 'https://starkrank.com/ch-de/schnellcheck/' },
  { hreflang: 'x-default', href: 'https://starkrank.com/find-your-service/' },
];
---

<BaseLayout
  title="Schnellcheck — Welche Lösung passt? | StarkRank Schweiz"
  description="Beantworten Sie 4 kurze Fragen und erfahren Sie, welche digitalen Marketing-Services Ihr Unternehmen wirklich braucht. Kostenlos, ohne Anmeldung."
  locale="ch-de"
  schema={[webAppSchema, faqSchema]}
>
  <Fragment slot="head">
    {hreflangAlternates.map(({ hreflang, href }) => (
      <link rel="alternate" hreflang={hreflang} href={href} />
    ))}
  </Fragment>

  <section class="max-w-3xl mx-auto px-4 pt-16 pb-8 text-center">
    <h1 class="text-3xl md:text-4xl mb-4">{chDe.intro.h1}</h1>
    <p class="text-lg text-gray max-w-2xl mx-auto mb-3">{chDe.intro.subheading}</p>
    <p class="text-sm text-gray">{chDe.intro.trustLine}</p>
  </section>

  <ServiceFinderApp client:visible locale={chDe} market="ch-de" />

  <section class="max-w-3xl mx-auto px-4 py-16">
    <h2 class="text-2xl mb-8 text-center">Häufig gestellte Fragen</h2>
    {chDe.faq.map(item => (
      <details class="mb-4 bg-white rounded-lg border border-gray-light/40">
        <summary class="px-6 py-4 cursor-pointer font-headline font-bold text-navy text-[0.9375rem] list-none flex items-center justify-between">
          {item.question}
          <svg class="w-5 h-5 text-gray flex-shrink-0 ml-4 transition-transform" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
        </summary>
        <div class="px-6 pb-4 text-gray text-[0.875rem] leading-relaxed" set:html={item.answer} />
      </details>
    ))}
  </section>
</BaseLayout>
