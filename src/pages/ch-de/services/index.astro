---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HeroSection from '../../../components/ui/HeroSection.astro';
import Section from '../../../components/ui/Section.astro';
import SectionHeader from '../../../components/ui/SectionHeader.astro';
import Card from '../../../components/ui/Card.astro';
import { getCollection } from 'astro:content';
import { getLocalizedPillars } from '../../../data/pillars';
import { getLocalizedNavHref } from '../../../data/navigation';
import { t } from '../../../utils/i18n';

const pillars = getLocalizedPillars('ch-de');
const allServices = await getCollection('services');
const deServiceHubs = await getCollection('serviceHubs', (h) => h.data.locale === 'de');

// CH-DE description lookup order:
//   1. chDeOverrides (services where DE hub leaks EUR prices, or flat-locale
//      services without a DE hub at all) — CHF prices, Swiss tone where needed
//   2. DE service hub (currency-neutral copy shared between DE + CH-DE)
//   3. EN canonical (final fallback, shouldn't fire in practice)
const chDeOverrides: Record<string, string> = {
  // Flat-locale services (no DE service hub exists) — CH-DE meta descriptions
  'ai-search-optimization': 'ChatGPT und Google AI zitieren Ihre Konkurrenz — aber nicht Sie. Kostenloser AISO-Check in 24 Stunden. 2 Dimensionen geprüft. Unverbindlich.',
  'ecommerce-seo-audit': 'Produktkatalog-SEO ist eine eigene Disziplin. Wir prüfen die 8 Schwachstellen Ihrer PDPs, PLPs und Filternavigation — Lieferung in 7 Tagen.',
  'eeat-audit': 'Echtes E-E-A-T wird gezeigt, nicht behauptet. Wir bewerten Ihre Seite nach einer 40-Punkte-Rubrik mit signal-basierter Remediation. 1\'500 CHF pauschal.',
  // DE service hubs whose description contains EUR prices — overridden to CHF
  'technical-seo-audit': 'Technisches SEO-Audit für klassische und KI-Suche. Priorisierte Roadmap für Ihr Team. Ab 990 CHF. Kostenlose Erstberatung anfordern.',
};

function getChDeDescription(slug: string, fallbackEn: string): string {
  if (chDeOverrides[slug]) return chDeOverrides[slug];
  const hub = deServiceHubs.find((h) => h.data.serviceSlug === slug);
  if (hub) return hub.data.description;
  return fallbackEn;
}

const servicesByPillar = pillars.map((pillar) => ({
  pillar,
  services: pillar.services
    .map((slug) => allServices.find((s) => s.data.slug === slug))
    .filter((s): s is NonNullable<typeof s> => Boolean(s)),
}));
---

<BaseLayout
  title="Dienstleistungen — StarkRank Schweiz"
  description="Das vollständige StarkRank-Leistungsspektrum für Schweizer Unternehmen: KI-Suchoptimierung, technisches SEO, Google Ads, Content-Marketing und Analytics-Beratung — mit Datenverarbeitung in der Schweiz."
  locale="ch-de"
>
  <HeroSection
    headline="Unsere Dienstleistungen"
    subheadline="Datenbasiertes Wachstum von KI-Suchintelligenz bis zu transparenter Messung — fokussiert auf Unternehmen in der Deutschschweiz."
  />

  {servicesByPillar.map(({ pillar, services }, idx) => (
    <Section bg={idx % 2 === 0 ? 'cream' : 'white'} id={pillar.id} class="scroll-mt-20">
      <SectionHeader
        label={pillar.tagline}
        title={pillar.name}
        subtitle={pillar.description}
      />
      {pillar.id === 'performance-media' && (
        <p class="mt-4 mb-8 text-sm font-body text-gray leading-relaxed max-w-3xl">
          Auch bekannt als <strong>SEA-Agentur</strong> (Search Engine Advertising) — StarkRank bietet Google Ads Management, Google Ads Audit und Paid Social Strategy.
        </p>
      )}
      {pillar.id === 'search-ai-intelligence' && (
        <p class="mt-4 mb-8 text-sm font-body text-gray leading-relaxed max-w-3xl">
          Auch bekannt als <strong>LLMO-Agentur</strong> (Large Language Model Optimization) — StarkRank bietet Optimierung dafür, dass Ihre Marke in ChatGPT, Perplexity, Claude und Google AI Overviews zitiert und empfohlen wird.
        </p>
      )}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map((service) => (
          <Card href={getLocalizedNavHref(`/services/${service.data.slug}/`, 'ch-de')}>
            <h3 class="text-lg font-headline font-bold text-navy">{t('service.' + service.data.slug, 'ch-de')}</h3>
            <p class="mt-2 text-sm font-body text-gray leading-relaxed">{getChDeDescription(service.data.slug, service.data.description)}</p>
          </Card>
        ))}
      </div>

      {pillar.id === 'content-copywriting' && (
        <div class="mt-12 pt-10 border-t border-gray-light/40">
          <h3 class="text-xs font-label font-bold uppercase tracking-[0.2em] text-blue mb-2">Content-Produkte</h3>
          <p class="text-sm font-body text-gray leading-relaxed mb-6 max-w-2xl">Strukturierte First-Party-Assets, die jede Content-Pipeline mit nicht-generischem Expertenwissen speisen — ergänzend zum Content-Marketing-Retainer oder standalone buchbar.</p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <Card href="/ch-de/expertenbibliothek/">
              <span class="text-xs font-label font-semibold uppercase tracking-wide text-blue">Ab 2'500 CHF</span>
              <h4 class="mt-2 text-lg font-headline font-bold text-navy">Expertenbibliothek</h4>
              <p class="mt-2 text-sm font-body text-gray leading-relaxed">Personen-spezifisch. Das gesamte Wissen Ihres Gründers über seine Praxis — Fallstudien, konträre Positionen, Frameworks — einmal im Onboarding als kanonische Datei gebaut, aus der Ihr Content-Team täglich schöpft.</p>
            </Card>
            <Card href="/ch-de/experteninterview/">
              <span class="text-xs font-label font-semibold uppercase tracking-wide text-blue">Ab 800 CHF</span>
              <h4 class="mt-2 text-lg font-headline font-bold text-navy">Experteninterview</h4>
              <p class="mt-2 text-sm font-body text-gray leading-relaxed">Themen-spezifisch. Gezielte Fragen an Ihren Experten zu einer einzelnen Content-Initiative — extrahiert Fallstudien, konträre Winkel und Workflow-Details, die generische KI-Texte nicht erfinden können.</p>
            </Card>
          </div>
        </div>
      )}
    </Section>
  ))}
</BaseLayout>
