---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import CTABanner from '../../components/ui/CTABanner.astro';
import EcommerceForkBox from '../../components/ch-de/EcommerceForkBox.astro';

const title = 'Online Shop SEO Audit — Produktschema | StarkRank Schweiz';
const description = 'Produktkatalog-SEO ist eine eigene Disziplin. Wir prüfen die 8 Schwachstellen Ihrer PDPs, PLPs und Filternavigation — Lieferung in 7 Tagen.';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'E-Commerce-SEO-Audit',
  description: 'Spezialisiertes SEO-Audit für Produktkatalog-Websites, das 8 Schwachstellen abdeckt: Produktschema, Filternavigation, Variantenhandhabung, Kategorieseiten, Nichtverfügbarkeit, Sitemap-Abdeckung, Bewertungsschema und PDP-Bildoptimierung. Lieferung in 7 Werktagen.',
  url: 'https://starkrank.com/ch-de/ecommerce-seo-audit/',
  provider: { '@type': 'Organization', name: 'StarkRank', url: 'https://starkrank.com' },
  areaServed: [
    { '@type': 'Country', name: 'Germany' },
    { '@type': 'Country', name: 'Austria' },
    { '@type': 'Country', name: 'Switzerland' },
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'E-Commerce-SEO-Audit Stufen',
    itemListElement: [
      { '@type': 'Offer', name: 'E-Commerce-SEO-Audit — Starter', description: 'Kataloge bis 1.000 SKUs. 10 PDPs + 3 PLPs validiert. Lieferung in 5-7 Werktagen.', price: '2500', priceCurrency: 'CHF' },
      { '@type': 'Offer', name: 'E-Commerce-SEO-Audit — Growth', description: 'Kataloge 1.000-10.000 SKUs. 18 PDPs + 5 PLPs validiert. Lieferung in 7-10 Werktagen.', price: '3600', priceCurrency: 'CHF' },
      { '@type': 'Offer', name: 'E-Commerce-SEO-Audit — Enterprise', description: 'Kataloge 10.000+ SKUs. 25+ PDPs + 8 PLPs validiert. Lieferung in 10-14 Werktagen.', price: '4000', priceCurrency: 'CHF' },
      { '@type': 'Offer', name: 'E-Commerce Schema-Monitoring', description: 'Laufende Produktschema-Validierung als Retainer. Monatliche rotierende 10-SKU-Stichprobe, Regressions-Warnungen, Delta-Reporting.', price: '800', priceCurrency: 'CHF' },
    ],
  },
  isRelatedTo: {
    '@type': 'Service',
    '@id': 'https://starkrank.com/ch-de/onlineshop-erstellen-lassen/#service',
    name: 'Onlineshop erstellen lassen',
    url: 'https://starkrank.com/ch-de/onlineshop-erstellen-lassen/',
  },
};

const faqItems = [
  { question: 'Wie unterscheidet sich das vom allgemeinen technischen SEO-Audit?', answer: 'Ein allgemeines technisches Audit prüft die sitewide Infrastruktur — Core Web Vitals, robots.txt, Indexierungs-Grundlagen, Sitemap-Struktur. Es behandelt Ihre PDPs und PLPs als generische Seiten. Das E-Commerce-Audit inspiziert Produktkatalog-Artefakte spezifisch: Produktschema-Vollständigkeit, Kanonisierung der Filternavigation, Kannibalisierung zwischen Varianten-Seiten, Wahrhaftigkeit der Verfügbarkeit bei Nichtverfügbarkeit, Einbindung des Bewertungsschemas.' },
  { question: 'Welche E-Commerce-Plattformen unterstützen Sie?', answer: 'Shopify, Shopify Plus, WooCommerce, BigCommerce, Magento (Adobe Commerce) und Custom-Headless-Stacks (Next.js Commerce, Remix, Custom Node). Für Headless-Custom-Builds bitten wir während des Auftrags um Repo-Zugriff, um in der Umsetzungs-Roadmap auf konkrete Template-Dateien zu verweisen.' },
  { question: 'Wie gross ist die geprüfte Stichprobe?', answer: 'Die Stichprobe skaliert mit der Katalog-Grösse: Kataloge bis 1.000 SKUs erhalten 10 repräsentative PDPs, 1.000-10.000 erhalten 18, 10.000 oder mehr erhalten 25 oder mehr. Wir wählen über High-Velocity-SKUs, Low-Velocity-SKUs, variantenreiche Produkte und ausverkaufte Artikel.' },
  { question: 'Setzen Sie die Fixes um oder identifizieren sie nur?', answer: 'Das Audit ist Diagnose und Roadmap. Die Umsetzung ist ein separater Auftrag. Wir können die Umsetzung am Ende des Audits skizzieren, falls Sie uns damit beauftragen möchten, oder die Roadmap an Ihr internes Team oder Ihre bestehende Agentur übergeben.' },
  { question: 'Wie passt das zur KI-Suchoptimierung?', answer: 'Die Vollständigkeit des Produktschemas bestimmt direkt, ob KI-Plattformen wie ChatGPT, Perplexity und Google AI Overviews Ihre Produkte namentlich mit Preis und Verfügbarkeit zitieren können. Die Schema-Ebene ist fundamental für KI-Zitationen. Kombinieren Sie dieses Audit mit unserem KI-Suchoptimierung-Service für breitere KI-Suche-Abdeckung.' },
  { question: 'Was passiert mit ausverkauften Produkten im Audit?', answer: 'Wir prüfen 2-3 langfristig ausverkaufte Produkte, die Sie benennen. Akzeptabel: HTTP 200 plus Offer.availability OutOfStock plus Benachrichtigungs-CTA plus Produkt verbleibt in der Sitemap. Nicht akzeptabel: 200 mit InStock-Verfügbarkeit (lügt Google an), 404 ohne Redirect (Linkkraft verloren), 301 auf die Startseite (Linkkraft landet auf der falschen Seite).' },
  { question: 'Was, wenn mein Katalog weniger als 500 SKUs hat?', answer: 'Die Starter-Stufe gilt trotzdem — die Methodik funktioniert bei 200 SKUs genauso wie bei 1.000. Für sehr kleine Kataloge (unter 50 SKUs) deckt das Audit dieselben Schwachstellen auf (Schema-Lücken, OOS-Fehlverhalten, dünne PLPs), nur mit weniger Umsetzungspunkten.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

const schemas = [serviceSchema, faqSchema];

const breadcrumbs = [
  { label: 'Start', href: '/' },
  { label: 'E-Commerce-SEO-Audit', href: '/ecommerce-seo-audit/' },
];

const auditAreas = [
  { num: 1, area: 'Produktschema', what: 'Pflichtfelder (name, image, description, brand, offers, price, availability, AggregateRating) deterministisch validiert, nicht per Augenmass', why: 'Rich Snippets, KI-Zitations-Eignung, Merchant-Center-Konformität' },
  { num: 2, area: 'Filternavigation', what: 'Canonical-Tags oder noindex auf gefilterten URLs, Sitemap-Hygiene, robots.txt-Muster', why: 'Crawl-Budget, Duplicate Content im grossen Stil' },
  { num: 3, area: 'Variantenhandhabung', what: 'Canonicals pro Variante, hasVariant-Schema, Einzigartigkeit von H1 und Meta-Title, Varianten-Picker-Verlinkung', why: 'Verhindert Kannibalisierung über Farben und Grössen hinweg' },
  { num: 4, area: 'Kategorieseiten (PLPs)', what: 'Einzigartige Intro-Texte ≥50 Wörter, H1 ≠ Meta-Title, eigenständige Beschreibungen pro Kategorie', why: 'Dünne PLPs verlieren Rankings an Wettbewerber mit besserer Kategorietiefe' },
  { num: 5, area: 'Nichtverfügbarkeit (OOS)', what: 'HTTP-Status, Wahrhaftigkeit von Offer.availability, Sitemap-Einbindung, Benachrichtigungs-CTA', why: 'Langfristig ausverkaufte Seiten bewahren Linkkraft bei korrekter Behandlung' },
  { num: 6, area: 'Sitemap-Produktabdeckung', what: 'Produktzahl in der Sitemap vs. autoritativer Katalogzahl, Lückenanalyse, Sitemap-Index-Struktur', why: 'Fehlende Produkte = verlorene Indexierung im grossen Stil' },
  { num: 7, area: 'Bewertungsschema auf PDPs', what: 'AggregateRating-Präsenz, Review-App-Schema-Integration (Yotpo, Judge.me, Loox, Shopify), GBP-Bewertungs-Abgleich', why: 'Sterne-Rich-Snippet steigert CTR messbar' },
  { num: 8, area: 'PDP-Bildoptimierung', what: 'Alt-Texte mit Produkt- und Variantenattributen, Dateigrösse (≤200 KB Hero), deklarierte Dimensionen, Lazy Loading', why: 'CWV-Konformität + Traffic aus Google Bilder' },
];

const processSteps = [
  { num: 1, title: 'Scope klären (Tag 1)', body: 'Kickoff-Call zur Bestätigung von Plattform, Katalog-Grösse, autoritativer Produktanzahl (Shopify-Admin-Export, Merchant-Center-Feed oder CSV) sowie 2-3 langfristig ausverkauften SKUs zur Prüfung.' },
  { num: 2, title: 'Daten erfassen (Tag 2-3)', body: 'Firecrawl-Scraping über Startseite, PLPs und PDPs; Screaming-Frog-Crawl; DataForSEO-Lighthouse-Läufe; Ausführung des Schema-Validators über die vollständige Stichprobe.' },
  { num: 3, title: 'Befunde analysieren (Tag 4-5)', body: 'Befunde nach Schweregrad zusammenstellen. Prüfung der Top-3-ranking Wettbewerber-PDPs zur primären kommerziellen Anfrage als Benchmark-Kontext.' },
  { num: 4, title: 'Bericht erstellen (Tag 6)', body: 'Interne QA gegen unsere 8-Bereiche-Checkliste; Schema-Anhang kompiliert.' },
  { num: 5, title: 'Lieferung und Durchsprache (Tag 7)', body: 'Liefer-Call mit Befunden, priorisierter Umsetzungs-Roadmap und nächsten Schritten.' },
];

const relatedLinks = [
  { title: 'SEO Audit in Basel', href: '/ch-de/seo-audit-basel/' },
  { title: 'KI-Suchoptimierung', href: '/ch-de/ki-suchoptimierung-basel/' },
  { title: 'Content-Marketing', href: '/ch-de/content-marketing-basel/' },
  { title: 'Kostenloser AI-Search-Check', href: '/aiso-check/' },
];
import { getSelfLastModified } from '../../utils/getLastModified';
const lastModified = getSelfLastModified(import.meta.url);
const lastModifiedIso = lastModified.toISOString().split('T')[0];
const lastModifiedLabel = lastModified.toLocaleDateString('de-CH', { year: 'numeric', month: 'long' });
---

<BaseLayout title={title} description={description} locale="de" schema={schemas}>
  <Fragment slot="head">
    <link rel="alternate" hreflang="en" href="https://starkrank.com/en/services/ecommerce-seo-audit/" />
    <link rel="alternate" hreflang="de-DE" href="https://starkrank.com/ecommerce-seo-audit/" />
    <link rel="alternate" hreflang="de-CH" href="https://starkrank.com/ch-de/ecommerce-seo-audit/" />
    <link rel="alternate" hreflang="x-default" href="https://starkrank.com/ecommerce-seo-audit/" />
  </Fragment>

  <!-- Hero -->
  <Section bg="cream">
    <Breadcrumbs items={breadcrumbs} />

    <span class="text-xs font-label font-semibold uppercase tracking-[0.2em] text-blue mb-3 block">
      Suche &amp; KI-Intelligenz
    </span>
    <h1 class="text-4xl md:text-5xl font-headline font-black tracking-tight text-navy">
      E-Commerce-SEO-Audit — Die 8 Schwachstellen beheben, die Produktsichtbarkeit kosten
    </h1>
    <p class="mt-4 text-lg text-gray font-body leading-relaxed max-w-3xl">
      Produktkatalog-SEO ist kein gewöhnliches SEO. Ein Shopify-Shop mit 5.000 SKUs versagt auf Arten, die ein Blog nie erleben wird — Filternavigation sprengt das Crawl-Budget, Variantenseiten kannibalisieren einander, ausverkaufte Produkte lügen Google an, und Lücken im Produktschema kosten das Rich Snippet, das Klicks bringt. Wir prüfen alle acht Schwachstellen in einem Auftrag und liefern Ihnen eine priorisierte Fix-Liste.
    </p>

    <div class="mt-8 flex flex-wrap gap-4">
      <Button href="/ch-de/kontakt/" variant="primary" size="lg">Audit jetzt buchen</Button>
      <Button href="#whats-included" variant="ghost" size="lg">Leistungsumfang ansehen</Button>
    </div>

    <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs font-body text-gray">
      <span>Zuletzt aktualisiert: <time datetime={lastModifiedIso}>{lastModifiedLabel}</time></span>
      <span>Von <a href="/about/" class="text-blue hover:text-blue-light font-semibold">Wilko Feye</a>, StarkRank</span>
    </div>
  </Section>

  <!-- Build-vs-Audit Fork Box: push visitors without a shop yet to the build page -->
  <EcommerceForkBox variant="audit-to-build" />

  <!-- Main content + sidebar -->
  <section class="bg-white">
    <div class="max-w-7xl mx-auto px-6 py-16 md:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <div class="lg:col-span-2 space-y-0">

          <div class="pb-14">
            <h2 class="text-2xl md:text-3xl font-headline font-black text-navy tracking-tight mb-6">
              Warum brauchen E-Commerce-Websites ein spezialisiertes SEO-Audit?
            </h2>
            <div class="space-y-4 text-base font-body text-gray leading-relaxed">
              <p>Generische Audits melden fehlende Meta-Beschreibungen und schwache Core Web Vitals — und hören dort auf. Produktkatalog-Websites versagen anders: Indizes blähen sich durch Filter-URLs auf, Variantenseiten kannibalisieren sich, und Produkt-JSON-LD übergeht die Felder, die Rich Snippets auslösen. Unser Audit adressiert 8 spezifische Schwachstellen, die Katalog-Websites am meisten Traffic kosten.</p>
              <p>Der Wandel hin zur KI-Suche macht das dringlicher. Wenn jemand ChatGPT nach "beste wasserdichte Wanderstiefel unter 200 Franken" fragt, extrahieren KI-Plattformen aus dem Produktschema — <code class="font-mono text-sm bg-cream px-1">name</code>, <code class="font-mono text-sm bg-cream px-1">price</code>, <code class="font-mono text-sm bg-cream px-1">availability</code>, <code class="font-mono text-sm bg-cream px-1">aggregateRating</code>. Shops mit sauberem, vollständigem Produkt-Markup werden namentlich zitiert. Shops mit fehlerhaftem oder fehlendem Schema werden übersprungen.</p>
            </div>
          </div>

          <div id="whats-included" class="pt-14 pb-14 border-t border-gray-light/30">
            <h2 class="text-2xl md:text-3xl font-headline font-black text-navy tracking-tight mb-4">
              Was umfasst das E-Commerce-Audit?
            </h2>
            <p class="text-base font-body text-gray leading-relaxed mb-8">
              Das Audit deckt 8 spezifische Schwachstellen von Produktkatalog-Websites ab. Jeder Bereich liefert eine Checkliste, eine Validator-Ausgabe wo relevant und eine priorisierte Umsetzungs-Roadmap zugeschnitten auf Ihre Plattform (Shopify, WooCommerce, BigCommerce, Magento).
            </p>

            <div class="overflow-x-auto">
              <table class="w-full text-sm font-body border-collapse">
                <thead>
                  <tr class="border-b-2 border-navy/20">
                    <th class="text-left py-3 pr-4 font-headline font-bold text-navy">#</th>
                    <th class="text-left py-3 pr-4 font-headline font-bold text-navy">Bereich</th>
                    <th class="text-left py-3 pr-4 font-headline font-bold text-navy">Was wir prüfen</th>
                    <th class="text-left py-3 font-headline font-bold text-navy">Warum es zählt</th>
                  </tr>
                </thead>
                <tbody>
                  {auditAreas.map((a) => (
                    <tr class="border-b border-gray-light/40">
                      <td class="py-3 pr-4 text-blue font-bold align-top">{a.num}</td>
                      <td class="py-3 pr-4 font-semibold text-dark align-top">{a.area}</td>
                      <td class="py-3 pr-4 text-gray leading-relaxed align-top">{a.what}</td>
                      <td class="py-3 text-gray leading-relaxed align-top">{a.why}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <div class="pt-14 pb-14 border-t border-gray-light/30">
            <h2 class="text-2xl md:text-3xl font-headline font-black text-navy tracking-tight mb-6">
              Warum benötigt Produktschema eine deterministische Validierung?
            </h2>
            <div class="space-y-4 text-base font-body text-gray leading-relaxed">
              <p>Manuelle Schema-Prüfung skaliert nicht — Menschen übersehen Felder. Wir betreiben einen deterministischen JSON-LD-Validator gegen jede stichprobenartig geprüfte PDP. Er gibt Exit-Code 1 zurück, sobald ein Pflichtfeld fehlt: <code class="font-mono text-sm bg-cream px-1">Product.name</code>, <code class="font-mono text-sm bg-cream px-1">Product.image</code>, <code class="font-mono text-sm bg-cream px-1">Product.description</code>, <code class="font-mono text-sm bg-cream px-1">Product.brand</code>, <code class="font-mono text-sm bg-cream px-1">Product.offers</code>, <code class="font-mono text-sm bg-cream px-1">Offer.price</code>, <code class="font-mono text-sm bg-cream px-1">Offer.priceCurrency</code>, <code class="font-mono text-sm bg-cream px-1">Offer.availability</code>, <code class="font-mono text-sm bg-cream px-1">AggregateRating.ratingValue</code>, <code class="font-mono text-sm bg-cream px-1">AggregateRating.reviewCount</code>, <code class="font-mono text-sm bg-cream px-1">Brand.name</code>.</p>
              <p>Jede Lücke landet im Audit mit exakter URL, Feldname und Validator-Ausgabe. Kein subjektives Urteil — Sie erhalten dieselbe Bewertung, die wir verwenden würden, um ein Deployment zu blockieren.</p>
            </div>
          </div>

          <div class="pt-14 pb-14 border-t border-gray-light/30">
            <h2 class="text-2xl md:text-3xl font-headline font-black text-navy tracking-tight mb-6">
              Warum ist Filternavigation der grösste stille Crawl-Budget-Killer?
            </h2>
            <div class="space-y-4 text-base font-body text-gray leading-relaxed">
              <p>Eine Kategorieseite mit 8 Filtern (Farbe, Grösse, Marke, Preis, Material, Bewertung, Sortierung, Verfügbarkeit) kann über 10.000 einzigartige URL-Kombinationen erzeugen. Wenn diese gefilterten URLs 200 OK ohne Canonical-Tag zurück zur sauberen Kategorie-URL ausliefern, crawlt und indexiert Google jede Permutation. Ihr 500-Produkt-Shop wird als 50.000 Beinahe-Duplikate indexiert.</p>
              <p>Wir testen jede gängige Filterkombination auf Ihren Kategorieseiten und verifizieren eines von drei akzeptablen Mustern: Canonical auf die saubere URL, <code class="font-mono text-sm bg-cream px-1">noindex</code> auf gefilterten Varianten oder Musterblock in der robots.txt. Wenn keines davon, ist es ein HIGH-Befund mit den exakten URLs und dem konkreten Fix.</p>
            </div>
          </div>

          <div class="pt-14 pb-14 border-t border-gray-light/30">
            <h2 class="text-2xl md:text-3xl font-headline font-black text-navy tracking-tight mb-6">
              Warum kannibalisieren sich Variantenseiten?
            </h2>
            <div class="space-y-4 text-base font-body text-gray leading-relaxed">
              <p>Varianten kannibalisieren, wenn jede Farbe oder Grösse auf einer eigenen URL liegt, aber identischen H1, Meta-Title und Canonical mit Geschwistern teilt. Google wählt 1 Variante zum Ranken; der Rest verliert Indexierung. Zwei Muster sind akzeptabel — entweder das eine oder das andere; sie zu mischen oder keines anzuwenden ist das Problem.</p>
              <p><strong class="text-dark">Muster A — separate URLs pro Variante:</strong> jede Varianten-URL hat ihren eigenen selbstreferenzierenden Canonical, eigenes Product- und Offer-JSON-LD und Verlinkung über einen sichtbaren Farb- oder Grössen-Picker.</p>
              <p><strong class="text-dark">Muster B — einzelne URL mit <code class="font-mono text-sm bg-cream px-1">hasVariant</code>-Schema:</strong> eine URL pro Produkt, Varianten im JSON-LD-hasVariant-Array oder in einer Multi-Entry-offers-Liste abgebildet.</p>
              <p>Wir markieren Ihr aktuelles Muster, identifizieren welche Varianten Sichtbarkeit verlieren und spezifizieren den Fix pro Produkt-Template.</p>
            </div>
          </div>

          <div class="pt-14 pb-14 border-t border-gray-light/30">
            <h2 class="text-2xl md:text-3xl font-headline font-black text-navy tracking-tight mb-6">
              Was passiert mit ausverkauften Produkten?
            </h2>
            <div class="space-y-4 text-base font-body text-gray leading-relaxed">
              <p>Der Umgang mit Nichtverfügbarkeit ist der am häufigsten missverstandene Bereich des E-Commerce-SEO. Viele Shops geben 404 für ausverkaufte Produkte zurück, um "den Index sauber zu halten", oder leiten auf die Startseite um. Beide Ansätze zerstören Linkkraft und SERP-Präsenz, die über Monate aufgebaut wurden.</p>
              <p><strong class="text-dark">Akzeptabel:</strong> HTTP 200 + <code class="font-mono text-sm bg-cream px-1">Offer.availability: OutOfStock</code> + Benachrichtigungs-CTA + Produkt verbleibt in der Sitemap. Das bewahrt Linkkraft und konvertiert geduldige Käufer über die E-Mail-Erfassung.</p>
              <p><strong class="text-dark">Nicht akzeptabel:</strong> 200 mit <code class="font-mono text-sm bg-cream px-1">InStock</code> (lügt Google und Merchant Center an), 404 ohne Redirect (verliert die gesamte Linkkraft), 301 auf die Startseite (Linkkraft landet auf einer Seite, die der Suchende nie wollte).</p>
            </div>
          </div>

          <div id="deliverables" class="pt-14 pb-14 border-t border-gray-light/30">
            <h2 class="text-2xl md:text-3xl font-headline font-black text-navy tracking-tight mb-6">
              Was erhalten Sie als Audit-Ergebnis?
            </h2>
            <div class="space-y-4 text-base font-body text-gray leading-relaxed">
              <p>Sie erhalten ein vollständiges Audit als client-gebrandetes PDF innerhalb von 7 Werktagen. Es umfasst:</p>
              <ul class="space-y-3 list-none pl-0">
                <li class="flex items-start gap-3"><span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span><span><strong class="text-dark">Executive Summary</strong> — 3-5 Sätze zum stärksten Bereich, schwächsten Bereich und zur vorrangigen Empfehlung</span></li>
                <li class="flex items-start gap-3"><span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span><span><strong class="text-dark">Befunde nach Schweregrad</strong> — CRITICAL (Deploy-Blocker) / HIGH / MEDIUM / LOW</span></li>
                <li class="flex items-start gap-3"><span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span><span><strong class="text-dark">Detailanalyse pro Bereich</strong> — alle 8 Audit-Bereiche mit URLs, Validator-Ausgaben und Screenshots</span></li>
                <li class="flex items-start gap-3"><span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span><span><strong class="text-dark">Schema-Validierungs-Anhang</strong> — eine Datei pro PDP, Feld-Ebene Pass/Fail</span></li>
                <li class="flex items-start gap-3"><span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span><span><strong class="text-dark">Umsetzungs-Roadmap</strong> — priorisierte Fix-Liste mit Aufwand und erwarteter Wirkung</span></li>
                <li class="flex items-start gap-3"><span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span><span><strong class="text-dark">Plattform-spezifische Fix-Hinweise</strong> — Shopify-Liquid, WooCommerce-Hooks, BigCommerce-Stencil, Magento-phtml — wir verweisen auf die konkrete zu ändernde Datei</span></li>
              </ul>
            </div>
          </div>

        </div>

        <!-- Sidebar -->
        <aside class="lg:col-span-1">
          <div class="lg:sticky lg:top-8 space-y-6">
            <div class="bg-cream border border-gray-light/40 rounded-lg p-6">
              <p class="text-xs font-label font-bold uppercase tracking-widest text-blue mb-4">Trust-Bar</p>
              <div class="space-y-2 text-sm font-body text-gray">
                <div class="flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-blue shrink-0"></span><span>Lieferung in 7 Werktagen</span></div>
                <div class="flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-blue shrink-0"></span><span>Deterministischer Schema-Validator</span></div>
