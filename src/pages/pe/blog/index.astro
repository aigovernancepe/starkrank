---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HeroSection from '../../../components/ui/HeroSection.astro';
import Section from '../../../components/ui/Section.astro';
import Card from '../../../components/ui/Card.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((p) => p.data.locale === 'pe')
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout
  title="Blog — StarkRank Perú"
  description="Guías y estrategias de SEO, marketing digital e inteligencia artificial para negocios en Perú."
  locale="pe"
>
  <HeroSection headline="Blog" subheadline="Guías y estrategias de SEO y marketing digital para negocios en Perú." />

  <Section bg="cream">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map((post) => (
        <Card href={`/pe/blog/${post.id}/`}>
          <time class="text-xs font-label font-semibold uppercase tracking-wide text-blue">
            {post.data.pubDate.toLocaleDateString('es-PE', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          <h3 class="mt-2 text-lg font-headline font-bold text-navy">{post.data.title}</h3>
          <p class="mt-2 text-sm font-body text-gray leading-relaxed">{post.data.description}</p>
        </Card>
      ))}
    </div>
  </Section>
</BaseLayout>
