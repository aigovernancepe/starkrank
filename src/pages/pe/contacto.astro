---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/ui/HeroSection.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Button from '../../components/ui/Button.astro';
---

<BaseLayout
  title="Contacto — StarkRank Perú"
  description="¿Listo para crecer? Contáctenos para una consulta gratuita sobre optimización de búsqueda IA, SEO, PPC y servicios de marketing digital."
  locale="pe"
>
  <HeroSection
    headline="Contáctenos"
    subheadline="¿Listo para crecer? Hablemos sobre su estrategia digital."
  />

  <Section bg="cream">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
      <div>
        <SectionHeader label="Envíenos un Mensaje" title="Cuéntenos Sobre sus Objetivos" />
        <form class="space-y-6" method="POST" action="/pe/contacto/">
          <div>
            <label for="name" class="block text-sm font-label font-semibold uppercase tracking-wide text-dark mb-2">Nombre</label>
            <input type="text" id="name" name="name" required class="w-full px-4 py-3 border border-gray-light rounded-md font-body text-dark bg-white focus:border-blue focus:outline-none" />
          </div>
          <div>
            <label for="email" class="block text-sm font-label font-semibold uppercase tracking-wide text-dark mb-2">Correo Electrónico</label>
            <input type="email" id="email" name="email" required class="w-full px-4 py-3 border border-gray-light rounded-md font-body text-dark bg-white focus:border-blue focus:outline-none" />
          </div>
          <div>
            <label for="message" class="block text-sm font-label font-semibold uppercase tracking-wide text-dark mb-2">Mensaje</label>
            <textarea id="message" name="message" rows="5" required class="w-full px-4 py-3 border border-gray-light rounded-md font-body text-dark bg-white focus:border-blue focus:outline-none resize-y"></textarea>
          </div>
          <Button variant="primary" size="lg">Enviar Mensaje</Button>
        </form>
      </div>

      <div>
        <SectionHeader label="Nuestra Oficina" title="Encuéntrenos" />
        <div class="space-y-8">
          <div class="border-b border-gray-light/40 pb-6">
            <h3 class="text-lg font-headline font-black text-navy">Perú</h3>
            <p class="mt-1 text-sm font-body text-gray">Lima</p>
            <a href="mailto:contacto@starkrank.com" class="mt-1 text-sm font-body text-blue hover:text-blue-light">
              contacto@starkrank.com
            </a>
          </div>
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>
