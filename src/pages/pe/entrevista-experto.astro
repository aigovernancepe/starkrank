---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import CTABanner from '../../components/ui/CTABanner.astro';

const title = 'Expert Interview — Contenido de Primera Mano | StarkRank';
const description = '2-4 preguntas dirigidas a su SME producen los casos, ángulos contrarios e historias de fracaso que la AI no puede inventar. Desde S/ 700.';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Expert Interview',
  description: 'Entrevista con alcance de tema a un experto en la materia que extrae material de primera mano (casos de estudio, visiones contrarias, detalle de workflow, historias de fracaso, frameworks con nombre) que el contenido AI commodity no puede generar.',
  url: 'https://starkrank.com/pe/entrevista-experto/',
  provider: { '@type': 'Organization', name: 'StarkRank', url: 'https://starkrank.com' },
  areaServed: [{ '@type': 'Country', name: 'Peru' }],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Expert Interview Packages',
    itemListElement: [
      { '@type': 'Offer', name: 'Standard', description: 'Entrevista de 45 minutos con 2 arquetipos de preguntas.', price: '700', priceCurrency: 'PEN' },
      { '@type': 'Offer', name: 'Deep Dive', description: 'Entrevista de 90 minutos con 4 arquetipos y absorción de material previo.', price: '1275', priceCurrency: 'PEN' },
      { '@type': 'Offer', name: 'Batch', description: 'Engagement multi-tema o multi-SME con 20% de descuento sobre la tarifa combinada.', price: '3060', priceCurrency: 'PEN' },
    ],
  },
};

const faqItems = [
  { question: '¿En qué se diferencia esto de la SME Expertise Library?', answer: 'SME Library tiene alcance de persona: el cuerpo completo de conocimiento de su fundador en toda su práctica, construido una vez. Expert Interview tiene alcance de tema: un procedimiento, un área de servicio, un archivo por tema. Ambos coexisten: la biblioteca es el respaldo; las entrevistas temáticas son la profundización cuando una iniciativa de contenido necesita profundidad.' },
  { question: '¿Cuántos arquetipos deberíamos correr por entrevista?', answer: '2 para una entrevista standard de S/ 700, 4 para una deep dive de S/ 1,275. Correr más de 4 diluye el tiempo por arquetipo. Si su iniciativa genuinamente necesita más, reserve una segunda entrevista en el mismo tema cubriendo arquetipos distintos.' },
  { question: '¿El SME puede ser entrevistado de forma remota?', answer: 'Sí. Teléfono, video o revisión asíncrona de transcripción funcionan. Las entrevistas presenciales a veces son más ricas para arquetipos de workflow, pero la mayoría de temas funciona remoto. Para fundadores viajeros, la revisión asíncrona de transcripción (Loom, nosotros sintetizamos) es una alternativa viable.' },
  { question: '¿Qué pasa si nuestro SME se congela en preguntas contrarias?', answer: 'Reformulamos. "¿Contra qué empujarías si un competidor lo dijera en un panel a tu lado?" o "¿Qué hacen los más nuevos en tu campo que te saca de quicio?" Para el final de la entrevista, la mayoría de SMEs tiene una posición contraria útil aunque el primer intento haya sido dudoso.' },
  { question: '¿Las entrevistas pueden reusarse en múltiples piezas de contenido?', answer: 'Sí. Una sola entrevista de 90 minutos típicamente alimenta 4-6 piezas: página de servicio, 2 blog posts, un caso de estudio, un pull quote y un esquema de podcast. El registro de uso rastrea qué ya se publicó para que su equipo no republique el mismo caso en tres posts distintos.' },
  { question: '¿Entrevistan a múltiples SMEs en un engagement?', answer: 'Para batches (3+ temas o 2+ SMEs), sí, con 20% de descuento sobre la tarifa combinada. Programamos las entrevistas por separado para que cada SME reciba atención completa, pero compartimos hallazgos de material previo entre el batch para evitar duplicación.' },
  { question: '¿Qué tan pronto después de la entrevista se entrega el archivo?', answer: '5-7 días desde la fecha de la entrevista. El pase de síntesis es el paso más largo porque compilamos citas textuales con atribución, las estructuramos por arquetipo y cruzamos referencias a entrevistas temáticas existentes o material de SME Library. Entrega express (3 días) disponible con 25% de recargo.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

const schemas = [serviceSchema, faqSchema];

const breadcrumbs = [
  { label: 'Inicio', href: '/pe/' },
  { label: 'Expert Interview', href: '/pe/entrevista-experto/' },
];

const archetypes = [
  { name: 'Contrarian', extracts: 'Creencias que separan a su SME de la opinión commodity sobre el tema', useFor: 'Secciones de Information Gain' },
  { name: 'Data concreta', extracts: 'Clientes nombrados, cifras específicas, data de resultado que los LLMs citan textualmente', useFor: 'Contenido de caso de estudio' },
  { name: 'Experience', extracts: 'Observaciones en primera persona: lo que el manual no dice', useFor: 'Hero sections de páginas de servicio' },
  { name: 'Límites de alcance', extracts: 'Advertencias y descalificadores: a quién no aplica este consejo', useFor: 'Secciones FAQ que generan confianza' },
  { name: 'Detalle de workflow', extracts: 'Detalle procedural: primeros 15 minutos de una cita o caso real', useFor: 'Cápsulas how-to, listas ordenadas' },
  { name: 'Historia de fracaso', extracts: 'Vulnerabilidad y lección aprendida de un caso que salió mal', useFor: 'Señal de confianza (raro en contenido de competidores)' },
  { name: 'Trend delta', extracts: 'Cambio de industria de 2-3 años que el SME ve y los pares no', useFor: 'Señal de freshness' },
  { name: 'Framework con nombre', extracts: 'Metodología formal o informal que el SME aplica a cada cliente', useFor: 'Spine de página de servicio, diferenciador' },
  { name: 'Mantras', extracts: 'Frases textuales de 1 línea que el SME repite en cada consulta', useFor: 'Pull quotes, aperturas de sección' },
  { name: 'Gancho de testimonio', extracts: 'Citas de clientes sobre el tema, con fuente y estado de atribución', useFor: 'Sidebars de caso de estudio' },
];

const processSteps = [
  { num: 1, title: 'Selección de tema (Día 1)', body: 'Confirmar 1 tema o área de servicio que cubrirá la entrevista. Más angosto es mejor: "cómo diagnosticamos molares rajadas" vence a "cómo hacemos odontología".' },
  { num: 2, title: 'Absorción de material (Día 2, Deep Dive)', body: 'Leer material público existente del SME (posts de LinkedIn, podcasts, artículos como invitado). Anotar los 3-5 puntos más importantes para evitar repreguntar.' },
  { num: 3, title: 'Entrevista en vivo (Día 3)', body: '45 o 90 minutos con el SME. Una pregunta a la vez, máximo 1 follow-up por arquetipo, captura textual para números y términos técnicos.' },
  { num: 4, title: 'Pase de cumplimiento YMYL (Día 4)', body: 'Para rubros regulados, marcar afirmaciones que activan las reglas de compliance. Los flags surgen para los creadores de contenido; no son un bloqueo.' },
  { num: 5, title: 'Síntesis del archivo (Día 5)', body: 'Entrevista compilada al formato canónico. Decisiones de atribución registradas por cita y por caso. Registro de uso inicializado vacío.' },
  { num: 6, title: 'Entrega (Día 6-7)', body: 'Archivo guardado. Llamada de handoff de 15 minutos si su equipo de contenido quiere un walkthrough.' },
];

const relatedLinks = [
  { title: 'SME Expertise Library', href: '/pe/biblioteca-experto/' },
  { title: 'Content Marketing', href: '/pe/marketing-contenidos-lima/' },
  { title: 'Optimización para IA', href: '/pe/busqueda-ia-lima/' },
  { title: '¿Aparece en Google?', href: '/pe/apareces-en-google/' },
];
---

<BaseLayout title={title} description={description} locale="pe" schema={schemas}>
  <Fragment slot="head">
    <link rel="alternate" hreflang="en" href="https://starkrank.com/services/expert-interview/" />
    <link rel="alternate" hreflang="de" href="https://starkrank.com/de/expert-interview/" />
    <link rel="alternate" hreflang="de-CH" href="https://starkrank.com/ch-de/expert-interview/" />
    <link rel="alternate" hreflang="es-PE" href="https://starkrank.com/pe/entrevista-experto/" />
    <link rel="alternate" hreflang="x-default" href="https://starkrank.com/services/expert-interview/" />
  </Fragment>

  <!-- Hero -->
  <Section bg="cream">
    <Breadcrumbs items={breadcrumbs} />

    <span class="text-xs font-label font-semibold uppercase tracking-[0.2em] text-blue mb-3 block">
      Content &amp; Copywriting
    </span>
    <h1 class="text-4xl md:text-5xl font-headline font-black tracking-tight text-navy">
      Expert Interview — Experticia de Primera Mano Que la AI No Puede Falsificar
    </h1>
    <p class="mt-4 text-lg text-gray font-body leading-relaxed max-w-3xl">
      El contenido que gana citaciones de AI en 2026 contiene información que los LLMs no pueden generar desde su data de entrenamiento: el caso donde un cliente específico recuperó $47K, la posición contraria que su fundador defiende en cada consulta, el fracaso que reformó cómo su equipo diagnostica problemas. Un Expert Interview captura las 3-8 piezas de material de primera mano que hacen su contenido inconfundiblemente suyo. De S/ 700 a S/ 1,275 por tema, por SME.
    </p>

    <div class="mt-8 flex flex-wrap gap-4">
      <Button href="/pe/contacto/" variant="primary" size="lg">Reserve un Expert Interview</Button>
      <Button href="#whats-extracted" variant="ghost" size="lg">Qué se extrae</Button>
    </div>

    <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs font-body text-gray">
      <span>Última actualización: <time datetime="2026-04-19">abril 2026</time></span>
      <span>Por <a href="/about/" class="text-blue hover:text-blue-light font-semibold">Wilko Feye</a>, StarkRank</span>
    </div>
  </Section>

  <!-- Main + sidebar -->
  <section class="bg-white">
    <div class="max-w-7xl mx-auto px-6 py-16 md:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <div class="lg:col-span-2 space-y-0">

          <div class="pb-14">
            <h2 class="text-2xl md:text-3xl font-headline font-black text-navy tracking-tight mb-6">
              ¿Por qué la experticia de primera mano supera al contenido AI commodity?
            </h2>
            <div class="space-y-4 text-base font-body text-gray leading-relaxed">
              <p>Google Search Quality Rater Guidelines y los sistemas de citación LLM premian contenido que demuestra Experience: observaciones en primera persona, resultados con cifras específicas y detalle de workflow que un resumen de training data no puede inventar.</p>
              <p>El contenido AI commodity se ve pulido pero se lee genérico. Un Expert Interview captura material imposible de sintetizar: clientes, cifras, fracasos y posiciones contrarias.</p>
            </div>
          </div>

          <div id="whats-extracted" class="pt-14 pb-14 border-t border-gray-light/30">
            <h2 class="text-2xl md:text-3xl font-headline font-black text-navy tracking-tight mb-4">
              ¿Qué material extrae un Expert Interview?
            </h2>
            <p class="text-base font-body text-gray leading-relaxed mb-8">
              Cada entrevista produce un archivo markdown estructurado con alcance de 1 tema o área de servicio, cubriendo 2-4 de 10 arquetipos de preguntas elegidos para la iniciativa de contenido específica. La profundidad vence a la amplitud, y el tiempo del SME es la restricción.
            </p>
            <div class="overflow-x-auto">
              <table class="w-full text-sm font-body border-collapse">
                <thead>
                  <tr class="border-b-2 border-navy/20">
                    <th class="text-left py-3 pr-4 font-headline font-bold text-navy">Arquetipo</th>
                    <th class="text-left py-3 pr-4 font-headline font-bold text-navy">Qué extrae</th>
                    <th class="text-left py-3 font-headline font-bold text-navy">Ideal para</th>
                  </tr>
                </thead>
                <tbody>
                  {archetypes.map((a) => (
                    <tr class="border-b border-gray-light/40">
                      <td class="py-3 pr-4 font-semibold text-dark align-top whitespace-nowrap">{a.name}</td>
                      <td class="py-3 pr-4 text-gray leading-relaxed align-top">{a.extracts}</td>
                      <td class="py-3 text-gray leading-relaxed align-top">{a.useFor}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <div class="pt-14 pb-14 border-t border-gray-light/30">
            <h2 class="text-2xl md:text-3xl font-headline font-black text-navy tracking-tight mb-6">
              ¿Cómo se ve una sesión de entrevista en vivo?
            </h2>
            <div class="space-y-4 text-base font-body text-gray leading-relaxed">
              <p>Las entrevistas duran 45-90 minutos (teléfono, video o presencial) cubriendo 2-4 arquetipos elegidos por adelantado. Hacemos 1 pregunta a la vez y esperamos la respuesta completa. Cuestionamos respuestas vagas hasta obtener una cifra concreta, un caso específico o un momento de decisión. Capturamos frases textuales para cualquier cosa que el SME diga con precisión.</p>
            </div>
          </div>

          <div class="pt-14 pb-14 border-t border-gray-light/30">
            <h2 class="text-2xl md:text-3xl font-headline font-black text-navy tracking-tight mb-6">
              ¿Qué pasa si su SME ya ha sido entrevistado públicamente?
            </h2>
            <div class="space-y-4 text-base font-body text-gray leading-relaxed">
              <p>Primero leemos el material público (posts largos de LinkedIn, podcasts, charlas, artículos como invitado) y evitamos pedirle al SME que repita lo que ya está en registro. Indagamos por lo que falta: el caso específico detrás de una afirmación pública, la visión contraria discutida en privado pero suavizada en público, la historia de fracaso referenciada pero no detallada. El tiempo en vivo se dedica a profundidad no publicada.</p>
            </div>
          </div>

          <div class="pt-14 pb-14 border-t border-gray-light/30">
            <h2 class="text-2xl md:text-3xl font-headline font-black text-navy tracking-tight mb-6">
              ¿Qué es el pase de cumplimiento YMYL?
            </h2>
            <div class="space-y-4 text-base font-body text-gray leading-relaxed">
              <p>Para rubros dentales, legales, médicos, asesoría financiera y salud, marcamos durante la entrevista afirmaciones que suenan a "garantizado", "especialista" sin board-cert, "ganamos $X", "cura", "off-label" o afirmaciones de resultado sin descargo. No filtramos las palabras del SME: el flag surge para que los creadores de contenido reformulen durante el drafting. Detalles que identifican al paciente o cliente se capturan solo con consentimiento explícito, documentado por cita y por caso.</p>
            </div>
          </div>

          <div id="deliverables" class="pt-14 pb-14 border-t border-gray-light/30">
            <h2 class="text-2xl md:text-3xl font-headline font-black text-navy tracking-tight mb-6">
              ¿Qué recibe con un Expert Interview?
            </h2>
            <p class="text-base font-body text-gray leading-relaxed mb-6">
              Un archivo markdown estructurado organizado por arquetipo. El archivo es autocontenido, versionado por fecha (nunca sobrescrito) y listo para que los briefs de contenido aguas abajo lo referencien.
            </p>
            <ul class="space-y-3 list-none pl-0 text-base font-body text-gray leading-relaxed">
              <li class="flex items-start gap-3"><span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span><span><strong class="text-dark">Archivo de entrevista estructurado</strong> — 2-4 secciones de arquetipo con citas textuales y detalle específico del caso</span></li>
              <li class="flex items-start gap-3"><span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span><span><strong class="text-dark">Tabla de ejemplos concretos</strong> — cada afirmación numérica capturada con resultado y estado de atribución</span></li>
              <li class="flex items-start gap-3"><span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span><span><strong class="text-dark">Reservorio de citas crudas</strong> — citas punchy con opinión densa, aptas para bookends y pull quotes</span></li>
              <li class="flex items-start gap-3"><span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span><span><strong class="text-dark">Frases citables y mantras</strong> — frases textuales de 1 oración que el SME repite en su trabajo</span></li>
              <li class="flex items-start gap-3"><span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span><span><strong class="text-dark">Detalle de workflow (lista ordenada)</strong> — spine procedural para cápsulas de contenido "Cómo hacer..."</span></li>
              <li class="flex items-start gap-3"><span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span><span><strong class="text-dark">Frameworks con nombre</strong> — si aplica, la metodología formal del SME para el tema</span></li>
              <li class="flex items-start gap-3"><span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span><span><strong class="text-dark">Flags de cumplimiento YMYL</strong> — afirmaciones marcadas por severidad con reformulación sugerida</span></li>
              <li class="flex items-start gap-3"><span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span><span><strong class="text-dark">Registro de atribución</strong> — estado de consentimiento por cita, registrado para referencia del equipo</span></li>
            </ul>
          </div>

        </div>

        <!-- Sidebar -->
        <aside class="lg:col-span-1">
          <div class="lg:sticky lg:top-8 space-y-6">
            <div class="bg-cream border border-gray-light/40 rounded-lg p-6">
              <p class="text-xs font-label font-bold uppercase tracking-widest text-blue mb-4">Ideal para</p>
              <div class="space-y-2 text-sm font-body text-gray">
                <div class="flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-blue shrink-0"></span><span>Prácticas lideradas por el fundador</span></div>
                <div class="flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-blue shrink-0"></span><span>Directores clínicos</span></div>
                <div class="flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-blue shrink-0"></span><span>Consultores independientes</span></div>
                <div class="flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-blue shrink-0"></span><span>Marcas apoyadas por ghostwriter</span></div>
              </div>
            </div>

            <div class="bg-cream border border-gray-light/40 rounded-lg p-6">
              <p class="text-xs font-label font-bold uppercase tracking-widest text-blue mb-2">Formato</p>
              <p class="text-sm font-body text-gray">10 arquetipos de preguntas · Alcance de tema (1 área de servicio por archivo) · Alimenta briefs de contenido y la dimensión Experience de E-E-A-T</p>
            </div>

            <div>
              <h3 class="text-xs font-label font-bold uppercase tracking-widest text-blue mb-4">Servicios relacionados</h3>
              <div class="space-y-3">
                {relatedLinks.map((r) => (
                  <Card href={r.href}>
                    <h4 class="text-sm font-headline font-bold text-navy">{r.title}</h4>
                  </Card>
                ))}
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <Section bg="cream">
    <SectionHeader label="Precios" title="¿Cuánto cuesta un Expert Interview?" />
    <p class="text-base font-body text-gray leading-relaxed max-w-3xl mb-10">
      Los precios escalan con profundidad de entrevista. Los batches multi-tema reciben 20% de descuento. Clientes del retainer de contenido las reciben incluidas en onboarding.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-white border border-gray-light/40 rounded-lg p-6 flex flex-col">
        <h3 class="text-lg font-headline font-black text-navy mb-2">Standard</h3>
        <p class="text-xs font-label font-semibold uppercase tracking-widest text-blue mb-4">1 tema, 2 arquetipos</p>
        <ul class="space-y-2 text-sm font-body text-gray mb-6 flex-1">
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">·</span> 45 minutos de entrevista</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">·</span> 2 arquetipos</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">·</span> Pase de cumplimiento YMYL</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">·</span> Decisiones de atribución</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">·</span> Archivo de salida estructurado</li>
        </ul>
        <p class="text-2xl font-headline font-black text-navy mb-4">S/ 700</p>
        <Button href="/pe/contacto/" variant="primary" size="md">Reservar Standard</Button>
      </div>

      <div class="bg-white border-2 border-blue rounded-lg p-6 flex flex-col">
        <h3 class="text-lg font-headline font-black text-navy mb-2">Deep Dive</h3>
        <p class="text-xs font-label font-semibold uppercase tracking-widest text-blue mb-4">1 tema, 4 arquetipos</p>
        <ul class="space-y-2 text-sm font-body text-gray mb-6 flex-1">
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">·</span> 90 minutos de entrevista</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">·</span> 4 arquetipos</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">·</span> Prep de material previo</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">·</span> Pase de cumplimiento YMYL</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">·</span> Archivo de salida estructurado</li>
        </ul>
        <p class="text-2xl font-headline font-black text-navy mb-4">S/ 1,275</p>
        <Button href="/pe/contacto/" variant="primary" size="md">Reservar Deep Dive</Button>
      </div>

      <div class="bg-white border border-gray-light/40 rounded-lg p-6 flex flex-col">
        <h3 class="text-lg font-headline font-black text-navy mb-2">Batch</h3>
        <p class="text-xs font-label font-semibold uppercase tracking-widest text-blue mb-4">3+ temas o 2+ SMEs</p>
        <ul class="space-y-2 text-sm font-body text-gray mb-6 flex-1">
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">·</span> 45-90 min por sesión</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">·</span> Arquetipos varían por tema</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">·</span> Prep de material compartida</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">·</span> Archivo estructurado por tema</li>
        </ul>
        <p class="text-2xl font-headline font-black text-navy mb-4">20% descuento</p>
        <Button href="/pe/contacto/" variant="primary" size="md">Consultar por Batch</Button>
      </div>
    </div>
  </Section>

  <!-- Process -->
  <Section bg="white">
    <SectionHeader label="Proceso" title="¿Cómo funciona el engagement?" />
    <p class="text-base font-body text-gray leading-relaxed max-w-3xl mb-10">
      El engagement se ejecuta en 6 o 7 días hábiles y seis fases. La entrega está lista 5-7 días después de la entrevista.
    </p>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {processSteps.map((step) => (
        <div class="bg-cream border border-gray-light/40 rounded-lg p-6">
          <div class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-blue text-white font-headline font-bold mb-4">{step.num}</div>
          <h3 class="text-base font-headline font-bold text-navy mb-2">{step.title}</h3>
          <p class="text-sm font-body text-gray leading-relaxed">{step.body}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- FAQ -->
  <Section bg="cream">
    <SectionHeader label="FAQ" title="¿Qué preguntan los clientes con más frecuencia?" />
    <div class="max-w-3xl space-y-6">
      {faqItems.map((item) => (
        <details class="group bg-white border border-gray-light/40 rounded-lg">
          <summary class="flex items-center justify-between gap-4 cursor-pointer p-6 font-headline font-bold text-navy text-base md:text-lg select-none">
            {item.question}
            <svg class="w-5 h-5 shrink-0 text-blue transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
          </summary>
          <div class="px-6 pb-6 text-sm font-body text-gray leading-relaxed">
            {item.answer}
          </div>
        </details>
      ))}
    </div>
  </Section>

  <!-- CTA -->
  <CTABanner bg="navy" title="¿Listo para capturar la experticia que la AI no puede falsificar?" subtitle="Toda marca liderada por su fundador se asienta sobre casos de estudio, visiones contrarias e historias de fracaso que nunca llegan al contenido. Un Expert Interview captura 3-8 piezas por sesión y entrega un archivo estructurado del que su motor de contenido puede tomar material por meses.">
    <Button href="/pe/contacto/" variant="primary" size="lg">Reserve un Expert Interview</Button>
    <Button href="/pe/biblioteca-experto/" variant="secondary" size="lg">Consultar por SME Library</Button>
  </CTABanner>
</BaseLayout>
