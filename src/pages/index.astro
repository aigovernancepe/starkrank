---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/ui/HeroSection.astro';
import Section from '../components/ui/Section.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import PillarCard from '../components/ui/PillarCard.astro';
import BuildingGraphicStatic from '../components/ui/BuildingGraphicStatic.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import CTASplit from '../components/ui/CTASplit.astro';
import { getLocalizedPillars } from '../data/pillars';

const pillars = getLocalizedPillars('de');

const pillarAnchorLinks: Record<string, string> = {
  'search-ai-intelligence': '/services/#search-ai-intelligence',
  'performance-media': '/services/#performance-media',
  'authority-pr': '/services/#authority-pr',
  'content-copywriting': '/services/#content-copywriting',
  'data-web': '/services/#data-web',
};

// Audience entry points — scalable container; add a market = one array entry.
const markets = [
  {
    label: 'B2B, Hersteller & Industrie',
    href: '/b2b-seo/',
    description:
      'Für Industrie-, Technologie- und Hersteller-Unternehmen mit erklärungsbedürftigen Produkten und mehrköpfigen Buying-Centern. Wir machen Sie dort sichtbar, wo Beschaffungsentscheidungen heute beginnen — in Google und in KI-Antworten, messbar über unseren eigenentwickelten AI Search Optimization Score.',
  },
];

const faqs = [
  {
    q: 'Was ist KI-Suchoptimierung — und warum reicht klassisches SEO nicht mehr?',
    a: 'KI-Suchoptimierung macht Ihre Marke dort sichtbar, wo immer mehr Kaufentscheidungen beginnen: in KI-Antworten von ChatGPT, Perplexity, Google AI Overviews und Copilot. Klassisches SEO optimiert für blaue Links — wir optimieren zusätzlich dafür, dass Sprachmodelle Ihre Inhalte verstehen, einordnen und zitieren. Beides messen wir mit unserem eigenentwickelten AI Search Optimization Score.',
  },
  {
    q: 'Was kostet die Zusammenarbeit mit StarkRank?',
    a: 'Transparent und ohne versteckte Stunden. Laufende SEO-Retainer beginnen bei 990 €/Monat für kleinere Unternehmen, der Mittelstands-Retainer ab 2.000 €/Monat. Einmalige Audits gibt es gestaffelt nach Site-Größe ab 1.500 €. Die genauen Bänder stehen offen auf unserer Preisseite — Sie kennen die Kosten, bevor wir das erste Gespräch führen.',
  },
  {
    q: 'Wie läuft ein Projekt mit StarkRank ab?',
    a: 'Als Zyklus, nicht als einmaliger Relaunch. Wir starten mit Analyse, leiten daraus eine priorisierte Strategie ab, setzen um — SEO, Content, Performance Media — und messen monatlich. Was wirkt, skalieren wir; was nicht wirkt, fliegt raus. Die Daten aus jeder Runde schärfen die nächste, statt im Schubladen-Report zu enden.',
  },
  {
    q: 'Was ist der kostenlose AI-Search-Check?',
    a: 'Eine schnelle, kostenlose Ersteinschätzung: Wir zeigen Ihnen, wie sichtbar Ihre Marke heute in klassischer Suche und in KI-Antworten ist und wo der größte Hebel liegt. Er ersetzt kein vollständiges SEO-Audit — das ist die bezahlte, tiefe Analyse über sechs Dimensionen — sondern hilft Ihnen einzuschätzen, ob sich ein Gespräch lohnt.',
  },
  {
    q: 'Für welche Unternehmen ist StarkRank gemacht?',
    a: 'Für B2B-Unternehmen, Mittelstand und IT-Dienstleister, die Suche als echten Wachstumskanal betreiben wollen — nicht für monatliche Ranking-Reports ohne Wirkung. Wir sitzen im Raum Hannover und arbeiten im ganzen Nordwesten, betreuen erklärungsbedürftige Produkte und Dienstleistungen mit längeren Kaufzyklen. Wenn Sichtbarkeit bei Ihnen Umsatz bedeutet, passen wir gut zusammen.',
  },
  {
    q: 'Arbeitet StarkRank mit festen Verträgen oder flexibel?',
    a: 'Beides — laufender Retainer oder klar abgegrenztes Projekt. Für Retainer empfehlen wir mindestens sechs Monate, weil SEO-Effekte Zeit brauchen, bis Google sie in Rankings übersetzt. Viele starten mit einem einmaligen Audit als Baseline und gehen danach in den Retainer über; der Audit-Preis wird nicht angerechnet.',
  },
];

const processSteps = [
  {
    num: '01',
    title: 'Analyse',
    body: 'AI Search Optimization Check, Keyword-Mapping und Wettbewerbsvergleich. Wo steht Ihre Marke heute in klassischer Suche und in KI-Antworten — und was genau bremst sie?',
  },
  {
    num: '02',
    title: 'Strategie',
    body: 'Priorisierte Roadmap mit messbaren Zielen, Budget- und Zeitrahmen. Welche Hebel bewegen in den nächsten 90 Tagen den größten Teil des Umsatzes?',
  },
  {
    num: '03',
    title: 'Umsetzung',
    body: 'SEO, Google Ads, Content, Digital PR, Analytics — laufend im Retainer oder projektbasiert. Keine Blackbox: jede Maßnahme mit nachvollziehbarem Warum.',
  },
  {
    num: '04',
    title: 'Messung & Anpassung',
    body: 'Monatliche Daten, Quartals-Review, Pivot wo nötig. Was nicht wirkt, fliegt. Was wirkt, skaliert. Zurück zu Schritt 01 mit neuer Datenlage.',
  },
];

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://starkrank.com/#organization',
  name: 'StarkRank',
  url: 'https://starkrank.com',
  logo: 'https://starkrank.com/SR-Logo-standard_high-res.png',
  description: 'Datengetriebene Digital-Marketing-Agentur mit Fokus auf KI-Suchoptimierung, technisches SEO und Performance-Marketing für den deutschen Mittelstand — Sitz im Raum Hannover.',
  sameAs: [
    'https://www.linkedin.com/company/starkrank',
    'https://www.wikidata.org/wiki/Q138764144',
    'https://www.crunchbase.com/organization/starkrank',
    'https://www.local.ch/de/d/oberwil-bl/4104/informatikdienstleistungen/starkrank-feye-KN9ZenQHAYQeeoIE6nM2SQ',
    'https://www.search.ch/tel/oberwil/langegasse-117/starkrank-feye',
  ],
  contactPoint: [
    {
      '@type': 'ContactPoint',
      email: 'info@starkrank.com',
      contactType: 'sales',
      areaServed: 'CH',
      availableLanguage: ['German', 'English'],
    },
    {
      '@type': 'ContactPoint',
      email: 'kontakt@starkrank.com',
      contactType: 'sales',
      areaServed: 'DE',
      availableLanguage: ['German', 'English'],
    },
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://starkrank.com/#website',
  name: 'StarkRank',
  url: 'https://starkrank.com',
  publisher: { '@id': 'https://starkrank.com/#organization' },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title="StarkRank — SEO & KI-Suchoptimierung für den Mittelstand"
  description="StarkRank unterstützt Unternehmen und den Mittelstand mit KI-Suchoptimierung, technischem SEO, Performance-Marketing und datengetriebenen Wachstumsstrategien — mit Sitz im Raum Hannover, aktiv im ganzen Nordwesten."
  locale="de"
  schema={[orgSchema, websiteSchema, faqSchema]}
>
  <HeroSection
    eyebrow="Stark in Search. Stark in Data. Stark in Growth."
    headline="Datenbasiertes Wachstum für das **KI-Zeitalter**"
    subheadline="StarkRank positioniert B2B-Unternehmen, Mittelstand und IT-Dienstleister für Sichtbarkeit in Suchmaschinen und KI-Plattformen — mit Sitz im Raum Hannover, aktiv im ganzen Nordwesten."
  >
    <Button href="/aiso-check/" variant="primary" size="lg">Kostenloser AI-Search-Check &rarr;</Button>
  </HeroSection>

  {/* Building-graphic: interactive on desktop, hidden on mobile */}
  <Section bg="cream">
    <SectionHeader
      label="Unsere Dienstleistungen"
      title="Fünf Bausteine des digitalen Wachstums"
      subtitle="Vier Disziplinen tragen das Wachstum Ihres Unternehmens — auf einem Fundament aus Daten und Web-Architektur."
      align="center"
    />
    <div class="hidden md:block">
      <BuildingGraphicStatic />
    </div>

    {/* Detailed pillar cards — on mobile these carry the whole metaphor (no SVG).
        Pillars in 2-col grid on md+, foundation (Daten & Web) spans full width. */}
    <div class="mt-8 md:mt-16 grid grid-cols-1 md:grid-cols-2 gap-6">
      {pillars.filter((p) => p.id !== 'data-web').map((pillar) => (
        <div id={`card-${pillar.id}`} data-pillar-id={pillar.id} class="pillar-card-wrapper">
          <PillarCard pillar={pillar} locale="de" href={pillarAnchorLinks[pillar.id]} />
        </div>
      ))}
      {pillars.filter((p) => p.id === 'data-web').map((pillar) => (
        <div id={`card-${pillar.id}`} data-pillar-id={pillar.id} class="pillar-card-wrapper md:col-span-2">
          <PillarCard pillar={pillar} locale="de" href={pillarAnchorLinks[pillar.id]} variant="foundation" />
        </div>
      ))}
    </div>
  </Section>

  {/* Audience entry points — scalable container, grows to a grid as verticals ship */}
  <Section bg="white">
    <SectionHeader
      label="Für Ihren Markt"
      title="Spezialisierte Lösungen für Ihre Branche"
      subtitle="Manche Märkte brauchen mehr als Standard-SEO. Wir gehen pro Segment in die Tiefe — mit Sichtbarkeit, die zu Ihren Kaufzyklen und Entscheidern passt."
      align="center"
    />
    <div class="mt-10 flex flex-wrap justify-center gap-6 max-w-5xl mx-auto">
      {markets.map((m) => (
        <Card href={m.href} class="w-full md:max-w-md">
          <h3 class="text-lg font-headline font-bold text-navy">{m.label}</h3>
          <p class="mt-3 text-sm font-body text-gray leading-relaxed">{m.description}</p>
        </Card>
      ))}
    </div>
  </Section>

  {/* Iterative process section — circular feedback loop */}
  <Section bg="cream">
    <SectionHeader
      label="Wie wir arbeiten"
      title="Ein Zyklus, kein Projekt"
      subtitle="Digitales Marketing ist kein einmaliger Relaunch. Es ist ein iterativer Prozess aus Analyse, Strategie, Umsetzung und Messung — mit Anpassungen auf Basis echter Daten."
      align="center"
    />
    <div class="mt-10 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 relative">
      {processSteps.map((step, idx) => (
        <div class="bg-white border border-gray-light/40 rounded-lg p-6 relative">
          <span class="text-xs font-label font-semibold uppercase tracking-[0.2em] text-blue">Schritt {step.num}</span>
          <h3 class="mt-2 text-lg font-headline font-bold text-navy">{step.title}</h3>
          <p class="mt-3 text-sm font-body text-gray leading-relaxed">{step.body}</p>
          {idx < processSteps.length - 1 && (
            <svg class="hidden lg:block absolute -right-4 top-1/2 -translate-y-1/2 w-6 h-6 text-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          )}
        </div>
      ))}
    </div>
    <div class="mt-8 flex items-center justify-center gap-3 text-sm font-label font-semibold uppercase tracking-wide text-blue">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v6h6M20 20v-6h-6M4 10a8 8 0 0114-4M20 14a8 8 0 01-14 4" />
      </svg>
      <span>Daten aus Schritt 04 fließen zurück in Schritt 01 — jeder Zyklus wird schärfer.</span>
    </div>
  </Section>

  {/* Pricing-transparency callout */}
  <Section bg="white">
    <div class="max-w-3xl mx-auto text-center">
      <span class="text-xs font-label font-semibold uppercase tracking-[0.2em] text-blue">Transparente Preise</span>
      <h2 class="mt-3 text-2xl md:text-3xl font-headline font-black text-navy">Wissen, was es kostet — bevor wir reden</h2>
      <p class="mt-4 text-base font-body text-gray leading-relaxed">Klare Retainer-Bänder ohne versteckte Stunden. Schauen Sie sich die Preisstruktur an, bevor Sie ein Erstgespräch buchen.</p>
      <div class="mt-8 flex flex-wrap gap-4 justify-center">
        <Button href="/preise/seo/" variant="primary" size="lg">SEO-Preise ansehen &rarr;</Button>
        <Button href="/services/" variant="outline" size="lg">Alle Services ansehen</Button>
      </div>
    </div>
  </Section>

  {/* FAQ / Capsule — top-of-funnel objection handling, feeds FAQPage schema */}
  <Section bg="cream">
    <SectionHeader
      label="Fragen & Antworten"
      title="Häufig gestellte Fragen"
      align="center"
    />
    <dl class="mt-8 space-y-8 max-w-3xl mx-auto">
      {faqs.map((f) => (
        <div>
          <dt class="text-lg font-headline font-bold text-navy">{f.q}</dt>
          <dd class="mt-2 text-base font-body text-gray leading-relaxed">{f.a}</dd>
        </div>
      ))}
    </dl>
  </Section>

  <CTASplit
    eyebrow="Erstgespräch"
    title="Bereit zu wachsen?"
    subtitle="Buchen Sie eine kostenlose Erstberatung — unverbindlich, ohne Verkaufsdruck. Wir hören erst zu, bevor wir etwas vorschlagen."
    image="/images/home-cta.webp"
    imageAlt="StarkRank-Team im Erstgespräch — drei Berater im offenen Austausch mit Kaffee."
    imagePosition="center top"
  >
    <Button href="/kontakt/" variant="primary" size="lg">Kontaktieren Sie uns</Button>
  </CTASplit>
</BaseLayout>
