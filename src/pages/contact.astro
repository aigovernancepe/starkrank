---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/ui/HeroSection.astro';
import Section from '../components/ui/Section.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Button from '../components/ui/Button.astro';
import ContactForm from '../components/ui/ContactForm.astro';
---

<BaseLayout
  title="Contact StarkRank — Get in Touch"
  description="Ready to grow? Contact StarkRank for a free consultation on AI search optimisation, SEO, PPC, and digital marketing services."
  noViewTransitions
>
  <HeroSection
    headline="Get in Touch"
    subheadline="Ready to grow? Let's talk about your digital strategy."
  />

  <Section bg="cream">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
      <div>
        <SectionHeader label="Send a Message" title="Tell Us About Your Goals" />
        <ContactForm locale="en" />
      </div>

      <div>
        <SectionHeader label="Our Locations" title="Find Us Worldwide" />
        <div class="space-y-8">
          {/* United States */}
          <div class="border-b border-gray-light/40 pb-6">
            <h3 class="text-lg font-headline font-black text-navy">United States</h3>
            <p class="mt-1 text-sm font-body text-gray">South Florida</p>
            <a href="mailto:contact@starkrank.com" class="mt-1 text-sm font-body text-blue hover:text-blue-light">
              contact@starkrank.com
            </a>
            <div class="mt-3 flex items-center gap-3">
              <a href="#" title="BBB" target="_blank" rel="noopener noreferrer" class="text-gray hover:text-navy transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-label="Better Business Bureau">
                  <path d="M3 4h5.5c1.4 0 2.5.5 3 1.3.4.6.5 1.2.5 1.9 0 1.2-.6 2-1.5 2.5 1.2.4 2 1.4 2 2.8 0 1-.4 1.8-1 2.4-.8.7-1.9 1.1-3.2 1.1H3V4zm3 4.8h2.2c.8 0 1.3-.4 1.3-1.1 0-.7-.5-1.1-1.3-1.1H6v2.2zm0 5h2.5c.9 0 1.5-.5 1.5-1.2s-.6-1.2-1.5-1.2H6v2.4zM14 4h5.5c1.4 0 2.5.5 3 1.3.4.6.5 1.2.5 1.9 0 1.2-.6 2-1.5 2.5 1.2.4 2 1.4 2 2.8 0 1-.4 1.8-1 2.4-.8.7-1.9 1.1-3.2 1.1H14V4zm3 4.8h2.2c.8 0 1.3-.4 1.3-1.1 0-.7-.5-1.1-1.3-1.1H17v2.2zm0 5h2.5c.9 0 1.5-.5 1.5-1.2s-.6-1.2-1.5-1.2H17v2.4z"/>
                </svg>
              </a>
              <a href="#" title="Yelp" target="_blank" rel="noopener noreferrer" class="text-gray hover:text-navy transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-label="Yelp">
                  <path d="M11.3 2c-.2 0-.4.1-.5.3L7.1 11c-.2.3 0 .7.3.8l3 1.2c.3.1.6 0 .8-.3l.7-1.5V3c0-.6-.3-1-.6-1zm-1 13.3c-.1-.3-.4-.5-.7-.4l-3.2.7c-.4.1-.5.5-.3.8l2 3c.2.2.5.3.8.1l1.3-.9c.3-.2.3-.5.2-.8l-.1-2.5zm2.4 1.5c-.3-.2-.6-.1-.8.1l-1.8 2.7c-.2.3-.1.7.3.8l3.3.8c.3.1.6-.1.7-.4l.2-1.5c0-.3-.2-.6-.5-.7l-1.4-.8zm3.5-3.2l-2.8 1.5c-.3.1-.4.5-.2.8l1.7 2.5c.2.3.6.3.9.1l2.5-2.2c.3-.2.3-.6.1-.9l-1.4-1.5c-.2-.2-.5-.3-.8-.3zm.5-3.3c-.3-.1-.7 0-.8.3l-1.2 3c-.1.3.1.6.4.7l1.6.3h.1c.3 0 .6-.2.7-.5l.8-3.1c.1-.4-.2-.7-.6-.7z"/>
                </svg>
              </a>
              <a href="https://www.crunchbase.com/organization/starkrank" title="Crunchbase" target="_blank" rel="noopener noreferrer" class="text-gray hover:text-navy transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-label="Crunchbase">
                  <path d="M21.6 0H2.4C1.08 0 0 1.08 0 2.4v19.2C0 22.92 1.08 24 2.4 24h19.2c1.32 0 2.4-1.08 2.4-2.4V2.4C24 1.08 22.92 0 21.6 0zM7.045 14.465c.345.69 1.035 1.14 1.83 1.14.48 0 .93-.165 1.275-.45l1.17 1.38c-.69.57-1.545.87-2.445.87-2.31 0-4.02-1.86-4.02-4.02s1.71-4.02 4.02-4.02c.9 0 1.755.3 2.445.87l-1.17 1.38c-.345-.285-.795-.45-1.275-.45-.795 0-1.485.45-1.83 1.14-.15.3-.24.645-.24 1.08s.09.78.24 1.08zm9.54 1.56c-1.095 0-2.07-.525-2.655-1.365v1.2h-1.86V5.4h1.86v4.74c.585-.84 1.56-1.365 2.655-1.365 1.98 0 3.51 1.83 3.51 3.87s-1.53 3.78-3.51 3.78zm-.36-5.88c-1.2 0-2.19.93-2.19 2.1 0 1.17.99 2.1 2.19 2.1s2.1-.93 2.1-2.1c0-1.17-.9-2.1-2.1-2.1z"/>
                </svg>
              </a>
            </div>
          </div>

          {/* Other locations */}
          {[
            { region: 'Switzerland', address: 'Basel-Landschaft', email: 'info@starkrank.com' },
            { region: 'Germany', address: 'Hannover', email: 'kontakt@starkrank.com' },
            { region: 'Peru', address: 'Lima', email: 'contacto@starkrank.com' },
          ].map((office) => (
            <div class="border-b border-gray-light/40 pb-6">
              <h3 class="text-lg font-headline font-black text-navy">{office.region}</h3>
              <p class="mt-1 text-sm font-body text-gray">{office.address}</p>
              <a href={`mailto:${office.email}`} class="mt-1 text-sm font-body text-blue hover:text-blue-light">
                {office.email}
              </a>
            </div>
          ))}
        </div>
      </div>
    </div>
  </Section>

  <section class="w-full">
    <iframe
      title="StarkRank — South Florida"
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d459578.0746113371!2d-80.60283595!3d26.0852234!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x88d9a6365e1b619b%3A0x4e0101afb1ad4b5!2sSouth%20Florida%2C%20FL!5e0!3m2!1sen!2sus!4v1"
      width="100%"
      height="400"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
    ></iframe>
  </section>
</BaseLayout>
