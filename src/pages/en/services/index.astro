---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HeroSection from '../../../components/ui/HeroSection.astro';
import Section from '../../../components/ui/Section.astro';
import SectionHeader from '../../../components/ui/SectionHeader.astro';
import Card from '../../../components/ui/Card.astro';
import { getCollection } from 'astro:content';
import { pillars } from '../../../data/pillars';
import { getLocalizedNavHref } from '../../../data/navigation';

const allServices = await getCollection('services');

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://starkrank.com/' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://starkrank.com/en/services/' },
  ],
};
---

<BaseLayout
  schema={[breadcrumbSchema]}
  title="Digital Marketing Services — StarkRank"
  description="StarkRank's digital marketing services: AI search optimisation, technical SEO, Google Ads, digital PR, content marketing, and analytics."
>
  <HeroSection
    headline="Our Services"
    subheadline="Full-service digital growth, from AI search intelligence to transparent reporting."
    backgroundImage="/images/services-hero.webp"
    backgroundImageAlt="StarkRank team in detailed strategy discussion over a printed wireframe, daylight and city view through the window — three team members in focused exchange."
  />

  {pillars.map((pillar) => {
    const pillarServices = allServices.filter((s) => s.data.pillar === pillar.id);
    return (
      <Section bg={pillars.indexOf(pillar) % 2 === 0 ? 'cream' : 'white'} id={pillar.id} class="scroll-mt-20">
        <SectionHeader
          label={pillar.tagline}
          title={pillar.name}
          subtitle={pillar.description}
        />
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {pillarServices.map((service) => (
            <Card href={getLocalizedNavHref(`/services/${service.data.slug}/`, 'de')}>
              <h3 class="text-lg font-headline font-bold text-navy">{service.data.title}</h3>
              <p class="mt-2 text-sm font-body text-gray leading-relaxed">{service.data.description}</p>
            </Card>
          ))}
        </div>
      </Section>
    );
  })}
</BaseLayout>
