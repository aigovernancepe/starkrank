---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import CTABanner from '../../components/ui/CTABanner.astro';
import { getCollection, render } from 'astro:content';
import { getPillarById } from '../../data/pillars';
import { getSpokePath } from '../../data/service-slugs';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services
    .filter((service) => !['ai-search-optimization', 'seo-for-dentists', 'seo-for-law-firms', 'seo-for-auto-services', 'seo-for-med-spas', 'seo-for-home-services', 'multi-location-seo'].includes(service.data.slug))
    .map((service) => ({
      params: { slug: service.data.slug },
      props: { service },
    }));
}

const { service } = Astro.props;
const { Content } = await render(service);
const pillar = getPillarById(service.data.pillar);

const allServices = await getCollection('services');
const relatedServices = service.data.relatedServices
  ? allServices.filter((s) => service.data.relatedServices!.includes(s.data.slug))
  : [];

// EN cities that offer this service — for sidebar local page links
const allCities = await getCollection('cities');
const enCities = allCities
  .filter((c) => c.data.locale === 'en' && c.data.services.includes(service.data.slug))
  .map((c) => ({
    city: c.data.city,
    href: `/${getSpokePath(service.data.slug, c.data.citySlug, 'en')}/`,
  }));

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.data.title,
  description: service.data.description,
  provider: { '@id': 'https://starkrank.com/#organization' },
  url: `https://starkrank.com/services/${service.data.slug}/`,
};

const faq = service.data.faq ?? [];
const faqSchema = faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item: { question: string; answer: string }) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
} : null;

const schemas = [serviceSchema, ...(faqSchema ? [faqSchema] : [])];

const isAISO = service.data.slug === 'ai-search-optimization';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services/' },
  ...(pillar ? [{ label: pillar.name, href: `/services/${pillar.services[0]}/` }] : []),
  { label: service.data.title, href: `/services/${service.data.slug}/` },
];
---

<BaseLayout
  title={`${service.data.title} — StarkRank`}
  description={service.data.description}
  schema={schemas}
>
  <Section bg="cream">
    <Breadcrumbs items={breadcrumbs} />

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      <div class="lg:col-span-2">
        <span class="text-xs font-label font-semibold uppercase tracking-[0.2em] text-blue mb-3 block">
          {pillar?.tagline}
        </span>
        <h1 class="text-4xl md:text-5xl font-headline font-black tracking-tight text-navy">
          {service.data.title}
        </h1>
        <p class="mt-4 text-lg text-gray font-body leading-relaxed">
          {service.data.description}
        </p>

        <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs font-body text-gray">
          {service.data.updatedDate && (
            <span>
              Last updated: <time datetime={service.data.updatedDate.toISOString().split('T')[0]}>
                {service.data.updatedDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}
              </time>
            </span>
          )}
          <span>
            By <a href="/about/" class="text-blue hover:text-blue-light font-semibold">Wilko Feye</a>, StarkRank
          </span>
        </div>

        <div class="mt-8 prose prose-lg max-w-none font-body text-dark prose-numbered-cards prose-branded-bullets
          [&>h2]:text-2xl [&>h2]:md:text-3xl [&>h2]:font-headline [&>h2]:font-black [&>h2]:text-navy [&>h2]:tracking-tight [&>h2]:mt-14 [&>h2]:mb-4 [&>h2]:pt-6 [&>h2]:border-t [&>h2]:border-gray-light/30
          [&>p]:leading-relaxed [&>p]:text-gray [&>p]:mb-6
          [&_strong]:text-dark
          [&_a]:text-blue [&_a]:font-semibold [&_a:hover]:text-blue-light
          first:[&>h2]:mt-0 first:[&>h2]:pt-0 first:[&>h2]:border-t-0
          [&>ol]:space-y-4
          [&>ol>li]:bg-white [&>ol>li]:border [&>ol>li]:border-gray-light/40 [&>ol>li]:rounded-lg [&>ol>li]:p-5 [&>ol>li]:text-gray [&>ol>li]:text-base [&>ol>li]:leading-relaxed
          [&>ul]:space-y-3
          [&>ul>li]:text-gray [&>ul>li]:text-base [&>ul>li]:leading-relaxed">
          <Content />
        </div>

        {service.data.features && service.data.features.length > 0 && (
          <div class="mt-14 pt-6 border-t border-gray-light/30">
            <h2 class="text-xs font-label font-bold uppercase tracking-widest text-blue mb-6">What's Included</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {service.data.features.map((feature: string, i: number) => (
                <div class="flex items-start gap-3 bg-white border border-gray-light/40 rounded-lg p-4">
                  <span class="shrink-0 w-7 h-7 rounded-full bg-blue text-white flex items-center justify-center text-xs font-label font-bold">
                    {i + 1}
                  </span>
                  <span class="text-sm font-body text-dark pt-0.5">{feature}</span>
                </div>
              ))}
            </div>
          </div>
        )}

        <div class="mt-12">
          <Button href="/contact/" variant="primary" size="lg">{isAISO ? 'Request Your Free AI Visibility Assessment' : 'Get Started'}</Button>
        </div>
      </div>

      <!-- Sidebar -->
      <aside class="lg:col-span-1">
        <div class="lg:sticky lg:top-8">
          {relatedServices.length > 0 && (
            <div>
              <h3 class="text-xs font-label font-bold uppercase tracking-widest text-blue mb-4">Related Services</h3>
              <div class="space-y-3">
                {relatedServices.map((related) => (
                  <Card href={`/services/${related.data.slug}/`}>
                    <h4 class="text-sm font-headline font-bold text-navy">{related.data.title}</h4>
                  </Card>
                ))}
              </div>
            </div>
          )}

          {enCities.length > 0 && (
            <div class="mt-8">
              <h3 class="text-xs font-label font-bold uppercase tracking-widest text-blue mb-4">Local Pages</h3>
              <div class="space-y-3">
                {enCities.map((c) => (
                  <Card href={c.href}>
                    <h4 class="text-sm font-headline font-bold text-navy">{service.data.title} in {c.city}</h4>
                  </Card>
                ))}
              </div>
            </div>
          )}
        </div>
      </aside>
    </div>
  </Section>

  {faq.length > 0 && (
    <Section bg="white">
      <SectionHeader label="FAQ" title="Frequently Asked Questions" />
      <div class="max-w-3xl space-y-6">
        {faq.map((item: { question: string; answer: string }) => (
          <details class="group bg-cream border border-gray-light/40 rounded-lg">
            <summary class="flex items-center justify-between gap-4 cursor-pointer p-6 font-headline font-bold text-navy text-base md:text-lg select-none">
              {item.question}
              <svg class="w-5 h-5 shrink-0 text-blue transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
              </svg>
            </summary>
            <div class="px-6 pb-6 text-sm font-body text-gray leading-relaxed">
              {item.answer}
            </div>
          </details>
        ))}
      </div>
    </Section>
  )}

  {isAISO ? (
    <CTABanner bg="navy" title="How AI-Ready Is Your Website?" subtitle="Request a free initial assessment and find out where you stand — before your competitors do. For a comprehensive AISO Score audit, ask about our full diagnostic.">
      <Button href="/contact/" variant="primary" size="lg">Request Your Free Assessment</Button>
    </CTABanner>
  ) : (
    <CTABanner bg="navy" title="Ready to Grow?" subtitle="Book a free consultation to discuss your digital strategy.">
      <Button href="/contact/" variant="primary" size="lg">Contact Us</Button>
    </CTABanner>
  )}
</BaseLayout>
