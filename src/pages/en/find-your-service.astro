---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceFinderApp from '../../components/ServiceFinder/ServiceFinderApp';
import { en } from '../../data/service-finder/locales/en';

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Find Your Service',
  alternateName: ['Service Schnellcheck'],
  description: 'Find out which digital marketing services your business needs — in 60 seconds.',
  url: 'https://starkrank.com/en/find-your-service/',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  provider: { '@type': 'Organization', name: 'Datanalytico Feye', url: 'https://starkrank.com' },
  inLanguage: ['en', 'de'],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: en.faq.map(f => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

const hreflangAlternates = [
  { hreflang: 'en', href: 'https://starkrank.com/en/find-your-service/' },
  { hreflang: 'es-PE', href: 'https://starkrank.com/pe/diagnostico-rapido/' },
  { hreflang: 'de-DE', href: 'https://starkrank.com/schnellcheck/' },
  { hreflang: 'de-CH', href: 'https://starkrank.com/ch-de/schnellcheck/' },
  { hreflang: 'x-default', href: 'https://starkrank.com/en/find-your-service/' },
];
---

<BaseLayout
  title="Find Your Service — Free Digital Marketing Diagnostic | StarkRank"
  description="Answer 4 quick questions and discover which digital marketing services your business actually needs. Free, no sign-up required."
  locale="en"
  schema={[webAppSchema, faqSchema]}
>
  <Fragment slot="head">
    {hreflangAlternates.map(({ hreflang, href }) => (
      <link rel="alternate" hreflang={hreflang} href={href} />
    ))}
  </Fragment>

  <section class="max-w-3xl mx-auto px-4 pt-16 pb-8 text-center">
    <h1 class="text-3xl md:text-4xl mb-4">{en.intro.h1}</h1>
    <p class="text-lg text-gray max-w-2xl mx-auto mb-3">{en.intro.subheading}</p>
    <p class="text-sm text-gray">{en.intro.trustLine}</p>
  </section>

  <ServiceFinderApp client:visible locale={en} market="en" />

  <section class="max-w-3xl mx-auto px-4 py-16">
    <h2 class="text-2xl mb-8 text-center">Frequently Asked Questions</h2>
    {en.faq.map(item => (
      <details class="mb-4 bg-white rounded-lg border border-gray-light/40">
        <summary class="px-6 py-4 cursor-pointer font-headline font-bold text-navy text-[0.9375rem] list-none flex items-center justify-between">
          {item.question}
          <svg class="w-5 h-5 text-gray flex-shrink-0 ml-4 transition-transform" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
        </summary>
        <div class="px-6 pb-4 text-gray text-[0.875rem] leading-relaxed" set:html={item.answer} />
      </details>
    ))}
  </section>
</BaseLayout>
