---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HeroSection from '../../../components/ui/HeroSection.astro';
import Section from '../../../components/ui/Section.astro';
import SectionHeader from '../../../components/ui/SectionHeader.astro';
import CTABanner from '../../../components/ui/CTABanner.astro';
import Button from '../../../components/ui/Button.astro';
---

<BaseLayout
  title="Case Studies — StarkRank"
  description="See how StarkRank delivers measurable results through AI search optimisation, technical SEO, and performance media strategies."
>
  <HeroSection headline="Case Studies" subheadline="Proof of ROI. Real results from real clients." />

  <Section bg="cream">
    <SectionHeader label="Coming Soon" title="We're Building Something Great" align="center" />
    <p class="text-center text-lg font-body text-gray max-w-2xl mx-auto">
      Our case studies are currently being prepared. Check back soon to see detailed examples of how StarkRank drives measurable growth for businesses across the globe.
    </p>
  </Section>

  <CTABanner bg="navy" title="Want to Be Our Next Success Story?" subtitle="Let's discuss how we can drive results for your business.">
    <Button href="/en/contact/" variant="primary" size="lg">Get Started</Button>
  </CTABanner>
</BaseLayout>
