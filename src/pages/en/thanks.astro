---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/ui/HeroSection.astro';
import Button from '../../components/ui/Button.astro';
import { t } from '../../utils/i18n';
---

<BaseLayout
  title={`${t('thanks.title', 'en')} — StarkRank`}
  description={t('thanks.body', 'en')}
  locale="en"
  noViewTransitions
>
  <meta slot="head" name="robots" content="noindex" />
  <HeroSection
    headline={t('thanks.title', 'en')}
    subheadline={t('thanks.body', 'en')}
  >
    <Button href="/en/" variant="primary" size="lg">{t('thanks.cta', 'en')}</Button>
  </HeroSection>
</BaseLayout>
