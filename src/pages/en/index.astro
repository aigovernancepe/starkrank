---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/ui/HeroSection.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import PillarCard from '../../components/ui/PillarCard.astro';
import Button from '../../components/ui/Button.astro';
import CTABanner from '../../components/ui/CTABanner.astro';
import { pillars } from '../../data/pillars';

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://starkrank.com/#organization',
  name: 'StarkRank',
  url: 'https://starkrank.com',
  logo: 'https://starkrank.com/SR-Logo-standard_high-res.png',
  description: 'Data-driven digital marketing agency specialising in AI search optimisation, technical SEO, and performance media.',
  sameAs: [
    'https://www.linkedin.com/company/starkrank',
    'https://www.wikidata.org/wiki/Q138764144',
    'https://www.crunchbase.com/organization/starkrank',
  ],
  contactPoint: [
    {
      '@type': 'ContactPoint',
      email: 'info@starkrank.com',
      contactType: 'sales',
      areaServed: 'CH',
      availableLanguage: ['German', 'English'],
    },
    {
      '@type': 'ContactPoint',
      email: 'kontakt@starkrank.com',
      contactType: 'sales',
      areaServed: 'DE',
      availableLanguage: ['German', 'English'],
    },
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://starkrank.com/#website',
  name: 'StarkRank',
  url: 'https://starkrank.com',
  publisher: { '@id': 'https://starkrank.com/#organization' },
};
---

<BaseLayout
  title="StarkRank — Data-Driven Growth for the AI Era"
  description="StarkRank is a global digital marketing agency specialising in AI search optimisation, technical SEO, performance ads, and data-driven growth strategies."
  schema={[orgSchema, websiteSchema]}
>
  <HeroSection
    headline="Data-Driven Growth for the **AI Era**"
    subheadline="We optimise your brand for search engines, AI platforms, and the humans behind both."
  >
    <Button href="/services/" variant="primary" size="lg">View Services</Button>
    <Button href="/contact/" variant="secondary" size="lg">Get in Touch</Button>
  </HeroSection>

  <Section bg="cream">
    <SectionHeader
      label="What We Do"
      title="Five Pillars of Digital Growth"
      subtitle="From AI search intelligence to transparent ROI reporting, we cover every angle of your digital presence."
      align="center"
    />
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {pillars.map((pillar) => (
        <PillarCard pillar={pillar} />
      ))}
    </div>
  </Section>

  <Section bg="white">
    <SectionHeader
      label="Why StarkRank"
      title="Technical Precision. Creative Authority."
      align="center"
    />
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
      <div>
        <p class="text-4xl font-headline font-black text-blue">100+</p>
        <p class="mt-2 text-sm font-body text-gray">Clients Served Globally</p>
      </div>
      <div>
        <p class="text-4xl font-headline font-black text-blue">2</p>
        <p class="mt-2 text-sm font-body text-gray">Markets, One Strategy</p>
      </div>
      <div>
        <p class="text-4xl font-headline font-black text-blue">14</p>
        <p class="mt-2 text-sm font-body text-gray">Specialist Services</p>
      </div>
    </div>
  </Section>

  <Section bg="cream">
    <SectionHeader
      label="Where We Operate"
      title="Two Markets. One Strategy."
      subtitle="Swiss precision with local market knowledge across the DACH region."
      align="center"
    />
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-3xl mx-auto">
      <a href="/ch-de/" class="group block bg-white border border-gray-light/40 rounded-lg p-6 transition-all hover:shadow-xl hover:border-blue/30 hover:-translate-y-1">
        <span class="text-xs font-label font-semibold uppercase tracking-[0.2em] text-blue">Switzerland</span>
        <h3 class="mt-2 text-xl font-headline font-black tracking-tight text-navy group-hover:text-blue transition-colors">Basel</h3>
        <p class="mt-3 text-sm font-body text-gray leading-relaxed">Swiss headquarters serving the trinational region — pharma and life sciences.</p>
      </a>
      <a href="/de/" class="group block bg-white border border-gray-light/40 rounded-lg p-6 transition-all hover:shadow-xl hover:border-blue/30 hover:-translate-y-1">
        <span class="text-xs font-label font-semibold uppercase tracking-[0.2em] text-blue">Germany</span>
        <h3 class="mt-2 text-xl font-headline font-black tracking-tight text-navy group-hover:text-blue transition-colors">Hannover</h3>
        <p class="mt-3 text-sm font-body text-gray leading-relaxed">German Mittelstand, B2B manufacturers, and IT services.</p>
      </a>
    </div>
  </Section>

  <CTABanner
    bg="navy"
    title="Is Your Ad Spend Working?"
    subtitle="Get a free Google Ads audit and discover where your budget is leaking."
  >
    <Button href="/free-google-ads-audit/" variant="primary" size="lg">Free Ads Audit</Button>
    <Button href="/free-copywriting-audit/" variant="ghost" size="lg">Free Copywriting Audit</Button>
  </CTABanner>
</BaseLayout>
