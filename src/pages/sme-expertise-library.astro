---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import CTABanner from '../components/ui/CTABanner.astro';

const title = 'Expertenbibliothek — Gründerwissen wird Content | StarkRank';
const description = 'Fälle, konträre Thesen, Fehlschläge und Frameworks Ihres Gründers gehören in eine strukturierte Bibliothek, aus der Ihr Content-Engine täglich schöpft.';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Expertenbibliothek',
  description: 'Strukturierte Wissens-Bibliothek, die Fallstudien, konträre Positionen, Fehlschlag-Stories, Frameworks, Insider-Wissen und zitierbares Material eines Gründers über 10 Sektionen erfasst. Aufgebaut über ein Live-Interview und als kanonische Markdown-Datei geliefert.',
  url: 'https://starkrank.com/de/sme-expertise-library/',
  provider: { '@type': 'Organization', name: 'StarkRank', url: 'https://starkrank.com' },
  areaServed: [
    { '@type': 'Country', name: 'Germany' },
    { '@type': 'Country', name: 'Austria' },
    { '@type': 'Country', name: 'Switzerland' },
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Expertenbibliothek Stufen',
    itemListElement: [
      { '@type': 'Offer', name: 'Standalone', description: 'Einbranchen-Praxis, 1 Servicelinie. 2-stündiges Interview, 3 Fallstudien, kanonische Datei.', price: '2100', priceCurrency: 'EUR' },
      { '@type': 'Offer', name: 'Multi-Service', description: 'Multi-Service-Kanzlei mit 3+ Servicelinien. 3-stündiges Interview, 5 Fallstudien.', price: '3400', priceCurrency: 'EUR' },
      { '@type': 'Offer', name: 'Jährlicher Refresh', description: 'Jährliche Refresh-Session mit neuen Fallstudien. Im Content-Marketing-Retainer enthalten.', price: '700', priceCurrency: 'EUR' },
    ],
  },
};

const faqItems = [
  { question: 'Wie unterscheidet sich das vom Expert-Interview-Service?', answer: 'Das Experteninterview ist themen-spezifisch — 1 Verfahren, 1 Servicebereich, 1 Datei pro Thema. Die Expertenbibliothek ist personen-spezifisch — das gesamte Wissen Ihres Gründers über seine Praxis, einmal im Onboarding gebaut. Beides existiert nebeneinander: die Expertenbibliothek ist der Rückhalt, Themen-Interviews sind der Deep-Dive.' },
  { question: 'Für wen ist die Expertenbibliothek NICHT geeignet?', answer: 'Kunden, bei denen kein einzelner Experte die Marke trägt: Multi-Location-Franchises, Generalisten-Agenturen, E-Commerce-Shops, reine Kategorie- oder Produktmarken. Auch Kunden in frühen Phasen ohne bisherigen umsatzträchtigen Content.' },
  { question: 'Was, wenn mein Gründer wenig Zeit für ein Interview hat?', answer: 'Wir teilen das 2-3-stündige Interview auf 2 oder 3 Sessions à 45-60 Minuten auf. Wir akzeptieren auch Transkripte bestehenden Materials (Podcast-Auftritte, Konferenz-Vorträge, Schulungsvideos) als Input, was die Live-Interview-Zeit deutlich reduziert.' },
  { question: 'Arbeiten Sie mit unserem bestehenden Content-Team oder ersetzen Sie es?', answer: 'Wir arbeiten ergänzend. Die Bibliothek ist so gebaut, dass sie jedes Content-Team speist, ob intern, Ghostwriter oder unser Content-Marketing-Retainer. Das Nutzungs-Log dokumentiert, welches Material bereits geschöpft wurde, sodass Ihr Team dieselbe Fallstudie nicht versehentlich dreimal wiederverwendet.' },
  { question: 'Wie oft muss die Expertenbibliothek aktualisiert werden?', answer: 'Monatlich zum Ergänzen neuer Fallstudien (10 Minuten). Quartalsweise zur Überprüfung der konträren Positionen (30 Minuten). Jährlich für ein vollständiges Rubrik-Re-Audit (2 Stunden, 700 € außerhalb des Retainers).' },
  { question: 'Kann die Expertenbibliothek von bereits lizenzierten KI-Schreibwerkzeugen verwendet werden?', answer: 'Ja. Die Bibliothek ist eine strukturierte Markdown-Datei, daher kann jedes Content-Werkzeug, das Markdown-Kontext akzeptiert (Claude, ChatGPT, Jasper, Writer, eigene Prompting-Pipelines), sie laden. Wir liefern eine kurze Prompt-Vorlage zum Einspeisen von Bibliothek-Sektionen in Generierungs-Workflows.' },
  { question: 'Was passiert, wenn unser Gründer ausscheidet oder die Rolle wechselt?', answer: 'Die Bibliothek ist das Asset; das Ausscheiden Ihres Gründers löscht sie nicht. Bisherige Fallstudien, Frameworks und konträre Positionen bleiben nutzbar (mit gemäß den ursprünglichen Einwilligungen erhaltener Attribution), solange sie korrekt sind.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

const schemas = [serviceSchema, faqSchema];

const breadcrumbs = [
  { label: 'Start', href: '/de/' },
  { label: 'Expertenbibliothek', href: '/de/sme-expertise-library/' },
];

const sections = [
  { num: 1, name: 'Kernexpertise & Qualifikationen', what: 'Jahre im Feld, Nischenkante, was der Experte besser weiß als 95% der Peers' },
  { num: 2, name: 'Konträre Überzeugungen', what: '2-4 Positionen, denen die meisten Peers widersprechen, plus Evidenz dahinter' },
  { num: 3, name: 'Fallstudien', what: '3-5 konkrete Projekte mit Vorher/Nachher, Wendepunkt-Entscheidungen, Ergebniszahlen, gezogenen Lehren' },
  { num: 4, name: 'Testimonials & direkte Zitate', what: 'Wörtliche Kundenzitate mit Quelle, bestes je erhaltenes Feedback, häufigstes Dankeschön' },
  { num: 5, name: 'Fehlschläge & Lehren', what: 'Projekte, die der Experte bereut, Ursachen, was er anders machen würde' },
  { num: 6, name: 'Frameworks & benannte Methoden', what: 'Gebrandete oder informelle Methodiken, die der Experte bei jedem Auftrag einsetzt' },
  { num: 7, name: 'Insider-Wissen', what: 'Branchenwahrheiten, die nicht in Lehrbüchern stehen, Muster, die Peers übersehen' },
  { num: 8, name: 'Aktuelle Branchensicht', what: 'Überhypte vs. unterschätzte Trends, was der Experte derzeit verfolgt' },
  { num: 9, name: 'Zitierbare Zeilen / Mantras', what: 'Einzeiler, die der Experte in jedem Beratungsgespräch wiederholt' },
  { num: 10, name: 'Beweise & Daten zum Zitieren', what: 'Interne Dashboards, konkrete Zahlen zur öffentlichen Nennung, Vorher/Nachher-Referenzen' },
];

const processSteps = [
  { num: 1, title: 'Vorbereitung (Tag 1-2)', body: 'Wir lesen Ihr bestehendes öffentliches Material (LinkedIn-Langform, Podcast-Auftritte, Konferenz-Vorträge, Gastartikel) und bereiten das Interview so vor, dass bereits Dokumentiertes nicht abgefragt wird.' },
  { num: 2, title: 'Live-Interview (Tag 3-5)', body: '2 bis 3 Stunden mit dem Experten in 1 oder 2 Sessions. Wir stellen eine Frage nach der anderen, haken bei vagen Antworten nach und decken alle 10 Sektionen ab.' },
  { num: 3, title: 'YMYL-Compliance-Durchgang (Tag 6)', body: 'Für regulierte Branchen markieren wir Behauptungen wie "garantiert", "Spezialist" ohne Facharzt-Anerkennung oder Ergebnis-Aussagen ohne Disclaimer.' },
  { num: 4, title: 'Synthese + Bibliothek-Entwurf (Tag 7-8)', body: 'Die 10 Sektionen werden in die kanonische Datei kompiliert. Attributions-Entscheidungen pro Zitat dokumentiert.' },
  { num: 5, title: 'Experten-Review-Zyklus (Tag 9-10)', body: 'Wir fassen die 8-12 tragendsten Punkte zur Freigabe an den Expertenzurück. Korrekturen eingepflegt, Attribution bestätigt.' },
  { num: 6, title: 'Lieferung (Tag 11-14)', body: 'Bibliothek-Datei gespeichert. 30-minütiger Walkthrough mit Ihrem Content-Team, wie aus Content-Briefs auf die Expertenbibliothek verwiesen wird.' },
];

const relatedLinks = [
  { title: 'Experteninterview', href: '/de/expert-interview/' },
  { title: 'Content-Marketing', href: '/de/content-marketing-hannover/' },
  { title: 'E-E-A-T-Audit', href: '/de/eeat-audit/' },
  { title: 'KI-Suchoptimierung', href: '/de/ki-suchoptimierung-hannover/' },
  { title: 'Kostenloser AISO-Check', href: '/de/aiso-check/' },
];
---

<BaseLayout title={title} description={description} locale="de" schema={schemas}>
  <Fragment slot="head">
    <link rel="alternate" hreflang="en" href="https://starkrank.com/services/sme-expertise-library/" />
    <link rel="alternate" hreflang="de" href="https://starkrank.com/de/sme-expertise-library/" />
    <link rel="alternate" hreflang="de-CH" href="https://starkrank.com/ch-de/sme-expertise-library/" />
    <link rel="alternate" hreflang="es-PE" href="https://starkrank.com/pe/biblioteca-experto/" />
    <link rel="alternate" hreflang="x-default" href="https://starkrank.com/services/sme-expertise-library/" />
  </Fragment>

  <!-- Hero -->
  <Section bg="cream">
    <Breadcrumbs items={breadcrumbs} />

    <span class="text-xs font-label font-semibold uppercase tracking-[0.2em] text-blue mb-3 block">
      Content &amp; Copywriting
    </span>
    <h1 class="text-4xl md:text-5xl font-headline font-black tracking-tight text-navy">
      Expertenbibliothek — Das Wissen Ihres Gründers als zitierbares Asset
    </h1>
    <p class="mt-4 text-lg text-gray font-body leading-relaxed max-w-3xl">
      Der schwierigste Content in 2026 ist der, den KI nicht generieren kann: Fehlschlag-Stories, Fallergebnisse mit konkreten Zahlen, konträre Positionen aus 20 Jahren Feldarbeit, benannte Frameworks, die Ihr Team tatsächlich nutzt. All das lebt im Kopf Ihres Gründers und taucht in Kundenmeetings auf, niemals im Content. Die Expertenbibliothek erfasst es einmal, strukturiert es über 10 Sektionen und wird zur Quelle, aus der Ihr Content-Team bei jedem Brief schöpft.
    </p>

    <div class="mt-8 flex flex-wrap gap-4">
      <Button href="/de/kontakt/" variant="primary" size="lg">Expertenbibliothek buchen</Button>
      <Button href="#sections" variant="ghost" size="lg">Die 10 Sektionen</Button>
    </div>

    <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs font-body text-gray">
      <span>Zuletzt aktualisiert: <time datetime="2026-04-19">April 2026</time></span>
      <span>Von <a href="/about/" class="text-blue hover:text-blue-light font-semibold">Wilko Feye</a>, StarkRank</span>
    </div>
  </Section>

  <!-- Main + sidebar -->
  <section class="bg-white">
    <div class="max-w-7xl mx-auto px-6 py-16 md:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <div class="lg:col-span-2 space-y-0">

          <div class="pb-14">
            <h2 class="text-2xl md:text-3xl font-headline font-black text-navy tracking-tight mb-6">
              Warum gehört Gründerwissen in eine strukturierte Bibliothek?
            </h2>
            <div class="space-y-4 text-base font-body text-gray leading-relaxed">
              <p>Ihr Gründer weiß Dinge, die niemand sonst in Ihrem Team weiß, die niemand in Ihrer Branche dokumentiert und die kein KI-Modell aus Trainingsdaten ableiten kann: Fallzahlen aus 15 Jahren Praxis, die konträre Position, die Kundenmeetings entscheidet, der Fehlschlag, der jeden folgenden Auftrag geprägt hat.</p>
              <p>Ohne Bibliothek bleibt dieses Wissen im Kopf. Die Bibliothek macht aus Ein-Personen-Expertise ein Team-Asset.</p>
            </div>
          </div>

          <div id="sections" class="pt-14 pb-14 border-t border-gray-light/30">
            <h2 class="text-2xl md:text-3xl font-headline font-black text-navy tracking-tight mb-4">
              Was umfasst die Expertenbibliothek?
            </h2>
            <p class="text-base font-body text-gray leading-relaxed mb-8">
              Die Bibliothek strukturiert das Wissen Ihres Gründers über 10 Sektionen in einer einzigen kanonischen Datei, aufgebaut durch ein strukturiertes 2-3-stündiges Interview mit optionaler Transkript-Übernahme aus bestehenden Podcast-Auftritten, Konferenz-Vorträgen oder LinkedIn-Langbeiträgen.
            </p>
            <div class="overflow-x-auto">
              <table class="w-full text-sm font-body border-collapse">
                <thead>
                  <tr class="border-b-2 border-navy/20">
                    <th class="text-left py-3 pr-4 font-headline font-bold text-navy">#</th>
                    <th class="text-left py-3 pr-4 font-headline font-bold text-navy">Sektion</th>
                    <th class="text-left py-3 font-headline font-bold text-navy">Was erfasst wird</th>
                  </tr>
                </thead>
                <tbody>
                  {sections.map((s) => (
                    <tr class="border-b border-gray-light/40">
                      <td class="py-3 pr-4 text-blue font-bold align-top">{s.num}</td>
                      <td class="py-3 pr-4 font-semibold text-dark align-top">{s.name}</td>
                      <td class="py-3 text-gray leading-relaxed align-top">{s.what}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <div class="pt-14 pb-14 border-t border-gray-light/30">
            <h2 class="text-2xl md:text-3xl font-headline font-black text-navy tracking-tight mb-6">
              Wie unterscheidet sich die Expertenbibliothek von einem Blog oder einer Über-uns-Seite?
            </h2>
            <div class="space-y-4 text-base font-body text-gray leading-relaxed">
              <p>Eine Über-uns-Seite behauptet Expertise; ein Blog veröffentlicht sie Artikel für Artikel. Die Bibliothek ist das Rohmaterial darunter. Sie ist nicht kundenseitig, nicht für SEO strukturiert und kein Fließtext: sie ist eine strukturierte Wissens-Datei mit 10 Sektionen, einem Nutzungs-Log, das dokumentiert, welcher Content bereits daraus geschöpft hat, und Querverweisen zu themenspezifischen Interviews.</p>
            </div>
          </div>

          <div class="pt-14 pb-14 border-t border-gray-light/30">
            <h2 class="text-2xl md:text-3xl font-headline font-black text-navy tracking-tight mb-6">
              Warum eine Bibliothek bauen statt nur Themen-Interviews zu führen?
            </h2>
            <div class="space-y-4 text-base font-body text-gray leading-relaxed">
              <p>Beides ist nützlich, und wir empfehlen oft beides. Themen-Interviews gehen tief auf 1 Servicebereich oder Verfahren; die Expertenbibliothek ist das gesamte Wissen des Gründers über seine Praxis. Teams, die mit Themen-Interviews beginnen, enden damit, den Expertenfür jedes neue Thema erneut zu interviewen. Teams, die mit der Expertenbibliothek beginnen, haben Breite abgedeckt und führen Themen-Interviews für Tiefe.</p>
            </div>
          </div>

          <div class="pt-14 pb-14 border-t border-gray-light/30">
            <h2 class="text-2xl md:text-3xl font-headline font-black text-navy tracking-tight mb-6">
              Wo liegen die Grenzen des Expertenbibliothek-Service?
            </h2>
            <div class="space-y-4 text-base font-body text-gray leading-relaxed">
              <p>Drei Grenzen sind vor dem Auftrag zu nennen:</p>
              <ul class="space-y-3 list-none pl-0">
                <li class="flex items-start gap-3"><span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span><span>Die Bibliothek erfordert ein Live-Interview (2-3 Stunden, aufteilbar); wir können sie nicht allein aus öffentlichem Material bauen, weil der wertvollste Content unveröffentlicht ist.</span></li>
                <li class="flex items-start gap-3"><span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span><span>1 Anker-Experte pro Expertenbibliothek; Mehr-Experten-Teams buchen 1 Bibliothek pro benanntem Experten zum Standalone-Tarif.</span></li>
                <li class="flex items-start gap-3"><span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span><span>YMYL-Branchen benötigen menschliche Freigabe der Attribution.</span></li>
              </ul>
            </div>
          </div>

          <div id="deliverables" class="pt-14 pb-14 border-t border-gray-light/30">
            <h2 class="text-2xl md:text-3xl font-headline font-black text-navy tracking-tight mb-6">
              Was erhalten Sie bei der Expertenbibliothek?
            </h2>
            <ul class="space-y-3 list-none pl-0 text-base font-body text-gray leading-relaxed">
              <li class="flex items-start gap-3"><span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span><span><strong class="text-dark">Kanonische Bibliothek-Datei</strong> — einheitliche Wahrheitsquelle, 10 Sektionen, über Kunden hinweg konsistente Struktur</span></li>
              <li class="flex items-start gap-3"><span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span><span><strong class="text-dark">YMYL-Compliance-Flag-Tabelle</strong> — anwendbare Regularien Claim-Mustern zugeordnet mit Vorschlägen für konforme Umformulierung</span></li>
              <li class="flex items-start gap-3"><span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span><span><strong class="text-dark">Querverweis-Index</strong> — Verweise auf bestehende themenspezifische Interview-Dateien für Deep-Dive-Material</span></li>
              <li class="flex items-start gap-3"><span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span><span><strong class="text-dark">Attributions-Entscheidungen</strong> — Einwilligung pro Zitat und pro Fallstudie (namentlich, anonymisiert oder nur intern)</span></li>
              <li class="flex items-start gap-3"><span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span><span><strong class="text-dark">Nutzungs-Log</strong> — leere Tabelle, die über die Zeit gefüllt wird, sobald Content-Briefs aus der Expertenbibliothek schöpfen</span></li>
              <li class="flex items-start gap-3"><span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span><span><strong class="text-dark">Jährlicher Refresh</strong> — optionale 700-€-Jahres-Session zum Ergänzen neuer Fälle, Aktualisieren der konträren Positionen und Auffrischen der aktuellen Sicht</span></li>
            </ul>
          </div>

        </div>

        <!-- Sidebar -->
        <aside class="lg:col-span-1">
          <div class="lg:sticky lg:top-8 space-y-6">
            <div class="bg-cream border border-gray-light/40 rounded-lg p-6">
              <p class="text-xs font-label font-bold uppercase tracking-widest text-blue mb-4">Am besten für</p>
              <div class="space-y-2 text-sm font-body text-gray">
                <div class="flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-blue shrink-0"></span><span>Gründergeführte Praxen</span></div>
                <div class="flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-blue shrink-0"></span><span>Solo-Berater</span></div>
                <div class="flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-blue shrink-0"></span><span>Experten-geführte B2B</span></div>
                <div class="flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-blue shrink-0"></span><span>Klinische Leitungen</span></div>
              </div>
            </div>

            <div class="bg-cream border border-gray-light/40 rounded-lg p-6">
              <p class="text-xs font-label font-bold uppercase tracking-widest text-blue mb-2">Format</p>
              <p class="text-sm font-body text-gray">1 kanonische Datei pro Kunde · 10 strukturierte Sektionen · Jährlicher Refresh optional · Speist jede nachgelagerte Content-Skill</p>
            </div>

            <div>
              <h3 class="text-xs font-label font-bold uppercase tracking-widest text-blue mb-4">Verwandte Services</h3>
              <div class="space-y-3">
                {relatedLinks.map((r) => (
                  <Card href={r.href}>
                    <h4 class="text-sm font-headline font-bold text-navy">{r.title}</h4>
                  </Card>
                ))}
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <Section bg="cream">
    <SectionHeader label="Preise" title="Wie viel kostet die Expertenbibliothek?" />
    <p class="text-base font-body text-gray leading-relaxed max-w-3xl mb-10">
      Preise gestaffelt nach Umfang. Content-Retainer-Kunden, deren Marke an einem Schlüssel-Experten verankert ist, erhalten die Expertenbibliothek im Onboarding ohne Aufpreis.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-white border border-gray-light/40 rounded-lg p-6 flex flex-col">
        <h3 class="text-lg font-headline font-black text-navy mb-2">Standalone</h3>
        <p class="text-xs font-label font-semibold uppercase tracking-widest text-blue mb-4">Einbranchen-Praxis</p>
        <ul class="space-y-2 text-sm font-body text-gray mb-6 flex-1">
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">·</span> 2 Stunden Interview</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">·</span> 3 Fallstudien erfasst</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">·</span> Compliance-Abgleich</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">·</span> Kanonische Datei</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">·</span> Jährlicher Refresh: 700 € Add-on</li>
        </ul>
        <p class="text-2xl font-headline font-black text-navy mb-4">2.100 €</p>
        <Button href="/de/kontakt/" variant="primary" size="md">Standalone buchen</Button>
      </div>

      <div class="bg-white border-2 border-blue rounded-lg p-6 flex flex-col">
        <h3 class="text-lg font-headline font-black text-navy mb-2">Multi-Service</h3>
        <p class="text-xs font-label font-semibold uppercase tracking-widest text-blue mb-4">3+ Servicelinien</p>
        <ul class="space-y-2 text-sm font-body text-gray mb-6 flex-1">
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">·</span> 3 Stunden Interview</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">·</span> 5 Fallstudien erfasst</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">·</span> Compliance-Abgleich</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">·</span> Kanonische Datei</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">·</span> Jährlicher Refresh: 700 € Add-on</li>
        </ul>
        <p class="text-2xl font-headline font-black text-navy mb-4">3.400 €</p>
        <Button href="/de/kontakt/" variant="primary" size="md">Multi-Service buchen</Button>
      </div>

      <div class="bg-white border border-gray-light/40 rounded-lg p-6 flex flex-col">
        <h3 class="text-lg font-headline font-black text-navy mb-2">Retainer</h3>
        <p class="text-xs font-label font-semibold uppercase tracking-widest text-blue mb-4">Content-Marketing-Kunden</p>
        <ul class="space-y-2 text-sm font-body text-gray mb-6 flex-1">
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">·</span> 2-3 Stunden Interview</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">·</span> 3-5 Fallstudien</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">·</span> Compliance-Abgleich</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">·</span> Jährlicher Refresh enthalten</li>
        </ul>
        <p class="text-2xl font-headline font-black text-navy mb-4">Im Retainer</p>
        <Button href="/de/kontakt/" variant="primary" size="md">Retainer anfragen</Button>
      </div>
    </div>
  </Section>

  <!-- Process -->
  <Section bg="white">
    <SectionHeader label="Ablauf" title="Wie läuft der Auftrag ab?" />
    <p class="text-base font-body text-gray leading-relaxed max-w-3xl mb-10">
      Der Auftrag verläuft in sechs Schritten über 2 Wochen. Die Interview-Disziplin am dritten Tag ist ausschlaggebend für die Qualität des Endergebnisses.
    </p>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {processSteps.map((step) => (
        <div class="bg-cream border border-gray-light/40 rounded-lg p-6">
          <div class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-blue text-white font-headline font-bold mb-4">{step.num}</div>
          <h3 class="text-base font-headline font-bold text-navy mb-2">{step.title}</h3>
          <p class="text-sm font-body text-gray leading-relaxed">{step.body}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- FAQ -->
  <Section bg="cream">
    <SectionHeader label="FAQ" title="Welche Fragen stellen Käufer am häufigsten?" />
    <div class="max-w-3xl space-y-6">
      {faqItems.map((item) => (
        <details class="group bg-white border border-gray-light/40 rounded-lg">
          <summary class="flex items-center justify-between gap-4 cursor-pointer p-6 font-headline font-bold text-navy text-base md:text-lg select-none">
            {item.question}
            <svg class="w-5 h-5 shrink-0 text-blue transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
          </summary>
          <div class="px-6 pb-6 text-sm font-body text-gray leading-relaxed">
            {item.answer}
          </div>
        </details>
      ))}
    </div>
  </Section>

  <!-- CTA -->
  <CTABanner bg="navy" title="Bereit, Gründerwissen in ein Team-Asset zu verwandeln?" subtitle="Jede gründergeführte Praxis hat mehr Expertise als Content. Die Expertenbibliothek erfasst sie einmal in einer strukturierten Datei, aus der Ihr Content-Team bei jedem Brief schöpft. 2.100 € Standalone, 3.400 € Multi-Service, im Content-Marketing-Retainer enthalten.">
    <Button href="/de/kontakt/" variant="primary" size="lg">Expertenbibliothek buchen</Button>
    <Button href="/de/content-marketing-hannover/" variant="secondary" size="lg">Content-Retainer anfragen</Button>
  </CTABanner>
</BaseLayout>
