---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import CTABanner from '../../components/ui/CTABanner.astro';
import { getCollection } from 'astro:content';
import { getPillarById } from '../../data/pillars';
import { getSpokePath } from '../../data/service-slugs';

const slug = 'seo-for-auto-services';
const allServices = await getCollection('services');
const service = allServices.find((s) => s.data.slug === slug)!;
const pillar = getPillarById(service.data.pillar);

const relatedServices = service.data.relatedServices
  ? allServices.filter((s) => service.data.relatedServices!.includes(s.data.slug))
  : [];

const allCities = await getCollection('cities');
const enCities = allCities
  .filter((c) => c.data.locale === 'en' && c.data.services.includes(slug))
  .map((c) => ({
    city: c.data.city,
    href: `/${getSpokePath(slug, c.data.citySlug, 'en')}/`,
  }));

const title = 'SEO for Auto Services — More Customers From Google & AI | StarkRank';
const description = "Your auto service business deserves more customers from Google. We handle GBP, local SEO, before/after galleries, and AI search optimization. Results in 90 days.";

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'SEO for Auto Services',
  description: 'Comprehensive SEO for auto service businesses including GBP optimization, before/after galleries, review management, and AI search optimization. Covers detailing, repair, body shops, tire shops, and oil change services.',
  url: 'https://starkrank.com/services/seo-for-auto-services/',
  provider: {
    '@type': 'Organization',
    name: 'StarkRank',
    url: 'https://starkrank.com',
  },
  areaServed: [
    { '@type': 'Country', name: 'United States' },
    { '@type': 'Country', name: 'Peru' },
    { '@type': 'Country', name: 'Germany' },
    { '@type': 'Country', name: 'Switzerland' },
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Auto Service SEO Packages',
    itemListElement: [
      {
        '@type': 'Offer',
        name: 'Starter Auto Service SEO',
        description: 'Single location with fewer than 3 direct competitors. GBP optimization, 5 service pages, basic review management.',
        price: '1000',
        priceCurrency: 'USD',
        priceSpecification: {
          '@type': 'UnitPriceSpecification',
          price: '1000',
          priceCurrency: 'USD',
          referenceQuantity: { '@type': 'QuantitativeValue', value: '1', unitText: 'month' },
        },
      },
      {
        '@type': 'Offer',
        name: 'Growth Auto Service SEO',
        description: 'Single location in a competitive market. Full service page build-out, before/after galleries, review strategy, city pages, and AISO optimization.',
        price: '2000',
        priceCurrency: 'USD',
        priceSpecification: {
          '@type': 'UnitPriceSpecification',
          price: '2000',
          priceCurrency: 'USD',
          referenceQuantity: { '@type': 'QuantitativeValue', value: '1', unitText: 'month' },
        },
      },
    ],
  },
};

const faqItems = [
  {
    question: 'How long does auto service SEO take to work?',
    answer: 'Most auto service businesses see measurable improvements in Google Maps visibility within 60-90 days. Organic search traffic typically increases within 3-6 months. SEO compounds over time — the longer you invest, the wider the gap between you and franchise competitors who rely on brand name alone.',
  },
  {
    question: 'How do I compete with franchise chains like Midas or Jiffy Lube?',
    answer: "Franchise chains have brand recognition, but they rarely invest in local SEO at the individual location level. Independent shops that optimize their Google Business Profile, build a strong review profile with recent work photos, and publish service-specific content consistently outrank franchise locations in local search.",
  },
  {
    question: 'Are before/after photos really that important for SEO?',
    answer: "Yes — before/after galleries are the single most important trust signal for auto service businesses. They prove quality of work, increase time on site, reduce bounce rates, and give Google image search another way to surface your business.",
  },
  {
    question: 'What schema markup do auto service businesses need?',
    answer: 'Auto service businesses need AutomotiveBusiness schema (not AutoRepair — which is too narrow for detailing and body shops), plus Service schema for each service offered, FAQPage schema on pages with Q&A content, and LocalBusiness with areaServed for geographic targeting.',
  },
  {
    question: 'Do I need SEO if I already get customers through word of mouth?',
    answer: "Word of mouth is powerful, but it doesn't scale and it doesn't capture the customer who just moved to your area or whose usual shop closed. Over 80% of consumers search online before choosing a local service provider — including auto services.",
  },
  {
    question: 'What about emergency services like roadside assistance and towing?',
    answer: "Emergency auto service pages are high-intent gold mines. Someone searching 'emergency towing near me' at 11 PM needs help immediately and will call the first business that appears. We build dedicated emergency service pages that rank for these urgent, high-conversion queries.",
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://starkrank.com/' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://starkrank.com/services/' },
    { '@type': 'ListItem', position: 3, name: 'SEO for Auto Services', item: 'https://starkrank.com/services/seo-for-auto-services/' },
  ],
};

const schemas = [serviceSchema, faqSchema, breadcrumbSchema];

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services/' },
  { label: 'SEO for Auto Services', href: '/services/seo-for-auto-services/' },
];

const includedItems = [
  { name: 'Google Business Profile Optimization', description: '25+ photos including before/after galleries, weekly posts, service highlights, Q&A management, and category optimization for every service you offer.' },
  { name: 'Service-Specific Pages', description: 'Dedicated landing pages for each service — detailing, collision repair, body work, tire services, oil changes, brake repair — each with FAQ schema and localized content.' },
  { name: 'Before/After Gallery Optimization', description: 'WebP-optimized photo galleries with descriptive alt text, lazy loading, and structured data. Your best work becomes a trust signal that ranks in Google Image Search.' },
  { name: 'City and Area Pages', description: 'Genuine local pages targeting neighborhoods and surrounding cities you serve. Not thin doorway pages — real content with local landmarks, driving directions, and area-specific service information.' },
  { name: 'Technical SEO Audit', description: 'Site speed optimization, mobile-first audit, crawl error resolution, and schema markup implementation. The foundation that makes everything else work.' },
  { name: 'Review Management Strategy', description: 'Systematic review generation workflow, response templates for positive and negative reviews, and review velocity monitoring. Recent reviews matter more than total count.' },
  { name: 'AI Search Optimization (AISO)', description: 'Entity verification, structured data for AI retrieval, answer-first content formatting, and AI crawler access configuration. Get cited when customers ask AI assistants for auto service recommendations.' },
  { name: 'Monthly Reporting', description: 'Customer acquisition metrics — not just rankings. Phone calls, direction requests, website visits from GBP, organic traffic growth, review velocity, and AISO Score tracking.' },
];

const comparisonRows = [
  { feature: 'Google Business Profile optimization', starter: true, growth: true, premium: true },
  { feature: 'Service-specific pages', starter: '5 pages', growth: '10+ pages', premium: '15+ pages' },
  { feature: 'Before/after gallery', starter: 'Basic', growth: 'Optimized', premium: 'Optimized' },
  { feature: 'City/area pages', starter: false, growth: '3 pages', premium: '5+ pages' },
  { feature: 'Technical SEO audit', starter: 'Initial', growth: 'Quarterly', premium: 'Monthly' },
  { feature: 'Review management', starter: 'Templates', growth: 'Active', premium: 'Active' },
  { feature: 'AI search optimization', starter: false, growth: true, premium: true },
  { feature: 'AISO Score tracking', starter: false, growth: 'Quarterly', premium: 'Monthly' },
  { feature: 'Competitor monitoring', starter: false, growth: true, premium: true },
  { feature: 'Dedicated strategist', starter: false, growth: true, premium: true },
  { feature: 'Multi-location management', starter: false, growth: false, premium: true },
  { feature: 'Monthly reporting', starter: true, growth: true, premium: true },
];

const timelineSteps = [
  { period: '30 Days', title: 'Foundation', items: ['GBP audit and optimization', 'Technical SEO fixes', 'Schema markup implementation', 'Review generation workflow launch', 'Before/after gallery setup'] },
  { period: '60-90 Days', title: 'Visibility', items: ['Service pages live and indexed', 'Google Maps ranking improvements', 'Review velocity increasing', 'First city/area pages published', 'AISO baseline score established'] },
  { period: '6 Months', title: 'Growth', items: ['Organic traffic measurably increasing', 'Ranking for service + city keywords', 'Review profile outpacing competitors', 'AI search citations appearing', 'Before/after galleries ranking in Image Search'] },
  { period: '12 Months', title: 'Dominance', items: ['Top 3 Maps for primary services', 'Multiple city pages ranking', 'Strong AISO Score with regular citations', 'Compounding organic traffic', 'Franchise competitors losing ground in local results'] },
];
---

<BaseLayout
  title={title}
  description={description}
  schema={schemas}
>
  <!-- Hero -->
  <Section bg="cream">
    <Breadcrumbs items={breadcrumbs} />

    <span class="text-xs font-label font-semibold uppercase tracking-[0.2em] text-blue mb-3 block">
      {pillar?.tagline}
    </span>
    <h1 class="text-4xl md:text-5xl font-headline font-black tracking-tight text-navy">
      SEO for Auto Services — More Customers From Google &amp; AI Search
    </h1>
    <p class="mt-4 text-lg text-gray font-body leading-relaxed max-w-3xl">
      Your customers search Google before they search their glove box for your card. Whether you run a detailing shop, collision repair center, body shop, tire service, or oil change franchise — the business that shows up first wins the call. We make sure that's you.
    </p>

    <div class="mt-8 flex flex-wrap gap-4">
      <Button href="/aiso-score/" variant="primary" size="lg">Get Your Free AISO Score</Button>
      <Button href="#whats-included" variant="ghost" size="lg">See What's Included</Button>
    </div>

    <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs font-body text-gray">
      <span>
        Last updated: <time datetime="2026-03-26">March 2026</time>
      </span>
      <span>
        By <a href="/about/" class="text-blue hover:text-blue-light font-semibold">Wilko Feye</a>, StarkRank
      </span>
    </div>
  </Section>

  <!-- Main content + sidebar -->
  <section class="bg-white">
    <div class="max-w-7xl mx-auto px-6 py-16 md:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Main content (~65%) -->
        <div class="lg:col-span-2 space-y-0">

          <!-- Why auto services need SEO -->
          <div class="pb-14">
            <h2 class="text-2xl md:text-3xl font-headline font-black text-navy tracking-tight mb-6">
              Why do auto service businesses need SEO?
            </h2>
            <div class="space-y-4 text-base font-body text-gray leading-relaxed">
              <p>The auto service industry runs on local search. When someone's check engine light comes on, when they need a dent removed before lease return, when they want their car detailed before selling it — they search Google. The shop that appears in the Maps 3-pack and the top organic results gets the call.</p>
              <p>But most auto service businesses treat their online presence as an afterthought. A basic website with a phone number. A Google Business Profile with 3 photos from 2019. No service-specific pages. No reviews strategy. No structured data. Meanwhile, franchise chains dominate the search results by default — not because they're better, but because they have corporate marketing teams handling their SEO.</p>
              <p>Independent shops and small chains can outrank franchises with targeted local SEO. The advantage: you can move faster, publish real work photos, build genuine local relationships, and create content that franchises can't replicate at the individual location level.</p>
              <p>And now there's a new channel: AI search. When someone asks ChatGPT or Google's AI Overview "best auto detailing near me," your business needs to be in the answer. That requires a different set of optimizations — structured data, entity verification, and answer-formatted content — that most auto service businesses haven't even started thinking about.</p>
            </div>
          </div>

          <!-- What's included (inline) -->
          <div id="whats-included" class="pt-14 pb-14 border-t border-gray-light/30">
            <h2 class="text-2xl md:text-3xl font-headline font-black text-navy tracking-tight mb-6">
              What's included in auto service SEO?
            </h2>
            <div class="space-y-6">
              {includedItems.map((item) => (
                <div>
                  <h3 class="text-lg font-headline font-bold text-navy mb-2">{item.name}</h3>
                  <p class="text-base font-body text-gray leading-relaxed">{item.description}</p>
                </div>
              ))}
            </div>
          </div>

          <!-- Results timeline -->
          <div class="pt-14 pb-14 border-t border-gray-light/30">
            <h2 class="text-2xl md:text-3xl font-headline font-black text-navy tracking-tight mb-6">
              What results can you expect — and when?
            </h2>
            <p class="text-base font-body text-gray leading-relaxed mb-8">
              SEO is not a switch you flip — it's an asset you build. Here's a realistic timeline for auto service businesses based on competitive markets.
            </p>
            <div class="space-y-8">
              {timelineSteps.map((step) => (
                <div class="flex gap-6">
                  <div class="shrink-0 w-24">
                    <span class="text-sm font-headline font-black text-blue">{step.period}</span>
                  </div>
                  <div>
                    <h3 class="text-base font-headline font-bold text-navy mb-2">{step.title}</h3>
                    <ul class="space-y-2 text-sm font-body text-gray">
                      {step.items.map((item) => (
                        <li class="flex items-start gap-2">
                          <span class="text-blue font-bold shrink-0">-</span>
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- AI and auto service marketing -->
          <div class="pt-14 pb-14 border-t border-gray-light/30">
            <h2 class="text-2xl md:text-3xl font-headline font-black text-navy tracking-tight mb-6">
              How does AI search change auto service marketing?
            </h2>
            <div class="space-y-4 text-base font-body text-gray leading-relaxed">
              <p>AI search platforms like ChatGPT, Perplexity, and Google AI Overviews are changing how customers find auto services. Instead of scrolling through 10 blue links, they ask a question and get a direct answer with cited sources. If your business isn't structured to be cited, you're invisible in this growing channel.</p>
              <p>Auto service businesses have a unique advantage in AI search: <strong class="text-dark">before/after content</strong>. A well-documented detailing transformation, a paint correction timelapse, a collision repair progression — this is the kind of original, visual content that AI models treat as a primary source. No franchise chain produces this at the individual location level.</p>
              <p>We use StarkRank's <strong class="text-dark">Capsule Technique</strong> to structure your service pages so AI platforms can extract and cite your content. Each service page opens with a direct, 40-60 word answer to the question the heading poses — exactly the format AI retrieval systems prefer.</p>
              <p>Your <a href="/aiso-score/" class="text-blue font-semibold hover:text-blue-light">AISO Score</a> tells you exactly where you stand across six dimensions of AI search readiness, benchmarked against your local competitors.</p>
            </div>
          </div>

          <!-- Compliance -->
          <div class="pt-14 border-t border-gray-light/30">
            <h2 class="text-2xl md:text-3xl font-headline font-black text-navy tracking-tight mb-6">
              Advertising compliance for auto service businesses
            </h2>
            <div class="space-y-4 text-base font-body text-gray leading-relaxed">
              <p>Auto service advertising is regulated at the federal and state level. Every piece of content we create follows these guidelines:</p>
              <ul class="space-y-3 list-none pl-0">
                <li class="flex items-start gap-3">
                  <span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span>
                  <span><strong class="text-dark">FTC Act Section 5 — Truthful Advertising:</strong> No misleading claims about service quality, turnaround times, or pricing. All claims must be substantiated and accurate.</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span>
                  <span><strong class="text-dark">Certification Claim Substantiation:</strong> ASE certification, manufacturer certifications, and specialty credentials must be current and verifiable. We never claim certifications without documentation.</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span>
                  <span><strong class="text-dark">"Starting at" Pricing Disclosure:</strong> All pricing on service pages uses clear "starting at" language with conditions disclosed. No bait-and-switch pricing structures.</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span>
                  <span><strong class="text-dark">Before/After Photo Standards:</strong> All before/after photos must represent actual work performed by your shop. No stock photos, no photos from other locations, no digitally enhanced results.</span>
                </li>
              </ul>
            </div>
          </div>

        </div>

        <!-- Sidebar (~35%) -->
        <aside class="lg:col-span-1">
          <div class="lg:sticky lg:top-8 space-y-6">
            <!-- Trust bar -->
            <div class="bg-cream border border-gray-light/40 rounded-lg p-6">
              <p class="text-xs font-label font-bold uppercase tracking-widest text-blue mb-4">We know auto service advertising rules</p>
              <div class="space-y-2 text-sm font-body text-gray">
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-blue shrink-0"></span>
                  <span>FTC Act §5 Truthful Advertising</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-blue shrink-0"></span>
                  <span>Certification Claim Substantiation</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-blue shrink-0"></span>
                  <span>"Starting at" Pricing Disclosure</span>
                </div>
              </div>
            </div>

            {relatedServices.length > 0 && (
              <div>
                <h3 class="text-xs font-label font-bold uppercase tracking-widest text-blue mb-4">Related Services</h3>
                <div class="space-y-3">
                  {relatedServices.map((related) => (
                    <Card href={`/services/${related.data.slug}/`}>
                      <h4 class="text-sm font-headline font-bold text-navy">{related.data.title}</h4>
                    </Card>
                  ))}
                </div>
              </div>
            )}

            {enCities.length > 0 && (
              <div>
                <h3 class="text-xs font-label font-bold uppercase tracking-widest text-blue mb-4">Local Pages</h3>
                <div class="space-y-3">
                  {enCities.map((c) => (
                    <Card href={c.href}>
                      <h4 class="text-sm font-headline font-bold text-navy">Auto Service SEO in {c.city}</h4>
                    </Card>
                  ))}
                </div>
              </div>
            )}
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <Section bg="white" id="pricing">
    <SectionHeader label="Pricing" title="Auto Service SEO Packages" />

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      <!-- Starter -->
      <div class="bg-cream border border-gray-light/40 rounded-lg p-6 flex flex-col">
        <h3 class="text-lg font-headline font-black text-navy mb-2">Starter</h3>
        <p class="text-xs font-label font-semibold uppercase tracking-widest text-blue mb-4">Single Location &bull; Low Competition</p>
        <p class="text-sm font-body text-gray mb-4">For auto service businesses in markets with fewer than 3 direct competitors. The essentials to get found on Google Maps and organic search.</p>
        <ul class="space-y-2 text-sm font-body text-gray mb-6 flex-1">
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">-</span> Google Business Profile optimization</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">-</span> 5 service-specific pages with FAQ schema</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">-</span> Basic before/after gallery setup</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">-</span> Review response templates</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">-</span> Initial technical SEO audit</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">-</span> Monthly performance report</li>
        </ul>
        <p class="text-2xl font-headline font-black text-navy mb-4">From $1,000/mo</p>
        <Button href="/contact/" variant="primary" size="md">Get Started</Button>
      </div>

      <!-- Growth -->
      <div class="bg-cream border-2 border-blue rounded-lg p-6 flex flex-col relative">
        <h3 class="text-lg font-headline font-black text-navy mb-2">Growth</h3>
        <p class="text-xs font-label font-semibold uppercase tracking-widest text-blue mb-4">Single Location &bull; Competitive Market</p>
        <p class="text-sm font-body text-gray mb-4">For auto service businesses competing against franchises and established independents. Everything in Starter, plus:</p>
        <ul class="space-y-2 text-sm font-body text-gray mb-6 flex-1">
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">-</span> 10+ service pages with full schema markup</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">-</span> Optimized before/after galleries (WebP, alt text, lazy loading)</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">-</span> 3 city/area pages with genuine local content</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">-</span> Active review management and generation</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">-</span> AI search optimization (AISO)</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">-</span> Quarterly AISO Score tracking</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">-</span> Competitor monitoring</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">-</span> Dedicated strategist</li>
        </ul>
        <p class="text-2xl font-headline font-black text-navy mb-4">From $2,000/mo</p>
        <Button href="/contact/" variant="primary" size="md">Let's Talk</Button>
      </div>

      <!-- Premium -->
      <div class="bg-cream border border-gray-light/40 rounded-lg p-6 flex flex-col">
        <h3 class="text-lg font-headline font-black text-navy mb-2">Premium</h3>
        <p class="text-xs font-label font-semibold uppercase tracking-widest text-blue mb-4">Multi-Location or Multi-Service</p>
        <p class="text-sm font-body text-gray mb-4">For auto service businesses with multiple locations or a wide service menu. Everything in Growth, plus:</p>
        <ul class="space-y-2 text-sm font-body text-gray mb-6 flex-1">
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">-</span> 15+ service pages across all locations</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">-</span> 5+ city/area pages</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">-</span> Multi-location GBP management</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">-</span> Monthly technical SEO audit</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">-</span> Monthly AISO Score tracking</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">-</span> Cross-location content strategy</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">-</span> Dedicated strategist</li>
        </ul>
        <p class="text-2xl font-headline font-black text-navy mb-4">From $3,500/mo</p>
        <Button href="/contact/" variant="primary" size="md">Let's Talk</Button>
      </div>
    </div>

    <!-- Comparison table -->
    <div class="overflow-x-auto">
      <table class="w-full text-sm font-body border-collapse">
        <thead>
          <tr class="border-b-2 border-navy/20">
            <th class="text-left py-3 pr-4 font-headline font-bold text-navy"></th>
            <th class="text-center py-3 px-4 font-headline font-bold text-navy">Starter</th>
            <th class="text-center py-3 px-4 font-headline font-bold text-navy">Growth</th>
            <th class="text-center py-3 px-4 font-headline font-bold text-navy">Premium</th>
          </tr>
        </thead>
        <tbody>
          {comparisonRows.map((row) => (
            <tr class="border-b border-gray-light/40">
              <td class="py-3 pr-4 text-dark">{row.feature}</td>
              <td class="py-3 px-4 text-center text-gray">
                {row.starter === true ? <span class="text-blue font-bold">&#10003;</span> : row.starter === false ? '' : row.starter}
              </td>
              <td class="py-3 px-4 text-center text-gray">
                {row.growth === true ? <span class="text-blue font-bold">&#10003;</span> : row.growth === false ? '' : row.growth}
              </td>
              <td class="py-3 px-4 text-center text-gray">
                {row.premium === true ? <span class="text-blue font-bold">&#10003;</span> : row.premium === false ? '' : row.premium}
              </td>
            </tr>
          ))}
          <tr class="border-t-2 border-navy/20">
            <td class="py-3 pr-4 font-headline font-bold text-navy">Price</td>
            <td class="py-3 px-4 text-center font-headline font-bold text-navy">From $1,000/mo</td>
            <td class="py-3 px-4 text-center font-headline font-bold text-navy">From $2,000/mo</td>
            <td class="py-3 px-4 text-center font-headline font-bold text-navy">From $3,500/mo</td>
          </tr>
          <tr>
            <td></td>
            <td class="py-3 px-4 text-center"><Button href="/contact/" variant="ghost" size="sm">Get Started</Button></td>
            <td class="py-3 px-4 text-center"><Button href="/contact/" variant="ghost" size="sm">Let's Talk</Button></td>
            <td class="py-3 px-4 text-center"><Button href="/contact/" variant="ghost" size="sm">Let's Talk</Button></td>
          </tr>
        </tbody>
      </table>
    </div>
  </Section>

  <!-- FAQ -->
  <Section bg="cream">
    <SectionHeader label="FAQ" title="Frequently Asked Questions" />
    <div class="max-w-3xl space-y-6">
      {faqItems.map((item) => (
        <details class="group bg-white border border-gray-light/40 rounded-lg">
          <summary class="flex items-center justify-between gap-4 cursor-pointer p-6 font-headline font-bold text-navy text-base md:text-lg select-none">
            {item.question}
            <svg class="w-5 h-5 shrink-0 text-blue transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
          </summary>
          <div class="px-6 pb-6 text-sm font-body text-gray leading-relaxed">
            {item.answer}
          </div>
        </details>
      ))}
    </div>
  </Section>

  <!-- CTA -->
  <CTABanner bg="navy" title="Ready to Grow Your Auto Service Business?" subtitle="Your competitors are showing up on Google Maps and AI search results. Every day without an SEO strategy is a day they capture customers who should be calling you. Start with a free AISO Score assessment.">
    <Button href="/aiso-score/" variant="primary" size="lg">Get Your Free AISO Score</Button>
    <Button href="/contact/" variant="secondary" size="lg">Request a Consultation</Button>
  </CTABanner>
</BaseLayout>
