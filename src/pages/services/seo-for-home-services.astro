---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import CTABanner from '../../components/ui/CTABanner.astro';
import { getCollection } from 'astro:content';
import { getPillarById } from '../../data/pillars';
import { getSpokePath } from '../../data/service-slugs';

const slug = 'seo-for-home-services';
const allServices = await getCollection('services');
const service = allServices.find((s) => s.data.slug === slug)!;
const pillar = getPillarById(service.data.pillar);

const relatedServices = service.data.relatedServices
  ? allServices.filter((s) => service.data.relatedServices!.includes(s.data.slug))
  : [];

const allCities = await getCollection('cities');
const enCities = allCities
  .filter((c) => c.data.locale === 'en' && c.data.services.includes(slug))
  .map((c) => ({
    city: c.data.city,
    href: `/${getSpokePath(slug, c.data.citySlug, 'en')}/`,
  }));

const title = 'SEO for Home Services — More Leads From Google & AI | StarkRank';
const description = "Stop paying aggregators for your own leads. We handle GBP, local SEO, review management, and AI search optimization for plumbers, HVAC, electricians, and contractors.";

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'SEO for Home Services',
  description: 'Home service SEO covering Google Business Profile optimization, emergency service pages, review management, seasonal content strategy, and AI search optimization for plumbers, HVAC, electricians, and contractors.',
  url: 'https://starkrank.com/services/seo-for-home-services/',
  provider: {
    '@type': 'Organization',
    name: 'StarkRank',
    url: 'https://starkrank.com',
  },
  areaServed: [
    { '@type': 'Country', name: 'United States' },
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Home Service SEO Services',
    itemListElement: [
      {
        '@type': 'Offer',
        name: 'Starter Home Service SEO',
        description: 'Single trade, small service area. Includes GBP optimization, technical audit, 5 service pages, review setup, seasonal content calendar, 1 blog per month, basic AISO, and monthly reporting with aggregator cost comparison.',
        price: '1000',
        priceCurrency: 'USD',
        priceSpecification: {
          '@type': 'UnitPriceSpecification',
          price: '1000',
          priceCurrency: 'USD',
          referenceQuantity: { '@type': 'QuantitativeValue', value: '1', unitText: 'month' },
        },
      },
      {
        '@type': 'Offer',
        name: 'Growth Home Service SEO',
        description: 'Single trade, competitive metro. Full service coverage with emergency pages, active review campaign, seasonal content strategy, 2 blogs and 1 service page per month, full AISO, and weekly rank tracking.',
        price: '2000',
        priceCurrency: 'USD',
        priceSpecification: {
          '@type': 'UnitPriceSpecification',
          price: '2000',
          priceCurrency: 'USD',
          referenceQuantity: { '@type': 'QuantitativeValue', value: '1', unitText: 'month' },
        },
      },
      {
        '@type': 'Offer',
        name: 'Premium Home Service SEO',
        description: 'Multi-trade or multi-location. All services plus city pages, all-location review management, expanded seasonal content, 4 blogs and 2 service pages per month, AISO plus AI Share of Voice, and full ROI attribution reporting.',
        price: '3500',
        priceCurrency: 'USD',
        priceSpecification: {
          '@type': 'UnitPriceSpecification',
          price: '3500',
          priceCurrency: 'USD',
          referenceQuantity: { '@type': 'QuantitativeValue', value: '1', unitText: 'month' },
        },
      },
    ],
  },
};

const faqItems = [
  {
    question: 'How long does home service SEO take to work?',
    answer: 'Most home service companies see measurable improvements in Google Maps visibility within 60-90 days. Emergency service pages often rank faster because of high intent and lower competition. Organic search traffic typically increases within 3-6 months.',
  },
  {
    question: 'Can SEO replace HomeAdvisor, Angi, and Thumbtack?',
    answer: 'Yes, for most home service companies. Those platforms rank for your keywords and sell leads back to you at $30-80 per lead, often shared with 3-4 competitors. Most clients reduce aggregator spending by 50-70% within 6 months and eliminate it within 12 months.',
  },
  {
    question: 'How important are Google reviews for home service SEO?',
    answer: 'Critical — more so than almost any other industry. Homeowners are letting a stranger into their home and check reviews before they call. Review velocity matters more than total count. We help you build sustainable review generation systems.',
  },
  {
    question: 'How do you handle seasonal demand swings?',
    answer: 'We build a seasonal content calendar that publishes relevant content before demand peaks — AC content before summer, heating before winter, roof inspection before storm season. This captures search traffic when homeowners are actively looking.',
  },
  {
    question: 'Do you work with all types of home service companies?',
    answer: 'Yes. We serve plumbers, HVAC technicians, electricians, roofers, painters, landscapers, pest control companies, cleaning services, and general contractors. Each trade gets a strategy tailored to its specific search patterns and competitive dynamics.',
  },
  {
    question: 'What if I was burned by a previous SEO agency?',
    answer: 'We show you exactly what we do, give you access to all tools and data, and report on lead acquisition metrics — not just rankings. We track cost per lead versus your aggregator costs so you see the ROI directly. Month-to-month contracts available.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const schemas = [serviceSchema, faqSchema];

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services/' },
  { label: 'SEO for Home Services', href: '/services/seo-for-home-services/' },
];

const comparisonRows = [
  { feature: 'GBP optimization', starter: true, growth: true, premium: true },
  { feature: 'Technical audit', starter: true, growth: true, premium: true },
  { feature: 'Service pages', starter: '5 services', growth: 'All services', premium: 'All + city pages' },
  { feature: 'Emergency pages', starter: false, growth: true, premium: true },
  { feature: 'Review management', starter: 'Setup only', growth: 'Active campaign', premium: 'All locations' },
  { feature: 'Seasonal content', starter: 'Calendar only', growth: 'Full strategy', premium: 'Full + proactive' },
  { feature: 'Content (monthly)', starter: '1 blog', growth: '2 blogs + 1 page', premium: '4 blogs + 2 pages' },
  { feature: 'AI search optimization', starter: 'Basic AISO', growth: 'Full AISO', premium: 'AISO + AI SoV' },
  { feature: 'Reporting', starter: 'Monthly', growth: 'Weekly rank tracking', premium: 'ROI attribution' },
];
---

<BaseLayout
  title={title}
  description={description}
  schema={schemas}
>
  <!-- Hero -->
  <Section bg="cream">
    <Breadcrumbs items={breadcrumbs} />

    <span class="text-xs font-label font-semibold uppercase tracking-[0.2em] text-blue mb-3 block">
      {pillar?.tagline}
    </span>
    <h1 class="text-4xl md:text-5xl font-headline font-black tracking-tight text-navy">
      SEO for Home Services — More Leads From Google &amp; AI Search
    </h1>
    <p class="mt-4 text-lg text-gray font-body leading-relaxed max-w-3xl">
      HomeAdvisor, Angi, and Thumbtack rank for your keywords and sell your own leads back to you at $30-80 each — often shared with three other contractors. You're funding their SEO instead of building your own. We change that. We build the local search presence, review profile, and AI visibility that puts leads directly into your pipeline — no middleman, no per-lead fees, and an asset that compounds over time.
    </p>

    <div class="mt-8 flex flex-wrap gap-4">
      <Button href="/aiso-score/" variant="primary" size="lg">Get Your Free AISO Score</Button>
      <Button href="#whats-included" variant="ghost" size="lg">See What's Included</Button>
    </div>

    <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs font-body text-gray">
      <span>
        Last updated: <time datetime="2026-03-26">March 2026</time>
      </span>
      <span>
        By <a href="/about/" class="text-blue hover:text-blue-light font-semibold">Wilko Feye</a>, StarkRank
      </span>
    </div>
  </Section>

  <!-- Main content + sidebar -->
  <section class="bg-white">
    <div class="max-w-7xl mx-auto px-6 py-16 md:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Main content (~65%) -->
        <div class="lg:col-span-2 space-y-0">

          <!-- Why home service companies need SEO -->
          <div class="pb-14">
            <h2 class="text-2xl md:text-3xl font-headline font-black text-navy tracking-tight mb-6">
              Why home service companies need SEO in 2026
            </h2>
            <div class="space-y-4 text-base font-body text-gray leading-relaxed">
              <p>Local search is the most competitive channel for home service companies. Google's Local Pack now shows three results — if you're not in that top three for "plumber near me," "AC repair," or "emergency electrician," the homeowner calls whoever is. Paid ads can supplement, but they stop the moment you stop paying. SEO builds a durable asset that generates leads month after month.</p>
              <p>The aggregator problem is real and getting worse. HomeAdvisor, Angi, and Thumbtack spend millions on SEO to rank for your service keywords, then sell those leads back to you at $30-80 each — often shared with three or four competitors. You're paying for your own leads and competing on price to win them. Every dollar you invest in your own SEO is a dollar that builds equity in your business instead of theirs.</p>
              <p>AI search is the next front. ChatGPT, Perplexity, and Google AI Overviews now answer home service questions directly and recommend companies by name. When a homeowner asks "best plumber near me" or "how much does AC repair cost," AI platforms cite businesses with strong entity signals, verified reviews, and structured content. If your business isn't built for AI retrieval, you're invisible in a channel that's growing faster than any other in search.</p>
            </div>
          </div>

          <!-- What's included -->
          <div id="whats-included-detail" class="pt-14 pb-14 border-t border-gray-light/30">
            <h2 class="text-2xl md:text-3xl font-headline font-black text-navy tracking-tight mb-6">
              What's included in home service SEO
            </h2>
            <div class="space-y-4 text-base font-body text-gray leading-relaxed">
              <p>Every engagement is tailored to your trade and market, but the core deliverables cover the full spectrum of home service search visibility:</p>
              <ul class="space-y-3 list-none pl-0">
                <li class="flex items-start gap-3">
                  <span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span>
                  <span><strong class="text-dark">Google Business Profile optimization</strong> — 25+ photos, weekly posts, Q&amp;A management, category optimization, and booking link setup</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span>
                  <span><strong class="text-dark">Service-specific pages</strong> — dedicated pages for every service you offer (plumbing, HVAC, electrical, roofing, painting) with FAQ schema and localized content</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span>
                  <span><strong class="text-dark">Emergency service pages</strong> — high-intent pages for burst pipes, AC failures, electrical outages, and roof leaks that capture urgent searches</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span>
                  <span><strong class="text-dark">City and service area pages</strong> — genuine local content for each city and neighborhood you serve, not templated doorway pages</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span>
                  <span><strong class="text-dark">Technical SEO audit</strong> — site speed, mobile usability, crawl errors, structured data (HomeAndConstructionBusiness schema), and Core Web Vitals</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span>
                  <span><strong class="text-dark">Review management</strong> — review solicitation workflows, response drafting, velocity monitoring, and reputation tracking across Google, Yelp, and BBB</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span>
                  <span><strong class="text-dark">AI search optimization</strong> — AISO Score assessment, entity verification, answer-first content restructuring, and AI citation monitoring</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span>
                  <span><strong class="text-dark">Seasonal content strategy</strong> — content calendar aligned to demand cycles: AC before summer, heating before winter, roof inspections before storm season</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span>
                  <span><strong class="text-dark">Monthly reporting</strong> — lead acquisition metrics (calls, form fills, bookings) with aggregator cost comparison so you see the ROI versus HomeAdvisor/Angi spend</span>
                </li>
              </ul>
            </div>
          </div>

          <!-- Results timeline -->
          <div class="pt-14 pb-14 border-t border-gray-light/30">
            <h2 class="text-2xl md:text-3xl font-headline font-black text-navy tracking-tight mb-6">
              What results to expect and when
            </h2>
            <div class="space-y-4 text-base font-body text-gray leading-relaxed">
              <p><strong class="text-dark">30 days:</strong> Technical foundation complete. GBP fully optimized with photos, posts, and correct categories. Technical audit issues resolved. Review solicitation workflow live. Emergency service pages published and indexed. You'll see GBP insights improving within weeks.</p>
              <p><strong class="text-dark">60-90 days:</strong> Google Maps visibility improves for core services. First service-specific pages ranking. Review velocity increasing. AISO Score baseline established. Most companies see a measurable increase in direct calls and form submissions by this point — and a noticeable decrease in aggregator dependency.</p>
              <p><strong class="text-dark">6 months:</strong> Organic search traffic increasing for service and location keywords. City pages driving leads from surrounding areas. AI search citations beginning to appear. Seasonal content capturing demand peaks. Most clients reduce aggregator spending by 50-70% by this point as direct leads increase.</p>
              <p><strong class="text-dark">12 months:</strong> Dominant local presence for core services and areas. Strong review profile with consistent velocity. AI platforms citing your business for service queries. Lead acquisition cost from organic significantly lower than aggregator or paid channels. Most clients have eliminated aggregator dependency entirely. The gap between you and competitors who aren't investing in SEO is now substantial.</p>
            </div>
          </div>

          <!-- AI and home service marketing -->
          <div class="pt-14 pb-14 border-t border-gray-light/30">
            <h2 class="text-2xl md:text-3xl font-headline font-black text-navy tracking-tight mb-6">
              How AI is changing home service marketing
            </h2>
            <div class="space-y-4 text-base font-body text-gray leading-relaxed">
              <p>Homeowners are increasingly asking AI assistants for help: "Who's the best plumber near me?" "How much does it cost to replace an AC unit?" "I have a burst pipe — what do I do?" When ChatGPT or Google AI Overviews answers these questions, they cite specific businesses and sources. Emergency searches are especially impactful — a homeowner with a flooded basement at 2 AM is asking whatever device is closest for immediate help. If your business isn't structured for AI retrieval, you're invisible in these high-intent moments.</p>
              <p>We structure your content using the Capsule Technique — answer-first paragraphs of 40-60 words placed directly under question-phrased headings. This is exactly how AI models extract and cite information. Combined with proper HomeAndConstructionBusiness schema markup, entity verification, and AI crawler access, your business becomes a source that AI platforms reference by name.</p>
              <p>Every home service SEO engagement includes an <a href="/aiso-score/" class="text-blue font-semibold hover:text-blue-light">AISO Score assessment</a> — our proprietary framework for measuring AI search readiness across six dimensions. It shows you exactly where you stand compared to competing contractors and what to fix first.</p>
            </div>
          </div>

          <!-- Compliance section -->
          <div class="pt-14 border-t border-gray-light/30">
            <h2 class="text-2xl md:text-3xl font-headline font-black text-navy tracking-tight mb-6">
              Compliance built into every deliverable
            </h2>
            <div class="space-y-4 text-base font-body text-gray leading-relaxed">
              <p>Home service marketing operates under licensing and advertising requirements that vary by state and trade. Every piece of content we produce is built with compliance in mind from the start — not checked after the fact.</p>
              <ul class="space-y-3 list-none pl-0">
                <li class="flex items-start gap-3">
                  <span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span>
                  <span><strong class="text-dark">FL Statute 489.119</strong> — All advertising includes the contractor's license number as required. We verify license status before publishing any content that references credentials or certifications.</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span>
                  <span><strong class="text-dark">FTC Act &sect;5</strong> — All testimonials and endorsements comply with FTC disclosure requirements. No deceptive claims, no fake reviews, no undisclosed material connections. Pricing claims are accurate and verifiable.</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span>
                  <span><strong class="text-dark">Insurance verification</strong> — Content references to insurance, bonding, and licensing are verified before publication. We never claim coverage that isn't current and documented.</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="w-2 h-2 rounded-full bg-blue mt-2 shrink-0"></span>
                  <span><strong class="text-dark">BBB Standards</strong> — Marketing materials align with Better Business Bureau advertising standards, including truthful representation of services, transparent pricing, and honest claims about experience and qualifications.</span>
                </li>
              </ul>
            </div>
          </div>

        </div>

        <!-- Sidebar (~35%) -->
        <aside class="lg:col-span-1">
          <div class="lg:sticky lg:top-8 space-y-6">
            <!-- Trust bar -->
            <div class="bg-cream border border-gray-light/40 rounded-lg p-6">
              <p class="text-xs font-label font-bold uppercase tracking-widest text-blue mb-4">We know home service compliance</p>
              <div class="space-y-2 text-sm font-body text-gray">
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-blue shrink-0"></span>
                  <span>FL Statute 489.119</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-blue shrink-0"></span>
                  <span>FTC Act &sect;5</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-blue shrink-0"></span>
                  <span>Insurance Verification</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-blue shrink-0"></span>
                  <span>BBB Standards</span>
                </div>
              </div>
            </div>

            {relatedServices.length > 0 && (
              <div>
                <h3 class="text-xs font-label font-bold uppercase tracking-widest text-blue mb-4">Related Services</h3>
                <div class="space-y-3">
                  {relatedServices.map((related) => (
                    <Card href={`/services/${related.data.slug}/`}>
                      <h4 class="text-sm font-headline font-bold text-navy">{related.data.title}</h4>
                    </Card>
                  ))}
                </div>
              </div>
            )}

            {enCities.length > 0 && (
              <div>
                <h3 class="text-xs font-label font-bold uppercase tracking-widest text-blue mb-4">Local Pages</h3>
                <div class="space-y-3">
                  {enCities.map((c) => (
                    <Card href={c.href}>
                      <h4 class="text-sm font-headline font-bold text-navy">SEO for Home Services in {c.city}</h4>
                    </Card>
                  ))}
                </div>
              </div>
            )}
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <Section bg="white" id="whats-included">
    <SectionHeader label="Packages" title="Home Service SEO Pricing" />

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      <!-- Starter -->
      <div class="bg-cream border border-gray-light/40 rounded-lg p-6 flex flex-col">
        <h3 class="text-lg font-headline font-black text-navy mb-2">Starter</h3>
        <p class="text-xs font-label font-semibold uppercase tracking-widest text-blue mb-4">Single Trade, Small Area</p>
        <p class="text-sm font-body text-gray mb-4">For single-trade companies in smaller service areas with fewer than 3 direct competitors. The essentials to get your GBP and core services ranking.</p>
        <ul class="space-y-2 text-sm font-body text-gray mb-6 flex-1">
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">-</span> Google Business Profile optimization</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">-</span> Technical SEO audit + fixes</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">-</span> 5 service-specific pages</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">-</span> Review solicitation setup</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">-</span> Seasonal content calendar</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">-</span> 1 blog post per month</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">-</span> Basic AISO Score assessment</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">-</span> Monthly reporting with aggregator cost comparison</li>
        </ul>
        <p class="text-2xl font-headline font-black text-navy mb-4">$1,000/mo</p>
        <Button href="/contact/" variant="primary" size="md">Get Started</Button>
      </div>

      <!-- Growth -->
      <div class="bg-cream border-2 border-blue rounded-lg p-6 flex flex-col relative">
        <h3 class="text-lg font-headline font-black text-navy mb-2">Growth</h3>
        <p class="text-xs font-label font-semibold uppercase tracking-widest text-blue mb-4">Single Trade, Competitive Metro</p>
        <p class="text-sm font-body text-gray mb-4">For single-trade companies in competitive metro areas. Full service coverage with emergency pages and active review and content campaigns.</p>
        <ul class="space-y-2 text-sm font-body text-gray mb-6 flex-1">
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">-</span> Everything in Starter</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">-</span> All service pages + emergency pages</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">-</span> Active review campaign with response drafting</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">-</span> Full seasonal content strategy</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">-</span> 2 blog posts + 1 service page per month</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">-</span> Full AISO Score + optimization</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">-</span> Weekly rank tracking</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">-</span> Competitor monitoring</li>
        </ul>
        <p class="text-2xl font-headline font-black text-navy mb-4">$2,000/mo</p>
        <Button href="/contact/" variant="primary" size="md">Get Started</Button>
      </div>

      <!-- Premium -->
      <div class="bg-cream border border-gray-light/40 rounded-lg p-6 flex flex-col">
        <h3 class="text-lg font-headline font-black text-navy mb-2">Premium</h3>
        <p class="text-xs font-label font-semibold uppercase tracking-widest text-blue mb-4">Multi-Trade / Multi-Location</p>
        <p class="text-sm font-body text-gray mb-4">For multi-trade or multi-location companies. Per-location optimization with centralized management and ROI attribution.</p>
        <ul class="space-y-2 text-sm font-body text-gray mb-6 flex-1">
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">-</span> Everything in Growth, per location</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">-</span> All services + city/area pages</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">-</span> Active review campaign, all locations</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">-</span> Full seasonal content + proactive storm/weather pages</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">-</span> 4 blog posts + 2 service pages per month</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">-</span> AISO + AI Share of Voice tracking</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">-</span> Full ROI attribution reporting</li>
          <li class="flex items-start gap-2"><span class="text-blue font-bold shrink-0">-</span> Dedicated account strategist</li>
        </ul>
        <p class="text-2xl font-headline font-black text-navy mb-4">$3,500/mo</p>
        <Button href="/contact/" variant="primary" size="md">Let's Talk</Button>
      </div>
    </div>

    <!-- Comparison table -->
    <div class="overflow-x-auto">
      <table class="w-full text-sm font-body border-collapse">
        <thead>
          <tr class="border-b-2 border-navy/20">
            <th class="text-left py-3 pr-4 font-headline font-bold text-navy"></th>
            <th class="text-center py-3 px-4 font-headline font-bold text-navy">Starter</th>
            <th class="text-center py-3 px-4 font-headline font-bold text-navy">Growth</th>
            <th class="text-center py-3 px-4 font-headline font-bold text-navy">Premium</th>
          </tr>
        </thead>
        <tbody>
          {comparisonRows.map((row) => (
            <tr class="border-b border-gray-light/40">
              <td class="py-3 pr-4 text-dark">{row.feature}</td>
              <td class="py-3 px-4 text-center text-gray">
                {row.starter === true ? <span class="text-blue font-bold">&#10003;</span> : row.starter === false ? '' : row.starter}
              </td>
              <td class="py-3 px-4 text-center text-gray">
                {row.growth === true ? <span class="text-blue font-bold">&#10003;</span> : row.growth === false ? '' : row.growth}
              </td>
              <td class="py-3 px-4 text-center text-gray">
                {row.premium === true ? <span class="text-blue font-bold">&#10003;</span> : row.premium === false ? '' : row.premium}
              </td>
            </tr>
          ))}
          <tr class="border-t-2 border-navy/20">
            <td class="py-3 pr-4 font-headline font-bold text-navy">Price</td>
            <td class="py-3 px-4 text-center font-headline font-bold text-navy">$1,000/mo</td>
            <td class="py-3 px-4 text-center font-headline font-bold text-navy">$2,000/mo</td>
            <td class="py-3 px-4 text-center font-headline font-bold text-navy">$3,500/mo</td>
          </tr>
          <tr>
            <td></td>
            <td class="py-3 px-4 text-center"><Button href="/contact/" variant="ghost" size="sm">Get Started</Button></td>
            <td class="py-3 px-4 text-center"><Button href="/contact/" variant="ghost" size="sm">Get Started</Button></td>
            <td class="py-3 px-4 text-center"><Button href="/contact/" variant="ghost" size="sm">Let's Talk</Button></td>
          </tr>
        </tbody>
      </table>
    </div>
  </Section>

  <!-- FAQ -->
  <Section bg="cream">
    <SectionHeader label="FAQ" title="Frequently Asked Questions" />
    <div class="max-w-3xl space-y-6">
      {faqItems.map((item) => (
        <details class="group bg-white border border-gray-light/40 rounded-lg">
          <summary class="flex items-center justify-between gap-4 cursor-pointer p-6 font-headline font-bold text-navy text-base md:text-lg select-none">
            {item.question}
            <svg class="w-5 h-5 shrink-0 text-blue transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
          </summary>
          <div class="px-6 pb-6 text-sm font-body text-gray leading-relaxed">
            {item.answer}
          </div>
        </details>
      ))}
    </div>
  </Section>

  <!-- CTA -->
  <CTABanner bg="navy" title="Ready to Stop Paying for Your Own Leads?" subtitle="HomeAdvisor, Angi, and Thumbtack are ranking for your keywords and selling your leads back to you. Every month without your own SEO strategy is a month they profit from your reputation. Start with a free AISO Score to see where you stand.">
    <Button href="/aiso-score/" variant="primary" size="lg">Get Your Free AISO Score</Button>
    <Button href="/contact/" variant="secondary" size="lg">Book a Call</Button>
  </CTABanner>
</BaseLayout>
