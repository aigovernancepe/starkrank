---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SplitHero from '../../components/ui/SplitHero.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Card from '../../components/ui/Card.astro';
import BuildingGraphicStatic from '../../components/ui/BuildingGraphicStatic.astro';
import { getCollection } from 'astro:content';
import { getLocalizedPillars } from '../../data/pillars';
import { getLocalizedNavHref } from '../../data/navigation';
import { t } from '../../utils/i18n';

const pillars = getLocalizedPillars('de');
const allServices = await getCollection('services');
const deServiceHubs = await getCollection('serviceHubs', (h) => h.data.locale === 'de');

// Orphan hubs: DE service hubs whose serviceSlug isn't in any pillar's services list.
// Phase 2a retired some EN canonical services from pillars (e.g. performance-web-development),
// but Phase 3d shipped DE keyword hubs for them (webagentur-deutschland). Surface them
// under their underlying service's pillar so the catalog mirrors the actual hub footprint.
const pillarServiceSlugs = new Set(pillars.flatMap((p) => p.services));
const orphanServices = deServiceHubs
  .filter((h) => !pillarServiceSlugs.has(h.data.serviceSlug))
  .map((h) => allServices.find((s) => s.data.slug === h.data.serviceSlug))
  .filter((s): s is NonNullable<typeof s> => Boolean(s));

// Service-hub frontmatter holds the German description; the canonical service
// file's description is EN-only. Fall back to a curated map for the 3 flat-
// locale services that have no service-hub entry (AISO, ecommerce, E-E-A-T).
const flatLocaleDescriptionsDe: Record<string, string> = {
  'ai-search-optimization': 'ChatGPT und Google AI zitieren Ihre Konkurrenz — aber nicht Sie. Kostenloser AI Search Optimization Check in 24 Stunden. 2 Dimensionen geprüft. Unverbindlich.',
  'ecommerce-seo-audit': 'Produktkatalog-SEO ist eine eigene Disziplin. Wir prüfen die 8 Schwachstellen Ihrer PDPs, PLPs und Filternavigation — Lieferung in 7 Tagen.',
  'eeat-audit': 'Echtes E-E-A-T wird gezeigt, nicht behauptet. Wir bewerten Ihre Seite nach einer 40-Punkte-Rubrik mit signal-basierter Remediation. 1.200 € pauschal.',
};

function getDeDescription(slug: string, fallbackEn: string): string {
  const hub = deServiceHubs.find((h) => h.data.serviceSlug === slug);
  if (hub) return hub.data.description;
  return flatLocaleDescriptionsDe[slug] ?? fallbackEn;
}

const servicesByPillar = pillars.map((pillar) => {
  const baseServices = pillar.services
    .map((slug) => allServices.find((s) => s.data.slug === slug))
    .filter((s): s is NonNullable<typeof s> => Boolean(s));
  const extraServices = orphanServices.filter((s) => s.data.pillar === pillar.id);
  return { pillar, services: [...baseServices, ...extraServices] };
});
---

<BaseLayout
  title="Dienstleistungen — StarkRank"
  description="Das vollständige StarkRank-Leistungsspektrum: KI-Suchoptimierung, technisches SEO, Google Ads, Content-Marketing, E-E-A-T-Audits und Analytics-Beratung für Unternehmen in Deutschland und der Schweiz."
  locale="de"
>
  <SplitHero
    headline="Unsere Dienstleistungen"
    subheadline="Datenbasiertes Wachstum von KI-Suchintelligenz bis zu transparenter Messung — fokussiert auf Unternehmen im Nordwesten."
    image="/images/services-hero.webp"
    imageAlt="StarkRank-Team in detaillierter Strategie-Diskussion an einer gedruckten Wireframe-Skizze, Tageslicht und Stadtblick durchs Fenster — drei Teammitglieder im fokussierten Austausch."
    imagePosition="center top"
  />

  <Section bg="white">
    <SectionHeader
      label="Übersicht"
      title="Fünf Bausteine des digitalen Wachstums"
      subtitle="Vier Bausteine des digitalen Marketings stehen auf dem Fundament Daten & Web. Klicken Sie einen Baustein an, um direkt zum Leistungsbereich zu springen."
      align="center"
    />
    <BuildingGraphicStatic linked />
  </Section>

  {servicesByPillar.map(({ pillar, services }, idx) => (
    <Section bg={idx % 2 === 0 ? 'cream' : 'white'} id={pillar.id} class="scroll-mt-20">
      <SectionHeader
        label={pillar.tagline}
        title={pillar.name}
        subtitle={pillar.description}
        align="center"
      />
      {pillar.id === 'performance-media' && (
        <p class="mt-4 mb-8 text-sm font-body text-gray leading-relaxed max-w-3xl mx-auto text-center">
          Auch bekannt als <strong>SEA-Agentur</strong> (Search Engine Advertising) — StarkRank bietet Google Ads Management, Google Ads Audit und Paid Social Strategy.
        </p>
      )}
      {pillar.id === 'search-ai-intelligence' && (
        <p class="mt-4 mb-8 text-sm font-body text-gray leading-relaxed max-w-3xl mx-auto text-center">
          Auch bekannt als <strong>LLMO-Agentur</strong> (Large Language Model Optimization) — StarkRank bietet Optimierung dafür, dass Ihre Marke in ChatGPT, Perplexity, Claude, Copilot und Google AI Overviews zitiert und empfohlen wird.
        </p>
      )}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map((service) => (
          <Card href={getLocalizedNavHref(`/services/${service.data.slug}/`, 'de')}>
            <h3 class="text-lg font-headline font-bold text-navy">{t('service.' + service.data.slug, 'de')}</h3>
            <p class="mt-2 text-sm font-body text-gray leading-relaxed">{getDeDescription(service.data.slug, service.data.description)}</p>
          </Card>
        ))}
      </div>

      {pillar.id === 'content-copywriting' && (
        <div class="mt-12 pt-10 border-t border-gray-light/40">
          <h3 class="text-xs font-label font-bold uppercase tracking-[0.2em] text-blue mb-2 text-center">Content-Produkte</h3>
          <p class="text-sm font-body text-gray leading-relaxed mb-6 max-w-2xl mx-auto text-center">Strukturierte First-Party-Assets, die jede Content-Pipeline mit nicht-generischem Expertenwissen speisen — ergänzend zum Content-Marketing-Retainer oder standalone buchbar.</p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <Card href="/expertenbibliothek/">
              <span class="text-xs font-label font-semibold uppercase tracking-wide text-blue">Ab 2.100 €</span>
              <h4 class="mt-2 text-lg font-headline font-bold text-navy">Expertenbibliothek</h4>
              <p class="mt-2 text-sm font-body text-gray leading-relaxed">Personen-spezifisch. Das gesamte Wissen Ihres Gründers über seine Praxis — Fallstudien, konträre Positionen, Frameworks — einmal im Onboarding als kanonische Datei gebaut, aus der Ihr Content-Team täglich schöpft.</p>
            </Card>
            <Card href="/experteninterview/">
              <span class="text-xs font-label font-semibold uppercase tracking-wide text-blue">Ab 700 €</span>
              <h4 class="mt-2 text-lg font-headline font-bold text-navy">Experteninterview</h4>
              <p class="mt-2 text-sm font-body text-gray leading-relaxed">Themen-spezifisch. Gezielte Fragen an Ihren Experten zu einer einzelnen Content-Initiative — extrahiert Fallstudien, konträre Winkel und Workflow-Details, die generische KI-Texte nicht erfinden können.</p>
            </Card>
          </div>
        </div>
      )}
    </Section>
  ))}
</BaseLayout>
