---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/ui/HeroSection.astro';
import Section from '../../components/ui/Section.astro';
import Button from '../../components/ui/Button.astro';
---

<BaseLayout
  title="Free Google Ads Audit — StarkRank"
  description="Stop wasting ad spend. Get a free, comprehensive Google Ads audit from StarkRank to find where your budget is leaking and how to maximise ROI."
>
  <HeroSection
    headline="Free Google Ads Audit"
    subheadline="Stop guessing. We'll analyse your campaigns, find the leaks, and show you exactly how to improve your ROI."
  >
    <Button href="#audit-form" variant="primary" size="lg">Request Your Audit</Button>
  </HeroSection>

  <Section bg="cream" id="audit-form">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
      <div>
        <h2 class="text-3xl font-headline font-black text-navy mb-6">What We Analyse</h2>
        <ul class="space-y-4">
          {[
            'Account structure and campaign architecture',
            'Keyword targeting and negative keyword gaps',
            'Ad copy effectiveness and quality scores',
            'Conversion tracking and attribution accuracy',
            'Auction insights and competitive positioning',
            'Budget allocation and wasted spend identification',
          ].map((item) => (
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-blue mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <span class="text-sm font-body text-dark">{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <form class="space-y-6 contact-form" data-success="Thank you! We've received your audit request and will be in touch within 24 hours." data-error="Something went wrong. Please try again or email us at contact@starkrank.com.">
          <input type="hidden" name="access_key" value="c6c510f0-14d6-42e3-b16b-c4db8ac4e71b" />
          <input type="hidden" name="subject" value="Free Google Ads Audit Request" />
          <input type="hidden" name="from_name" value="StarkRank — Ads Audit" />
          <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

          <div>
            <label for="name" class="block text-sm font-label font-semibold uppercase tracking-wide text-dark mb-2">Name</label>
            <input type="text" id="name" name="name" required class="w-full px-4 py-3 border border-gray-light rounded-md font-body text-dark bg-white focus:border-blue focus:outline-none" />
          </div>
          <div>
            <label for="email" class="block text-sm font-label font-semibold uppercase tracking-wide text-dark mb-2">Email</label>
            <input type="email" id="email" name="email" required class="w-full px-4 py-3 border border-gray-light rounded-md font-body text-dark bg-white focus:border-blue focus:outline-none" />
          </div>
          <div>
            <label for="ads-url" class="block text-sm font-label font-semibold uppercase tracking-wide text-dark mb-2">Website URL</label>
            <input type="url" id="ads-url" name="url" required class="w-full px-4 py-3 border border-gray-light rounded-md font-body text-dark bg-white focus:border-blue focus:outline-none" />
          </div>
          <div>
            <label for="spend" class="block text-sm font-label font-semibold uppercase tracking-wide text-dark mb-2">Monthly Ad Spend</label>
            <select id="spend" name="spend" class="w-full px-4 py-3 border border-gray-light rounded-md font-body text-dark bg-white focus:border-blue focus:outline-none">
              <option>Under $1,000</option>
              <option>$1,000 – $5,000</option>
              <option>$5,000 – $20,000</option>
              <option>$20,000+</option>
            </select>
          </div>

          <div>
            <button type="submit" class="inline-flex items-center justify-center font-label font-semibold uppercase tracking-wide transition-all rounded-md bg-blue text-white hover:bg-blue-light px-8 py-4 text-sm">
              <span class="submit-text">Request Free Audit</span>
              <svg class="submit-spinner hidden w-5 h-5 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            </button>
          </div>

          <div class="form-status hidden rounded-lg p-4 text-sm font-body"></div>
        </form>
      </div>
    </div>
  </Section>
</BaseLayout>

<script>
  function initForms() {
    document.querySelectorAll('.contact-form').forEach((form) => {
      if ((form as HTMLFormElement).dataset.initialized) return;
      (form as HTMLFormElement).dataset.initialized = 'true';

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const f = e.target as HTMLFormElement;
        const submitText = f.querySelector('.submit-text') as HTMLElement;
        const spinner = f.querySelector('.submit-spinner') as HTMLElement;
        const status = f.querySelector('.form-status') as HTMLElement;
        const button = f.querySelector('button[type="submit"]') as HTMLButtonElement;

        submitText.classList.add('hidden');
        spinner.classList.remove('hidden');
        button.disabled = true;
        status.classList.add('hidden');

        try {
          const res = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(Object.fromEntries(new FormData(f))),
          });
          const data = await res.json();

          if (data.success) {
            status.textContent = f.dataset.success || 'Message sent!';
            status.className = 'form-status rounded-lg p-4 text-sm font-body bg-blue/10 text-blue border border-blue/20';
            f.reset();
          } else {
            status.textContent = f.dataset.error || 'Something went wrong.';
            status.className = 'form-status rounded-lg p-4 text-sm font-body bg-red-50 text-red-700 border border-red-200';
          }
        } catch {
          status.textContent = f.dataset.error || 'Something went wrong.';
          status.className = 'form-status rounded-lg p-4 text-sm font-body bg-red-50 text-red-700 border border-red-200';
        }

        submitText.classList.remove('hidden');
        spinner.classList.add('hidden');
        button.disabled = false;
      });
    });
  }

  initForms();
  document.addEventListener('astro:after-swap', initForms);
</script>
