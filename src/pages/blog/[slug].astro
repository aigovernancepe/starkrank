---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  author: { '@type': 'Organization', name: 'StarkRank' },
  publisher: { '@id': 'https://starkrank.com/#organization' },
  url: `https://starkrank.com/blog/${post.id}/`,
};

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Blog', href: '/blog/' },
  { label: post.data.title, href: `/blog/${post.id}/` },
];
---

<BaseLayout
  title={`${post.data.title} — StarkRank`}
  description={post.data.description}
  schema={articleSchema}
>
  <Section bg="cream">
    <Breadcrumbs items={breadcrumbs} />
    <article class="max-w-3xl">
      <time class="text-xs font-label font-semibold uppercase tracking-wide text-blue">
        {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
      <h1 class="mt-3 text-4xl md:text-5xl font-headline font-black tracking-tight text-navy">
        {post.data.title}
      </h1>
      <div class="mt-8 prose prose-lg max-w-none font-body text-dark">
        <Content />
      </div>
    </article>
  </Section>
</BaseLayout>
