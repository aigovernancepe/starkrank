---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import CookieConsent from '../components/global/CookieConsent.astro';
import { getLangAttribute, getHreflangAlternates } from '../utils/i18n';
import type { Locale } from '../data/locales';

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  ogImage?: string;
  canonical?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noViewTransitions?: boolean;
}

const {
  title,
  description,
  locale = 'en',
  ogImage = '/SR-Logo-standard_high-res.png',
  canonical,
  schema,
  noViewTransitions = false,
} = Astro.props;

const lang = getLangAttribute(locale);
const site = Astro.site?.origin ?? 'https://starkrank.com';
const canonicalUrl = canonical ?? `${site}${Astro.url.pathname}`;
const alternates = getHreflangAlternates(Astro.url.pathname, site);
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${site}${ogImage}`;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Preconnect to 3rd-party origins used on the critical path -->
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    <link rel="preconnect" href="https://js-eu1.hsforms.net" crossorigin />
    <link rel="preconnect" href="https://js-eu1.hs-scripts.com" crossorigin />
    <link rel="preconnect" href="https://js-eu1.hs-analytics.net" crossorigin />
    <link rel="preconnect" href="https://js-eu1.hs-banner.net" crossorigin />
    <link rel="preconnect" href="https://track-eu1.hubspot.com" crossorigin />
    <link rel="preconnect" href="https://forms-eu1.hsforms.net" crossorigin />

    {!noViewTransitions && <ClientRouter />}

    <!-- Google Consent Mode v2 — defaults must be set before gtag loads -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        wait_for_update: 500,
      });
      // Restore consent if previously accepted
      if (localStorage.getItem('cookie-consent') === 'granted') {
        gtag('consent', 'update', {
          analytics_storage: 'granted',
          ad_storage: 'granted',
          ad_user_data: 'granted',
          ad_personalization: 'granted',
        });
      }
    </script>

    <!-- GA4 — respects consent mode, loads in denied state by default -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-FCS0HH5VC0"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-FCS0HH5VC0');
    </script>

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Hreflang -->
    {alternates.map(({ hreflang, href }) => (
      <link rel="alternate" hreflang={hreflang} href={href} />
    ))}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="StarkRank" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512x512.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Set lead_source_page URL param for HubSpot hidden field pre-population -->
    <script is:inline>
      (function() {
        var url = new URL(window.location);
        if (!url.searchParams.has('lead_source_page')) {
          url.searchParams.set('lead_source_page', window.location.pathname);
          history.replaceState(null, '', url);
        }
      })();
    </script>
    <!-- Font preloads -->
    <link rel="preload" href="/fonts/InterTight-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/DMSans-latin.woff2" as="font" type="font/woff2" crossorigin />

    <!-- JSON-LD Schema -->
    {schema && (
      Array.isArray(schema)
        ? schema.map((s) => (
            <script type="application/ld+json" set:html={JSON.stringify(s)} />
          ))
        : <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}

    <slot name="head" />
  </head>
  <body class="bg-cream text-dark antialiased">
    <Header locale={locale} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
    <CookieConsent locale={locale} />

    <!-- HubSpot Tracking Code — loaded on idle to keep the LCP path clear -->
    <script is:inline>
      (function(){
        function load(){
          if (document.getElementById('hs-script-loader')) return;
          var s = document.createElement('script');
          s.id = 'hs-script-loader';
          s.async = true;
          s.defer = true;
          s.src = '//js-eu1.hs-scripts.com/148108624.js';
          document.body.appendChild(s);
        }
        if ('requestIdleCallback' in window) {
          requestIdleCallback(load, { timeout: 4000 });
        } else {
          addEventListener('load', function(){ setTimeout(load, 2000); });
        }
      })();
    </script>
  </body>
</html>
