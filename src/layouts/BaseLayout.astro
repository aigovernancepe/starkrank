---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import CookieConsent from '../components/global/CookieConsent.astro';
import { getLangAttribute, getHreflangAlternates } from '../utils/i18n';
import type { Locale } from '../data/locales';

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  ogImage?: string;
  canonical?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noViewTransitions?: boolean;
}

const {
  title,
  description,
  locale = 'en',
  ogImage = '/images/logos/starkrank-dark-avatar.svg',
  canonical,
  schema,
  noViewTransitions = false,
} = Astro.props;

const lang = getLangAttribute(locale);
const site = Astro.site?.origin ?? 'https://starkrank.com';
const canonicalUrl = canonical ?? `${site}${Astro.url.pathname}`;
const alternates = getHreflangAlternates(Astro.url.pathname, site);
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${site}${ogImage}`;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {!noViewTransitions && <ClientRouter />}

    <!-- Google Consent Mode v2 — defaults must be set before gtag loads -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        wait_for_update: 500,
      });
      // Restore consent if previously accepted
      if (localStorage.getItem('cookie-consent') === 'granted') {
        gtag('consent', 'update', {
          analytics_storage: 'granted',
          ad_storage: 'granted',
          ad_user_data: 'granted',
          ad_personalization: 'granted',
        });
      }
    </script>

    <!-- GA4 — respects consent mode, loads in denied state by default -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-FCS0HH5VC0"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-FCS0HH5VC0');
    </script>

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Hreflang -->
    {alternates.map(({ hreflang, href }) => (
      <link rel="alternate" hreflang={hreflang} href={href} />
    ))}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="StarkRank" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512x512.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- HubSpot Forms -->
    <script is:inline src="https://js-eu1.hsforms.net/forms/embed/148108624.js" defer></script>

    <!-- Font preloads -->
    <link rel="preload" href="/fonts/InterTight-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/DMSans-latin.woff2" as="font" type="font/woff2" crossorigin />

    <!-- JSON-LD Schema -->
    {schema && (
      Array.isArray(schema)
        ? schema.map((s) => (
            <script type="application/ld+json" set:html={JSON.stringify(s)} />
          ))
        : <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}

    <slot name="head" />
  </head>
  <body class="bg-cream text-dark antialiased">
    <Header locale={locale} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
    <CookieConsent locale={locale} />

    {/* WhatsApp floating button — PE pages only */}
    {locale === 'pe' && (
      <a
        href="https://wa.me/51XXXXXXXXXX?text=Hola%2C%20quiero%20saber%20si%20mi%20negocio%20aparece%20en%20Google"
        class="fixed bottom-6 right-6 z-[1000] rounded-full shadow-lg hover:scale-110 transition-transform md:bottom-6 md:right-6"
        style="bottom:24px;right:24px;"
        target="_blank"
        rel="noopener"
        aria-label="Contactar por WhatsApp"
      >
        <svg viewBox="0 0 56 56" width="56" height="56" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="28" cy="28" r="28" fill="#25D366"/>
          <path d="M37.7 18.2A13.36 13.36 0 0028.05 14.5c-7.4 0-13.42 6.02-13.43 13.42a13.38 13.38 0 001.79 6.72L14.5 41.5l6.99-1.83a13.4 13.4 0 006.42 1.64h.01c7.4 0 13.42-6.02 13.43-13.42a13.35 13.35 0 00-3.65-9.69zM28.05 38.13a11.14 11.14 0 01-5.68-1.55l-.41-.24-4.23 1.11 1.13-4.12-.27-.42a11.12 11.12 0 01-1.7-5.96c0-6.15 5.01-11.15 11.17-11.15a11.1 11.1 0 017.89 3.28 11.1 11.1 0 013.26 7.9c-.01 6.15-5.01 11.15-11.16 11.15zm6.12-8.35c-.34-.17-1.98-1-2.29-1.1-.31-.11-.53-.17-.75.17-.22.33-.87 1.1-1.07 1.33-.2.22-.39.25-.73.08-.34-.17-1.42-.53-2.7-1.68-1-.89-1.67-2-1.87-2.33-.2-.34-.02-.52.15-.69.15-.15.34-.39.5-.59.17-.2.22-.34.34-.56.11-.22.05-.42-.03-.59-.08-.17-.75-1.82-1.03-2.49-.27-.65-.55-.56-.75-.57h-.64c-.22 0-.59.08-.89.42-.31.33-1.17 1.14-1.17 2.79s1.2 3.24 1.36 3.46c.17.22 2.36 3.6 5.72 5.05.8.34 1.42.55 1.91.7.8.26 1.53.22 2.1.13.65-.1 1.98-.81 2.26-1.59.28-.79.28-1.46.2-1.6-.09-.14-.31-.22-.64-.39z" fill="white"/>
        </svg>
      </a>
    )}
    <!-- HubSpot Tracking Code -->
    <script type="text/javascript" id="hs-script-loader" async defer src="//js-eu1.hs-scripts.com/148108624.js"></script>
  </body>
</html>
