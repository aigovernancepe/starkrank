---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/ui/HeroSection.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import CTABanner from '../../components/ui/CTABanner.astro';
import type { Locale } from '../../data/locales';
import { t } from '../../utils/i18n';
import { getEffectiveUpdatedDate } from '../../utils/getLastModified';
import { getSpokePath } from '../../data/service-slugs';
import { getCollection, render } from 'astro:content';

interface Props {
  cityHub: any;
  city: any;
  locale: Locale;
}

const { cityHub, city, locale } = Astro.props;
const cityHubData = cityHub.data;
const cityData = city.data ?? city;

const site = Astro.site?.origin ?? 'https://starkrank.com';
const localePath = locale === 'en' || locale === 'de' ? '' : `/${locale}`;
const pageUrl = `${localePath}/agentur-${cityData.citySlug}/`;
const heroImagePath = `/images/cities/${cityData.citySlug}.webp`;

const title = `${cityHubData.title} — StarkRank`;
const description = cityHubData.description;

// Render hub markdown body if present
const HubContent = (await render(cityHub)).Content;

// Resolve services that have spokes for this city — these become the service cards
const allSpokes = await getCollection('spokes', (s) =>
  s.data.locale === locale && s.data.citySlug === cityData.citySlug,
);
const allServices = await getCollection('services');
// Prefer curated featuredServices on the hub; fall back to the city's full services list.
// featuredServices lets us match demand evidence (e.g. only show services with measurable
// search volume in this city) without affecting the broader CitySpokePage cross-links.
const featuredSlugs = cityHubData.featuredServices ?? cityData.services;
const servicesWithSpokes = featuredSlugs
  .map((slug: string) => {
    const spoke = allSpokes.find((s) => s.data.serviceSlug === slug);
    const service = allServices.find((s) => s.data.slug === slug);
    if (!spoke || !service) return null;
    return {
      slug,
      title: spoke.data.title,
      description: spoke.data.description,
      href: `${localePath}/${getSpokePath(slug, cityData.citySlug, locale)}/`,
    };
  })
  .filter(Boolean);

// Breadcrumbs
const homeLabel: Record<string, string> = { de: 'Startseite', 'ch-de': 'Startseite' };
const homeHref = locale === 'de' ? '/' : `/${locale}/`;
const breadcrumbs = [
  { label: homeLabel[locale] ?? 'Startseite', href: homeHref },
  { label: cityHubData.title, href: pageUrl },
];

const sectors = cityHubData.sectors ?? [];
const whyParagraphs = cityHubData.whyParagraphs ?? [];
const faq: Array<{ question: string; answer: string }> = cityHubData.faq ?? [];

// JSON-LD
const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${site}/#agentur-${cityData.citySlug}`,
  name: `StarkRank ${cityData.city}`,
  description: cityHubData.description,
  url: `${site}${pageUrl}`,
  parentOrganization: { '@id': `${site}/#organization` },
  address: {
    '@type': 'PostalAddress',
    addressLocality: cityData.city,
    addressRegion: cityData.region,
    postalCode: cityData.postalCode,
    addressCountry: cityData.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: cityData.coordinates.lat,
    longitude: cityData.coordinates.lng,
  },
  areaServed: { '@type': 'City', name: cityData.city },
  hasOfferCatalog: servicesWithSpokes.length > 0 ? {
    '@type': 'OfferCatalog',
    name: `${cityHubData.title}`,
    itemListElement: servicesWithSpokes.map((s) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: s.title,
        url: `${site}${s.href}`,
      },
    })),
  } : undefined,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.label,
    item: `${site}${b.href}`,
  })),
};

const faqSchema = faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
} : null;

const effectiveUpdatedDate = await getEffectiveUpdatedDate(cityHub.filePath ?? '', cityHubData.updatedDate);

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  url: `${site}${pageUrl}`,
  name: title,
  dateModified: effectiveUpdatedDate.toISOString(),
};

const pageSchemas = [webPageSchema, localBusinessSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])];
const ctaText = cityHubData.cta ?? `Kostenlose Erstberatung für ${cityData.city} anfordern`;
const ctaHref = locale === 'de' ? '/kontakt/' : `/${locale}/kontakt/`;
---

<BaseLayout {title} {description} locale={locale} canonicalUrl={`${site}${pageUrl}`}>
  {pageSchemas.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}

  <HeroSection
    headline={cityHubData.heroHeadline}
    subheadline={cityHubData.heroLede}
    align="left"
    backgroundImage={heroImagePath}
    backgroundImageAlt={`${cityData.city} cityscape`}
  >
    <Button href={ctaHref} variant="primary" size="lg">{ctaText} →</Button>
  </HeroSection>

  <div>
    <div class="bg-white border-b border-gray-light/30">
      <div class="max-w-7xl mx-auto px-6 py-4">
        <Breadcrumbs items={breadcrumbs} />
      </div>
    </div>

    {servicesWithSpokes.length > 0 && (
      <Section bg="white">
        <SectionHeader
          eyebrow={cityHubData.servicesTitle ?? 'Dienstleistungen'}
          title={`Was wir für ${cityData.city} machen`}
          subtitle={cityHubData.servicesIntro}
        />
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-10">
          {servicesWithSpokes.map((s) => (
            <a
              href={s.href}
              class="block bg-cream/40 border border-gray-light/40 rounded-lg p-6 transition-all hover:shadow-md hover:border-blue/30 hover:-translate-y-0.5"
            >
              <h3 class="text-lg font-headline font-bold text-navy group-hover:text-blue transition-colors">
                {s.title}
              </h3>
              <p class="mt-2 text-sm font-body text-gray leading-relaxed">{s.description}</p>
            </a>
          ))}
        </div>
      </Section>
    )}

    {sectors.length > 0 && (
      <Section bg="cream">
        <SectionHeader
          eyebrow="Branchen"
          title={cityHubData.sectorsTitle ?? `Welche Branchen wir in ${cityData.city} bedienen`}
        />
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-10">
          {sectors.map((sector) => (
            <div class="flex gap-4 items-start bg-white border border-gray-light/40 rounded-lg p-5">
              <div class="shrink-0 w-10 h-10 rounded-md bg-blue/10 flex items-center justify-center">
                <svg class="w-5 h-5 text-blue" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3H21m-3.75 3H21" />
                </svg>
              </div>
              <div>
                <h3 class="text-base font-headline font-bold text-navy">{sector.name}</h3>
                <p class="mt-1 text-sm font-body text-gray leading-relaxed">{sector.description}</p>
              </div>
            </div>
          ))}
        </div>
      </Section>
    )}

    {whyParagraphs.length > 0 && (
      <Section bg="white">
        <SectionHeader
          eyebrow="Warum StarkRank"
          title={cityHubData.whyTitle ?? `Warum StarkRank in ${cityData.city}`}
        />
        <div class="prose prose-lg max-w-3xl mt-8">
          {whyParagraphs.map((para) => <p class="font-body text-dark leading-relaxed">{para}</p>)}
        </div>
      </Section>
    )}

    {HubContent && (
      <Section bg="cream">
        <article class="prose prose-lg max-w-3xl prose-headings:text-navy prose-headings:font-headline prose-h2:font-black prose-h2:tracking-tight prose-h2:text-3xl md:prose-h2:text-4xl prose-h2:mt-12 prose-h2:mb-6 first:prose-h2:mt-0">
          <HubContent />
        </article>
      </Section>
    )}

    {faq.length > 0 && (
      <Section bg="white">
        <SectionHeader eyebrow="FAQ" title="Häufige Fragen" />
        <div class="max-w-3xl mt-8 space-y-4">
          {faq.map((item) => (
            <details class="bg-cream/40 border border-gray-light/40 rounded-lg p-5 group">
              <summary class="font-headline font-bold text-navy cursor-pointer list-none flex justify-between items-center">
                <span>{item.question}</span>
                <svg class="w-5 h-5 text-blue transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                </svg>
              </summary>
              <p class="mt-4 text-sm font-body text-gray leading-relaxed">{item.answer}</p>
            </details>
          ))}
        </div>
      </Section>
    )}

    <CTABanner title={ctaText}>
      <Button href={ctaHref} variant="primary" size="lg">Jetzt starten →</Button>
    </CTABanner>

    {effectiveUpdatedDate && (
      <div class="bg-white border-t border-gray-light/30">
        <div class="max-w-7xl mx-auto px-6 py-6">
          <p class="text-xs text-gray text-center">
            {locale === 'de' || locale === 'ch-de' ? 'Zuletzt aktualisiert' : 'Last updated'}: {effectiveUpdatedDate.toLocaleDateString(locale === 'de' || locale === 'ch-de' ? 'de-DE' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </p>
        </div>
      </div>
    )}
  </div>
</BaseLayout>
