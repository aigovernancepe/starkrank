---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import CTABanner from '../../components/ui/CTABanner.astro';
import type { Locale } from '../../data/locales';
import { t, tf } from '../../utils/i18n';
import { getSpokePath } from '../../data/service-slugs';

interface Props {
  city: {
    city: string;
    citySlug: string;
    country: string;
    locale: string;
    services: string[];
    coordinates: { lat: number; lng: number };
    address?: string;
    region?: string;
    postalCode?: string;
  };
  service: {
    title: string;
    slug: string;
    description: string;
    pillar: string;
  };
  locale: Locale;
  spokeSlug: string;
}

const { city, service, locale, spokeSlug } = Astro.props;
const site = Astro.site?.origin ?? 'https://starkrank.com';
const localePath = locale === 'en' ? '' : `/${locale}`;
const pageUrl = `${localePath}/${spokeSlug}/`;

const localServiceTitle = t(`service.${service.slug}`, locale);
const vars = { service: localServiceTitle, city: city.city, country: city.country };
const inWord = t('spoke.in', locale);

const title = `${localServiceTitle} ${inWord} ${city.city} — StarkRank`;
const description = tf('spoke.description', vars, locale);

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${site}/#local-${city.citySlug}`,
  name: `StarkRank ${city.city}`,
  url: `${site}${pageUrl}`,
  parentOrganization: { '@id': `${site}/#organization` },
  address: {
    '@type': 'PostalAddress',
    addressLocality: city.city,
    addressRegion: city.region,
    postalCode: city.postalCode,
    addressCountry: city.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: city.coordinates.lat,
    longitude: city.coordinates.lng,
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: `${localServiceTitle} ${inWord} ${city.city}`,
    itemListElement: [{
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: service.title,
        url: `${site}/services/${service.slug}/`,
      },
    }],
  },
};

const homeHref = locale === 'en' ? '/' : `/${locale}/`;
const breadcrumbs = [
  { label: t('spoke.home', locale), href: homeHref },
  { label: `${localServiceTitle} ${inWord} ${city.city}`, href: pageUrl },
];
---

<BaseLayout title={title} description={description} locale={locale} schema={localBusinessSchema}>
  <Section bg="cream">
    <Breadcrumbs items={breadcrumbs} />

    <span class="text-xs font-label font-semibold uppercase tracking-[0.2em] text-blue mb-3 block">
      {city.city}, {city.country}
    </span>
    <h1 class="text-4xl md:text-5xl font-headline font-black tracking-tight text-navy">
      {localServiceTitle} {inWord} {city.city}
    </h1>
    <p class="mt-4 text-lg text-gray font-body leading-relaxed max-w-3xl">
      {description}
    </p>

    <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-8">
      <div>
        <h2 class="text-2xl font-headline font-black text-navy mb-4">{tf('spoke.whyCity', vars, locale)}</h2>
        <p class="text-sm font-body text-gray leading-relaxed">
          {tf('spoke.whyCityText', vars, locale)}
        </p>
      </div>
      <div>
        <h2 class="text-2xl font-headline font-black text-navy mb-4">{t('spoke.approach', locale)}</h2>
        <p class="text-sm font-body text-gray leading-relaxed">
          {tf('spoke.approachText', { ...vars, service: localServiceTitle.toLowerCase() }, locale)}
        </p>
      </div>
    </div>

    <div class="mt-12">
      <h2 class="text-xs font-label font-bold uppercase tracking-widest text-blue mb-4">{tf('spoke.otherServices', vars, locale)}</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {city.services.filter((s: string) => s !== service.slug).slice(0, 6).map((serviceSlug: string) => {
          const spokePath = getSpokePath(serviceSlug, city.citySlug, locale);
          return (
            <Card href={`${localePath}/${spokePath}/`}>
              <h4 class="text-sm font-headline font-bold text-navy">
                {t(`service.${serviceSlug}`, locale)}
              </h4>
            </Card>
          );
        })}
      </div>
    </div>

    <div class="mt-12">
      <Button href="/contact/" variant="primary" size="lg">{tf('spoke.contactIn', vars, locale)}</Button>
    </div>
  </Section>

  <CTABanner bg="navy" title={tf('spoke.growBusiness', vars, locale)} subtitle={t('spoke.bookConsultation', locale)}>
    <Button href="/contact/" variant="primary" size="lg">{t('spoke.getStarted', locale)}</Button>
  </CTABanner>
</BaseLayout>
