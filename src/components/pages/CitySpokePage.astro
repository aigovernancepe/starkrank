---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/ui/HeroSection.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import CTABanner from '../../components/ui/CTABanner.astro';
import type { Locale } from '../../data/locales';
import { t, tf } from '../../utils/i18n';
import { getSpokePath } from '../../data/service-slugs';
import { getLocalizedNavHref } from '../../data/navigation';
import { render } from 'astro:content';
import { getPillarById } from '../../data/pillars';

interface Props {
  city: {
    city: string;
    citySlug: string;
    country: string;
    locale: string;
    services: string[];
    coordinates: { lat: number; lng: number };
    address?: string;
    region?: string;
    postalCode?: string;
  };
  service: any;
  locale: Locale;
  spokeSlug: string;
  spoke?: any;
}

const { city, service, locale, spokeSlug, spoke } = Astro.props;

// Support both full collection entry (new) and plain data object (legacy)
const serviceData = service.data ?? service;

// Pillar grouping for service sections
const pillar = serviceData.pillar ? getPillarById(serviceData.pillar) : null;
const pillarServices = pillar ? pillar.services.filter((s: string) => s !== serviceData.slug) : [];
const otherServices = city.services.filter((s: string) => s !== serviceData.slug && !pillarServices.includes(s));
const localPillarName = pillar ? t(`pillar.${pillar.id}`, locale) : '';

const site = Astro.site?.origin ?? 'https://starkrank.com';
const localePath = locale === 'en' ? '' : `/${locale}`;
const pageUrl = `${localePath}/${spokeSlug}/`;

const localServiceTitle = t(`service.${serviceData.slug}`, locale);
const vars = { service: localServiceTitle, city: city.city, country: city.country };
const inWord = t('spoke.in', locale);
const heroImagePath = `/images/cities/${city.citySlug}.webp`;

const hasSpokeContent = !!spoke;
const spokeTitle = spoke?.data?.title ?? `${localServiceTitle} ${inWord} ${city.city}`;
const spokeDescription = spoke?.data?.description ?? tf('spoke.description', vars, locale);

const title = `${spokeTitle} — StarkRank`;
const description = spokeDescription;

// Render spoke markdown body if available
const SpokeContent = hasSpokeContent ? (await render(spoke)).Content : null;

// Structured spoke data
const highlights = spoke?.data?.highlights ?? [];
const sectors = spoke?.data?.sectors ?? [];
const deliverables = spoke?.data?.deliverables ?? [];
const faq: Array<{ question: string; answer: string }> = spoke?.data?.faq ?? [];
const highlightsTitle = spoke?.data?.highlightsTitle ?? null;
const sectorsTitle = spoke?.data?.sectorsTitle ?? null;

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${site}/#local-${city.citySlug}`,
  name: `StarkRank ${city.city}`,
  url: `${site}${pageUrl}`,
  parentOrganization: { '@id': `${site}/#organization` },
  address: {
    '@type': 'PostalAddress',
    addressLocality: city.city,
    addressRegion: city.region,
    postalCode: city.postalCode,
    addressCountry: city.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: city.coordinates.lat,
    longitude: city.coordinates.lng,
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: `${localServiceTitle} ${inWord} ${city.city}`,
    itemListElement: [{
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: serviceData.title,
        url: `${site}/services/${serviceData.slug}/`,
      },
    }],
  },
};

// AISO detection — must be before breadcrumbs
const isAISO = serviceData.slug === 'ai-search-optimization';

const homeHref = locale === 'en' ? '/' : `/${locale}/`;
const breadcrumbs = isAISO
  ? [
      { label: t('spoke.home', locale), href: homeHref },
      { label: localServiceTitle, href: locale === 'en' ? `/services/${serviceData.slug}/` : `${localePath}/` },
      { label: city.city, href: pageUrl },
    ]
  : [
      { label: t('spoke.home', locale), href: homeHref },
      { label: `${localServiceTitle} ${inWord} ${city.city}`, href: pageUrl },
    ];

const faqSchema = faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
} : null;

const pageSchemas = [localBusinessSchema, ...(faqSchema ? [faqSchema] : [])];

const ctaTitle = spoke?.data?.localCTA ?? tf('spoke.growBusiness', vars, locale);

// CTA href: AISO pages use lead magnet, others use contact
const aisoCtaHref: Record<string, string> = {
  en: '/free-aiso-score/',
  pe: '/pe/apareces-en-google/',
  de: '/de/kontakt/',
  'ch-de': '/ch-de/kontakt/',
};
const ctaHref = isAISO ? (aisoCtaHref[locale] ?? getLocalizedNavHref('/contact/', locale)) : getLocalizedNavHref('/contact/', locale);

// Trust stats (locale-aware)
const trustStats: Record<string, { label: string; items: string[] }> = {
  en: { label: 'Trusted across 4 markets', items: ['150+ AISO Scores Delivered', '4 Markets', '6-Dimension Framework'] },
  pe: { label: 'Presencia en 4 mercados', items: ['150+ Evaluaciones Entregadas', '4 Mercados', 'Marco de 6 Dimensiones'] },
  de: { label: 'Vertrauen in 4 Märkten', items: ['150+ AISO Scores Erstellt', '4 Märkte', '6-Dimensionen-Framework'] },
  'ch-de': { label: 'Vertrauen in 4 Märkten', items: ['150+ AISO Scores Erstellt', '4 Märkte', '6-Dimensionen-Framework'] },
};
const stats = trustStats[locale] ?? trustStats.en;

// Pricing signal (locale-aware)
const pricingSignals: Record<string, string> = {
  en: 'Free 2-dimension assessment available. Comprehensive audit from $3,000.',
  pe: 'Evaluación gratuita de 2 dimensiones disponible. Auditoría completa desde S/ 3,500.',
  de: 'Kostenlose Erstbewertung (2 Dimensionen) verfügbar. Umfassendes Audit ab €3.000.',
  'ch-de': 'Kostenlose Erstbewertung (2 Dimensionen) verfügbar. Umfassendes Audit ab CHF 4.000.',
};
const pricingSignal = pricingSignals[locale] ?? pricingSignals.en;

// Enhanced schemas for AISO pages
const serviceSchema = isAISO ? {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: spokeTitle,
  description: spokeDescription,
  provider: { '@type': 'Organization', name: 'StarkRank', url: 'https://starkrank.com' },
  areaServed: { '@type': 'City', name: city.city },
  url: `${site}${pageUrl}`,
} : null;

// Improved breadcrumb labels per locale
const homeLabel: Record<string, string> = { en: 'Home', pe: 'Inicio', de: 'Startseite', 'ch-de': 'Startseite' };
const servicesLabel: Record<string, string> = { en: 'Services', pe: 'Servicios', de: 'Dienstleistungen', 'ch-de': 'Dienstleistungen' };

const breadcrumbSchema = isAISO ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: homeLabel[locale] ?? 'Home', item: `${site}${homeHref}` },
    { '@type': 'ListItem', position: 2, name: servicesLabel[locale] ?? 'Services', item: locale === 'en' ? `${site}/services/` : `${site}/${locale}/` },
    { '@type': 'ListItem', position: 3, name: localServiceTitle, item: `${site}/services/${serviceData.slug}/` },
    { '@type': 'ListItem', position: 4, name: `${localServiceTitle} ${inWord} ${city.city}`, item: `${site}${pageUrl}` },
  ],
} : null;

const allSchemas = [
  localBusinessSchema,
  ...(faqSchema ? [faqSchema] : []),
  ...(serviceSchema ? [serviceSchema] : []),
  ...(breadcrumbSchema ? [breadcrumbSchema] : []),
];
---

<BaseLayout title={title} description={description} locale={locale} schema={allSchemas}>
  <HeroSection
    headline={`${localServiceTitle} ${inWord} **${city.city}**`}
    subheadline={description}
    align="left"
    backgroundImage={heroImagePath}
  >
    <Button href={ctaHref} variant="primary" size="lg">{locale === 'pe' ? 'Revisa Gratis →' : isAISO ? ctaTitle : tf('spoke.contactIn', vars, locale)}</Button>
  </HeroSection>

  {/* PE CTA banner — all PE spoke pages */}
  {locale === 'pe' && (
    <div class="bg-blue text-white">
      <div class="max-w-7xl mx-auto px-6 py-3 flex flex-wrap items-center justify-between gap-4">
        <span class="text-sm font-body font-semibold">¿Tu negocio aparece en Google? Revísalo gratis →</span>
        <a href="/pe/apareces-en-google/" class="text-xs font-label font-semibold uppercase tracking-wide bg-white text-blue hover:bg-cream rounded-md px-4 py-2 transition-colors">
          Revisa Gratis
        </a>
      </div>
    </div>
  )}

  {/* Trust stats bar — AISO pages only */}
  {isAISO && (
    <div class="bg-white border-b border-gray-light/30">
      <div class="max-w-7xl mx-auto px-6 py-4 flex flex-wrap items-center gap-4 md:gap-8">
        <span class="text-xs font-label font-bold uppercase tracking-widest text-blue">{stats.label}</span>
        {stats.items.map((item) => (
          <span class="text-sm font-body text-dark font-semibold">{item}</span>
        ))}
      </div>
    </div>
  )}

  {hasSpokeContent && SpokeContent ? (
    <>
      {/* Section 1: Breadcrumbs + Narrative content */}
      <Section bg="cream">
        <Breadcrumbs items={breadcrumbs} />

        {spoke?.data?.updatedDate && (
          <div class="mb-6 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs font-body text-gray">
            <span>
              {t('spoke.lastUpdated', locale)}: <time datetime={spoke.data.updatedDate.toISOString().split('T')[0]}>
                {spoke.data.updatedDate.toLocaleDateString(locale === 'pe' ? 'es-PE' : locale === 'de' || locale === 'ch-de' ? 'de-CH' : 'en-US', { month: 'long', year: 'numeric' })}
              </time>
            </span>
            <span>
              {t('spoke.by', locale)} <a href={locale === 'en' ? '/about/' : `/${locale}/`} class="text-blue hover:text-blue-light font-semibold">Wilko Feye</a>, StarkRank
            </span>
          </div>
        )}

        <div class="prose prose-lg max-w-none font-body text-dark prose-numbered-cards prose-branded-bullets
          [&>h2]:text-2xl [&>h2]:md:text-3xl [&>h2]:font-headline [&>h2]:font-black [&>h2]:text-navy [&>h2]:tracking-tight [&>h2]:mt-12 [&>h2]:mb-4
          [&>p]:leading-relaxed [&>p]:text-gray [&>p]:mb-6
          [&_strong]:text-dark
          [&_a]:text-blue [&_a]:font-semibold [&_a:hover]:text-blue-light
          [&>ol]:space-y-4
          [&>ol>li]:bg-white [&>ol>li]:border [&>ol>li]:border-gray-light/40 [&>ol>li]:rounded-lg [&>ol>li]:p-5 [&>ol>li]:text-gray [&>ol>li]:text-base [&>ol>li]:leading-relaxed
          [&>ul]:space-y-3
          [&>ul>li]:text-gray [&>ul>li]:text-base [&>ul>li]:leading-relaxed">
          <SpokeContent />
        </div>

        {/* Highlights inline within narrative section */}
        {highlights.length > 0 && (
          <div class="mt-10">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
              {highlights.map((h: { title: string; description: string }, i: number) => (
                <div class="bg-white border border-gray-light/40 rounded-lg p-5 pl-14 relative">
                  <span class="absolute left-4 top-5 w-7 h-7 rounded-full bg-blue text-white flex items-center justify-center text-xs font-label font-bold">
                    {i + 1}
                  </span>
                  <h3 class="text-base font-headline font-bold text-navy mb-2">{h.title}</h3>
                  <p class="text-sm font-body text-gray leading-relaxed">{h.description}</p>
                </div>
              ))}
            </div>
          </div>
        )}
      </Section>

      {/* Section 3: Sectors with heading */}
      {sectors.length > 0 && (
        <Section bg="cream">
          <SectionHeader label={t('spoke.sectorsLabel', locale)} title={sectorsTitle ?? tf('spoke.sectorsTitle', vars, locale)} />
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {sectors.map((s: { name: string; description: string }) => (
              <div class="flex gap-4 items-start bg-white border border-gray-light/40 rounded-lg p-5">
                <div class="shrink-0 w-10 h-10 rounded-md bg-blue/10 flex items-center justify-center">
                  <svg class="w-5 h-5 text-blue" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3H21m-3.75 3H21" />
                  </svg>
                </div>
                <div>
                  <h3 class="text-base font-headline font-bold text-navy">{s.name}</h3>
                  <p class="mt-1 text-sm font-body text-gray leading-relaxed">{s.description}</p>
                </div>
              </div>
            ))}
          </div>
        </Section>
      )}

      {/* Section 4: Deliverables as checklist */}
      {deliverables.length > 0 && (
        <Section bg="white">
          <SectionHeader label={t('spoke.deliverables', locale)} title={t('spoke.deliverablesTitle', locale)} />
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {deliverables.map((d: string, i: number) => (
              <div class="flex items-start gap-4 bg-cream border border-gray-light/40 rounded-lg p-5">
                <span class="shrink-0 w-8 h-8 rounded-full bg-blue text-white flex items-center justify-center text-sm font-label font-bold">
                  {i + 1}
                </span>
                <p class="text-sm font-body text-dark leading-relaxed pt-1">{d}</p>
              </div>
            ))}
          </div>

          {/* Pricing signal — AISO pages only */}
          {isAISO && (
            <p class="mt-8 text-sm font-body text-dark font-semibold bg-cream border border-gray-light/40 rounded-lg p-4">
              {pricingSignal}
            </p>
          )}
        </Section>
      )}

      {/* Section 5: FAQ accordion */}
      {faq.length > 0 && (
        <Section bg="cream">
          <SectionHeader label="FAQ" title={t('spoke.faqTitle', locale)} />
          <div class="max-w-3xl space-y-6">
            {faq.map((item: { question: string; answer: string }) => (
              <details class="group bg-white border border-gray-light/40 rounded-lg">
                <summary class="flex items-center justify-between gap-4 cursor-pointer p-6 font-headline font-bold text-navy text-base md:text-lg select-none">
                  {item.question}
                  <svg class="w-5 h-5 shrink-0 text-blue transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                  </svg>
                </summary>
                <div class="px-6 pb-6 text-sm font-body text-gray leading-relaxed">
                  {item.answer}
                </div>
              </details>
            ))}
          </div>
        </Section>
      )}

      {/* Section 6: Same-pillar services */}
      {pillarServices.length > 0 && (
        <Section bg="white">
          <h2 class="text-xs font-label font-bold uppercase tracking-widest text-blue mb-4">{tf('spoke.pillarServices', { ...vars, pillar: localPillarName }, locale)}</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {pillarServices.map((serviceSlug: string) => {
              const spokePath = getSpokePath(serviceSlug, city.citySlug, locale);
              return (
                <Card href={`${localePath}/${spokePath}/`}>
                  <h4 class="text-sm font-headline font-bold text-navy">
                    {t(`service.${serviceSlug}`, locale)}
                  </h4>
                </Card>
              );
            })}
          </div>
        </Section>
      )}

      {/* Section 7: All other services in this city */}
      {otherServices.length > 0 && (
        <Section bg="cream">
          <h2 class="text-xs font-label font-bold uppercase tracking-widest text-blue mb-4">{tf('spoke.allServices', vars, locale)}</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {otherServices.map((serviceSlug: string) => {
              const spokePath = getSpokePath(serviceSlug, city.citySlug, locale);
              return (
                <Card href={`${localePath}/${spokePath}/`}>
                  <h4 class="text-sm font-headline font-bold text-navy">
                    {t(`service.${serviceSlug}`, locale)}
                  </h4>
                </Card>
              );
            })}
          </div>
        </Section>
      )}
    </>
  ) : (
    <Section bg="cream">
      <Breadcrumbs items={breadcrumbs} />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div>
          <h2 class="text-2xl font-headline font-black text-navy mb-4">{tf('spoke.whyCity', vars, locale)}</h2>
          <p class="text-sm font-body text-gray leading-relaxed">
            {tf('spoke.whyCityText', vars, locale)}
          </p>
        </div>
        <div>
          <h2 class="text-2xl font-headline font-black text-navy mb-4">{t('spoke.approach', locale)}</h2>
          <p class="text-sm font-body text-gray leading-relaxed">
            {tf('spoke.approachText', { ...vars, service: localServiceTitle.toLowerCase() }, locale)}
          </p>
        </div>
      </div>

      {pillarServices.length > 0 && (
        <div class="mt-12">
          <h2 class="text-xs font-label font-bold uppercase tracking-widest text-blue mb-4">{tf('spoke.pillarServices', { ...vars, pillar: localPillarName }, locale)}</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {pillarServices.map((serviceSlug: string) => {
              const spokePath = getSpokePath(serviceSlug, city.citySlug, locale);
              return (
                <Card href={`${localePath}/${spokePath}/`}>
                  <h4 class="text-sm font-headline font-bold text-navy">
                    {t(`service.${serviceSlug}`, locale)}
                  </h4>
                </Card>
              );
            })}
          </div>
        </div>
      )}

      {otherServices.length > 0 && (
        <div class="mt-12">
          <h2 class="text-xs font-label font-bold uppercase tracking-widest text-blue mb-4">{tf('spoke.allServices', vars, locale)}</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {otherServices.map((serviceSlug: string) => {
              const spokePath = getSpokePath(serviceSlug, city.citySlug, locale);
              return (
                <Card href={`${localePath}/${spokePath}/`}>
                  <h4 class="text-sm font-headline font-bold text-navy">
                    {t(`service.${serviceSlug}`, locale)}
                  </h4>
                </Card>
              );
            })}
          </div>
        </div>
      )}
    </Section>
  )}

  <CTABanner bg="navy" title={ctaTitle} subtitle={t('spoke.bookConsultation', locale)}>
    <Button href={ctaHref} variant="primary" size="lg">{t('spoke.getStarted', locale)}</Button>
  </CTABanner>
</BaseLayout>
