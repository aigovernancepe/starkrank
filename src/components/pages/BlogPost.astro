---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Breadcrumbs from '../ui/Breadcrumbs.astro';
import Button from '../ui/Button.astro';
import CTABanner from '../ui/CTABanner.astro';
import Card from '../ui/Card.astro';
import ServiceFinderCta from '../ui/ServiceFinderCta.astro';
import type { CollectionEntry } from 'astro:content';

interface CTA {
  label: string;
  href: string;
}

interface Props {
  post: CollectionEntry<'blog'>;
  Content: any;
  headings: { depth: number; slug: string; text: string }[];
  relatedPosts?: CollectionEntry<'blog'>[];
  ctaTitle?: string;
  ctaSubtitle?: string;
  primaryCTA?: CTA;
  secondaryCTA?: CTA;
  hreflangAlternates?: { hreflang: string; href: string }[];
  schemas: Record<string, unknown>[];
  breadcrumbs: { label: string; href: string }[];
  locale?: string;
  blogBasePath?: string;
  effectiveUpdatedDate?: Date;
}

const {
  post,
  Content,
  headings,
  relatedPosts = [],
  ctaTitle,
  ctaSubtitle,
  primaryCTA = { label: 'Get Your Free AI Search Score', href: '/aiso-score/' },
  secondaryCTA = { label: 'Contact Us', href: '/contact/' },
  hreflangAlternates = [],
  schemas,
  breadcrumbs,
  locale = 'en',
  blogBasePath = '/blog',
  effectiveUpdatedDate,
} = Astro.props;

const displayDate = effectiveUpdatedDate ?? post.data.updatedDate ?? post.data.pubDate;

const isDe = locale === 'de' || locale === 'ch-de';
const tocHeadings = headings.filter((h) => h.depth === 2);

const aboutHrefMap: Record<string, string> = {
  en: '/en/about/',
  pe: '/pe/',
  de: '/ueber-uns/',
  'ch-de': '/ch-de/ueber-uns/',
};
const aboutHref = aboutHrefMap[locale] ?? aboutHrefMap.en;

const dateLocaleMap: Record<string, string> = { en: 'en-US', pe: 'es-PE', de: 'de-DE', 'ch-de': 'de-CH' };
const dateLocale = dateLocaleMap[locale] ?? 'en-US';

const faqLabel = 'FAQ';
const faqTitleMap: Record<string, string> = { en: 'Frequently Asked Questions', pe: 'Preguntas Frecuentes', de: 'Häufig gestellte Fragen', 'ch-de': 'Häufig gestellte Fragen' };
const faqTitle = faqTitleMap[locale] ?? 'Frequently Asked Questions';

const titleSuffixMap: Record<string, string> = { en: '', pe: ' Perú', de: '', 'ch-de': ' Schweiz' };
const titleSuffix = titleSuffixMap[locale] ?? '';

const updatedLabelMap: Record<string, string> = { en: 'Last updated: ', pe: 'Última actualización: ', de: 'Letzte Aktualisierung: ', 'ch-de': 'Letzte Aktualisierung: ' };
const byLabelMap: Record<string, string> = { en: 'By ', pe: 'Por ', de: 'Von ', 'ch-de': 'Von ' };
const tocLabelMap: Record<string, string> = { en: 'In this article', pe: 'En este artículo', de: 'In diesem Artikel', 'ch-de': 'In diesem Artikel' };
const assessmentLabelMap: Record<string, string> = { en: 'Free Assessment', pe: 'Evaluación gratuita', de: 'Kostenlose Bewertung', 'ch-de': 'Kostenlose Bewertung' };
const assessmentDescMap: Record<string, string> = { en: 'See where you stand in traditional and AI search — in 60 seconds.', pe: '¿Tu negocio aparece en Google? Descúbrelo en 60 segundos.', de: 'Wie steht Ihre Website in der klassischen und KI-Suche? In 60 Sekunden.', 'ch-de': 'Wie steht Ihre Website in der klassischen und KI-Suche? In 60 Sekunden.' };
const relatedLabelMap: Record<string, string> = { en: 'Related Articles', pe: 'Artículos relacionados', de: 'Verwandte Artikel', 'ch-de': 'Verwandte Artikel' };

const defaultCtaTitleMap: Record<string, string> = { en: 'Ready to Grow Your Business?', pe: '¿Listo para crecer tu negocio?', de: 'Bereit für mehr Sichtbarkeit?', 'ch-de': 'Bereit für mehr Sichtbarkeit?' };
const defaultCtaSubtitleMap: Record<string, string> = { en: 'Get a clear picture of where you stand in search — traditional and AI.', pe: 'Descubre cómo está tu presencia en Google y en búsquedas con inteligencia artificial.', de: 'Sehen Sie, wo Sie in der klassischen und KI-Suche stehen.', 'ch-de': 'Sehen Sie, wo Sie in der klassischen und KI-Suche stehen.' };
---

<BaseLayout
  title={`${post.data.title} — StarkRank${titleSuffix}`}
  description={post.data.description}
  locale={locale}
  schema={schemas}
>
  {hreflangAlternates.map((alt) => (
    <link slot="head" rel="alternate" hreflang={alt.hreflang} href={`https://starkrank.com${alt.href}`} />
  ))}

  <!-- Hero -->
  <Section bg="cream">
    <Breadcrumbs items={breadcrumbs} />

    {post.data.category && (
      <span class="text-xs font-label font-semibold uppercase tracking-[0.2em] text-blue mb-3 block">
        {post.data.category}
      </span>
    )}
    <h1 class="text-4xl md:text-5xl font-headline font-black tracking-tight text-navy">
      {post.data.title}
    </h1>
    <p class="mt-4 text-lg text-gray font-body leading-relaxed max-w-3xl">
      {post.data.description}
    </p>

    <div class="mt-8 flex flex-wrap gap-4">
      <Button href={primaryCTA.href} variant="primary" size="lg">{primaryCTA.label}</Button>
      <Button href={secondaryCTA.href} variant="outline" size="lg">{secondaryCTA.label}</Button>
    </div>

    <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs font-body text-gray">
      <span>
        {updatedLabelMap[locale]}
        <time datetime={displayDate.toISOString()}>
          {displayDate.toLocaleDateString(dateLocale, { year: 'numeric', month: 'long' })}
        </time>
      </span>
      <span>
        {byLabelMap[locale]}
        <a href={aboutHref} class="text-blue hover:text-blue-light font-semibold">{post.data.author}</a>, StarkRank
      </span>
    </div>
  </Section>

  <!-- Main content + sidebar -->
  <section class="bg-white">
    <div class="max-w-7xl mx-auto px-6 py-16 md:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Article -->
        <article class="lg:col-span-2 blog-prose">
          <Content />
        </article>

        <!-- Sidebar -->
        <aside class="lg:col-span-1">
          <div class="lg:sticky lg:top-8 space-y-6">
            {tocHeadings.length > 0 && (
              <nav class="bg-cream border border-gray-light/40 rounded-lg p-6">
                <p class="text-xs font-label font-bold uppercase tracking-widest text-blue mb-4">
                  {tocLabelMap[locale]}
                </p>
                <ul class="space-y-2 list-none pl-0">
                  {tocHeadings.map((h) => (
                    <li class="before:hidden">
                      <a href={`#${h.slug}`} class="text-sm font-body text-gray hover:text-blue transition-colors">
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            )}

            <div class="bg-cream border border-gray-light/40 rounded-lg p-6">
              <p class="text-xs font-label font-bold uppercase tracking-widest text-blue mb-3">
                {assessmentLabelMap[locale]}
              </p>
              <p class="text-sm font-body text-gray mb-4">
                {assessmentDescMap[locale]}
              </p>
              <Button href={primaryCTA.href} variant="primary" size="md">{primaryCTA.label}</Button>
            </div>

            {relatedPosts.length > 0 && (
              <div>
                <p class="text-xs font-label font-bold uppercase tracking-widest text-blue mb-4">
                  {relatedLabelMap[locale]}
                </p>
                <div class="space-y-3">
                  {relatedPosts.map((related) => (
                    <Card href={`${blogBasePath}/${related.id}/`}>
                      <h4 class="text-sm font-headline font-bold text-navy">{related.data.title}</h4>
                    </Card>
                  ))}
                </div>
              </div>
            )}
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Service Finder CTA -->
  <ServiceFinderCta locale={locale} />

  <!-- FAQ -->
  {post.data.faq && post.data.faq.length > 0 && (
    <Section bg="cream">
      <SectionHeader label={faqLabel} title={faqTitle} />
      <div class="max-w-3xl space-y-6">
        {post.data.faq.map((item) => (
          <details class="group bg-white border border-gray-light/40 rounded-lg">
            <summary class="flex items-center justify-between gap-4 cursor-pointer p-6 font-headline font-bold text-navy text-base md:text-lg select-none">
              {item.question}
              <svg class="w-5 h-5 shrink-0 text-blue transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
              </svg>
            </summary>
            <div class="px-6 pb-6 text-sm font-body text-gray leading-relaxed">
              {item.answer}
            </div>
          </details>
        ))}
      </div>
    </Section>
  )}

  <!-- Bottom CTA -->
  <CTABanner bg="navy" title={ctaTitle ?? defaultCtaTitleMap[locale]} subtitle={ctaSubtitle ?? defaultCtaSubtitleMap[locale]}>
    <Button href={primaryCTA.href} variant="primary" size="lg">{primaryCTA.label}</Button>
    <Button href={secondaryCTA.href} variant="secondary" size="lg">{secondaryCTA.label}</Button>
  </CTABanner>
</BaseLayout>
