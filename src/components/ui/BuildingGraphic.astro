---
interface Props {
  locale: 'de' | 'ch-de' | 'en';
}

const { locale } = Astro.props;

const pillarLabels: Record<string, Record<string, string>> = {
  de: {
    'search-ai-intelligence': 'Suche & KI',
    'performance-media': 'Performance Media',
    'authority-pr': 'Autorität',
    'content-copywriting': 'Content',
  },
  'ch-de': {
    'search-ai-intelligence': 'Suche & KI',
    'performance-media': 'Performance Media',
    'authority-pr': 'Autorität',
    'content-copywriting': 'Content',
  },
  en: {
    'search-ai-intelligence': 'Search & AI',
    'performance-media': 'Performance Media',
    'authority-pr': 'Authority',
    'content-copywriting': 'Content',
  },
};

const pillarAria: Record<string, Record<string, string>> = {
  de: {
    'search-ai-intelligence': 'Zur Säule Suche und KI-Intelligenz scrollen',
    'performance-media': 'Zur Säule Performance Media scrollen',
    'authority-pr': 'Zur Säule Autorität scrollen',
    'content-copywriting': 'Zur Säule Content scrollen',
    'data-web': 'Zum Fundament Daten und Web scrollen',
  },
  'ch-de': {
    'search-ai-intelligence': 'Zur Säule Suche und KI-Intelligenz scrollen',
    'performance-media': 'Zur Säule Performance Media scrollen',
    'authority-pr': 'Zur Säule Autorität scrollen',
    'content-copywriting': 'Zur Säule Content scrollen',
    'data-web': 'Zum Fundament Daten und Web scrollen',
  },
  en: {
    'search-ai-intelligence': 'Jump to Search and AI Intelligence card',
    'performance-media': 'Jump to Performance Media card',
    'authority-pr': 'Jump to Authority card',
    'content-copywriting': 'Jump to Content card',
    'data-web': 'Jump to Data and Web card',
  },
};

const strings = {
  de: {
    top: 'WACHSTUM',
    foundation: 'DATEN & WEB',
    caption: 'Fundament jeder strategischen Entscheidung',
    title: 'Wachstumsströme aus Daten und Web',
    desc: 'Abstrakte Grafik: Vier aufsteigende Ströme — Suche und KI-Intelligenz, Performance Media, Autorität und Content und Texterstellung — konvergieren in einem Wachstumspunkt. Sie entspringen einem Fundament aus Daten und Web. Beim Hover wird die zugehörige Karte unten hervorgehoben, beim Klick wird dorthin gescrollt.',
  },
  'ch-de': {
    top: 'WACHSTUM',
    foundation: 'DATEN & WEB',
    caption: 'Fundament jeder strategischen Entscheidung',
    title: 'Wachstumsströme aus Daten und Web',
    desc: 'Abstrakte Grafik: Vier aufsteigende Ströme — Suche und KI-Intelligenz, Performance Media, Autorität und Content und Texterstellung — konvergieren in einem Wachstumspunkt. Sie entspringen einem Fundament aus Daten und Web. Beim Hover wird die zugehörige Karte unten hervorgehoben, beim Klick wird dorthin gescrollt.',
  },
  en: {
    top: 'GROWTH',
    foundation: 'DATA & WEB',
    caption: 'Foundation of every strategic decision',
    title: 'Growth Streams from Data and Web',
    desc: 'Abstract graphic: four rising streams — Search and AI Intelligence, Performance Media, Authority, and Content and Copywriting — converging on a growth point. They rise from a Data and Web foundation. Hovering highlights the matching card below; clicking scrolls to it.',
  },
}[locale];

const aria = pillarAria[locale];
const labels = pillarLabels[locale];

// Geometry — four streams rising from foundation, subtly converging.
const canvasW = 840;
const streamBottomY = 458;
const streamTopY = 146;
const foundationY = 470;
const foundationH = 62;
const streamBottomWidth = 92;
const streamTopWidth = 70;

// Bottom centers spread across the foundation; top centers converge slightly inward.
const streams = [
  { id: 'search-ai-intelligence', num: '01', bx: 175, tx: 260 },
  { id: 'performance-media', num: '02', bx: 340, tx: 378 },
  { id: 'authority-pr', num: '03', bx: 500, tx: 462 },
  { id: 'content-copywriting', num: '04', bx: 665, tx: 580 },
];

// Build stream path — soft trapezoid with rounded top and bottom corners
function streamPath(bx: number, tx: number): string {
  const halfB = streamBottomWidth / 2;
  const halfT = streamTopWidth / 2;
  const r = 14; // corner radius
  const bl = { x: bx - halfB, y: streamBottomY };
  const br = { x: bx + halfB, y: streamBottomY };
  const tl = { x: tx - halfT, y: streamTopY };
  const tr = { x: tx + halfT, y: streamTopY };
  // Use cubic bezier on the side edges for organic flow
  // cleaner: quadratic bezier approach for the side curves
  return [
    `M ${bl.x + r} ${bl.y}`,
    `L ${br.x - r} ${br.y}`,
    `Q ${br.x} ${br.y} ${br.x} ${br.y - r}`,
    // right edge curves toward top
    `C ${br.x - 6} ${(br.y + tr.y) / 2 - 20} ${tr.x + 6} ${(br.y + tr.y) / 2 + 20} ${tr.x} ${tr.y + r}`,
    `Q ${tr.x} ${tr.y} ${tr.x - r} ${tr.y}`,
    `L ${tl.x + r} ${tl.y}`,
    `Q ${tl.x} ${tl.y} ${tl.x} ${tl.y + r}`,
    // left edge curves toward bottom
    `C ${tl.x - 6} ${(tl.y + bl.y) / 2 + 20} ${bl.x + 6} ${(tl.y + bl.y) / 2 - 20} ${bl.x} ${bl.y - r}`,
    `Q ${bl.x} ${bl.y} ${bl.x + r} ${bl.y}`,
    'Z',
  ].join(' ');
}
---

<div class="building-graphic relative">
  <svg
    viewBox="0 0 840 600"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-labelledby="building-title building-desc"
    class="w-full h-auto max-w-3xl mx-auto mt-8"
    style="font-family: 'Outfit', ui-sans-serif, system-ui;"
  >
    <title id="building-title">{strings.title}</title>
    <desc id="building-desc">{strings.desc}</desc>

    <defs>
      {/* Backdrop — subtle radial warm spot */}
      <radialGradient id="backdrop" cx="50%" cy="45%" r="75%">
        <stop offset="0%" stop-color="#FDFCFA" />
        <stop offset="100%" stop-color="#F2F0EB" />
      </radialGradient>

      {/* Stream fill — rich vertical gradient from navy at base to light blue at crown */}
      <linearGradient id="stream-fill" x1="0" y1="1" x2="0" y2="0">
        <stop offset="0%" stop-color="#1A3B6E" />
        <stop offset="35%" stop-color="#3B7DD8" />
        <stop offset="100%" stop-color="#8AB6EC" />
      </linearGradient>

      {/* Active state — brighter, more saturated */}
      <linearGradient id="stream-fill-active" x1="0" y1="1" x2="0" y2="0">
        <stop offset="0%" stop-color="#2E5FA8" />
        <stop offset="35%" stop-color="#5A9AE6" />
        <stop offset="100%" stop-color="#B4D4F3" />
      </linearGradient>

      {/* Inner highlight — thin bright edge on stream's right side */}
      <linearGradient id="stream-highlight" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="#ffffff" stop-opacity="0" />
        <stop offset="50%" stop-color="#ffffff" stop-opacity="0.18" />
        <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
      </linearGradient>

      {/* Foundation fill — deep navy */}
      <linearGradient id="foundation-fill" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#1A3B6E" />
        <stop offset="100%" stop-color="#0E1A2D" />
      </linearGradient>

      {/* Foundation hatch — subtle blue overlay */}
      <pattern id="found-hatch" x="0" y="0" width="14" height="14" patternUnits="userSpaceOnUse" patternTransform="rotate(30)">
        <line x1="0" y1="0" x2="0" y2="14" stroke="#3B7DD8" stroke-width="0.8" opacity="0.4" />
        <circle cx="7" cy="7" r="1" fill="#5A9AE6" opacity="0.35" />
      </pattern>

      {/* Soft glow filter — bloom effect behind streams */}
      <filter id="glow" x="-40%" y="-40%" width="180%" height="180%">
        <feGaussianBlur stdDeviation="12" result="blur" />
        <feColorMatrix in="blur" type="matrix" values="0 0 0 0 0.231  0 0 0 0 0.490  0 0 0 0 0.847  0 0 0 0.6 0" />
      </filter>

      <filter id="glow-active" x="-40%" y="-40%" width="180%" height="180%">
        <feGaussianBlur stdDeviation="18" result="blur" />
        <feColorMatrix in="blur" type="matrix" values="0 0 0 0 0.352  0 0 0 0 0.603  0 0 0 0 0.901  0 0 0 0.85 0" />
      </filter>

      {/* Gold accent arrow for WACHSTUM target */}
      <marker id="gold-arrow" viewBox="0 0 12 12" refX="6" refY="11" markerUnits="userSpaceOnUse" markerWidth="14" markerHeight="14" orient="auto">
        <path d="M 6 0 L 12 10 L 0 10 Z" fill="#B8893B" />
      </marker>
    </defs>

    {/* Backdrop */}
    <rect width="840" height="600" fill="url(#backdrop)" />

    {/* ─── WACHSTUM — the convergence label ─── */}
    <g>
      <text x="420" y="76" text-anchor="middle" fill="#0E1A2D" font-size="22" font-weight="900" letter-spacing="10">{strings.top}</text>
      <line x1="340" y1="92" x2="500" y2="92" stroke="#B8893B" stroke-width="2.5" />
      <line x1="340" y1="92" x2="356" y2="92" stroke="#0E1A2D" stroke-width="2.5" />
      <line x1="484" y1="92" x2="500" y2="92" stroke="#0E1A2D" stroke-width="2.5" />
    </g>

    {/* ─── Four streams ─── */}
    {streams.map(({ id, num, bx, tx }) => (
      <a href={`#card-${id}`} data-pillar-id={id} aria-label={aria[id]}>
        <g class="stream-group">
          {/* Glow layer (behind solid) */}
          <path d={streamPath(bx, tx)} fill="url(#stream-fill)" filter="url(#glow)" class="stream-glow" opacity="0.55" />

          {/* Solid stream */}
          <path d={streamPath(bx, tx)} fill="url(#stream-fill)" class="stream-body" />

          {/* Subtle highlight wash */}
          <path d={streamPath(bx, tx)} fill="url(#stream-highlight)" pointer-events="none" />

          {/* Vertical inner accent — single bright thread up the centre */}
          <line x1={bx} y1={streamBottomY - 18} x2={tx} y2={streamTopY + 22} stroke="#ffffff" stroke-width="1.2" opacity="0.28" stroke-linecap="round" pointer-events="none" />

          {/* Icon — cream on blue, midway up the stream */}
          <g transform={`translate(${bx + (tx - bx) * 0.55 - 18}, ${streamBottomY - (streamBottomY - streamTopY) * 0.58 - 18})`} fill="none" stroke="#F8F7F4" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="stream-icon" pointer-events="none">
            {id === 'search-ai-intelligence' && (
              <g>
                <circle cx="15" cy="15" r="9" />
                <line x1="22" y1="22" x2="28" y2="28" />
                <path d="M28 4 L29.5 7.5 L33 9 L29.5 10.5 L28 14 L26.5 10.5 L23 9 L26.5 7.5 Z" fill="#B8893B" stroke="none" />
              </g>
            )}
            {id === 'performance-media' && (
              <g>
                <line x1="2" y1="32" x2="34" y2="32" />
                <rect x="5" y="22" width="7" height="10" />
                <rect x="15" y="14" width="7" height="18" />
                <rect x="25" y="4" width="7" height="28" fill="#B8893B" fill-opacity="0.55" />
              </g>
            )}
            {id === 'authority-pr' && (
              <g>
                <path d="M18 3 L32 8 V17 C32 25 18 32 18 32 C18 32 4 25 4 17 V8 Z" />
                <path d="M12 17 L16 21 L24 13" stroke="#B8893B" stroke-width="2.4" />
              </g>
            )}
            {id === 'content-copywriting' && (
              <g>
                <path d="M6 3 H22 L30 11 V33 H6 Z" />
                <path d="M22 3 V11 H30" />
                <line x1="12" y1="18" x2="24" y2="18" />
                <line x1="12" y1="23" x2="24" y2="23" />
                <line x1="12" y1="28" x2="18" y2="28" stroke="#B8893B" stroke-width="2.4" />
              </g>
            )}
          </g>

          {/* Label above the stream's top */}
          <text x={tx} y={streamTopY - 18} text-anchor="middle" fill="#0E1A2D" font-size="13" font-weight="700" letter-spacing="0.5" class="stream-label">{labels[id]}</text>

          {/* Number badge — gold disc at stream base */}
          <circle cx={bx} cy={streamBottomY + 2} r="14" fill="#B8893B" stroke="#F8F7F4" stroke-width="2" class="stream-number-ring" />
          <text x={bx} y={streamBottomY + 6} text-anchor="middle" fill="#0E1A2D" font-size="12" font-weight="800">{num}</text>
        </g>
      </a>
    ))}

    {/* ─── Foundation ─── */}
    <a href="#card-data-web" data-pillar-id="data-web" aria-label={aria['data-web']}>
      <g class="foundation-group">
        {/* Gold accent line above foundation */}
        <rect x="50" y={foundationY - 4} width="740" height="2.5" fill="#B8893B" class="foundation-gold" />

        {/* Main slab */}
        <rect x="50" y={foundationY} width="740" height={foundationH} fill="url(#foundation-fill)" class="foundation-fill" rx="4" />
        <rect x="50" y={foundationY} width="740" height={foundationH} fill="url(#found-hatch)" pointer-events="none" rx="4" />

        {/* Database icon left */}
        <g transform={`translate(82, ${foundationY + 18})`} fill="none" stroke="#B8893B" stroke-width="1.9" pointer-events="none">
          <ellipse cx="11" cy="3" rx="10" ry="3" />
          <path d="M1 3 V13 C1 14.5 5.5 16 11 16 C16.5 16 21 14.5 21 13 V3" />
          <path d="M1 13 V23 C1 24.5 5.5 26 11 26 C16.5 26 21 24.5 21 23 V13" />
        </g>

        {/* DATEN & WEB label */}
        <text x="420" y={foundationY + foundationH / 2 + 5} text-anchor="middle" fill="#F8F7F4" font-size="16" font-weight="800" letter-spacing="8" pointer-events="none">{strings.foundation}</text>

        {/* Right micro-dots — data motif */}
        <g transform={`translate(718, ${foundationY + 20})`} pointer-events="none">
          <circle cx="0" cy="0" r="1.5" fill="#B8893B" />
          <circle cx="8" cy="0" r="1.5" fill="#F8F7F4" opacity="0.4" />
          <circle cx="16" cy="0" r="1.5" fill="#F8F7F4" opacity="0.2" />
          <circle cx="0" cy="8" r="1.5" fill="#F8F7F4" opacity="0.4" />
          <circle cx="8" cy="8" r="1.5" fill="#F8F7F4" opacity="0.7" />
          <circle cx="16" cy="8" r="1.5" fill="#B8893B" />
          <circle cx="0" cy="16" r="1.5" fill="#F8F7F4" opacity="0.2" />
          <circle cx="8" cy="16" r="1.5" fill="#B8893B" opacity="0.6" />
          <circle cx="16" cy="16" r="1.5" fill="#F8F7F4" opacity="0.5" />
        </g>
      </g>
    </a>

    {/* Caption below foundation */}
    <text x="420" y={foundationY + foundationH + 30} text-anchor="middle" fill="#0E1A2D" opacity="0.55" font-size="11" font-style="italic">{strings.caption}</text>
  </svg>
</div>

<style>
  .building-graphic :global(.stream-group),
  .building-graphic :global(.foundation-group) {
    transition: transform 320ms cubic-bezier(0.4, 0, 0.2, 1);
    transform-origin: center bottom;
    transform-box: fill-box;
  }
  .building-graphic :global(.stream-body),
  .building-graphic :global(.stream-glow),
  .building-graphic :global(.stream-number-ring),
  .building-graphic :global(.foundation-fill),
  .building-graphic :global(.foundation-gold) {
    transition: fill 260ms ease, filter 260ms ease, stroke 260ms ease, opacity 260ms ease;
  }
  .building-graphic a {
    cursor: pointer;
  }

  /* Stream hover / focus / paired-active */
  .building-graphic a[data-pillar-id]:hover .stream-group,
  .building-graphic a[data-pillar-id]:focus-visible .stream-group,
  .building-graphic a[data-pillar-id].is-active .stream-group {
    transform: translateY(-6px) scale(1.015);
  }
  .building-graphic a[data-pillar-id]:hover .stream-body,
  .building-graphic a[data-pillar-id]:focus-visible .stream-body,
  .building-graphic a[data-pillar-id].is-active .stream-body {
    fill: url(#stream-fill-active);
  }
  .building-graphic a[data-pillar-id]:hover .stream-glow,
  .building-graphic a[data-pillar-id]:focus-visible .stream-glow,
  .building-graphic a[data-pillar-id].is-active .stream-glow {
    filter: url(#glow-active);
    opacity: 0.85;
  }
  .building-graphic a[data-pillar-id]:hover .stream-number-ring,
  .building-graphic a[data-pillar-id]:focus-visible .stream-number-ring,
  .building-graphic a[data-pillar-id].is-active .stream-number-ring {
    fill: #D4A44A;
  }

  /* Foundation hover */
  .building-graphic a[data-pillar-id="data-web"]:hover .foundation-group,
  .building-graphic a[data-pillar-id="data-web"]:focus-visible .foundation-group,
  .building-graphic a[data-pillar-id="data-web"].is-active .foundation-group {
    transform: translateY(-2px);
  }
  .building-graphic a[data-pillar-id="data-web"]:hover .foundation-gold,
  .building-graphic a[data-pillar-id="data-web"]:focus-visible .foundation-gold,
  .building-graphic a[data-pillar-id="data-web"].is-active .foundation-gold {
    fill: #D4A44A;
  }

  .building-graphic a[data-pillar-id]:focus-visible {
    outline: 2px solid #3B7DD8;
    outline-offset: 3px;
    border-radius: 4px;
  }

  /* Paired highlight on card wrappers below */
  :global(.pillar-card-wrapper) {
    transition: transform 220ms ease, box-shadow 220ms ease;
    border-radius: 0.5rem;
  }
  :global(.pillar-card-wrapper.is-active) {
    transform: translateY(-4px);
    box-shadow: 0 0 0 2px #3B7DD8, 0 12px 24px -6px rgba(59, 125, 216, 0.25);
  }
  :global(.pillar-card-wrapper.is-flash) {
    animation: pillar-flash 1.4s ease-out;
  }
  @keyframes pillar-flash {
    0% { box-shadow: 0 0 0 0 rgba(59, 125, 216, 0.6); }
    40% { box-shadow: 0 0 0 6px rgba(59, 125, 216, 0.45); }
    100% { box-shadow: 0 0 0 0 rgba(59, 125, 216, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .building-graphic :global(.stream-group),
    .building-graphic :global(.foundation-group),
    :global(.pillar-card-wrapper) {
      transition: none !important;
    }
    .building-graphic a:hover .stream-group,
    .building-graphic a:hover .foundation-group,
    .building-graphic a.is-active .stream-group,
    .building-graphic a.is-active .foundation-group,
    :global(.pillar-card-wrapper.is-active),
    :global(.pillar-card-wrapper.is-flash) {
      transform: none !important;
      filter: none !important;
      animation: none !important;
    }
  }
</style>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const elements = Array.from(document.querySelectorAll<HTMLElement>('[data-pillar-id]'));
  const groups = new Map<string, HTMLElement[]>();
  elements.forEach((el) => {
    const id = el.getAttribute('data-pillar-id');
    if (!id) return;
    if (!groups.has(id)) groups.set(id, []);
    groups.get(id)!.push(el);
  });

  groups.forEach((group) => {
    const activate = () => group.forEach((el) => el.classList.add('is-active'));
    const deactivate = () => group.forEach((el) => el.classList.remove('is-active'));
    group.forEach((el) => {
      el.addEventListener('mouseenter', activate);
      el.addEventListener('mouseleave', deactivate);
      el.addEventListener('focusin', activate);
      el.addEventListener('focusout', deactivate);
    });
  });

  document.querySelectorAll<HTMLAnchorElement>('.building-graphic a[data-pillar-id]').forEach((link) => {
    link.addEventListener('click', (event) => {
      const id = link.getAttribute('data-pillar-id');
      if (!id) return;
      const card = document.querySelector<HTMLElement>(`.pillar-card-wrapper[data-pillar-id="${id}"]`);
      if (!card) return;
      event.preventDefault();
      card.scrollIntoView({ behavior: prefersReducedMotion ? 'auto' : 'smooth', block: 'center' });
      card.classList.remove('is-flash');
      void card.offsetWidth;
      card.classList.add('is-flash');
      window.setTimeout(() => card.classList.remove('is-flash'), 1500);
    });
  });
</script>
