---
interface Props {
  locale: 'de' | 'ch-de' | 'en';
}

const { locale } = Astro.props;

const pillarLabels: Record<string, Record<string, string>> = {
  de: {
    'search-ai-intelligence': 'Suche & KI',
    'performance-media': 'Performance Media',
    'authority-pr': 'Autorität',
    'content-copywriting': 'Content',
  },
  'ch-de': {
    'search-ai-intelligence': 'Suche & KI',
    'performance-media': 'Performance Media',
    'authority-pr': 'Autorität',
    'content-copywriting': 'Content',
  },
  en: {
    'search-ai-intelligence': 'Search & AI',
    'performance-media': 'Performance Media',
    'authority-pr': 'Authority',
    'content-copywriting': 'Content',
  },
};

const pillarAria: Record<string, Record<string, string>> = {
  de: {
    'search-ai-intelligence': 'Zur Säule Suche und KI-Intelligenz scrollen',
    'performance-media': 'Zur Säule Performance Media scrollen',
    'authority-pr': 'Zur Säule Autorität scrollen',
    'content-copywriting': 'Zur Säule Content scrollen',
    'data-web': 'Zum Fundament Daten und Web scrollen',
  },
  'ch-de': {
    'search-ai-intelligence': 'Zur Säule Suche und KI-Intelligenz scrollen',
    'performance-media': 'Zur Säule Performance Media scrollen',
    'authority-pr': 'Zur Säule Autorität scrollen',
    'content-copywriting': 'Zur Säule Content scrollen',
    'data-web': 'Zum Fundament Daten und Web scrollen',
  },
  en: {
    'search-ai-intelligence': 'Jump to Search and AI Intelligence card',
    'performance-media': 'Jump to Performance Media card',
    'authority-pr': 'Jump to Authority card',
    'content-copywriting': 'Jump to Content card',
    'data-web': 'Jump to Data and Web card',
  },
};

const strings = {
  de: {
    top: 'WACHSTUM',
    foundation: 'DATEN & WEB',
    caption: 'Fundament jeder strategischen Entscheidung',
    title: 'StarkRank — vier Disziplinen steigen auf',
    desc: 'Vier StarkRank-Chevrons steigen vom Fundament Daten und Web zur Wachstumsspitze auf. Jeder Chevron trägt den Namen einer Disziplin — Suche und KI-Intelligenz, Performance Media, Autorität, Content und Texterstellung. Beim Hover wird die zugehörige Karte unten hervorgehoben, beim Klick wird dorthin gescrollt.',
  },
  'ch-de': {
    top: 'WACHSTUM',
    foundation: 'DATEN & WEB',
    caption: 'Fundament jeder strategischen Entscheidung',
    title: 'StarkRank — vier Disziplinen steigen auf',
    desc: 'Vier StarkRank-Chevrons steigen vom Fundament Daten und Web zur Wachstumsspitze auf. Jeder Chevron trägt den Namen einer Disziplin — Suche und KI-Intelligenz, Performance Media, Autorität, Content und Texterstellung. Beim Hover wird die zugehörige Karte unten hervorgehoben, beim Klick wird dorthin gescrollt.',
  },
  en: {
    top: 'GROWTH',
    foundation: 'DATA & WEB',
    caption: 'Foundation of every strategic decision',
    title: 'StarkRank — four disciplines ascending',
    desc: 'Four StarkRank chevrons rise from the Data and Web foundation toward the growth peak. Each chevron is labeled with a discipline — Search and AI Intelligence, Performance Media, Authority, Content and Copywriting. Hovering highlights the matching card below; clicking scrolls to it.',
  },
}[locale];

const aria = pillarAria[locale];
const labels = pillarLabels[locale];

// ─── Geometry ───
// Single-column of 4 double-chevron marks. Each mark mirrors the logo's
// pictorial mark: larger filled triangle + smaller filled triangle offset
// upper-left. Chevrons shift slightly rightward as they ascend.
const chevronW = 110;
const chevronH = 72;
const chevronGapY = 24;
const firstChevronY = 118; // top of highest (chevron 04)

// Bottom-to-top indexing: row 0 = bottommost (01 Suche & KI), row 3 = top (04)
// We render top-to-bottom visually, so visual order = [04, 03, 02, 01]
const chevronRows = [
  { id: 'search-ai-intelligence', row: 0 },
  { id: 'performance-media', row: 1 },
  { id: 'authority-pr', row: 2 },
  { id: 'content-copywriting', row: 3 },
];

// Position each row. row 3 is at top (lowest Y), row 0 at bottom (highest Y).
// Each row shifts slightly LEFT as it descends (bottom chevron more to the left,
// top chevron more to the right — creates a subtle rising-rightward trajectory).
function chevronCenter(row: number) {
  const y = firstChevronY + chevronH / 2 + (3 - row) * (chevronH + chevronGapY);
  const x = 248 + row * 14; // rightward shift as row index rises
  return { x, y };
}

const baselineY = firstChevronY + chevronH * 4 + chevronGapY * 3 + 18; // top of foundation
const foundationH = 72;

// Proper chevron band path — inverted-V with hollow interior, matches SR logo mark
function chevronBandPath(cx: number, cy: number, w: number, h: number, t: number): string {
  const hw = w / 2;
  const hh = h / 2;
  const innerPeakY = cy - hh + t * 1.8;
  return [
    `M ${cx - hw} ${cy + hh}`,
    `L ${cx} ${cy - hh}`,
    `L ${cx + hw} ${cy + hh}`,
    `L ${cx + hw - t} ${cy + hh}`,
    `L ${cx} ${innerPeakY}`,
    `L ${cx - hw + t} ${cy + hh}`,
    'Z',
  ].join(' ');
}

// Generate the double-chevron paths: larger primary-blue + smaller navy offset upper-left.
function chevronPaths(cx: number, cy: number) {
  const outerT = chevronW * 0.26;
  const innerW = chevronW * 0.62;
  const innerH = chevronH * 0.62;
  const innerT = innerW * 0.3;
  const offsetX = -chevronW * 0.22;
  const offsetY = -chevronH * 0.2;
  return {
    outer: chevronBandPath(cx, cy, chevronW, chevronH, outerT),
    inner: chevronBandPath(cx + offsetX, cy + offsetY, innerW, innerH, innerT),
  };
}

// Small mini brand-mark for top accent (matches the logo style in miniature)
const miniMarkOuter = chevronBandPath(0, 0, 28, 16, 7);
const miniMarkInner = chevronBandPath(-4, -3, 18, 11, 4);
---

<div class="building-graphic relative">
  <svg
    viewBox="0 0 840 640"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-labelledby="building-title building-desc"
    class="w-full h-auto max-w-3xl mx-auto mt-8"
    style="font-family: 'Inter Tight', ui-sans-serif, system-ui, sans-serif;"
  >
    <title id="building-title">{strings.title}</title>
    <desc id="building-desc">{strings.desc}</desc>

    <defs>
      {/* Warm backdrop */}
      <radialGradient id="backdrop" cx="50%" cy="50%" r="75%">
        <stop offset="0%" stop-color="#FDFCFA" />
        <stop offset="100%" stop-color="#F2F0EB" />
      </radialGradient>

      {/* Foundation fill */}
      <linearGradient id="foundation-fill" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#1A3B6E" />
        <stop offset="100%" stop-color="#0E1A2D" />
      </linearGradient>
      <pattern id="found-hatch" x="0" y="0" width="14" height="14" patternUnits="userSpaceOnUse" patternTransform="rotate(30)">
        <line x1="0" y1="0" x2="0" y2="14" stroke="#3B7DD8" stroke-width="0.8" opacity="0.4" />
        <circle cx="7" cy="7" r="1" fill="#5A9AE6" opacity="0.35" />
      </pattern>

      {/* Soft glow filter */}
      <filter id="mark-glow" x="-40%" y="-40%" width="180%" height="180%">
        <feGaussianBlur stdDeviation="8" result="blur" />
        <feColorMatrix in="blur" type="matrix" values="0 0 0 0 0.231  0 0 0 0 0.490  0 0 0 0 0.847  0 0 0 0.5 0" />
      </filter>
      <filter id="mark-glow-active" x="-40%" y="-40%" width="180%" height="180%">
        <feGaussianBlur stdDeviation="14" result="blur" />
        <feColorMatrix in="blur" type="matrix" values="0 0 0 0 0.352  0 0 0 0 0.603  0 0 0 0 0.901  0 0 0 0.9 0" />
      </filter>
    </defs>

    <rect width="840" height="640" fill="url(#backdrop)" />

    {/* ─── WACHSTUM peak — Inter Tight Black, with tiny logo mark in gold below ─── */}
    <g>
      <text x="420" y="68" text-anchor="middle" fill="#0E1A2D" font-size="26" font-weight="900" letter-spacing="10">{strings.top}</text>
      <g transform="translate(420, 88)">
        <path d={miniMarkOuter} fill="#3B7DD8" fill-rule="evenodd" />
        <path d={miniMarkInner} fill="#0E1A2D" fill-rule="evenodd" />
      </g>
    </g>

    {/* ─── Four StarkRank chevrons ascending ─── */}
    {chevronRows.map(({ id, row }) => {
      const center = chevronCenter(row);
      const paths = chevronPaths(center.x, center.y);
      const label = labels[id];
      return (
        <a href={`#card-${id}`} data-pillar-id={id} aria-label={aria[id]}>
          <g class="chev-group">
            {/* Glow layer */}
            <path d={paths.outer} fill="#3B7DD8" class="chev-glow" filter="url(#mark-glow)" opacity="0.6" fill-rule="evenodd" />

            {/* Larger chevron (primary blue — matches logo main) */}
            <path d={paths.outer} fill="#3B7DD8" class="chev-outer" fill-rule="evenodd" />

            {/* Smaller chevron (navy, offset upper-left — matches logo accent) */}
            <path d={paths.inner} fill="#0E1A2D" class="chev-inner" fill-rule="evenodd" />

            {/* Label — aligned with chevron's vertical center, Inter Tight Black */}
            <text
              x={center.x + chevronW / 2 + 32}
              y={center.y + 8}
              text-anchor="start"
              fill="#0E1A2D"
              font-size="26"
              font-weight="900"
              letter-spacing="-0.3"
              class="chev-label"
            >{label}</text>
          </g>
        </a>
      );
    })}

    {/* ─── Foundation ─── */}
    <a href="#card-data-web" data-pillar-id="data-web" aria-label={aria['data-web']}>
      <g class="foundation-group">
        {/* Gold accent line */}
        <rect x="50" y={baselineY - 4} width="740" height="2.5" fill="#B8893B" class="foundation-gold" />

        {/* Main slab */}
        <rect x="50" y={baselineY} width="740" height={foundationH} fill="url(#foundation-fill)" class="foundation-fill" rx="4" />
        <rect x="50" y={baselineY} width="740" height={foundationH} fill="url(#found-hatch)" pointer-events="none" rx="4" />

        {/* Database icon — gold */}
        <g transform={`translate(86, ${baselineY + 22})`} fill="none" stroke="#B8893B" stroke-width="2" pointer-events="none">
          <ellipse cx="11" cy="3" rx="10" ry="3" />
          <path d="M1 3 V13 C1 14.5 5 16 11 16 C17 16 21 14.5 21 13 V3" />
          <path d="M1 13 V23 C1 24.5 5 26 11 26 C17 26 21 24.5 21 23 V13" />
        </g>

        {/* DATEN & WEB — Inter Tight Black */}
        <text
          x="420"
          y={baselineY + foundationH / 2 + 7}
          text-anchor="middle"
          fill="#F8F7F4"
          font-size="22"
          font-weight="900"
          letter-spacing="10"
          pointer-events="none"
        >{strings.foundation}</text>

        {/* Data dot grid right */}
        <g transform={`translate(720, ${baselineY + 22})`} pointer-events="none">
          <circle cx="0" cy="0" r="1.5" fill="#B8893B" />
          <circle cx="8" cy="0" r="1.5" fill="#F8F7F4" opacity="0.4" />
          <circle cx="16" cy="0" r="1.5" fill="#F8F7F4" opacity="0.2" />
          <circle cx="0" cy="8" r="1.5" fill="#F8F7F4" opacity="0.4" />
          <circle cx="8" cy="8" r="1.5" fill="#F8F7F4" opacity="0.7" />
          <circle cx="16" cy="8" r="1.5" fill="#B8893B" />
          <circle cx="0" cy="16" r="1.5" fill="#F8F7F4" opacity="0.2" />
          <circle cx="8" cy="16" r="1.5" fill="#B8893B" opacity="0.6" />
          <circle cx="16" cy="16" r="1.5" fill="#F8F7F4" opacity="0.5" />
        </g>
      </g>
    </a>

    {/* Caption */}
    <text
      x="420"
      y={baselineY + foundationH + 32}
      text-anchor="middle"
      fill="#0E1A2D"
      opacity="0.55"
      font-size="13"
      font-style="italic"
      style="font-family: 'Inter Tight', ui-sans-serif, system-ui;"
    >{strings.caption}</text>
  </svg>
</div>

<style>
  .building-graphic :global(.chev-group),
  .building-graphic :global(.foundation-group) {
    transition: transform 320ms cubic-bezier(0.4, 0, 0.2, 1);
    transform-origin: center;
    transform-box: fill-box;
  }
  .building-graphic :global(.chev-outer),
  .building-graphic :global(.chev-inner),
  .building-graphic :global(.chev-glow),
  .building-graphic :global(.chev-label),
  .building-graphic :global(.foundation-gold),
  .building-graphic :global(.foundation-fill) {
    transition: fill 260ms ease, filter 260ms ease, stroke 260ms ease, opacity 260ms ease;
  }
  .building-graphic a {
    cursor: pointer;
  }

  /* Chevron hover — brighten, glow, lift, label accent */
  .building-graphic a[data-pillar-id]:hover .chev-group,
  .building-graphic a[data-pillar-id]:focus-visible .chev-group,
  .building-graphic a[data-pillar-id].is-active .chev-group {
    transform: translateY(-5px) scale(1.025);
  }
  .building-graphic a[data-pillar-id]:hover .chev-outer,
  .building-graphic a[data-pillar-id]:focus-visible .chev-outer,
  .building-graphic a[data-pillar-id].is-active .chev-outer {
    fill: #5A9AE6;
  }
  .building-graphic a[data-pillar-id]:hover .chev-inner,
  .building-graphic a[data-pillar-id]:focus-visible .chev-inner,
  .building-graphic a[data-pillar-id].is-active .chev-inner {
    fill: #B8893B;
  }
  .building-graphic a[data-pillar-id]:hover .chev-glow,
  .building-graphic a[data-pillar-id]:focus-visible .chev-glow,
  .building-graphic a[data-pillar-id].is-active .chev-glow {
    filter: url(#mark-glow-active);
    opacity: 0.9;
  }
  .building-graphic a[data-pillar-id]:hover .chev-label,
  .building-graphic a[data-pillar-id]:focus-visible .chev-label,
  .building-graphic a[data-pillar-id].is-active .chev-label {
    fill: #3B7DD8;
  }

  /* Foundation hover */
  .building-graphic a[data-pillar-id="data-web"]:hover .foundation-group,
  .building-graphic a[data-pillar-id="data-web"]:focus-visible .foundation-group,
  .building-graphic a[data-pillar-id="data-web"].is-active .foundation-group {
    transform: translateY(-3px);
  }
  .building-graphic a[data-pillar-id="data-web"]:hover .foundation-gold,
  .building-graphic a[data-pillar-id="data-web"]:focus-visible .foundation-gold,
  .building-graphic a[data-pillar-id="data-web"].is-active .foundation-gold {
    fill: #D4A44A;
  }

  .building-graphic a[data-pillar-id]:focus-visible {
    outline: 2px solid #3B7DD8;
    outline-offset: 3px;
    border-radius: 4px;
  }

  /* Paired card highlight below — unchanged */
  :global(.pillar-card-wrapper) {
    transition: transform 220ms ease, box-shadow 220ms ease;
    border-radius: 0.5rem;
  }
  :global(.pillar-card-wrapper.is-active) {
    transform: translateY(-4px);
    box-shadow: 0 0 0 2px #3B7DD8, 0 12px 24px -6px rgba(59, 125, 216, 0.25);
  }
  :global(.pillar-card-wrapper.is-flash) {
    animation: pillar-flash 1.4s ease-out;
  }
  @keyframes pillar-flash {
    0% { box-shadow: 0 0 0 0 rgba(59, 125, 216, 0.6); }
    40% { box-shadow: 0 0 0 6px rgba(59, 125, 216, 0.45); }
    100% { box-shadow: 0 0 0 0 rgba(59, 125, 216, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .building-graphic :global(.chev-group),
    .building-graphic :global(.foundation-group),
    :global(.pillar-card-wrapper) {
      transition: none !important;
    }
    .building-graphic a:hover .chev-group,
    .building-graphic a:hover .foundation-group,
    .building-graphic a.is-active .chev-group,
    .building-graphic a.is-active .foundation-group,
    :global(.pillar-card-wrapper.is-active),
    :global(.pillar-card-wrapper.is-flash) {
      transform: none !important;
      filter: none !important;
      animation: none !important;
    }
  }
</style>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const elements = Array.from(document.querySelectorAll<HTMLElement>('[data-pillar-id]'));
  const groups = new Map<string, HTMLElement[]>();
  elements.forEach((el) => {
    const id = el.getAttribute('data-pillar-id');
    if (!id) return;
    if (!groups.has(id)) groups.set(id, []);
    groups.get(id)!.push(el);
  });

  groups.forEach((group) => {
    const activate = () => group.forEach((el) => el.classList.add('is-active'));
    const deactivate = () => group.forEach((el) => el.classList.remove('is-active'));
    group.forEach((el) => {
      el.addEventListener('mouseenter', activate);
      el.addEventListener('mouseleave', deactivate);
      el.addEventListener('focusin', activate);
      el.addEventListener('focusout', deactivate);
    });
  });

  document.querySelectorAll<HTMLAnchorElement>('.building-graphic a[data-pillar-id]').forEach((link) => {
    link.addEventListener('click', (event) => {
      const id = link.getAttribute('data-pillar-id');
      if (!id) return;
      const card = document.querySelector<HTMLElement>(`.pillar-card-wrapper[data-pillar-id="${id}"]`);
      if (!card) return;
      event.preventDefault();
      card.scrollIntoView({ behavior: prefersReducedMotion ? 'auto' : 'smooth', block: 'center' });
      card.classList.remove('is-flash');
      void card.offsetWidth;
      card.classList.add('is-flash');
      window.setTimeout(() => card.classList.remove('is-flash'), 1500);
    });
  });
</script>
