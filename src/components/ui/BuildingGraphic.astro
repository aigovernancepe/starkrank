---
interface Props {
  locale: 'de' | 'ch-de' | 'en';
}

const { locale } = Astro.props;

const pillarLabels: Record<string, Record<string, string>> = {
  de: {
    'search-ai-intelligence': 'Suche & KI',
    'performance-media': 'Performance Media',
    'authority-pr': 'Autorität',
    'content-copywriting': 'Content',
  },
  'ch-de': {
    'search-ai-intelligence': 'Suche & KI',
    'performance-media': 'Performance Media',
    'authority-pr': 'Autorität',
    'content-copywriting': 'Content',
  },
  en: {
    'search-ai-intelligence': 'Search & AI',
    'performance-media': 'Performance Media',
    'authority-pr': 'Authority',
    'content-copywriting': 'Content',
  },
};

const pillarAria: Record<string, Record<string, string>> = {
  de: {
    'search-ai-intelligence': 'Zur Säule Suche und KI-Intelligenz scrollen',
    'performance-media': 'Zur Säule Performance Media scrollen',
    'authority-pr': 'Zur Säule Autorität scrollen',
    'content-copywriting': 'Zur Säule Content scrollen',
    'data-web': 'Zum Fundament Daten und Web scrollen',
  },
  'ch-de': {
    'search-ai-intelligence': 'Zur Säule Suche und KI-Intelligenz scrollen',
    'performance-media': 'Zur Säule Performance Media scrollen',
    'authority-pr': 'Zur Säule Autorität scrollen',
    'content-copywriting': 'Zur Säule Content scrollen',
    'data-web': 'Zum Fundament Daten und Web scrollen',
  },
  en: {
    'search-ai-intelligence': 'Jump to Search and AI Intelligence card',
    'performance-media': 'Jump to Performance Media card',
    'authority-pr': 'Jump to Authority card',
    'content-copywriting': 'Jump to Content card',
    'data-web': 'Jump to Data and Web card',
  },
};

const strings = {
  de: {
    top: 'WACHSTUM',
    foundation: 'DATEN & WEB',
    caption: 'Fundament jeder strategischen Entscheidung',
    title: 'StarkRank — vier Disziplinen steigen auf',
    desc: 'Vier gestapelte Chevrons im StarkRank-Stil steigen vom Fundament Daten und Web zur Wachstumsspitze auf. Jeder Chevron steht für eine Disziplin — Suche und KI-Intelligenz, Performance Media, Autorität, Content und Texterstellung. Beim Hover wird die zugehörige Karte unten hervorgehoben, beim Klick wird dorthin gescrollt.',
  },
  'ch-de': {
    top: 'WACHSTUM',
    foundation: 'DATEN & WEB',
    caption: 'Fundament jeder strategischen Entscheidung',
    title: 'StarkRank — vier Disziplinen steigen auf',
    desc: 'Vier gestapelte Chevrons im StarkRank-Stil steigen vom Fundament Daten und Web zur Wachstumsspitze auf. Jeder Chevron steht für eine Disziplin — Suche und KI-Intelligenz, Performance Media, Autorität, Content und Texterstellung. Beim Hover wird die zugehörige Karte unten hervorgehoben, beim Klick wird dorthin gescrollt.',
  },
  en: {
    top: 'GROWTH',
    foundation: 'DATA & WEB',
    caption: 'Foundation of every strategic decision',
    title: 'StarkRank — four disciplines ascending',
    desc: 'Four stacked chevrons in the StarkRank mark style ascend from the Data and Web foundation toward the growth peak. Each chevron represents a discipline — Search and AI Intelligence, Performance Media, Authority, Content and Copywriting. Hovering highlights the matching card below; clicking scrolls to it.',
  },
}[locale];

const aria = pillarAria[locale];
const labels = pillarLabels[locale];

// ─── Geometry ───
// Canvas: 840 × 560. Foundation slab at bottom. Four chevrons rising in a
// nested stack, each with a higher peak and narrower footprint. Peaks
// shift slightly rightward for a "trend ascending" sensibility.
const baseY = 472;          // chevron foot Y (top of foundation)
const foundationY = 480;
const foundationH = 60;

type Chevron = {
  id: string;
  num: string;
  // Outer (larger) chevron — matches the brand-mark's primary chevron
  footLeftX: number;
  footRightX: number;
  peakX: number;
  peakY: number;
  // Thickness of the chevron stroke band (outer - inner)
  band: number;
  // Color token for this layer
  color: string;
  colorActive: string;
};

// Build four chevrons ascending. Each has outer + inner edges — the inner
// edge produces the "chevron band" shape that echoes the SR mark.
const chevrons: Chevron[] = [
  {
    id: 'search-ai-intelligence',
    num: '01',
    footLeftX: 110,
    footRightX: 720,
    peakX: 400,
    peakY: 330,
    band: 36,
    color: '#1A3B6E',
    colorActive: '#2E5FA8',
  },
  {
    id: 'performance-media',
    num: '02',
    footLeftX: 180,
    footRightX: 680,
    peakX: 415,
    peakY: 246,
    band: 32,
    color: '#2E5FA8',
    colorActive: '#3B7DD8',
  },
  {
    id: 'authority-pr',
    num: '03',
    footLeftX: 260,
    footRightX: 630,
    peakX: 430,
    peakY: 170,
    band: 28,
    color: '#3B7DD8',
    colorActive: '#5A9AE6',
  },
  {
    id: 'content-copywriting',
    num: '04',
    footLeftX: 340,
    footRightX: 570,
    peakX: 445,
    peakY: 98,
    band: 24,
    color: '#5A9AE6',
    colorActive: '#8AB6EC',
  },
];

// Render a chevron as a band (outer filled triangle minus inner cutout).
// Path winds outer clockwise + inner counter-clockwise (even-odd fill).
function chevronPath(c: Chevron): string {
  const outerL = { x: c.footLeftX, y: baseY };
  const outerR = { x: c.footRightX, y: baseY };
  const outerP = { x: c.peakX, y: c.peakY };

  // Inset the inner edge by `band` pixels perpendicular to each leg.
  // For simplicity compute the inner triangle by moving peak down + feet inward.
  const innerP = { x: c.peakX, y: c.peakY + c.band * 1.6 };
  const innerL = { x: c.footLeftX + c.band * 1.3, y: baseY };
  const innerR = { x: c.footRightX - c.band * 1.3, y: baseY };

  return [
    `M ${outerL.x} ${outerL.y}`,
    `L ${outerP.x} ${outerP.y}`,
    `L ${outerR.x} ${outerR.y}`,
    `L ${innerR.x} ${innerR.y}`,
    `L ${innerP.x} ${innerP.y}`,
    `L ${innerL.x} ${innerL.y}`,
    'Z',
  ].join(' ');
}

// Small brand-mark badge: double chevron (outer + offset inner), inside the number disc.
const badgeMarkPath = 'M -6 3 L 0 -3 L 6 3 M -3.5 5 L 0 0.5 L 3.5 5';
---

<div class="building-graphic relative">
  <svg
    viewBox="0 0 840 600"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-labelledby="building-title building-desc"
    class="w-full h-auto max-w-3xl mx-auto mt-8"
    style="font-family: 'Outfit', ui-sans-serif, system-ui;"
  >
    <title id="building-title">{strings.title}</title>
    <desc id="building-desc">{strings.desc}</desc>

    <defs>
      {/* Warm radial backdrop */}
      <radialGradient id="backdrop" cx="50%" cy="50%" r="75%">
        <stop offset="0%" stop-color="#FDFCFA" />
        <stop offset="100%" stop-color="#F2F0EB" />
      </radialGradient>

      {/* Foundation fill */}
      <linearGradient id="foundation-fill" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#1A3B6E" />
        <stop offset="100%" stop-color="#0E1A2D" />
      </linearGradient>

      {/* Foundation data-motif hatch */}
      <pattern id="found-hatch" x="0" y="0" width="14" height="14" patternUnits="userSpaceOnUse" patternTransform="rotate(30)">
        <line x1="0" y1="0" x2="0" y2="14" stroke="#3B7DD8" stroke-width="0.8" opacity="0.4" />
        <circle cx="7" cy="7" r="1" fill="#5A9AE6" opacity="0.35" />
      </pattern>

      {/* Glow filter — layered chevrons need subtle bloom */}
      <filter id="chev-glow" x="-30%" y="-30%" width="160%" height="160%">
        <feGaussianBlur stdDeviation="6" result="blur" />
        <feColorMatrix in="blur" type="matrix" values="0 0 0 0 0.231  0 0 0 0 0.490  0 0 0 0 0.847  0 0 0 0.55 0" />
      </filter>
      <filter id="chev-glow-active" x="-30%" y="-30%" width="160%" height="160%">
        <feGaussianBlur stdDeviation="12" result="blur" />
        <feColorMatrix in="blur" type="matrix" values="0 0 0 0 0.352  0 0 0 0 0.603  0 0 0 0 0.901  0 0 0 0.85 0" />
      </filter>
    </defs>

    {/* Backdrop */}
    <rect width="840" height="600" fill="url(#backdrop)" />

    {/* ─── WACHSTUM peak label ─── */}
    <g>
      <text x="420" y="60" text-anchor="middle" fill="#0E1A2D" font-size="22" font-weight="900" letter-spacing="10">{strings.top}</text>
      {/* Mini brand-mark accent under label (tiny double-chevron in gold) */}
      <g transform="translate(420, 76)" fill="none" stroke="#B8893B" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M -14 7 L 0 -7 L 14 7" />
        <path d="M -8 10 L 0 1 L 8 10" stroke="#0E1A2D" stroke-width="2" />
      </g>
    </g>

    {/* ─── Four ascending chevrons ─── */}
    {chevrons.map((c) => (
      <a href={`#card-${c.id}`} data-pillar-id={c.id} aria-label={aria[c.id]}>
        <g class="chev-group" style={`--chev-color:${c.color};--chev-color-active:${c.colorActive};`}>
          {/* Glow layer behind solid */}
          <path d={chevronPath(c)} fill={c.color} class="chev-glow" filter="url(#chev-glow)" opacity="0.55" />

          {/* Solid chevron band */}
          <path d={chevronPath(c)} fill={c.color} class="chev-body" />

          {/* Inner highlight stripe — light line following inner peak edge */}
          <g opacity="0.35" pointer-events="none">
            <line x1={c.peakX - 3} y1={c.peakY + c.band * 1.65} x2={c.footLeftX + c.band * 1.35} y2={baseY - 2} stroke="#ffffff" stroke-width="1" stroke-linecap="round" />
            <line x1={c.peakX + 3} y1={c.peakY + c.band * 1.65} x2={c.footRightX - c.band * 1.35} y2={baseY - 2} stroke="#ffffff" stroke-width="1" stroke-linecap="round" />
          </g>

          {/* Gold peak accent — tiny triangle kissing the apex */}
          <path d={`M ${c.peakX - 5} ${c.peakY + 4} L ${c.peakX} ${c.peakY - 3} L ${c.peakX + 5} ${c.peakY + 4} Z`} fill="#B8893B" class="chev-peak-gold" pointer-events="none" />

          {/* Number disc — on the right outer face mid-height */}
          {(() => {
            const midX = (c.footRightX + c.peakX) / 2 + 6;
            const midY = (baseY + c.peakY) / 2;
            return (
              <g transform={`translate(${midX}, ${midY})`} class="chev-badge">
                <circle cx="0" cy="0" r="16" fill="#F8F7F4" stroke="#B8893B" stroke-width="2.5" class="chev-badge-ring" />
                <text x="0" y="4" text-anchor="middle" fill="#0E1A2D" font-size="11" font-weight="800" letter-spacing="0.5">{c.num}</text>
              </g>
            );
          })()}

          {/* Label on the left outer face, mirrored */}
          {(() => {
            const midX = (c.footLeftX + c.peakX) / 2 - 12;
            const midY = (baseY + c.peakY) / 2 - 2;
            return (
              <text x={midX} y={midY} text-anchor="end" fill="#0E1A2D" font-size="12" font-weight="700" letter-spacing="0.3" class="chev-label">{labels[c.id]}</text>
            );
          })()}
        </g>
      </a>
    ))}

    {/* ─── Foundation ─── */}
    <a href="#card-data-web" data-pillar-id="data-web" aria-label={aria['data-web']}>
      <g class="foundation-group">
        {/* Gold accent line above */}
        <rect x="50" y={foundationY - 4} width="740" height="2.5" fill="#B8893B" class="foundation-gold" />

        {/* Main slab */}
        <rect x="50" y={foundationY} width="740" height={foundationH} fill="url(#foundation-fill)" class="foundation-fill" rx="4" />
        <rect x="50" y={foundationY} width="740" height={foundationH} fill="url(#found-hatch)" pointer-events="none" rx="4" />

        {/* Database icon left — gold */}
        <g transform={`translate(82, ${foundationY + 16})`} fill="none" stroke="#B8893B" stroke-width="1.9" pointer-events="none">
          <ellipse cx="11" cy="3" rx="10" ry="3" />
          <path d="M1 3 V12 C1 13.5 5 15 11 15 C17 15 21 13.5 21 12 V3" />
          <path d="M1 12 V21 C1 22.5 5 24 11 24 C17 24 21 22.5 21 21 V12" />
        </g>

        {/* DATEN & WEB label */}
        <text x="420" y={foundationY + foundationH / 2 + 5} text-anchor="middle" fill="#F8F7F4" font-size="16" font-weight="800" letter-spacing="8" pointer-events="none">{strings.foundation}</text>

        {/* Data dot grid right */}
        <g transform={`translate(718, ${foundationY + 18})`} pointer-events="none">
          <circle cx="0" cy="0" r="1.5" fill="#B8893B" />
          <circle cx="8" cy="0" r="1.5" fill="#F8F7F4" opacity="0.4" />
          <circle cx="16" cy="0" r="1.5" fill="#F8F7F4" opacity="0.2" />
          <circle cx="0" cy="8" r="1.5" fill="#F8F7F4" opacity="0.4" />
          <circle cx="8" cy="8" r="1.5" fill="#F8F7F4" opacity="0.7" />
          <circle cx="16" cy="8" r="1.5" fill="#B8893B" />
          <circle cx="0" cy="16" r="1.5" fill="#F8F7F4" opacity="0.2" />
          <circle cx="8" cy="16" r="1.5" fill="#B8893B" opacity="0.6" />
          <circle cx="16" cy="16" r="1.5" fill="#F8F7F4" opacity="0.5" />
        </g>
      </g>
    </a>

    {/* Caption */}
    <text x="420" y={foundationY + foundationH + 30} text-anchor="middle" fill="#0E1A2D" opacity="0.55" font-size="11" font-style="italic">{strings.caption}</text>
  </svg>
</div>

<style>
  .building-graphic :global(.chev-group),
  .building-graphic :global(.foundation-group) {
    transition: transform 320ms cubic-bezier(0.4, 0, 0.2, 1);
    transform-origin: center bottom;
    transform-box: fill-box;
  }
  .building-graphic :global(.chev-body),
  .building-graphic :global(.chev-glow),
  .building-graphic :global(.chev-peak-gold),
  .building-graphic :global(.chev-badge-ring),
  .building-graphic :global(.foundation-gold) {
    transition: fill 260ms ease, filter 260ms ease, stroke 260ms ease, opacity 260ms ease;
  }
  .building-graphic a {
    cursor: pointer;
  }

  /* Chevron hover / focus / paired-active */
  .building-graphic a[data-pillar-id]:hover .chev-group,
  .building-graphic a[data-pillar-id]:focus-visible .chev-group,
  .building-graphic a[data-pillar-id].is-active .chev-group {
    transform: translateY(-6px) scale(1.015);
  }
  .building-graphic a[data-pillar-id]:hover .chev-body,
  .building-graphic a[data-pillar-id]:focus-visible .chev-body,
  .building-graphic a[data-pillar-id].is-active .chev-body {
    fill: var(--chev-color-active);
  }
  .building-graphic a[data-pillar-id]:hover .chev-glow,
  .building-graphic a[data-pillar-id]:focus-visible .chev-glow,
  .building-graphic a[data-pillar-id].is-active .chev-glow {
    fill: var(--chev-color-active);
    filter: url(#chev-glow-active);
    opacity: 0.85;
  }
  .building-graphic a[data-pillar-id]:hover .chev-peak-gold,
  .building-graphic a[data-pillar-id]:focus-visible .chev-peak-gold,
  .building-graphic a[data-pillar-id].is-active .chev-peak-gold {
    fill: #D4A44A;
  }
  .building-graphic a[data-pillar-id]:hover .chev-badge-ring,
  .building-graphic a[data-pillar-id]:focus-visible .chev-badge-ring,
  .building-graphic a[data-pillar-id].is-active .chev-badge-ring {
    stroke: #D4A44A;
    fill: #FFFCF5;
  }

  /* Foundation hover */
  .building-graphic a[data-pillar-id="data-web"]:hover .foundation-group,
  .building-graphic a[data-pillar-id="data-web"]:focus-visible .foundation-group,
  .building-graphic a[data-pillar-id="data-web"].is-active .foundation-group {
    transform: translateY(-3px);
  }
  .building-graphic a[data-pillar-id="data-web"]:hover .foundation-gold,
  .building-graphic a[data-pillar-id="data-web"]:focus-visible .foundation-gold,
  .building-graphic a[data-pillar-id="data-web"].is-active .foundation-gold {
    fill: #D4A44A;
  }

  .building-graphic a[data-pillar-id]:focus-visible {
    outline: 2px solid #3B7DD8;
    outline-offset: 3px;
    border-radius: 4px;
  }

  /* Paired highlight on card wrappers below */
  :global(.pillar-card-wrapper) {
    transition: transform 220ms ease, box-shadow 220ms ease;
    border-radius: 0.5rem;
  }
  :global(.pillar-card-wrapper.is-active) {
    transform: translateY(-4px);
    box-shadow: 0 0 0 2px #3B7DD8, 0 12px 24px -6px rgba(59, 125, 216, 0.25);
  }
  :global(.pillar-card-wrapper.is-flash) {
    animation: pillar-flash 1.4s ease-out;
  }
  @keyframes pillar-flash {
    0% { box-shadow: 0 0 0 0 rgba(59, 125, 216, 0.6); }
    40% { box-shadow: 0 0 0 6px rgba(59, 125, 216, 0.45); }
    100% { box-shadow: 0 0 0 0 rgba(59, 125, 216, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .building-graphic :global(.chev-group),
    .building-graphic :global(.foundation-group),
    :global(.pillar-card-wrapper) {
      transition: none !important;
    }
    .building-graphic a:hover .chev-group,
    .building-graphic a:hover .foundation-group,
    .building-graphic a.is-active .chev-group,
    .building-graphic a.is-active .foundation-group,
    :global(.pillar-card-wrapper.is-active),
    :global(.pillar-card-wrapper.is-flash) {
      transform: none !important;
      filter: none !important;
      animation: none !important;
    }
  }
</style>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const elements = Array.from(document.querySelectorAll<HTMLElement>('[data-pillar-id]'));
  const groups = new Map<string, HTMLElement[]>();
  elements.forEach((el) => {
    const id = el.getAttribute('data-pillar-id');
    if (!id) return;
    if (!groups.has(id)) groups.set(id, []);
    groups.get(id)!.push(el);
  });

  groups.forEach((group) => {
    const activate = () => group.forEach((el) => el.classList.add('is-active'));
    const deactivate = () => group.forEach((el) => el.classList.remove('is-active'));
    group.forEach((el) => {
      el.addEventListener('mouseenter', activate);
      el.addEventListener('mouseleave', deactivate);
      el.addEventListener('focusin', activate);
      el.addEventListener('focusout', deactivate);
    });
  });

  document.querySelectorAll<HTMLAnchorElement>('.building-graphic a[data-pillar-id]').forEach((link) => {
    link.addEventListener('click', (event) => {
      const id = link.getAttribute('data-pillar-id');
      if (!id) return;
      const card = document.querySelector<HTMLElement>(`.pillar-card-wrapper[data-pillar-id="${id}"]`);
      if (!card) return;
      event.preventDefault();
      card.scrollIntoView({ behavior: prefersReducedMotion ? 'auto' : 'smooth', block: 'center' });
      card.classList.remove('is-flash');
      void card.offsetWidth;
      card.classList.add('is-flash');
      window.setTimeout(() => card.classList.remove('is-flash'), 1500);
    });
  });
</script>
