---
interface Props {
  locale: 'de' | 'ch-de' | 'en';
}

const { locale } = Astro.props;

const pillarLabels: Record<string, Record<string, string[]>> = {
  de: {
    'search-ai-intelligence': ['Suche', '& KI'],
    'performance-media': ['Performance', 'Media'],
    'authority-pr': ['Autorität'],
    'content-copywriting': ['Content'],
  },
  'ch-de': {
    'search-ai-intelligence': ['Suche', '& KI'],
    'performance-media': ['Performance', 'Media'],
    'authority-pr': ['Autorität'],
    'content-copywriting': ['Content'],
  },
  en: {
    'search-ai-intelligence': ['Search', '& AI'],
    'performance-media': ['Performance', 'Media'],
    'authority-pr': ['Authority'],
    'content-copywriting': ['Content'],
  },
};

const pillarAria: Record<string, Record<string, string>> = {
  de: {
    'search-ai-intelligence': 'Zur Säule Suche und KI-Intelligenz scrollen',
    'performance-media': 'Zur Säule Performance Media scrollen',
    'authority-pr': 'Zur Säule Autorität scrollen',
    'content-copywriting': 'Zur Säule Content scrollen',
    'data-web': 'Zum Fundament Daten und Web scrollen',
  },
  'ch-de': {
    'search-ai-intelligence': 'Zur Säule Suche und KI-Intelligenz scrollen',
    'performance-media': 'Zur Säule Performance Media scrollen',
    'authority-pr': 'Zur Säule Autorität scrollen',
    'content-copywriting': 'Zur Säule Content scrollen',
    'data-web': 'Zum Fundament Daten und Web scrollen',
  },
  en: {
    'search-ai-intelligence': 'Jump to Search and AI Intelligence card',
    'performance-media': 'Jump to Performance Media card',
    'authority-pr': 'Jump to Authority card',
    'content-copywriting': 'Jump to Content card',
    'data-web': 'Jump to Data and Web card',
  },
};

const strings = {
  de: {
    top: 'WACHSTUM',
    foundation: 'DATEN & WEB',
    caption: 'Fundament jeder strategischen Entscheidung',
    title: 'Fünf Bausteine des digitalen Wachstums',
    desc: 'Vier Bausteine des digitalen Marketings — Suche und KI-Intelligenz, Performance Media, Autorität und Content und Texterstellung — stehen auf dem fünften Baustein: Daten und Web. Zusammen bauen sie das Wachstum eines Unternehmens. Beim Hover wird die zugehörige Karte unten hervorgehoben, beim Klick wird dorthin gescrollt.',
  },
  'ch-de': {
    top: 'WACHSTUM',
    foundation: 'DATEN & WEB',
    caption: 'Fundament jeder strategischen Entscheidung',
    title: 'Fünf Bausteine des digitalen Wachstums',
    desc: 'Vier Bausteine des digitalen Marketings — Suche und KI-Intelligenz, Performance Media, Autorität und Content und Texterstellung — stehen auf dem fünften Baustein: Daten und Web. Zusammen bauen sie das Wachstum eines Unternehmens. Beim Hover wird die zugehörige Karte unten hervorgehoben, beim Klick wird dorthin gescrollt.',
  },
  en: {
    top: 'GROWTH',
    foundation: 'DATA & WEB',
    caption: 'Foundation of every strategic decision',
    title: 'Five Building Blocks of Digital Growth',
    desc: 'Four building blocks of digital marketing — Search and AI Intelligence, Performance Media, Authority, and Content and Copywriting — rest on the fifth block: Data and Web. Together they build a company\'s growth. Hovering highlights the matching card below; clicking scrolls to it.',
  },
}[locale];

const aria = pillarAria[locale];
const labels = pillarLabels[locale];

// Pillar geometry (kept stable across locales so icons + labels align)
const pillars = [
  { id: 'search-ai-intelligence', x: 90, cx: 155 },
  { id: 'performance-media', x: 250, cx: 315 },
  { id: 'authority-pr', x: 410, cx: 475 },
  { id: 'content-copywriting', x: 570, cx: 635 },
];
---

<div class="building-graphic relative">
  <svg
    viewBox="0 0 800 430"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-labelledby="building-title building-desc"
    class="w-full h-auto max-w-3xl mx-auto mt-8"
    style="font-family: 'Inter Tight', ui-sans-serif, system-ui, sans-serif;"
  >
    <title id="building-title">{strings.title}</title>
    <desc id="building-desc">{strings.desc}</desc>

    <defs>
      {/* Soft pillar fill — white → warm cream (modern, not flat) */}
      <linearGradient id="pillar-fill" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#FFFFFF" />
        <stop offset="100%" stop-color="#F6F3ED" />
      </linearGradient>
      {/* Active-state fill — subtle cool tint */}
      <linearGradient id="pillar-fill-active" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#FFFFFF" />
        <stop offset="100%" stop-color="#EAF1FB" />
      </linearGradient>
      {/* Foundation — primary blue gradient */}
      <linearGradient id="foundation-fill" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#5A9AE6" />
        <stop offset="100%" stop-color="#3B7DD8" />
      </linearGradient>
      {/* Soft shadow — warmer, more diffuse than original hard drop */}
      <filter id="pillar-shadow" x="-20%" y="-20%" width="140%" height="140%">
        <feDropShadow dx="0" dy="8" stdDeviation="8" flood-color="#0E1A2D" flood-opacity="0.10" />
      </filter>
      <filter id="pillar-shadow-active" x="-30%" y="-30%" width="160%" height="160%">
        <feDropShadow dx="0" dy="12" stdDeviation="14" flood-color="#3B7DD8" flood-opacity="0.30" />
      </filter>
    </defs>

    {/* Top label — WACHSTUM in Inter Tight */}
    <text x="400" y="26" text-anchor="middle" fill="#0E1A2D" font-size="14" font-weight="900" letter-spacing="8">{strings.top}</text>
    {/* Gold accent underline replaces the old black triangle arrow */}
    <line x1="360" y1="38" x2="440" y2="38" stroke="#B8893B" stroke-width="2.5" stroke-linecap="round" />

    {/* Pillars — each is a clickable group that scrolls to its card below */}
    {pillars.map(({ id, x, cx }) => (
      <a href={`#card-${id}`} data-pillar-id={id} aria-label={aria[id]}>
        <g class="pillar-group">
          {/* Pillar card — gradient fill, generous rounded corners, soft shadow */}
          <rect x={x} y="72" width="130" height="268" rx="14" fill="url(#pillar-fill)" stroke="#3B7DD8" stroke-width="1.5" filter="url(#pillar-shadow)" class="pillar-rect" />

          {/* Icon — larger, centred near the top */}
          <g transform={`translate(${cx - 26}, 104)`} fill="none" stroke="#3B7DD8" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="pillar-icon">
            {id === 'search-ai-intelligence' && (
              <g>
                {/* Magnifying glass */}
                <circle cx="20" cy="20" r="13" />
                <line x1="30" y1="30" x2="40" y2="40" />
                {/* AI sparkle */}
                <path d="M41 6 L42.5 10 L46.5 11.5 L42.5 13 L41 17 L39.5 13 L35.5 11.5 L39.5 10 Z" fill="#B8893B" stroke="none" />
              </g>
            )}
            {id === 'performance-media' && (
              <g>
                {/* Bar chart */}
                <line x1="4" y1="44" x2="48" y2="44" />
                <rect x="8" y="28" width="9" height="16" rx="1.5" />
                <rect x="21.5" y="18" width="9" height="26" rx="1.5" />
                <rect x="35" y="6" width="9" height="38" rx="1.5" fill="#B8893B" fill-opacity="0.35" />
              </g>
            )}
            {id === 'authority-pr' && (
              <g>
                {/* Shield with check */}
                <path d="M26 4 L44 10 V22 C44 33 26 44 26 44 C26 44 8 33 8 22 V10 Z" />
                <path d="M18 22 L24 28 L34 16" stroke="#B8893B" stroke-width="3" />
              </g>
            )}
            {id === 'content-copywriting' && (
              <g>
                {/* Document with lines */}
                <path d="M10 4 H34 L44 14 V46 H10 Z" />
                <path d="M34 4 V14 H44" />
                <line x1="18" y1="24" x2="36" y2="24" />
                <line x1="18" y1="30" x2="36" y2="30" />
                <line x1="18" y1="36" x2="28" y2="36" stroke="#B8893B" stroke-width="3" />
              </g>
            )}
          </g>

          {/* Label — Inter Tight Black */}
          {labels[id].length === 1 ? (
            <text x={cx} y="226" text-anchor="middle" fill="#0E1A2D" font-size="16" font-weight="900" letter-spacing="-0.2">{labels[id][0]}</text>
          ) : (
            <>
              <text x={cx} y="216" text-anchor="middle" fill="#0E1A2D" font-size="15" font-weight="900" letter-spacing="-0.2">{labels[id][0]}</text>
              <text x={cx} y="236" text-anchor="middle" fill="#0E1A2D" font-size="15" font-weight="900" letter-spacing="-0.2">{labels[id][1]}</text>
            </>
          )}
        </g>
      </a>
    ))}

    {/* Foundation — blue bar only (no navy base bar below) */}
    <a href="#card-data-web" data-pillar-id="data-web" aria-label={aria['data-web']}>
      <g class="foundation-group">
        {/* Gold accent line above */}
        <rect x="40" y="352" width="720" height="2" fill="#B8893B" class="foundation-gold" />
        {/* Main foundation bar with gradient */}
        <rect x="40" y="356" width="720" height="30" fill="url(#foundation-fill)" rx="4" filter="url(#pillar-shadow)" class="foundation-rect" />

        {/* Database icon — bigger, cream-stroked */}
        <g transform="translate(58, 358)" fill="none" stroke="#F8F7F4" stroke-width="1.8" pointer-events="none">
          <ellipse cx="11" cy="4" rx="10" ry="3" />
          <path d="M1 4 V12 C1 13.5 5.5 15 11 15 C16.5 15 21 13.5 21 12 V4" />
          <path d="M1 12 V20 C1 21.5 5.5 23 11 23 C16.5 23 21 21.5 21 20 V12" />
        </g>

        {/* DATEN & WEB label — Inter Tight Black */}
        <text x="400" y="375" text-anchor="middle" fill="#F8F7F4" font-size="15" font-weight="900" letter-spacing="6" pointer-events="none">{strings.foundation}</text>
      </g>
    </a>

    {/* Caption */}
    <text x="400" y="410" text-anchor="middle" fill="#0E1A2D" opacity="0.55" font-size="11" font-style="italic">{strings.caption}</text>
  </svg>
</div>

<style>
  .building-graphic :global(.pillar-group),
  .building-graphic :global(.foundation-group) {
    transition: transform 260ms cubic-bezier(0.4, 0, 0.2, 1);
    transform-origin: center;
    transform-box: fill-box;
  }
  .building-graphic :global(.pillar-rect),
  .building-graphic :global(.pillar-icon),
  .building-graphic :global(.foundation-rect),
  .building-graphic :global(.foundation-gold) {
    transition: fill 220ms ease, stroke 220ms ease, filter 220ms ease;
  }
  .building-graphic a { cursor: pointer; }

  /* Pillar hover: lift + activate fill tint + stronger glow shadow */
  .building-graphic a[data-pillar-id]:hover .pillar-group,
  .building-graphic a[data-pillar-id]:focus-visible .pillar-group,
  .building-graphic a[data-pillar-id].is-active .pillar-group {
    transform: translateY(-6px);
  }
  .building-graphic a[data-pillar-id]:hover .pillar-rect,
  .building-graphic a[data-pillar-id]:focus-visible .pillar-rect,
  .building-graphic a[data-pillar-id].is-active .pillar-rect {
    fill: url(#pillar-fill-active);
    stroke: #3B7DD8;
    stroke-width: 2;
    filter: url(#pillar-shadow-active);
  }

  /* Foundation hover */
  .building-graphic a[data-pillar-id="data-web"]:hover .foundation-group,
  .building-graphic a[data-pillar-id="data-web"]:focus-visible .foundation-group,
  .building-graphic a[data-pillar-id="data-web"].is-active .foundation-group {
    transform: translateY(-3px);
  }
  .building-graphic a[data-pillar-id="data-web"]:hover .foundation-gold,
  .building-graphic a[data-pillar-id="data-web"]:focus-visible .foundation-gold,
  .building-graphic a[data-pillar-id="data-web"].is-active .foundation-gold {
    fill: #D4A44A;
  }

  .building-graphic a[data-pillar-id]:focus-visible {
    outline: 2px solid #3B7DD8;
    outline-offset: 3px;
    border-radius: 4px;
  }

  /* Paired card highlight below */
  :global(.pillar-card-wrapper) {
    transition: transform 220ms ease, box-shadow 220ms ease;
    border-radius: 0.5rem;
  }
  :global(.pillar-card-wrapper.is-active) {
    transform: translateY(-4px);
    box-shadow: 0 0 0 2px #3B7DD8, 0 12px 24px -6px rgba(59, 125, 216, 0.25);
  }
  :global(.pillar-card-wrapper.is-flash) {
    animation: pillar-flash 1.4s ease-out;
  }
  @keyframes pillar-flash {
    0% { box-shadow: 0 0 0 0 rgba(59, 125, 216, 0.6); }
    40% { box-shadow: 0 0 0 6px rgba(59, 125, 216, 0.45); }
    100% { box-shadow: 0 0 0 0 rgba(59, 125, 216, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .building-graphic :global(.pillar-group),
    .building-graphic :global(.foundation-group),
    :global(.pillar-card-wrapper) {
      transition: none !important;
    }
    .building-graphic a:hover .pillar-group,
    .building-graphic a:hover .foundation-group,
    .building-graphic a.is-active .pillar-group,
    .building-graphic a.is-active .foundation-group,
    :global(.pillar-card-wrapper.is-active),
    :global(.pillar-card-wrapper.is-flash) {
      transform: none !important;
      filter: none !important;
      animation: none !important;
    }
  }
</style>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const elements = Array.from(document.querySelectorAll<HTMLElement>('[data-pillar-id]'));
  const groups = new Map<string, HTMLElement[]>();
  elements.forEach((el) => {
    const id = el.getAttribute('data-pillar-id');
    if (!id) return;
    if (!groups.has(id)) groups.set(id, []);
    groups.get(id)!.push(el);
  });

  groups.forEach((group) => {
    const activate = () => group.forEach((el) => el.classList.add('is-active'));
    const deactivate = () => group.forEach((el) => el.classList.remove('is-active'));
    group.forEach((el) => {
      el.addEventListener('mouseenter', activate);
      el.addEventListener('mouseleave', deactivate);
      el.addEventListener('focusin', activate);
      el.addEventListener('focusout', deactivate);
    });
  });

  document.querySelectorAll<HTMLAnchorElement>('.building-graphic a[data-pillar-id]').forEach((link) => {
    link.addEventListener('click', (event) => {
      const id = link.getAttribute('data-pillar-id');
      if (!id) return;
      const card = document.querySelector<HTMLElement>(`.pillar-card-wrapper[data-pillar-id="${id}"]`);
      if (!card) return;
      event.preventDefault();
      card.scrollIntoView({ behavior: prefersReducedMotion ? 'auto' : 'smooth', block: 'center' });
      card.classList.remove('is-flash');
      void card.offsetWidth;
      card.classList.add('is-flash');
      window.setTimeout(() => card.classList.remove('is-flash'), 1500);
    });
  });
</script>
