---
interface Props {
  locale: 'de' | 'ch-de' | 'en';
}

const { locale } = Astro.props;

const pillarLabels: Record<string, Record<string, string>> = {
  de: {
    'search-ai-intelligence': 'Suche & KI',
    'performance-media': 'Performance Media',
    'authority-pr': 'Autorität',
    'content-copywriting': 'Content',
  },
  'ch-de': {
    'search-ai-intelligence': 'Suche & KI',
    'performance-media': 'Performance Media',
    'authority-pr': 'Autorität',
    'content-copywriting': 'Content',
  },
  en: {
    'search-ai-intelligence': 'Search & AI',
    'performance-media': 'Performance Media',
    'authority-pr': 'Authority',
    'content-copywriting': 'Content',
  },
};

const pillarAria: Record<string, Record<string, string>> = {
  de: {
    'search-ai-intelligence': 'Zur Säule Suche und KI-Intelligenz scrollen',
    'performance-media': 'Zur Säule Performance Media scrollen',
    'authority-pr': 'Zur Säule Autorität scrollen',
    'content-copywriting': 'Zur Säule Content scrollen',
    'data-web': 'Zum Fundament Daten und Web scrollen',
  },
  'ch-de': {
    'search-ai-intelligence': 'Zur Säule Suche und KI-Intelligenz scrollen',
    'performance-media': 'Zur Säule Performance Media scrollen',
    'authority-pr': 'Zur Säule Autorität scrollen',
    'content-copywriting': 'Zur Säule Content scrollen',
    'data-web': 'Zum Fundament Daten und Web scrollen',
  },
  en: {
    'search-ai-intelligence': 'Jump to Search and AI Intelligence card',
    'performance-media': 'Jump to Performance Media card',
    'authority-pr': 'Jump to Authority card',
    'content-copywriting': 'Jump to Content card',
    'data-web': 'Jump to Data and Web card',
  },
};

const s = {
  de: { foundation: 'DATEN & WEB', caption: 'Fundament jeder strategischen Entscheidung', wachstum: 'WACHSTUM' },
  'ch-de': { foundation: 'DATEN & WEB', caption: 'Fundament jeder strategischen Entscheidung', wachstum: 'WACHSTUM' },
  en: { foundation: 'DATA & WEB', caption: 'Foundation of every strategic decision', wachstum: 'GROWTH' },
}[locale];

const disciplines = [
  { id: 'search-ai-intelligence', num: '01' },
  { id: 'performance-media',      num: '02' },
  { id: 'authority-pr',           num: '03' },
  { id: 'content-copywriting',    num: '04' },
];

const labels = pillarLabels[locale];
const aria = pillarAria[locale];
---

<div class="building-graphic">
  {/* Top: WACHSTUM label + real StarkRank logo as the brand anchor */}
  <div class="brand-anchor">
    <span class="wachstum-label">{s.wachstum}</span>
    <img src="/SR-Logo-standard_high-res.png" alt="StarkRank" width="320" height="118" class="brand-logo" />
  </div>

  {/* Horizontal row of four discipline items */}
  <div class="disciplines">
    {disciplines.map((d) => (
      <a href={`#card-${d.id}`} data-pillar-id={d.id} aria-label={aria[d.id]} class="discipline">
        <span class="discipline-badge">{d.num}</span>
        <span class="discipline-label">{labels[d.id]}</span>
        <svg viewBox="0 0 24 16" xmlns="http://www.w3.org/2000/svg" class="discipline-chev" aria-hidden="true">
          <path d="M 4 14 L 12 2 L 20 14 L 16 14 L 12 8 L 8 14 Z" fill="currentColor" fill-rule="evenodd" />
        </svg>
      </a>
    ))}
  </div>

  {/* Foundation strip */}
  <a href="#card-data-web" data-pillar-id="data-web" aria-label={aria['data-web']} class="foundation">
    <svg viewBox="0 0 24 30" xmlns="http://www.w3.org/2000/svg" class="foundation-icon" aria-hidden="true">
      <ellipse cx="12" cy="4" rx="10" ry="3" fill="none" stroke="#B8893B" stroke-width="1.8" />
      <path d="M2 4 V15 C2 16.5 6.5 18 12 18 C17.5 18 22 16.5 22 15 V4" fill="none" stroke="#B8893B" stroke-width="1.8" />
      <path d="M2 15 V26 C2 27.5 6.5 29 12 29 C17.5 29 22 27.5 22 26 V15" fill="none" stroke="#B8893B" stroke-width="1.8" />
    </svg>
    <span class="foundation-label">{s.foundation}</span>
    <div class="foundation-dots" aria-hidden="true">
      <span></span><span></span><span></span>
      <span></span><span></span><span></span>
      <span></span><span></span><span></span>
    </div>
  </a>

  <p class="caption">{s.caption}</p>
</div>

<style>
  .building-graphic {
    max-width: 48rem;
    margin: 2rem auto 0;
    font-family: 'Inter Tight', ui-sans-serif, system-ui, sans-serif;
    padding: 0 1rem;
  }

  /* Brand anchor */
  .brand-anchor {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .wachstum-label {
    font-size: 0.875rem;
    font-weight: 900;
    letter-spacing: 0.6em;
    color: #0E1A2D;
    padding-right: 0.6em; /* visual centering for letter-spacing */
    position: relative;
  }
  .wachstum-label::after {
    content: '';
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    bottom: -10px;
    width: 3rem;
    height: 2px;
    background: #B8893B;
  }
  .brand-logo {
    display: block;
    max-width: 18rem;
    width: 100%;
    height: auto;
    margin-top: 1.5rem;
  }

  /* Disciplines row */
  .disciplines {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-top: 3rem;
  }
  .discipline {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding: 1.25rem 0.75rem 1rem;
    background: transparent;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: transform 260ms cubic-bezier(0.4, 0, 0.2, 1), background-color 260ms ease;
    color: #3B7DD8;
  }
  .discipline-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    background: #B8893B;
    color: #0E1A2D;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 900;
    letter-spacing: 0.03em;
    box-shadow: 0 4px 12px -3px rgba(184, 137, 59, 0.35);
    transition: background-color 220ms ease, transform 220ms ease, box-shadow 220ms ease;
  }
  .discipline-label {
    font-size: 1rem;
    font-weight: 900;
    letter-spacing: -0.01em;
    color: #0E1A2D;
    text-align: center;
    line-height: 1.2;
    transition: color 220ms ease;
  }
  .discipline-chev {
    width: 1rem;
    height: 0.75rem;
    color: #3B7DD8;
    opacity: 0;
    transform: translateY(-2px);
    transition: opacity 220ms ease, transform 220ms ease;
  }
  .discipline:hover,
  .discipline:focus-visible,
  .discipline.is-active {
    transform: translateY(-4px);
    background-color: rgba(59, 125, 216, 0.06);
    outline: none;
  }
  .discipline:hover .discipline-badge,
  .discipline:focus-visible .discipline-badge,
  .discipline.is-active .discipline-badge {
    background: #D4A44A;
    transform: scale(1.05);
    box-shadow: 0 6px 16px -3px rgba(184, 137, 59, 0.55);
  }
  .discipline:hover .discipline-label,
  .discipline:focus-visible .discipline-label,
  .discipline.is-active .discipline-label {
    color: #3B7DD8;
  }
  .discipline:hover .discipline-chev,
  .discipline:focus-visible .discipline-chev,
  .discipline.is-active .discipline-chev {
    opacity: 1;
    transform: translateY(0);
  }
  .discipline:focus-visible {
    outline: 2px solid #3B7DD8;
    outline-offset: 3px;
  }

  /* Foundation strip */
  .foundation {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    background: linear-gradient(to bottom, #1A3B6E, #0E1A2D);
    padding: 1.5rem 2rem;
    margin-top: 2.5rem;
    border-radius: 0.5rem;
    border-top: 2px solid #B8893B;
    text-decoration: none;
    color: #F8F7F4;
    position: relative;
    overflow: hidden;
    transition: transform 260ms ease, border-color 260ms ease;
  }
  .foundation-icon {
    width: 1.5rem;
    height: auto;
    flex-shrink: 0;
  }
  .foundation-label {
    font-size: 1.25rem;
    font-weight: 900;
    letter-spacing: 0.5em;
    padding-right: 0.5em;
  }
  .foundation-dots {
    display: grid;
    grid-template-columns: repeat(3, 6px);
    gap: 4px;
    position: absolute;
    right: 1.5rem;
    top: 50%;
    transform: translateY(-50%);
  }
  .foundation-dots span {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: rgba(248, 247, 244, 0.35);
  }
  .foundation-dots span:nth-child(1),
  .foundation-dots span:nth-child(6),
  .foundation-dots span:nth-child(8) {
    background: #B8893B;
  }
  .foundation:hover,
  .foundation:focus-visible,
  .foundation.is-active {
    transform: translateY(-2px);
    border-color: #D4A44A;
    outline: none;
  }
  .foundation:focus-visible {
    outline: 2px solid #3B7DD8;
    outline-offset: 3px;
  }

  /* Caption */
  .caption {
    margin-top: 1rem;
    text-align: center;
    font-style: italic;
    color: rgba(14, 26, 45, 0.55);
    font-size: 0.875rem;
  }

  /* Paired card highlight — unchanged from previous */
  :global(.pillar-card-wrapper) {
    transition: transform 220ms ease, box-shadow 220ms ease;
    border-radius: 0.5rem;
  }
  :global(.pillar-card-wrapper.is-active) {
    transform: translateY(-4px);
    box-shadow: 0 0 0 2px #3B7DD8, 0 12px 24px -6px rgba(59, 125, 216, 0.25);
  }
  :global(.pillar-card-wrapper.is-flash) {
    animation: pillar-flash 1.4s ease-out;
  }
  @keyframes pillar-flash {
    0% { box-shadow: 0 0 0 0 rgba(59, 125, 216, 0.6); }
    40% { box-shadow: 0 0 0 6px rgba(59, 125, 216, 0.45); }
    100% { box-shadow: 0 0 0 0 rgba(59, 125, 216, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .discipline,
    .discipline-badge,
    .discipline-chev,
    .foundation,
    :global(.pillar-card-wrapper) {
      transition: none !important;
    }
    .discipline:hover,
    .foundation:hover,
    :global(.pillar-card-wrapper.is-active),
    :global(.pillar-card-wrapper.is-flash) {
      transform: none !important;
      animation: none !important;
    }
  }
</style>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const elements = Array.from(document.querySelectorAll<HTMLElement>('.building-graphic [data-pillar-id]'));
  const groups = new Map<string, HTMLElement[]>();
  elements.forEach((el) => {
    const id = el.getAttribute('data-pillar-id');
    if (!id) return;
    if (!groups.has(id)) groups.set(id, []);
    groups.get(id)!.push(el);
  });

  groups.forEach((group) => {
    const on = () => group.forEach((el) => el.classList.add('is-active'));
    const off = () => group.forEach((el) => el.classList.remove('is-active'));
    group.forEach((el) => {
      el.addEventListener('mouseenter', on);
      el.addEventListener('mouseleave', off);
      el.addEventListener('focusin', on);
      el.addEventListener('focusout', off);
    });
  });

  document.querySelectorAll<HTMLAnchorElement>('.building-graphic a[data-pillar-id]').forEach((link) => {
    link.addEventListener('click', (event) => {
      const id = link.getAttribute('data-pillar-id');
      if (!id) return;
      const card = document.querySelector<HTMLElement>(`.pillar-card-wrapper[data-pillar-id="${id}"]`);
      if (!card) return;
      event.preventDefault();
      card.scrollIntoView({ behavior: prefersReducedMotion ? 'auto' : 'smooth', block: 'center' });
      card.classList.remove('is-flash');
      void card.offsetWidth;
      card.classList.add('is-flash');
      window.setTimeout(() => card.classList.remove('is-flash'), 1500);
    });
  });
</script>
