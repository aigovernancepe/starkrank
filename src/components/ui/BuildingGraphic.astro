---
interface Props {
  locale: 'de' | 'ch-de' | 'en';
}

const { locale } = Astro.props;

const pillarLabels: Record<string, Record<string, string[]>> = {
  de: {
    'search-ai-intelligence': ['Suche', '& KI'],
    'performance-media': ['Performance', 'Media'],
    'authority-pr': ['Autorität'],
    'content-copywriting': ['Content'],
  },
  'ch-de': {
    'search-ai-intelligence': ['Suche', '& KI'],
    'performance-media': ['Performance', 'Media'],
    'authority-pr': ['Autorität'],
    'content-copywriting': ['Content'],
  },
  en: {
    'search-ai-intelligence': ['Search', '& AI'],
    'performance-media': ['Performance', 'Media'],
    'authority-pr': ['Authority'],
    'content-copywriting': ['Content'],
  },
};

const pillarAria: Record<string, Record<string, string>> = {
  de: {
    'search-ai-intelligence': 'Zur Säule Suche und KI-Intelligenz scrollen',
    'performance-media': 'Zur Säule Performance Media scrollen',
    'authority-pr': 'Zur Säule Autorität scrollen',
    'content-copywriting': 'Zur Säule Content scrollen',
    'data-web': 'Zum Fundament Daten und Web scrollen',
  },
  'ch-de': {
    'search-ai-intelligence': 'Zur Säule Suche und KI-Intelligenz scrollen',
    'performance-media': 'Zur Säule Performance Media scrollen',
    'authority-pr': 'Zur Säule Autorität scrollen',
    'content-copywriting': 'Zur Säule Content scrollen',
    'data-web': 'Zum Fundament Daten und Web scrollen',
  },
  en: {
    'search-ai-intelligence': 'Jump to Search and AI Intelligence card',
    'performance-media': 'Jump to Performance Media card',
    'authority-pr': 'Jump to Authority card',
    'content-copywriting': 'Jump to Content card',
    'data-web': 'Jump to Data and Web card',
  },
};

const strings = {
  de: {
    top: 'WACHSTUM',
    foundation: 'DATEN & WEB',
    caption: 'Fundament jeder strategischen Entscheidung',
    title: 'Das Gebäude des digitalen Wachstums',
    desc: 'Vier Säulen des digitalen Marketings — Suche und KI-Intelligenz, Performance Media, Autorität und Content und Texterstellung — getragen vom Fundament Daten und Web. Zusammen bauen sie das Wachstum eines Unternehmens. Beim Hover wird die zugehörige Karte unten hervorgehoben, beim Klick wird dorthin gescrollt.',
  },
  'ch-de': {
    top: 'WACHSTUM',
    foundation: 'DATEN & WEB',
    caption: 'Fundament jeder strategischen Entscheidung',
    title: 'Das Gebäude des digitalen Wachstums',
    desc: 'Vier Säulen des digitalen Marketings — Suche und KI-Intelligenz, Performance Media, Autorität und Content und Texterstellung — getragen vom Fundament Daten und Web. Zusammen bauen sie das Wachstum eines Unternehmens. Beim Hover wird die zugehörige Karte unten hervorgehoben, beim Klick wird dorthin gescrollt.',
  },
  en: {
    top: 'GROWTH',
    foundation: 'DATA & WEB',
    caption: 'Foundation of every strategic decision',
    title: 'The Digital Growth Building',
    desc: 'Four pillars of digital marketing — Search and AI Intelligence, Performance Media, Authority, and Content and Copywriting — supported by a Data and Web foundation. Hovering highlights the matching card below; clicking scrolls to it.',
  },
}[locale];

const aria = pillarAria[locale];
const labels = pillarLabels[locale];

// Pillar geometry (kept stable across locales so icons + labels align)
const pillars = [
  { id: 'search-ai-intelligence', x: 90, cx: 155 },
  { id: 'performance-media', x: 250, cx: 315 },
  { id: 'authority-pr', x: 410, cx: 475 },
  { id: 'content-copywriting', x: 570, cx: 635 },
];
---

<div class="building-graphic relative">
  <svg viewBox="0 0 800 440" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="building-title building-desc" class="w-full h-auto max-w-3xl mx-auto mt-8">
    <title id="building-title">{strings.title}</title>
    <desc id="building-desc">{strings.desc}</desc>

    <defs>
      <filter id="pillar-shadow" x="-20%" y="-20%" width="140%" height="140%">
        <feDropShadow dx="0" dy="4" stdDeviation="3" flood-color="#0E1A2D" flood-opacity="0.12" />
      </filter>
    </defs>

    {/* Top label + accent */}
    <text x="400" y="28" text-anchor="middle" fill="#0E1A2D" font-size="14" font-weight="700" letter-spacing="6">{strings.top}</text>
    <path d="M 400 36 L 390 50 L 410 50 Z" fill="#0E1A2D" />

    {/* Entablature */}
    <rect x="40" y="58" width="720" height="14" fill="#0E1A2D" rx="2" />
    <rect x="60" y="72" width="680" height="4" fill="#3B7DD8" />

    {/* Pillars — each is a clickable group that scrolls to its card below */}
    {pillars.map(({ id, x, cx }) => (
      <a href={`#card-${id}`} data-pillar-id={id} aria-label={aria[id]}>
        <g class="pillar-group">
          <rect x={x} y="86" width="130" height="248" rx="4" fill="#ffffff" stroke="#3B7DD8" stroke-width="2" filter="url(#pillar-shadow)" />
          <rect x={x} y="86" width="130" height="8" fill="#3B7DD8" rx="4" />
          <rect x={x} y="326" width="130" height="8" fill="#3B7DD8" rx="4" />

          {/* Icon */}
          <g transform={`translate(${cx - 14}, 118)`} fill="none" stroke="#3B7DD8" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            {id === 'search-ai-intelligence' && (
              <g>
                <circle cx="10" cy="10" r="6.5" />
                <line x1="14.6" y1="14.6" x2="19" y2="19" />
                <path d="M20 4 L20.8 6 L23 6.8 L20.8 7.6 L20 10 L19.2 7.6 L17 6.8 L19.2 6 Z" fill="#3B7DD8" stroke="none" />
              </g>
            )}
            {id === 'performance-media' && (
              <g>
                <line x1="2" y1="22" x2="26" y2="22" />
                <rect x="4" y="14" width="5" height="8" fill="none" />
                <rect x="11.5" y="9" width="5" height="13" fill="none" />
                <rect x="19" y="4" width="5" height="18" fill="none" />
              </g>
            )}
            {id === 'authority-pr' && (
              <g>
                <path d="M14 2 L24 5 V13 C24 19 14 24 14 24 C14 24 4 19 4 13 V5 Z" />
                <path d="M10 13 L13 16 L18 10" />
              </g>
            )}
            {id === 'content-copywriting' && (
              <g>
                <path d="M7 3 H17 L22 8 V24 H7 Z" />
                <path d="M17 3 V8 H22" />
                <line x1="11" y1="13" x2="18" y2="13" />
                <line x1="11" y1="17" x2="18" y2="17" />
                <line x1="11" y1="21" x2="15" y2="21" />
              </g>
            )}
          </g>

          {/* Label */}
          {labels[id].length === 1 ? (
            <text x={cx} y="230" text-anchor="middle" fill="#0E1A2D" font-size="14" font-weight="700">{labels[id][0]}</text>
          ) : (
            <>
              <text x={cx} y="220" text-anchor="middle" fill="#0E1A2D" font-size="13" font-weight="700">{labels[id][0]}</text>
              <text x={cx} y="240" text-anchor="middle" fill="#0E1A2D" font-size="13" font-weight="700">{labels[id][1]}</text>
            </>
          )}
        </g>
      </a>
    ))}

    {/* Foundation */}
    <a href="#card-data-web" data-pillar-id="data-web" aria-label={aria['data-web']}>
      <g class="pillar-group">
        <rect x="40" y="348" width="720" height="26" fill="#3B7DD8" rx="2" filter="url(#pillar-shadow)" />
        <rect x="20" y="374" width="760" height="14" fill="#0E1A2D" rx="2" />

        {/* Foundation icon — stacked disks (database motif) */}
        <g transform="translate(60, 351)" fill="none" stroke="#ffffff" stroke-width="1.6">
          <ellipse cx="10" cy="3" rx="8" ry="2" />
          <path d="M2 3 V9 C2 10 6 11 10 11 C14 11 18 10 18 9 V3" />
          <path d="M2 9 V15 C2 16 6 17 10 17 C14 17 18 16 18 15 V9" />
        </g>

        <text x="400" y="366" text-anchor="middle" fill="#ffffff" font-size="15" font-weight="700" letter-spacing="4">{strings.foundation}</text>
      </g>
    </a>

    {/* Caption */}
    <text x="400" y="414" text-anchor="middle" fill="#888888" font-size="11" font-style="italic">{strings.caption}</text>
  </svg>
</div>

<style>
  .building-graphic :global(.pillar-group) {
    transition: transform 220ms ease, filter 220ms ease;
    transform-origin: center;
    transform-box: fill-box;
  }
  .building-graphic a {
    cursor: pointer;
  }
  .building-graphic a[data-pillar-id]:hover .pillar-group,
  .building-graphic a[data-pillar-id]:focus-visible .pillar-group,
  .building-graphic a[data-pillar-id].is-active .pillar-group {
    transform: translateY(-6px);
    filter: drop-shadow(0 6px 12px rgba(59, 125, 216, 0.35));
  }
  .building-graphic a[data-pillar-id="data-web"]:hover .pillar-group,
  .building-graphic a[data-pillar-id="data-web"]:focus-visible .pillar-group,
  .building-graphic a[data-pillar-id="data-web"].is-active .pillar-group {
    transform: translateY(-3px);
  }
  .building-graphic a[data-pillar-id]:focus-visible {
    outline: 2px solid #3B7DD8;
    outline-offset: 2px;
    border-radius: 4px;
  }

  /* Paired highlight on the card wrappers below */
  :global(.pillar-card-wrapper) {
    transition: transform 220ms ease, box-shadow 220ms ease;
    border-radius: 0.5rem;
  }
  :global(.pillar-card-wrapper.is-active) {
    transform: translateY(-4px);
    box-shadow: 0 0 0 2px #3B7DD8, 0 12px 24px -6px rgba(59, 125, 216, 0.25);
  }
  :global(.pillar-card-wrapper.is-flash) {
    animation: pillar-flash 1.4s ease-out;
  }
  @keyframes pillar-flash {
    0% { box-shadow: 0 0 0 0 rgba(59, 125, 216, 0.6); }
    40% { box-shadow: 0 0 0 6px rgba(59, 125, 216, 0.45); }
    100% { box-shadow: 0 0 0 0 rgba(59, 125, 216, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .building-graphic :global(.pillar-group),
    :global(.pillar-card-wrapper) {
      transition: none !important;
    }
    .building-graphic a[data-pillar-id]:hover .pillar-group,
    .building-graphic a[data-pillar-id].is-active .pillar-group,
    :global(.pillar-card-wrapper.is-active),
    :global(.pillar-card-wrapper.is-flash) {
      transform: none !important;
      filter: none !important;
      animation: none !important;
    }
  }
</style>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const elements = Array.from(document.querySelectorAll<HTMLElement>('[data-pillar-id]'));
  const groups = new Map<string, HTMLElement[]>();
  elements.forEach((el) => {
    const id = el.getAttribute('data-pillar-id');
    if (!id) return;
    if (!groups.has(id)) groups.set(id, []);
    groups.get(id)!.push(el);
  });

  groups.forEach((group) => {
    const activate = () => group.forEach((el) => el.classList.add('is-active'));
    const deactivate = () => group.forEach((el) => el.classList.remove('is-active'));
    group.forEach((el) => {
      el.addEventListener('mouseenter', activate);
      el.addEventListener('mouseleave', deactivate);
      el.addEventListener('focusin', activate);
      el.addEventListener('focusout', deactivate);
    });
  });

  document.querySelectorAll<HTMLAnchorElement>('.building-graphic a[data-pillar-id]').forEach((link) => {
    link.addEventListener('click', (event) => {
      const id = link.getAttribute('data-pillar-id');
      if (!id) return;
      const card = document.querySelector<HTMLElement>(`.pillar-card-wrapper[data-pillar-id="${id}"]`);
      if (!card) return;
      event.preventDefault();
      card.scrollIntoView({ behavior: prefersReducedMotion ? 'auto' : 'smooth', block: 'center' });
      card.classList.remove('is-flash');
      // Force reflow so re-adding the class restarts the animation
      void card.offsetWidth;
      card.classList.add('is-flash');
      window.setTimeout(() => card.classList.remove('is-flash'), 1500);
    });
  });
</script>
