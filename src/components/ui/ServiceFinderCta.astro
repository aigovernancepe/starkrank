---
import Button from './Button.astro';

interface Props {
  locale?: string;
}

const { locale = 'en' } = Astro.props;

const copy: Record<string, { heading: string; body: string; button: string; href: string }> = {
  en: {
    heading: 'Find the Right Service for Your Business',
    body: 'Not sure where to start after reading this? Our free diagnostic matches your situation to the services that will have the biggest impact \u2014 in 60 seconds.',
    button: 'Take the Service Check',
    href: '/en/find-your-service/',
  },
  pe: {
    heading: 'Descubre qu\u00e9 Servicio Necesita tu Negocio',
    body: '\u00bfNo sabes por d\u00f3nde empezar? Nuestro diagn\u00f3stico gratuito cruza tu situaci\u00f3n con los servicios que tendr\u00e1n mayor impacto \u2014 en 60 segundos.',
    button: 'Hacer el Diagn\u00f3stico',
    href: '/pe/diagnostico-rapido/',
  },
  de: {
    heading: 'Finden Sie den richtigen Service',
    body: 'Nicht sicher, wo Sie nach diesem Artikel anfangen sollen? Unser kostenloser Schnellcheck zeigt Ihnen, welche Services den gr\u00f6ssten Impact haben \u2014 in 60 Sekunden.',
    button: 'Zum Schnellcheck',
    href: '/schnellcheck/',
  },
  'ch-de': {
    heading: 'Finden Sie den richtigen Service',
    body: 'Nicht sicher, wo Sie nach diesem Artikel anfangen sollen? Unser kostenloser Schnellcheck zeigt Ihnen, welche Services den gr\u00f6ssten Impact haben \u2014 in 60 Sekunden.',
    button: 'Zum Schnellcheck',
    href: '/ch-de/schnellcheck/',
  },
};

const c = copy[locale] ?? copy.en;
---

<div class="max-w-3xl mx-auto my-12 border-l-4 border-blue bg-white rounded-lg p-6 md:p-8">
  <div class="flex items-start gap-4">
    <div class="hidden sm:flex flex-shrink-0 items-center justify-center w-10 h-10 rounded-lg bg-blue/10 text-blue">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="24" height="24">
        <circle cx="12" cy="12" r="10" /><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" />
      </svg>
    </div>
    <div>
      <h3 class="font-headline font-bold text-navy text-lg mb-2">{c.heading}</h3>
      <p class="font-body text-gray text-sm leading-relaxed mb-4">{c.body}</p>
      <Button href={c.href} variant="primary" size="md">{c.button} &rarr;</Button>
    </div>
  </div>
</div>
