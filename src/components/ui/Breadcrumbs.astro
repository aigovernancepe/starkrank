---
interface BreadcrumbItem {
  label: string;
  href: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
const site = Astro.site?.origin ?? 'https://starkrank.com';

const schemaItems = items.map((item, index) => ({
  '@type': 'ListItem',
  position: index + 1,
  name: item.label,
  item: `${site}${item.href}`,
}));

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: schemaItems,
};
---

<nav aria-label="Breadcrumb" class="mb-8">
  <ol class="flex flex-wrap items-center gap-1.5 text-sm font-body text-gray">
    {items.map((item, index) => (
      <li class="flex items-center gap-1.5">
        {index > 0 && <span class="text-gray-light">/</span>}
        {index === items.length - 1 ? (
          <span class="text-dark font-medium">{item.label}</span>
        ) : (
          <a href={item.href} class="hover:text-blue transition-colors">{item.label}</a>
        )}
      </li>
    ))}
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
