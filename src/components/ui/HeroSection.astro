---
interface Props {
  headline: string;
  subheadline?: string;
  align?: 'left' | 'center';
}

const { headline, subheadline, align = 'center' } = Astro.props;
const alignClass = align === 'center' ? 'text-center items-center' : 'text-left items-start';
---

<section class="bg-navy text-cream py-24 md:py-32">
  <div class:list={['max-w-7xl mx-auto px-6 flex flex-col', alignClass]}>
    <h1 class="text-4xl md:text-5xl lg:text-6xl font-headline font-black tracking-tight text-cream max-w-4xl">
      {headline}
    </h1>
    {subheadline && (
      <p class="mt-6 text-lg md:text-xl text-gray-light font-body max-w-2xl leading-relaxed">
        {subheadline}
      </p>
    )}
    <div class="mt-8 flex flex-wrap gap-4">
      <slot />
    </div>
  </div>
</section>
