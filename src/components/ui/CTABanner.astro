---
interface Props {
  bg?: 'cream' | 'navy';
  title: string;
  subtitle?: string;
  /** Optional background image URL. When set, a navy/80 overlay is applied
      so cream text remains readable, regardless of the `bg` prop. */
  backgroundImage?: string;
  /** Alt text for the background image. Required when backgroundImage is set. */
  backgroundImageAlt?: string;
  /** CSS object-position for the background image (e.g. "center top" to keep
      faces visible when subjects sit in the upper third of the frame). */
  imagePosition?: string;
}

const { bg = 'navy', title, subtitle, backgroundImage, backgroundImageAlt, imagePosition = 'center' } = Astro.props;
const hasImage = Boolean(backgroundImage);
const bgClass = hasImage ? '' : (bg === 'navy' ? 'bg-navy text-cream' : 'bg-cream text-dark');
const titleColor = hasImage || bg === 'navy' ? 'text-cream' : 'text-navy';
const subtitleColor = hasImage || bg === 'navy' ? 'text-gray-light' : 'text-gray';
---

<section class:list={['relative py-16 md:py-20 overflow-hidden', bgClass]}>
  {hasImage && (
    <div class="absolute inset-0">
      <img
        src={backgroundImage}
        alt={backgroundImageAlt || ''}
        class="w-full h-full object-cover"
        style={`object-position: ${imagePosition}`}
        loading="lazy"
      />
      <div class="absolute inset-0 bg-navy/80"></div>
    </div>
  )}

  <div class="relative max-w-4xl mx-auto px-6 text-center">
    <h2 class:list={['text-3xl md:text-4xl font-headline font-black tracking-tight', titleColor]}>
      {title}
    </h2>
    {subtitle && (
      <p class:list={['mt-4 text-lg font-body', subtitleColor]}>
        {subtitle}
      </p>
    )}
    <div class="mt-8 flex flex-wrap gap-4 justify-center">
      <slot />
    </div>
  </div>
</section>
