---
interface Props {
  bg?: 'cream' | 'navy';
  title: string;
  subtitle?: string;
}

const { bg = 'navy', title, subtitle } = Astro.props;
const bgClass = bg === 'navy' ? 'bg-navy text-cream' : 'bg-cream text-dark';
---

<section class:list={[bgClass, 'py-16 md:py-20']}>
  <div class="max-w-4xl mx-auto px-6 text-center">
    <h2 class:list={['text-3xl md:text-4xl font-headline font-black tracking-tight', bg === 'navy' ? 'text-cream' : 'text-navy']}>
      {title}
    </h2>
    {subtitle && (
      <p class:list={['mt-4 text-lg font-body', bg === 'navy' ? 'text-gray-light' : 'text-gray']}>
        {subtitle}
      </p>
    )}
    <div class="mt-8 flex flex-wrap gap-4 justify-center">
      <slot />
    </div>
  </div>
</section>
