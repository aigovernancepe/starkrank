---
interface Props {
  href?: string;
  class?: string;
}

const { href, class: className = '' } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag
  href={href}
  class:list={[
    'block bg-white border border-gray-light/40 rounded-lg p-6 transition-all hover:shadow-lg hover:border-blue/30 hover:-translate-y-0.5',
    className,
  ]}
>
  <slot />
</Tag>
