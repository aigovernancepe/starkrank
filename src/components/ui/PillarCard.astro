---
import type { Pillar } from '../../data/pillars';
import { getCurrentLocale, t } from '../../utils/i18n';
import type { Locale } from '../../data/locales';
import PillarIcon from './PillarIcon.astro';

interface Props {
  pillar: Pillar;
  locale?: Locale;
  href?: string;
  /** 'foundation' marks the Data & Web base card with a blue left stripe while
   * keeping the white-card palette — consistent with pillars, with just enough
   * accent to signal the foundation role. */
  variant?: 'default' | 'foundation';
}

const { pillar, locale, href, variant = 'default' } = Astro.props;
const currentLocale = locale ?? getCurrentLocale(Astro.url);
const hubSlug = pillar.services[0];
const linkHref = href ?? `/services/${hubSlug}/`;

const isFoundation = variant === 'foundation';
const iconId = pillar.id as Parameters<typeof PillarIcon>[0]['id'];

const wrapperClasses = isFoundation
  ? 'group block bg-white border border-gray-light/40 border-l-4 border-l-blue rounded-lg p-8 transition-all hover:shadow-xl hover:border-blue/30 hover:border-l-blue hover:-translate-y-1'
  : 'group block bg-white border border-gray-light/40 rounded-lg p-8 transition-all hover:shadow-xl hover:border-blue/30 hover:-translate-y-1';
---

<a href={linkHref} class={wrapperClasses}>
  <PillarIcon id={iconId} class="w-10 h-10 text-blue" />
  <span class="mt-4 block text-xs font-label font-semibold uppercase tracking-[0.2em] text-blue">
    {pillar.tagline}
  </span>
  <h3 class="mt-2 text-xl font-headline font-black tracking-tight text-navy group-hover:text-blue transition-colors">
    {pillar.name}
  </h3>
  <p class="mt-3 text-sm text-gray font-body leading-relaxed">
    {pillar.description}
  </p>
  <span class="mt-4 inline-flex items-center text-sm font-label font-semibold text-blue uppercase tracking-wide">
    {t('cta.learnMore', currentLocale)}
    <svg class="ml-1 w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </span>
</a>
