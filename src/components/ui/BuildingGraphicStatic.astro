---
/**
 * Static brand version of the five-building-blocks graphic (delivered by design, Janko).
 * Flat — no frame, no shadow, no hover/click interactivity. Headline + caption live
 * outside the graphic (in the SectionHeader). Used across all locales (DE, CH-DE, EN);
 * only two labels differ by language (Suche & KI / Daten & Web → Search & AI / Data & Web),
 * the rest (Performance Media, Digital PR, Content) are identical.
 *
 * Font: 'Inter' — the design-delivered original ("Inter 18pt"), self-hosted in global.css.
 * Whole-word labels with text-anchor="middle" let the font own letter-spacing, so glyph
 * widths never drift (the delivered file hard-coded per-glyph X values that broke under
 * any other render font). Geometry unchanged.
 *
 * `linked` (opt-in): turns each block into an in-page anchor to its pillar section
 * (#search-ai-intelligence … #data-web). Used on /services as a clickable overview /
 * table of contents. Default false keeps the flat homepage rendering untouched.
 * Anchor href works without JS; a small enhancement adds smooth scroll (reduced-motion safe).
 *
 * `panels` (opt-in, mutually exclusive with `linked`): MOBILE-only accordion. Each block
 * on the compact mobile graphic becomes a toggle that expands an info box (tagline + name +
 * description + CTA) right below the graphic — so the visitor reads a pillar without
 * scrolling away. The desktop graphic stays purely decorative (the desktop pillar cards
 * carry navigation there). Used on the DE/CH-DE homepages.
 */
import { t } from '../../utils/i18n';

interface PanelItem {
  id: string;
  name: string;
  tagline: string;
  description: string;
  href: string;
}

interface Props {
  /** When true, each block links to its pillar section and gains hover/scroll behaviour. */
  linked?: boolean;
  /** Locale — switches the language-dependent labels and a11y strings. Default 'de'. */
  locale?: 'de' | 'ch-de' | 'en' | 'pe';
  /** When provided (and not `linked`), mobile blocks toggle an info box per pillar. */
  panels?: PanelItem[];
}

const { linked = false, locale = 'de', panels } = Astro.props;
const isEn = locale === 'en';
const isPe = locale === 'pe';
// One uniform mobile label size per locale. PE drops to 22px so the longest Spanish
// word ("Rendimiento") fits the narrow mobile blocks; every PE label uses the same size.
const mobileFontSize = isPe ? '22' : '30';

// Mobile accordion: only when panels are passed and we're not in linked mode.
const accordion = !linked && Array.isArray(panels) && panels.length > 0;
const panelCta = t('cta.learnMore', locale);

// Wrapper element per block: clickable <a> when linked, plain <g> otherwise (the
// accordion turns the <g> into a button via role/tabindex attrs, not a tag swap).
const Wrapper = linked ? 'a' : 'g';

// Per-locale block labels. EN/DE only differ on Suche & KI / Daten & Web (the design-
// delivered original). Spanish (pe) translates every label; "Performance Media" becomes
// "Medios de Rendimiento" and "Digital PR" → "Autoridad y PR". `digitalPrDesktop` is one
// line for de/ch-de/en and two for the longer Spanish wording; mobile is always two lines.
const labelSets: Record<string, {
  searchAi: string[];
  performance: string[];
  digitalPrDesktop: string[];
  digitalPrMobile: string[];
  content: string;
  dataWeb: string;
}> = {
  de: {
    searchAi: ['Suche', '& KI'],
    performance: ['Performance', 'Media'],
    digitalPrDesktop: ['Digital PR'],
    digitalPrMobile: ['Digital', 'PR'],
    content: 'Content',
    dataWeb: 'Daten & Web',
  },
  'ch-de': {
    searchAi: ['Suche', '& KI'],
    performance: ['Performance', 'Media'],
    digitalPrDesktop: ['Digital PR'],
    digitalPrMobile: ['Digital', 'PR'],
    content: 'Content',
    dataWeb: 'Daten & Web',
  },
  en: {
    searchAi: ['Search', '& AI'],
    performance: ['Performance', 'Media'],
    digitalPrDesktop: ['Digital PR'],
    digitalPrMobile: ['Digital', 'PR'],
    content: 'Content',
    dataWeb: 'Data & Web',
  },
  pe: {
    searchAi: ['Búsqueda', 'e IA'],
    performance: ['Medios de', 'Rendimiento'],
    digitalPrDesktop: ['Autoridad', 'y PR'],
    digitalPrMobile: ['Autoridad', 'y PR'],
    content: 'Contenido',
    dataWeb: 'Datos y Web',
  },
};
const L = labelSets[locale] ?? labelSets.de;

const a11ySets: Record<string, { title: string; desc: string; blockAria: Record<string, string> }> = {
  en: {
    title: 'Five Building Blocks of Digital Growth',
    desc: 'Four building blocks of digital growth — Search & AI, Performance Media, Digital PR and Content — rest on the fifth block: Data & Web.',
    blockAria: {
      'search-ai-intelligence': 'Jump to the Search & AI services',
      'performance-media': 'Jump to the Performance Media services',
      'authority-pr': 'Jump to the Digital PR services',
      'content-copywriting': 'Jump to the Content services',
      'data-web': 'Jump to the Data & Web services',
    },
  },
  de: {
    title: 'Fünf Bausteine des digitalen Wachstums',
    desc: 'Vier Bausteine des digitalen Wachstums — Suche & KI, Performance Media, Digital PR und Content — stehen auf dem fünften Baustein: Daten & Web.',
    blockAria: {
      'search-ai-intelligence': 'Zum Leistungsbereich Suche & KI scrollen',
      'performance-media': 'Zum Leistungsbereich Performance Media scrollen',
      'authority-pr': 'Zum Leistungsbereich Digital PR scrollen',
      'content-copywriting': 'Zum Leistungsbereich Content scrollen',
      'data-web': 'Zum Leistungsbereich Daten & Web scrollen',
    },
  },
  pe: {
    title: 'Cinco bloques del crecimiento digital',
    desc: 'Cuatro bloques del crecimiento digital — Búsqueda e IA, Medios de Rendimiento, Autoridad y PR y Contenido — se apoyan sobre el quinto bloque: Datos y Web.',
    blockAria: {
      'search-ai-intelligence': 'Ir a los servicios de Búsqueda e IA',
      'performance-media': 'Ir a los servicios de Medios de Rendimiento',
      'authority-pr': 'Ir a los servicios de Autoridad y PR',
      'content-copywriting': 'Ir a los servicios de Contenido',
      'data-web': 'Ir a los servicios de Datos y Web',
    },
  },
};
// ch-de shares the German strings.
const a11y = a11ySets[locale] ?? a11ySets.de;

const blockAria = a11y.blockAria;
const panelById: Record<string, PanelItem> = accordion
  ? Object.fromEntries(panels!.map((p) => [p.id, p]))
  : {};

// Desktop graphic: clickable anchor when linked, otherwise a plain decorative group
// (this includes accordion mode — desktop navigation lives in the pillar cards).
function desktopAttrs(id: string) {
  return linked
    ? { href: `#${id}`, 'aria-label': blockAria[id], class: 'bg-block' }
    : { id };
}

// Mobile graphic: anchor when linked; an ARIA toggle button when accordion; else a
// plain group. The `-m` id suffix keeps non-interactive ids unique against the
// desktop SVG (both graphics live in the DOM, one hidden per breakpoint).
function mobileAttrs(id: string) {
  if (linked) return { href: `#${id}`, 'aria-label': blockAria[id], class: 'bg-block' };
  if (accordion) {
    const name = panelById[id]?.name ?? id;
    return {
      role: 'button',
      tabindex: '0',
      'data-bg-toggle': id,
      'aria-controls': `bg-panel-${id}`,
      'aria-expanded': 'false',
      'aria-label': isEn ? `Show ${name} details` : `${name} – Beschreibung anzeigen`,
      class: 'bg-block bg-toggle',
    };
  }
  return { id: `${id}-m` };
}
---

<!-- Desktop / tablet graphic (wide 800×430 layout). Hidden below md. -->
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 800 430"
  role="img"
  aria-labelledby="bg-title bg-desc"
  class="hidden md:block w-full h-auto max-w-3xl mx-auto mt-8"
>
  <title id="bg-title">{a11y.title}</title>
  <desc id="bg-desc">{a11y.desc}</desc>
  <defs>
    <style>
      .cls-1 { fill: #3b7dd8; }
      .cls-6 { fill: #5a9ae6; }
      /* Whole-word labels — letter-spacing left to the font so glyph widths and
         positions never drift (the delivered file hard-coded per-glyph X values
         for "Inter 18pt", which broke under any other render font). */
      .cls-10 {
        fill: #fff;
        font-family: 'Inter', 'Helvetica Neue', Arial, sans-serif;
        /* Inter is wider than the old Inter Tight, so the longest label
           ("Performance") overflowed its block at 27.56px. Dropped to ~16.5pt,
           close to the design-delivered "Inter 18pt". */
        font-size: 22px;
        font-weight: 700;
        letter-spacing: -.02em;
      }
    </style>
  </defs>
  <Wrapper {...desktopAttrs('search-ai-intelligence')}>
    <g>
      <polygon class="cls-6" points="74.14 15.12 15.51 73.74 15.51 349.32 186.29 349.32 186.29 15.12 74.14 15.12"/>
      <text class="cls-10" text-anchor="middle"><tspan x="100.9" y="185.84">{L.searchAi[0]}</tspan><tspan x="100.9" y="218.91">{L.searchAi[1]}</tspan></text>
    </g>
  </Wrapper>
  <Wrapper {...desktopAttrs('performance-media')}>
    <g>
      <polygon class="cls-6" points="273.65 15.12 215.02 73.74 215.02 349.32 385.8 349.32 385.8 15.12 273.65 15.12"/>
      <text class="cls-10" text-anchor="middle"><tspan x="300.41" y="186.78">{L.performance[0]}</tspan><tspan x="300.41" y="219.85">{L.performance[1]}</tspan></text>
    </g>
  </Wrapper>
  <Wrapper {...desktopAttrs('authority-pr')}>
    <g>
      <polygon class="cls-6" points="472.94 15.12 414.31 73.74 414.31 349.32 585.09 349.32 585.09 15.12 472.94 15.12"/>
      <text class="cls-10" text-anchor="middle">{L.digitalPrDesktop.length === 1 ? (<tspan x="499.7" y="204.43">{L.digitalPrDesktop[0]}</tspan>) : (<Fragment><tspan x="499.7" y="186.78">{L.digitalPrDesktop[0]}</tspan><tspan x="499.7" y="219.85">{L.digitalPrDesktop[1]}</tspan></Fragment>)}</text>
    </g>
  </Wrapper>
  <Wrapper {...desktopAttrs('content-copywriting')}>
    <g>
      <polygon class="cls-6" points="698.93 264.16 719.19 284.42 654.29 349.32 671.73 349.32 727.99 293.06 784.42 349.32 784.49 349.32 784.49 15.12 672.34 15.12 613.71 73.74 613.71 349.32 613.77 349.32 698.93 264.16"/>
      <polygon class="cls-6" points="746.72 349.32 729.15 331.91 711.75 349.32 746.72 349.32"/>
    </g>
    <text class="cls-10" text-anchor="middle"><tspan x="699.1" y="202.61">{L.content}</tspan></text>
  </Wrapper>
  <Wrapper {...desktopAttrs('data-web')}>
    <g>
      <polygon class="cls-1" points="702.16 358.9 671.53 389.54 671.53 358.9 15.51 358.88 15.51 414.86 784.19 414.88 784.19 358.91 702.16 358.9"/>
      <text class="cls-10" text-anchor="middle"><tspan x="399.85" y="397.19">{L.dataWeb}</tspan></text>
    </g>
  </Wrapper>
</svg>

<!--
  Mobile graphic (Janko's compact 600×420 layout — taller blocks for narrow screens).
  Shown below md, hidden from md up. Same locale/linked behaviour as the desktop SVG.
  "Performance Media" stays as Janko's vector outlines (font-independent, language-neutral);
  the live-text labels were converted to whole-word text-anchor="middle" on self-hosted
  'Inter' for the same reason as the desktop version (the delivered file's hard-coded
  per-glyph X values were tied to "Inter 18pt" and drift under any other render font).
-->
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 600 420"
