  <desc id="bg-desc-m">{a11y.desc}</desc>
  <defs>
    <style>
      /* These two classes are a desktop/iOS convenience only — DO NOT rely on them for
         Android. With two document-global SVG <style> blocks (desktop + this mobile one),
         Android Chrome applies only the FIRST. .cls-1/.cls-6 survive because they're
         duplicated in both blocks, but .cls-tm/.cls-pf live solely here, so Android dropped
         them: the labels rendered with no fill (dark) and no font-size (tiny), while the
         vector "Performance Media" was likewise unfilled. Every visual property the labels
         need — fill, font-size/-family/-weight, letter-spacing — is therefore set as a
         presentation attribute on the <text>/<g> elements (independent of these classes). */
      .cls-tm { fill: #fff; }
      .cls-pf { fill: #fff; }
    </style>
