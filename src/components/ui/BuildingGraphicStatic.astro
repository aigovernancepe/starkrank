{accordion && (
  <!-- Mobile-only info boxes; one expands when its block is tapped (see script). -->
  <div class="md:hidden mt-5 space-y-3" data-bg-panels>
    {panels!.map((p) => (
      <div
        id={`bg-panel-${p.id}`}
        data-bg-panel={p.id}
        hidden
        class="rounded-lg border border-gray-light/40 bg-white p-5 shadow-sm"
      >
        <span class="block text-xs font-label font-semibold uppercase tracking-[0.2em] text-blue">{p.tagline}</span>
        <h3 class="mt-1 text-lg font-headline font-black tracking-tight text-navy">{p.name}</h3>
        <p class="mt-2 text-sm text-gray font-body leading-relaxed">{p.description}</p>
        <a href={p.href} class="mt-3 inline-flex items-center text-sm font-label font-semibold uppercase tracking-wide text-blue">
          {panelCta}
          <svg class="ml-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </a>
      </div>
    ))}
  </div>
)}

{(linked || accordion) && (
  <style>
    .bg-block {
      cursor: pointer;
      transition: transform 220ms cubic-bezier(0.4, 0, 0.2, 1);
      transform-box: fill-box;
      transform-origin: center;
      /* Kill the grey tap-flash + the dark default focus rectangle Android Chrome
         draws on a tapped role=button/anchor (iOS Safari draws neither, which is why
         the box only showed up on Android). The blue keyboard ring below stays. */
      -webkit-tap-highlight-color: transparent;
    }
    .bg-block:focus:not(:focus-visible) {
      outline: none;
    }
    .bg-block polygon {
      transition: filter 220ms ease;
    }
    .bg-block:hover,
    .bg-block:focus-visible {
      transform: translateY(-6px);
    }
    .bg-block:hover polygon,
    .bg-block:focus-visible polygon {
      filter: brightness(1.08);
    }
    .bg-block:focus-visible {
      outline: 2px solid #3b7dd8;
      outline-offset: 4px;
      border-radius: 4px;
    }
    /* Open accordion block stays lifted/brightened so the active pillar is obvious. */
    .bg-toggle[aria-expanded='true'] {
      transform: translateY(-6px);
    }
    .bg-toggle[aria-expanded='true'] polygon {
      filter: brightness(1.12);
    }
    @media (prefers-reduced-motion: reduce) {
      .bg-block,
      .bg-block polygon {
        transition: none !important;
      }
      .bg-block:hover,
      .bg-block:focus-visible,
      .bg-toggle[aria-expanded='true'] {
        transform: none !important;
      }
    }
  </style>
)}

{linked && (
  <script>
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll<HTMLAnchorElement>('.bg-block').forEach((link) => {
      link.addEventListener('click', (event) => {
        const href = link.getAttribute('href');
        if (!href || !href.startsWith('#')) return;
        const target = document.querySelector<HTMLElement>(href);
        if (!target) return;
        event.preventDefault();
        target.scrollIntoView({ behavior: prefersReducedMotion ? 'auto' : 'smooth', block: 'start' });
      });
    });
  </script>
)}

{accordion && (
  <script>
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const toggles = Array.from(document.querySelectorAll<SVGGElement>('[data-bg-toggle]'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-bg-panel]'));

    function activate(toggle: SVGGElement) {
      const id = toggle.getAttribute('data-bg-toggle');
      if (!id) return;
      const panel = document.getElementById(`bg-panel-${id}`);
      if (!panel) return;
      const willOpen = toggle.getAttribute('aria-expanded') !== 'true';
      // Accordion: collapse everything, then open the tapped one (toggles off if re-tapped).
      toggles.forEach((t) => t.setAttribute('aria-expanded', 'false'));
      panels.forEach((p) => (p.hidden = true));
      if (willOpen) {
        toggle.setAttribute('aria-expanded', 'true');
        panel.hidden = false;
        panel.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'nearest' });
      }
    }

    toggles.forEach((toggle) => {
      toggle.addEventListener('click', () => activate(toggle));
      toggle.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          activate(toggle);
        }
      });
    });
  </script>
)}
