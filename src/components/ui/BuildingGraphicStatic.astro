---
/**
 * Static brand version of the five-building-blocks graphic (delivered by design, Janko).
 * Flat — no frame, no shadow, no hover/click interactivity. Headline + caption live
 * outside the graphic (in the SectionHeader). German labels only → DE + CH-DE.
 * EN keeps the interactive, localized BuildingGraphic.astro.
 *
 * Font: the delivered file referenced "Inter 18pt"; remapped to the site brand stack
 * ('Inter Tight') so it renders with the loaded webfont. Geometry/kerning unchanged.
 */
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 800 430"
  role="img"
  aria-labelledby="bg-title bg-desc"
  class="w-full h-auto max-w-3xl mx-auto mt-8"
>
  <title id="bg-title">Fünf Bausteine des digitalen Wachstums</title>
  <desc id="bg-desc">Vier Bausteine des digitalen Marketings — Suche &amp; KI, Performance Media, Digital PR und Content — stehen auf dem fünften Baustein: Daten &amp; Web.</desc>
  <defs>
    <style>
      .cls-1 { fill: #3b7dd8; }
      .cls-6 { fill: #5a9ae6; }
      /* Whole-word labels — letter-spacing left to the font so glyph widths and
         positions never drift (the delivered file hard-coded per-glyph X values
         for "Inter 18pt", which broke under any other render font). */
      .cls-10 {
        fill: #fff;
        font-family: 'Inter Tight', 'Helvetica Neue', Arial, sans-serif;
        font-size: 27.56px;
        font-weight: 700;
        letter-spacing: -.02em;
      }
    </style>
  </defs>
  <g id="search-ai-intelligence">
    <g>
      <polygon class="cls-6" points="74.14 15.12 15.51 73.74 15.51 349.32 186.29 349.32 186.29 15.12 74.14 15.12"/>
      <text class="cls-10" text-anchor="middle"><tspan x="100.9" y="185.84">Suche</tspan><tspan x="100.9" y="218.91">&amp; KI</tspan></text>
    </g>
  </g>
  <g id="performance-media">
    <g>
      <polygon class="cls-6" points="273.65 15.12 215.02 73.74 215.02 349.32 385.8 349.32 385.8 15.12 273.65 15.12"/>
      <text class="cls-10" text-anchor="middle"><tspan x="300.41" y="186.78">Performance</tspan><tspan x="300.41" y="219.85">Media</tspan></text>
    </g>
  </g>
  <g id="authority-pr">
    <g>
      <polygon class="cls-6" points="472.94 15.12 414.31 73.74 414.31 349.32 585.09 349.32 585.09 15.12 472.94 15.12"/>
      <text class="cls-10" text-anchor="middle"><tspan x="499.7" y="204.43">Digital PR</tspan></text>
    </g>
  </g>
  <g id="content-copywriting">
    <g>
      <polygon class="cls-6" points="698.93 264.16 719.19 284.42 654.29 349.32 671.73 349.32 727.99 293.06 784.42 349.32 784.49 349.32 784.49 15.12 672.34 15.12 613.71 73.74 613.71 349.32 613.77 349.32 698.93 264.16"/>
      <polygon class="cls-6" points="746.72 349.32 729.15 331.91 711.75 349.32 746.72 349.32"/>
    </g>
    <text class="cls-10" text-anchor="middle"><tspan x="699.1" y="202.61">Content</tspan></text>
  </g>
  <g id="data-web">
    <g>
      <polygon class="cls-1" points="702.16 358.9 671.53 389.54 671.53 358.9 15.51 358.88 15.51 414.86 784.19 414.88 784.19 358.91 702.16 358.9"/>
      <text class="cls-10" text-anchor="middle"><tspan x="399.85" y="397.19">Daten &amp; Web</tspan></text>
    </g>
  </g>
</svg>
