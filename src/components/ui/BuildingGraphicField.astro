---
interface Props {
  locale: 'de' | 'ch-de' | 'en';
}

const { locale } = Astro.props;

const labels: Record<string, Record<string, string>> = {
  de: {
    'search-ai-intelligence': 'Suche & KI',
    'performance-media': 'Performance Media',
    'authority-pr': 'Autorität',
    'content-copywriting': 'Content',
  },
  'ch-de': {
    'search-ai-intelligence': 'Suche & KI',
    'performance-media': 'Performance Media',
    'authority-pr': 'Autorität',
    'content-copywriting': 'Content',
  },
  en: {
    'search-ai-intelligence': 'Search & AI',
    'performance-media': 'Performance Media',
    'authority-pr': 'Authority',
    'content-copywriting': 'Content',
  },
};

const aria: Record<string, Record<string, string>> = {
  de: {
    'search-ai-intelligence': 'Zur Säule Suche und KI-Intelligenz scrollen',
    'performance-media': 'Zur Säule Performance Media scrollen',
    'authority-pr': 'Zur Säule Autorität scrollen',
    'content-copywriting': 'Zur Säule Content scrollen',
    'data-web': 'Zum Fundament Daten und Web scrollen',
  },
  'ch-de': {
    'search-ai-intelligence': 'Zur Säule Suche und KI-Intelligenz scrollen',
    'performance-media': 'Zur Säule Performance Media scrollen',
    'authority-pr': 'Zur Säule Autorität scrollen',
    'content-copywriting': 'Zur Säule Content scrollen',
    'data-web': 'Zum Fundament Daten und Web scrollen',
  },
  en: {
    'search-ai-intelligence': 'Jump to Search and AI Intelligence card',
    'performance-media': 'Jump to Performance Media card',
    'authority-pr': 'Jump to Authority card',
    'content-copywriting': 'Jump to Content card',
    'data-web': 'Jump to Data and Web card',
  },
};

const s = {
  de: { top: 'WACHSTUM', foundation: 'DATEN & WEB', caption: 'Fundament jeder strategischen Entscheidung' },
  'ch-de': { top: 'WACHSTUM', foundation: 'DATEN & WEB', caption: 'Fundament jeder strategischen Entscheidung' },
  en: { top: 'GROWTH', foundation: 'DATA & WEB', caption: 'Foundation of every strategic decision' },
}[locale];

const discs = [
  { id: 'search-ai-intelligence', num: '01', cx: 170 },
  { id: 'performance-media', num: '02', cx: 340 },
  { id: 'authority-pr', num: '03', cx: 510 },
  { id: 'content-copywriting', num: '04', cx: 680 },
];
const discCY = 270;
const discR = 60;

// Chevron band path — inverted-V with hollow interior, matches SR logo mark
function chevronPath(cxp: number, cyp: number, w: number, h: number, t: number): string {
  const hw = w / 2;
  const hh = h / 2;
  const innerPeakY = cyp - hh + t * 1.8;
  return [
    `M ${cxp - hw} ${cyp + hh}`,
    `L ${cxp} ${cyp - hh}`,
    `L ${cxp + hw} ${cyp + hh}`,
    `L ${cxp + hw - t} ${cyp + hh}`,
    `L ${cxp} ${innerPeakY}`,
    `L ${cxp - hw + t} ${cyp + hh}`,
    'Z',
  ].join(' ');
}

// In-disc chevron: centered at 0,0 (translated into place), 56 wide × 38 tall, thickness 15
const discChevOuter = chevronPath(0, 0, 56, 38, 15);
const discChevInner = chevronPath(-6, -5, 34, 23, 9);
---

<div class="variant-field relative">
  <svg viewBox="0 0 840 560" xmlns="http://www.w3.org/2000/svg" role="img" class="w-full h-auto max-w-3xl mx-auto mt-8" style="font-family: 'Inter Tight', ui-sans-serif, system-ui;">

    <defs>
      {/* Chevron-field tile pattern — faint SR marks repeated as proper chevron bands */}
      <pattern id="chev-field" x="0" y="0" width="80" height="80" patternUnits="userSpaceOnUse">
        <g opacity="0.09">
          {/* Outer chevron band, 44w × 30h, thickness 10 */}
          <path d="M 18 54 L 40 24 L 62 54 L 52 54 L 40 36 L 28 54 Z" fill="#3B7DD8" fill-rule="evenodd" />
          {/* Inner chevron band (offset upper-left), 26w × 18h, thickness 6 */}
          <path d="M 22 44 L 34 28 L 46 44 L 40 44 L 34 36 L 28 44 Z" fill="#0E1A2D" fill-rule="evenodd" />
        </g>
      </pattern>
      <radialGradient id="f-backdrop" cx="50%" cy="50%" r="75%">
        <stop offset="0%" stop-color="#FDFCFA" />
        <stop offset="100%" stop-color="#F2F0EB" />
      </radialGradient>
      <linearGradient id="f-found" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#1A3B6E" />
        <stop offset="100%" stop-color="#0E1A2D" />
      </linearGradient>
      <filter id="f-glow" x="-30%" y="-30%" width="160%" height="160%">
        <feGaussianBlur stdDeviation="8" result="blur" />
        <feColorMatrix in="blur" type="matrix" values="0 0 0 0 0.231  0 0 0 0 0.490  0 0 0 0 0.847  0 0 0 0.5 0" />
      </filter>
    </defs>

    {/* Backdrop — cream base + tiled chevron field overlay */}
    <rect width="840" height="560" fill="url(#f-backdrop)" />
    <rect width="840" height="560" fill="url(#chev-field)" />

    {/* WACHSTUM top */}
    <text x="420" y="82" text-anchor="middle" fill="#0E1A2D" font-size="26" font-weight="900" letter-spacing="10">{s.top}</text>
    <line x1="340" y1="96" x2="500" y2="96" stroke="#B8893B" stroke-width="2.5" />

    {/* ─── Four discipline discs ─── */}
    {discs.map(({ id, num, cx }) => (
      <a href={`#card-${id}`} data-pillar-id={id} aria-label={aria[locale][id]}>
        <g class="disc-group">
          {/* Soft glow behind */}
          <circle cx={cx} cy={discCY} r={discR + 4} fill="#3B7DD8" filter="url(#f-glow)" opacity="0.45" class="disc-glow" />

          {/* Disc fill — navy with gold ring */}
          <circle cx={cx} cy={discCY} r={discR} fill="#0E1A2D" stroke="#B8893B" stroke-width="3" class="disc-fill" />

          {/* Disc highlight arc (top-left) */}
          <path d={`M ${cx - discR + 6} ${discCY - discR * 0.55} A ${discR} ${discR} 0 0 1 ${cx - discR * 0.1} ${discCY - discR + 3}`} fill="none" stroke="#3B7DD8" stroke-width="3" stroke-linecap="round" opacity="0.6" pointer-events="none" />

          {/* SR double-chevron mark inside disc */}
          <g transform={`translate(${cx}, ${discCY})`} pointer-events="none">
            <path d={discChevOuter} fill="#3B7DD8" class="disc-chev-outer" fill-rule="evenodd" />
            <path d={discChevInner} fill="#F8F7F4" class="disc-chev-inner" opacity="0.95" fill-rule="evenodd" />
          </g>

          {/* Number + label below the disc */}
          <text x={cx} y={discCY + discR + 32} text-anchor="middle" fill="#B8893B" font-size="13" font-weight="900" letter-spacing="1.5">{num}</text>
          <text x={cx} y={discCY + discR + 56} text-anchor="middle" fill="#0E1A2D" font-size="17" font-weight="900" letter-spacing="-0.2" class="disc-label">{labels[locale][id]}</text>
        </g>
      </a>
    ))}

    {/* Foundation */}
    <a href="#card-data-web" data-pillar-id="data-web" aria-label={aria[locale]['data-web']}>
      <g class="field-foundation">
        <rect x="50" y="466" width="740" height="2.5" fill="#B8893B" class="field-found-gold" />
        <rect x="50" y="470" width="740" height="62" fill="url(#f-found)" class="field-found-fill" rx="4" />
        <text x="420" y="506" text-anchor="middle" fill="#F8F7F4" font-size="22" font-weight="900" letter-spacing="10" pointer-events="none">{s.foundation}</text>
      </g>
    </a>

    <text x="420" y="550" text-anchor="middle" fill="#0E1A2D" opacity="0.55" font-size="12" font-style="italic">{s.caption}</text>
  </svg>
</div>

<style>
  .variant-field :global(.disc-group) {
    transition: transform 280ms ease;
    transform-origin: center;
    transform-box: fill-box;
  }
  .variant-field :global(.disc-fill),
  .variant-field :global(.disc-glow),
  .variant-field :global(.disc-chev-outer),
  .variant-field :global(.disc-label),
  .variant-field :global(.field-found-gold) {
    transition: fill 240ms ease, opacity 240ms ease, filter 240ms ease, stroke 240ms ease;
  }
  .variant-field a { cursor: pointer; }
  .variant-field a[data-pillar-id]:hover .disc-group,
  .variant-field a[data-pillar-id]:focus-visible .disc-group,
  .variant-field a[data-pillar-id].is-active .disc-group {
    transform: translateY(-6px) scale(1.04);
  }
  .variant-field a[data-pillar-id]:hover .disc-fill,
  .variant-field a[data-pillar-id]:focus-visible .disc-fill,
  .variant-field a[data-pillar-id].is-active .disc-fill {
    fill: #1A3B6E;
    stroke: #D4A44A;
  }
  .variant-field a[data-pillar-id]:hover .disc-glow,
  .variant-field a[data-pillar-id]:focus-visible .disc-glow,
  .variant-field a[data-pillar-id].is-active .disc-glow {
    opacity: 0.9;
  }
  .variant-field a[data-pillar-id]:hover .disc-chev-outer,
  .variant-field a[data-pillar-id]:focus-visible .disc-chev-outer,
  .variant-field a[data-pillar-id].is-active .disc-chev-outer {
    fill: #5A9AE6;
  }
  .variant-field a[data-pillar-id]:hover .disc-label,
  .variant-field a[data-pillar-id]:focus-visible .disc-label,
  .variant-field a[data-pillar-id].is-active .disc-label {
    fill: #3B7DD8;
  }
  .variant-field a[data-pillar-id="data-web"]:hover .field-found-gold,
  .variant-field a[data-pillar-id="data-web"]:focus-visible .field-found-gold,
  .variant-field a[data-pillar-id="data-web"].is-active .field-found-gold {
    fill: #D4A44A;
  }
</style>

<script>
  const elements = Array.from(document.querySelectorAll<HTMLElement>('.variant-field [data-pillar-id]'));
  const groups = new Map<string, HTMLElement[]>();
  elements.forEach((el) => {
    const id = el.getAttribute('data-pillar-id');
    if (!id) return;
    if (!groups.has(id)) groups.set(id, []);
    groups.get(id)!.push(el);
  });
  groups.forEach((group) => {
    const on = () => group.forEach((el) => el.classList.add('is-active'));
    const off = () => group.forEach((el) => el.classList.remove('is-active'));
    group.forEach((el) => {
      el.addEventListener('mouseenter', on);
      el.addEventListener('mouseleave', off);
      el.addEventListener('focusin', on);
      el.addEventListener('focusout', off);
    });
  });
  document.querySelectorAll<HTMLAnchorElement>('.variant-field a[data-pillar-id]').forEach((link) => {
    link.addEventListener('click', (event) => {
      const id = link.getAttribute('data-pillar-id');
      if (!id) return;
      const card = document.querySelector<HTMLElement>(`.pillar-card-wrapper[data-pillar-id="${id}"]`);
      if (!card) return;
      event.preventDefault();
      card.scrollIntoView({ behavior: 'smooth', block: 'center' });
      card.classList.remove('is-flash');
      void card.offsetWidth;
      card.classList.add('is-flash');
      window.setTimeout(() => card.classList.remove('is-flash'), 1500);
    });
  });
</script>
