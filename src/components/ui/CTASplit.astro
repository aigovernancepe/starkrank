---
interface Props {
  /** Optional eyebrow rendered above the title (small caps, blue accent). */
  eyebrow?: string;
  title: string;
  subtitle?: string;
  /** Photo shown at full colour on the right — no darkening overlay. */
  image: string;
  /** Alt text for the photo. Required. */
  imageAlt: string;
  /** CSS object-position for the photo (e.g. "center top" to keep faces in frame). */
  imagePosition?: string;
  /** Optional caption pill placed over the photo — a small human/place anchor. */
  caption?: string;
}

const { eyebrow, title, subtitle, image, imageAlt, imagePosition = 'center', caption } = Astro.props;
---

{/* Split CTA: text left (reads first), human photo right at full colour.
    Replaces the navy/80-darkened full-bleed banner so the people stay visible. */}
<section class="relative bg-navy overflow-hidden py-16 md:py-24">
  {/* Subtle blue depth glow behind the photo — atmosphere, not decoration overload. */}
  <div class="pointer-events-none absolute -top-24 -right-24 w-[480px] h-[480px] rounded-full bg-blue/10 blur-3xl" aria-hidden="true"></div>

  <div class="relative max-w-7xl mx-auto px-6 grid md:grid-cols-2 gap-10 lg:gap-16 items-center">
    {/* Text column — centered on mobile (stacked), left-aligned beside the photo on desktop */}
    <div class="text-center md:text-left">
      {eyebrow && (
        <span class="block text-xs md:text-sm font-label font-semibold uppercase tracking-[0.2em] text-blue-light">
          {eyebrow}
        </span>
      )}
      <h2 class:list={['text-3xl md:text-4xl font-headline font-black tracking-tight text-cream', eyebrow && 'mt-4']}>
        {title}
      </h2>
      {subtitle && (
        <p class="mt-4 text-lg font-body text-gray-light leading-relaxed">
          {subtitle}
        </p>
      )}
      <div class="mt-8 flex flex-wrap gap-4 justify-center md:justify-start">
        <slot />
      </div>
    </div>

    {/* Photo column — full colour, editorial matte frame */}
    <div class="relative">
      {/* Offset accent behind the frame for depth */}
      <div class="pointer-events-none absolute inset-0 translate-x-3 translate-y-3 rounded-2xl bg-blue-light/15" aria-hidden="true"></div>
      <figure class="relative rounded-2xl overflow-hidden ring-1 ring-white/10 shadow-2xl">
        <img
          src={image}
          alt={imageAlt}
          class="w-full h-full object-cover aspect-[4/3]"
          style={`object-position: ${imagePosition}`}
          loading="lazy"
          decoding="async"
        />
        {caption && (
          <figcaption class="absolute bottom-4 left-4 inline-flex items-center gap-2 bg-cream/95 backdrop-blur px-3 py-1.5 rounded-full shadow-sm">
            <span class="w-1.5 h-1.5 rounded-full bg-blue" aria-hidden="true"></span>
            <span class="text-xs font-label font-semibold tracking-wide text-navy">{caption}</span>
          </figcaption>
        )}
      </figure>
    </div>
  </div>
</section>
