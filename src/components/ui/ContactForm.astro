<div id="hs-form-contact"></div>
<script is:inline>
  window.addEventListener('load', function() {
    if (window.hbspt) {
      hbspt.forms.create({
        region: 'eu1',
        portalId: '148108624',
        formId: '5c38981a-8f6a-4a5f-95e3-fc1658431b53',
        target: '#hs-form-contact',
        onFormReady: function() {
          setTimeout(function() {
            var input = document.querySelector('#hs-form-contact input[name="lead_source_page"]');
            if (input) input.value = window.location.pathname;
          }, 100);
        }
      });
    }
  });
</script>
