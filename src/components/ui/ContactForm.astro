---
interface Props {
  locale?: string;
  labels?: {
    name: string;
    email: string;
    message: string;
    submit: string;
    success: string;
    error: string;
  };
  subject?: string;
}

const { locale = 'en', labels, subject } = Astro.props;

const defaults: Record<string, { name: string; email: string; message: string; submit: string; success: string; error: string; subject: string }> = {
  en: {
    name: 'Name',
    email: 'Email',
    message: 'Message',
    submit: 'Send Message',
    success: 'Thank you! Your message has been sent. We will get back to you shortly.',
    error: 'Something went wrong. Please try again or email us directly.',
    subject: 'New enquiry from starkrank.com',
  },
  pe: {
    name: 'Nombre',
    email: 'Correo Electrónico',
    message: 'Mensaje',
    submit: 'Enviar Mensaje',
    success: '¡Gracias! Su mensaje ha sido enviado. Nos pondremos en contacto pronto.',
    error: 'Algo salió mal. Por favor intente nuevamente o escríbanos directamente.',
    subject: 'Nueva consulta desde starkrank.com/pe',
  },
  de: {
    name: 'Name',
    email: 'E-Mail',
    message: 'Nachricht',
    submit: 'Nachricht Senden',
    success: 'Vielen Dank! Ihre Nachricht wurde gesendet. Wir melden uns in Kürze.',
    error: 'Etwas ist schiefgelaufen. Bitte versuchen Sie es erneut oder schreiben Sie uns direkt.',
    subject: 'Neue Anfrage über starkrank.com/de',
  },
  'ch-de': {
    name: 'Name',
    email: 'E-Mail',
    message: 'Nachricht',
    submit: 'Nachricht Senden',
    success: 'Vielen Dank! Ihre Nachricht wurde gesendet. Wir melden uns in Kürze.',
    error: 'Etwas ist schiefgelaufen. Bitte versuchen Sie es erneut oder schreiben Sie uns direkt.',
    subject: 'Neue Anfrage über starkrank.com/ch-de',
  },
};

const l = { ...defaults[locale] ?? defaults.en, ...labels };
const emailSubject = subject ?? l.subject;
---

<form class="space-y-6 contact-form" data-success={l.success} data-error={l.error}>
  <input type="hidden" name="access_key" value="c6c510f0-14d6-42e3-b16b-c4db8ac4e71b" />
  <input type="hidden" name="subject" value={emailSubject} />
  <input type="hidden" name="from_name" value="StarkRank Website" />
  <!-- Honeypot spam protection -->
  <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

  <div>
    <label for="name" class="block text-sm font-label font-semibold uppercase tracking-wide text-dark mb-2">{l.name}</label>
    <input type="text" id="name" name="name" required class="w-full px-4 py-3 border border-gray-light rounded-md font-body text-dark bg-white focus:border-blue focus:outline-none" />
  </div>
  <div>
    <label for="email" class="block text-sm font-label font-semibold uppercase tracking-wide text-dark mb-2">{l.email}</label>
    <input type="email" id="email" name="email" required class="w-full px-4 py-3 border border-gray-light rounded-md font-body text-dark bg-white focus:border-blue focus:outline-none" />
  </div>
  <div>
    <label for="message" class="block text-sm font-label font-semibold uppercase tracking-wide text-dark mb-2">{l.message}</label>
    <textarea id="message" name="message" rows="5" required class="w-full px-4 py-3 border border-gray-light rounded-md font-body text-dark bg-white focus:border-blue focus:outline-none resize-y"></textarea>
  </div>

  <div>
    <button type="submit" class="inline-flex items-center justify-center font-label font-semibold uppercase tracking-wide transition-all rounded-md bg-blue text-white hover:bg-blue-light px-8 py-4 text-sm">
      <span class="submit-text">{l.submit}</span>
      <svg class="submit-spinner hidden w-5 h-5 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
    </button>
  </div>

  <div class="form-status hidden rounded-lg p-4 text-sm font-body"></div>
</form>

<script>
  function initForms() {
    document.querySelectorAll('.contact-form').forEach((form) => {
      if ((form as HTMLFormElement).dataset.initialized) return;
      (form as HTMLFormElement).dataset.initialized = 'true';

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const f = e.target as HTMLFormElement;
        const submitText = f.querySelector('.submit-text') as HTMLElement;
        const spinner = f.querySelector('.submit-spinner') as HTMLElement;
        const status = f.querySelector('.form-status') as HTMLElement;
        const button = f.querySelector('button[type="submit"]') as HTMLButtonElement;

        // Show loading state
        submitText.classList.add('hidden');
        spinner.classList.remove('hidden');
        button.disabled = true;
        status.classList.add('hidden');

        try {
          const res = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(Object.fromEntries(new FormData(f))),
          });

          const data = await res.json();

          if (data.success) {
            status.textContent = f.dataset.success || 'Message sent!';
            status.className = 'form-status rounded-lg p-4 text-sm font-body bg-blue/10 text-blue border border-blue/20';
            f.reset();
          } else {
            status.textContent = f.dataset.error || 'Something went wrong.';
            status.className = 'form-status rounded-lg p-4 text-sm font-body bg-red-50 text-red-700 border border-red-200';
          }
        } catch {
          status.textContent = f.dataset.error || 'Something went wrong.';
          status.className = 'form-status rounded-lg p-4 text-sm font-body bg-red-50 text-red-700 border border-red-200';
        }

        submitText.classList.remove('hidden');
        spinner.classList.add('hidden');
        button.disabled = false;
      });
    });
  }

  initForms();
  document.addEventListener('astro:after-swap', initForms);
</script>
