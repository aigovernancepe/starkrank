---
interface Props {
  formId?: string;
  region?: string;
  portalId?: string;
}

const {
  formId = '5c38981a-8f6a-4a5f-95e3-fc1658431b53',
  region = 'eu1',
  portalId = '148108624',
} = Astro.props;
---

<div class="hs-form-frame" data-region={region} data-form-id={formId} data-portal-id={portalId}></div>

<script>
  function loadHubSpotForms() {
    if (document.querySelector('script[data-hs-forms-embed]')) return;
    const s = document.createElement('script');
    s.src = 'https://js-eu1.hsforms.net/forms/embed/148108624.js';
    s.defer = true;
    s.setAttribute('data-hs-forms-embed', '');
    document.head.appendChild(s);
  }
  if ('requestIdleCallback' in window) {
    requestIdleCallback(loadHubSpotForms, { timeout: 2000 });
  } else {
    setTimeout(loadHubSpotForms, 1);
  }
  document.addEventListener('astro:after-swap', loadHubSpotForms);
</script>
