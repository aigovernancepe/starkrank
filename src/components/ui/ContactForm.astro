---
const formId = '5c38981a-8f6a-4a5f-95e3-fc1658431b53';
const portalId = '148108624';
const containerId = `hs-contact-${Math.random().toString(36).slice(2, 8)}`;
---

<div id={containerId}></div>
<script define:vars={{ formId, portalId, containerId }}>
  function initContactForm() {
    if (window.hbspt && window.hbspt.forms) {
      window.hbspt.forms.create({
        region: 'eu1',
        portalId: portalId,
        formId: formId,
        target: '#' + containerId
      });
    } else {
      setTimeout(initContactForm, 200);
    }
  }
  initContactForm();
</script>
