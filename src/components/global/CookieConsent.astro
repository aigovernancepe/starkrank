---
import type { Locale } from '../../data/locales';
import { t } from '../../utils/i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
---

<div
  id="cookie-consent"
  class="fixed bottom-0 left-0 right-0 z-50 hidden"
  role="dialog"
  aria-label={t('consent.title', locale)}
  tabindex="-1"
>
  <div class="max-w-4xl mx-auto px-4 pb-4">
    <div class="bg-navy border border-gray/30 rounded-lg shadow-2xl p-6 flex flex-col sm:flex-row items-start sm:items-center gap-4">
      <div class="flex-1">
        <p class="text-sm font-body text-cream leading-relaxed">
          {t('consent.message', locale)}
          <a href={t('consent.policyLink', locale)} class="text-blue-light hover:text-blue underline ml-1">
            {t('consent.policyText', locale)}
          </a>
        </p>
        <p
          id="cookie-consent-status"
          class="hidden text-xs font-body text-gray-light mt-2"
          data-status-granted={t('consent.status.granted', locale)}
          data-status-denied={t('consent.status.denied', locale)}
        ></p>
      </div>
      <div class="flex gap-3 shrink-0">
        <button
          id="cookie-decline"
          class="px-5 py-2.5 text-xs font-label font-semibold uppercase tracking-wide text-gray-light hover:text-cream border border-gray/40 hover:border-cream/40 rounded-md transition-colors"
        >
          {t('consent.decline', locale)}
        </button>
        <button
          id="cookie-accept"
          class="px-5 py-2.5 text-xs font-label font-semibold uppercase tracking-wide text-white bg-blue hover:bg-blue-light rounded-md transition-colors"
        >
          {t('consent.accept', locale)}
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  function initConsent() {
    const banner = document.getElementById('cookie-consent');
    const acceptBtn = document.getElementById('cookie-accept');
    const declineBtn = document.getElementById('cookie-decline');
    const status = document.getElementById('cookie-consent-status');
    // Lives in the footer, so it is a sibling of this component rather than a child.
    const settingsBtn = document.getElementById('cookie-settings');

    if (!banner || !acceptBtn || !declineBtn) return;

    const consent = localStorage.getItem('cookie-consent');

    if (consent === null) {
      // No decision yet — show banner
      banner.classList.remove('hidden');
    } else if (consent === 'granted') {
      // Previously accepted — update consent
      updateConsent(true);
    }
    // If 'denied', consent defaults already set to denied — nothing to do

    function showStatus() {
      if (!status) return;
      const current = localStorage.getItem('cookie-consent');
      const text = current === 'granted' ? status.dataset.statusGranted : status.dataset.statusDenied;
      if (current === null || !text) return;
      status.textContent = text;
      status.classList.remove('hidden');
    }

    // Tracks how the banner was opened. Return focus to the footer button only
    // when that is where the visitor came from — on the first-visit banner they
    // never touched it, so sending focus to the footer would be disorienting.
    let openedFromSettings = false;

    function close() {
      banner.classList.add('hidden');
      status?.classList.add('hidden');
      if (openedFromSettings) {
        settingsBtn?.focus();
        openedFromSettings = false;
      }
    }

    function decide(granted: boolean) {
      localStorage.setItem('cookie-consent', granted ? 'granted' : 'denied');
      updateConsent(granted);
      close();
    }

    acceptBtn.addEventListener('click', () => decide(true));
    declineBtn.addEventListener('click', () => decide(false));

    if (settingsBtn) {
      // Revealed only now: without JS the banner cannot open, so the control
      // would be dead. See Footer.astro.
      settingsBtn.classList.remove('hidden');
      settingsBtn.addEventListener('click', () => {
        openedFromSettings = true;
        showStatus();
        banner.classList.remove('hidden');
        banner.focus();
      });
    }

    // Bound to the banner, not to document — initConsent re-runs after every
    // view transition, and a document-level listener would stack up each time.
    banner.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      // Dismissible only once a choice is on record; first-time visitors decide.
      if (localStorage.getItem('cookie-consent') === null) return;
      close();
    });
  }

  function updateConsent(granted: boolean) {
    if (typeof window.gtag === 'function') {
      window.gtag('consent', 'update', {
        analytics_storage: granted ? 'granted' : 'denied',
        ad_storage: granted ? 'granted' : 'denied',
        ad_user_data: granted ? 'granted' : 'denied',
        ad_personalization: granted ? 'granted' : 'denied',
      });
    }

    if (granted) {
      // ClarityScript listens for this to inject the tag (pages that embed it).
      window.dispatchEvent(new CustomEvent('starkrank:consent-granted'));
    } else if (typeof window.clarity === 'function') {
      // Consent withdrawn after Clarity already loaded — tells Clarity to drop
      // its cookies and end the session.
      window.clarity('consentv2', { ad_Storage: 'denied', analytics_Storage: 'denied' });
    }
  }

  // Run on initial load
  initConsent();
  // Re-run after Astro view transitions (SPA navigation)
  document.addEventListener('astro:after-swap', initConsent);
</script>
