---
interface Props {
  variant?: 'standard' | 'negative';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  locale?: string;
}

const { variant = 'standard', size = 'md', class: className = '', locale } = Astro.props;
const localeHome: Record<string, string> = {
  de: '/',
  en: '/en/',
  'ch-de': '/ch-de/',
};
const homeHref = (locale && localeHome[locale]) ?? '/';

const sizeClasses: Record<string, string> = {
  sm: 'h-6 w-auto',
  md: 'h-8 w-auto',
  lg: 'h-12 w-auto',
};

const src = variant === 'negative'
  ? '/SR-Logo-negative.png'
  : '/SR-Logo-standard.png';
---

<a href={homeHref} class:list={['inline-block', className]}>
  <img
    src={src}
    alt="StarkRank"
    width="320"
    height="118"
    decoding="async"
    fetchpriority="high"
    class={sizeClasses[size]}
  />
</a>
