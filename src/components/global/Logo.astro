---
interface Props {
  variant?: 'standard' | 'negative';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  locale?: string;
}

const { variant = 'standard', size = 'md', class: className = '', locale } = Astro.props;
const homeHref = locale && locale !== 'en' ? `/${locale}/` : '/';

const sizeClasses: Record<string, string> = {
  sm: 'h-6 w-auto',
  md: 'h-8 w-auto',
  lg: 'h-12 w-auto',
};

const src = variant === 'negative'
  ? '/SR-Logo_Negativ_high-res.png'
  : '/SR-Logo-standard_high-res.png';
---

<a href={homeHref} class:list={['inline-block', className]}>
  <img src={src} alt="StarkRank" width="160" height="40" class={sizeClasses[size]} />
</a>
