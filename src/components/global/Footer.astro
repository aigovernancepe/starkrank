---
import Logo from './Logo.astro';
import { footerNav, getLocalizedNavHref, getLocalizedAudits } from '../../data/navigation';
import { getCurrentLocale, t } from '../../utils/i18n';
import type { Locale } from '../../data/locales';

interface Props {
  locale?: string;
}

const { locale: localeProp } = Astro.props;
const locale = (localeProp ?? getCurrentLocale(Astro.url) ?? 'en') as Locale;
const year = new Date().getFullYear();
const localizedAudits = getLocalizedAudits(locale);

const pillarKeys: Record<string, string> = {
  'Search & AI': 'pillar.search-ai-intelligence',
  'Performance Media': 'pillar.performance-media',
  'Authority & PR': 'pillar.authority-pr',
  'Content & Copy': 'pillar.content-copywriting',
  'Data & Web': 'pillar.data-web',
};

const companyKeys: Record<string, string> = {
  'About': 'nav.about',
  'Locations': 'nav.locations',
  'Case Studies': 'nav.caseStudies',
  'Blog': 'nav.blog',
  'Contact': 'nav.contact',
};

const auditKeys: Record<string, string> = {
  'Free Google Ads Audit': 'footer.freeAdsAudit',
  'Copywriting Audit': 'footer.copywritingAudit',
};
---

<footer class="bg-navy text-cream">
  <div class="max-w-7xl mx-auto px-6 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
      <!-- Brand -->
      <div>
        <Logo variant="stacked-transparent" size="lg" class="mb-4" locale={locale} />
        <p class="text-sm text-gray-light mt-4 font-body">
          {t('footer.tagline', locale)}
        </p>
        <div class="mt-4">
          <a href="https://www.linkedin.com/company/starkrank" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm font-body text-gray-light hover:text-cream transition-colors" aria-label="StarkRank on LinkedIn">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            LinkedIn
          </a>
        </div>
      </div>

      <!-- Services -->
      <div>
        <h4 class="text-xs font-label font-bold uppercase tracking-widest text-blue mb-4">
          {t('footer.services', locale)}
        </h4>
        <ul class="space-y-2">
          {footerNav.pillars.map((item) => (
            <li>
              <a href={getLocalizedNavHref(item.href, locale)} class="text-sm font-body text-gray-light hover:text-cream transition-colors">
                {t(pillarKeys[item.label] ?? item.label, locale)}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h4 class="text-xs font-label font-bold uppercase tracking-widest text-blue mb-4">
          {t('footer.company', locale)}
        </h4>
        <ul class="space-y-2">
          {footerNav.company.map((item) => (
            <li>
              <a href={getLocalizedNavHref(item.href, locale)} class="text-sm font-body text-gray-light hover:text-cream transition-colors">
                {t(companyKeys[item.label] ?? item.label, locale)}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Audits -->
      <div>
        <h4 class="text-xs font-label font-bold uppercase tracking-widest text-blue mb-4">
          {t('footer.audits', locale)}
        </h4>
        <ul class="space-y-2">
          {localizedAudits.map((item) => (
            <li>
              <a href={item.href} class="text-sm font-body text-gray-light hover:text-cream transition-colors">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-16 pt-8 border-t border-gray/20 flex flex-col sm:flex-row items-center justify-between gap-2">
      <p class="text-xs text-gray font-body">
        &copy; {year} StarkRank. {t('footer.rights', locale)}
      </p>
      <div class="flex gap-4">
        <a href={getLocalizedNavHref('/privacy/', locale)} class="text-xs text-gray font-body hover:text-cream transition-colors">
          {t('footer.privacy', locale)}
        </a>
        {(locale === 'de' || locale === 'ch-de') && (
          <a href={getLocalizedNavHref('/impressum/', locale)} class="text-xs text-gray font-body hover:text-cream transition-colors">
            Impressum
          </a>
        )}
      </div>
    </div>
  </div>
</footer>
